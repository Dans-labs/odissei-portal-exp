{"license":"CC-BY-4.0","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"School stakeholders perspective on WASH in schools collected through interviews and art-based research"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Mingoti Poague, KIH"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Faculty of Geo-Information Science and Earth Observation"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Faculty of Geo-Information Science and Earth Observation, University of Twente"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"This database contains data collected through semi-structured interviews and art-based research, as part of Kasandra Isabella Helouise Mingoti Poague’s PhD thesis project. \nActivities were conducted with teachers, parents and\/or legal guardians of students, students and school staff other than teachers. All data was collected between 13 and 28 of January of 2024 in the state of Minas Gerais, in Brazil. \n\nThe purpose of these qualitative and quantitative activities was to \nto assess the state of water, sanitation and hygiene (WASH), including whether the Human Rights to Water and Sanitation (HRtWS) and its normative contents are suitable, in schools (students aged 0–18 years old) from different stakeholder perspectives in a municipality in Brazil. We sought to better understand how WASH-friendly schools are in the study area and for which school stakeholders. Moreover, considering that the school's WASH infrastructure might have been modified during the COVID-19 pandemic, our second underlying objective was to identify what WASH measures were implemented in the schools amidst the COVID-19 pandemic, which have persisted until now.\nMore information about the methods and activities employed can be found in \nKasandra I.H.M. Poague, Andressa P. Ramos, Caio B. de S. Lopes, Gabriel V.L. Gonçalves, Marina B.R. Damasceno, Justine I. Blanford, Javier A. Martinez, Carmen Anthonj, WASH-friendly schools for whom? Integrating the perception of different school stakeholders in Brazil, Social Science & Medicine, Volume 367, 2025, 117753,ISSN 0277-9536, https:\/\/doi.org\/10.1016\/j.socscimed.2025.117753.\n\nThe present database includes the anonymized transcription of all semi-structured interviews in Portuguese, along with products (drawings, paintings, etc.) generated in the art-based research workshop, with the following anonymized descriptions provided by students."},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2025-04-28"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities","Earth and Environmental Sciences"]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Portuguese"]},{"typeName":"producer","multiple":true,"typeClass":"compound","value":[{"producerName":{"typeName":"producerName","multiple":false,"typeClass":"primitive","value":"Mingoti Poague, KIH"},"producerAffiliation":{"typeName":"producerAffiliation","multiple":false,"typeClass":"primitive","value":"Faculty of Geo-Information Science and Earth Observation, University of Twente"}}]},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Supervisor"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Anthonj, Carmen"}},{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Supervisor"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Martinez, J.A"}},{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Supervisor"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Blanford, J.I"}},{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Data Collector"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Mingoti Poague, KIH"}}]},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2025-04-28"},{"typeName":"timePeriodCovered","multiple":true,"typeClass":"compound","value":[{"timePeriodCoveredStart":{"typeName":"timePeriodCoveredStart","multiple":false,"typeClass":"primitive","value":"2024-01-13"},"timePeriodCoveredEnd":{"typeName":"timePeriodCoveredEnd","multiple":false,"typeClass":"primitive","value":"2024-01-28"}}]},{"typeName":"dateOfCollection","multiple":true,"typeClass":"compound","value":[{"dateOfCollectionStart":{"typeName":"dateOfCollectionStart","multiple":false,"typeClass":"primitive","value":"2024-01-13"},"dateOfCollectionEnd":{"typeName":"dateOfCollectionEnd","multiple":false,"typeClass":"primitive","value":"2024-01-28"}}]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Faculty of Geo-Information Science and Earth Observation, University of Twente"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Yes"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["English"]}]},"dansRelatio
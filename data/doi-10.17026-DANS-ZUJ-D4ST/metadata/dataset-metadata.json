{"license":"CC0-1.0","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Musical correspondence of Constantijn Huijgens"},{"typeName":"alternativeTitle","multiple":true,"typeClass":"primitive","value":["Duizend brieven over muziek van, aan en rond Constantijn Huygens. Een website van Rudolf Rasch"]},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"NHDA: R0233"}},{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:1427"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"R.A. Rasch"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit Utrecht, Muziekwetenschap"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"R A  Rasch"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit Utrecht"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Constantijn Huygens (1596-1687) was een veelzijdig man. Het bekendst is hij geworden als dichter, maar daarnaast was hij ook een bekwaam musicus en componist. Zowel zijn poëtische als zijn muzikale liefhebberijen beoefende hij als vrijetijdsbesteding naast een intensieve werkkring als secretaris van drie opeenvolgende Oranje-stadhouders uit de zeventiende eeuw: Frederik Hendrik, Willem II en Willem III.Zijn belangstelling voor muziek had tot gevolg dat een niet onbelangrijk deel van zijn correspondentie (waarvan veel maar niet alles bewaard is gebleven) handelt over muzikale onderwerpen. Het betreft daarbij zowel brieven van en aan beroepsmusici als brieven van en aan muzikale amateurs uit zijn omgeving.Tezamen geven deze “muziekbrieven” een unieke kijk op de muziekbeoefening in de Nederlandse Republiek in de zeventiende eeuw."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"cultural history"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Dutch classical composer"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"17th-century Dutch poet"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"17th-century Latin-language writer"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch","English","French"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2000-03-09"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2020-12-09"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2013-03-06"},{"typeName":"dataSources","multiple":true,"typeClass":"primitive","value":["Primaire bronnen zijn vermeld in de documenten."]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Dr. R.A. Rasch"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName":"dansM
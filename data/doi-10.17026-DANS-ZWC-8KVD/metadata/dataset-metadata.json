{"license":"DANS Licence","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, Schiedamse kinderen op stap, interview 07"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:41664"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Nieuwendijk, C.I."}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Gemeentearchief Schiedam (©)"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"C.I.  Nieuwendijk"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Gemeentearchief Schiedam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Mevrouw is in 1935 in Haarlem geboren en een jaar later  verhuis naar een benedenhuis in de Boerhaavelaan in Schiedam. Het gezin bestond uit vader, moeder, twee dochters en twee zonen. Vader was koperslager bij een bedrijf in Rotterdam-Hillegersberg. In januari 1945 heeft haar vader haar op de fiets naar Staphorst gebracht, naar de familie Luten, die daar een caf?\/herberg had. Haar oudste broer was in de omgeving van Balkbrug ondergebracht. Onderweg werd haar vader op de IJsselbrug door Duitsers aangehouden. Zij heeft daar urenlang op hem gewacht tot hij terug kwam. Gedurende haar verblijf in Staphorst had zij wekelijks contact met haar oudste broer, maar geen contact met haar ouders. Ze had het in Staphorst prima naar haar zin. In mei 1945 heeft zij in Staphorst de bevrijding meegemaakt en zij is in juli 1945 samen met haar broer per boot via Kampen en Amsterdam naar Schiedam teruggekeerd."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Respondentnummer 12. Document GV_Schiedam_gastgezin1_07_analyse interview bevat een analyse van het interview."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Schiedam"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Hongertochten"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Hongerwinter"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Kinderuitzending"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Kinderen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Honger"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Hunger"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Hungerwinter"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Children"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Childrentransport"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Churches"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Second World War"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Kerken"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Oral history"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Het Vergeten Bombardement (1943)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Gaarkeuken"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Rooms-katholiek"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Fietstocht"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"IJsselbrug"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Caf?\/herberg"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Hotel Waanders"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Bevrijding"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"St. Janschool"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2009-09-15"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Jos Teunissen (transcriptie)"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Drs. C.I. Nieuwendijk (interviewer), Gemeentearchief Schiedam"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Daniël Gallenka
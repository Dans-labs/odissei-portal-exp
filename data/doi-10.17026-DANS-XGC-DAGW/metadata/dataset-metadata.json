{"license":"CC-BY-4.0","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Quick Scan Co-creation in Higher Education"},{"typeName":"alternativeTitle","multiple":true,"typeClass":"primitive","value":["Quick Scan Co-creatie in het hoger onderwijs"]},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:301647"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"M.S.A. de Hei"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"The Hague University of Applied Sciences"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0002-4018-0427"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"I. Audenaerde"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"The Hague University of Applied Sciences"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"M.M.  Kargól"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"The Hague University of Applied Sciences"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"In this tool co-creation is regarded as a collaborative process, where students, lecturers and working field professionals from outside the university jointly develop innovative products, processes or knowledge. In co-creation all stakeholders equally contribute to the collaborative process, and aims to create beneficial outcomes for each participant. Based on peerreviewed literatue, we developed a questionnaire to assess co-creation processes in HE. Students, lecturers and working field professionals (N=103) participating in co-creation projects completed the questionnaire. We validated the questionnaire using a principal component analysis. The seven extracted scales proved to be sufficiently reliable. The tool can be downloaded and freely used. We would greatly appreciate if teams of users could email their completed tool (anonimised) to the researcher for further research purposes to m.s.a.dehei@hhs.nl."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Quick Scan Co-creatie in het hoger onderwijs"}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date Submitted: 2023-06-20"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"co-creation tool"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"collaborative learning"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"innovation"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"professionalization"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"higher education"}}]
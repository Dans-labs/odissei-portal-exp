{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Interview met Peter Struycken, Gorinchem, 26 april 2024"},{"typeName":"subtitle","multiple":false,"typeClass":"primitive","value":"Over intentie, werkwijze, presentatie en behoud"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Stigter, S."},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0001-5250-8461"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Stigter, S."},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"}},{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Data Steward"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Het interview is gericht op kunstenaarsintentie in het kader van een onderzoeksproject bij de Universiteit van Amsterdam. Het interview vindt plaats al lopend door de expositie Rondom PS; Peter Struycken en bevriende werken, ter ere van zijn 85e verjaardag. Tijdens het interview vertelt Struycken aan de hand van voorbeelden in de expositie over zijn ontwikkeling, die hij detail uitlegt ter illustratie van de grotere lijn die we bespreken. Deze volgt de ontwikkeling van het werk van Peter Struycken, van een zelfgemaakt marionettentheater tot aan zijn computer gegenereerde werk en schilderijen van het heden. Dit wordt geïllustreerd met de tentoongestelde werken in het Gorcums Museum, inclusief de digitale projecties voor de muziek van Boulez en Skrjabin. Er is aandacht voor zijn tijd op de Koninklijke Academie voor Beeldende Kunst in Den Haag en er wordt ingegaan op hoe werken tot stand komen aan de hand van zijn gedachten over hoe systemen in kleur, vorm en tijd zicht tot elkaar kunnen verhouden. Daarnaast vertelt Struycken het verhaal bij enkele werken uit zijn  kunstcollectie die voor een belangrijk deel is ontstaan uit vriendschappen, onder meer over schilderijen van Charley Toorop, Harry Verburg en Mark Mulders, en het laatste zelfportret van Charlotte van Pallandt. \nHet zien van de video is noodzakelijk om het interview goed te kunnen volgen."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Peter Struycken"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"RKD"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"https:\/\/rkd.nl\/artists\/75857"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Moderne Kunst"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"AAT"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"http:\/\/vocab.getty.e
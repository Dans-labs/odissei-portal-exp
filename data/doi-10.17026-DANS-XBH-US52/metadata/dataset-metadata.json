primitive","value":"Stichting Spin Off"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Vocaal Talent Nederland"}}]},{"typeName":"notesText","multiple":false,"typeClass":"primitive","value":"De deponeerder heeft het databestand in SAV formaat geleverd. Ter bevordering van de duurzaamheid heeft DANS de POR en DTA formaten van dit bestand toegevoegd.\n\nVan de 1065 participanten (633 uit de eerste peiling en 432 nieuwe uit de tweede peiling) zijn er 952 aanwezig in het databestand. De overige 113 hebben de vragenlijst schriftelijk of via een interne mail ingevuld, en zijn daarom niet aanwezig in het bestand."},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2017-03-03"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"P. van der Zant (Bureau Art)"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2017-04-14"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2017-03-22"}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Bureau Art"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D35000","https:\/\/www.narcis.nl\/classification\/D61000","https:\/\/www.narcis.nl\/classification\/D51000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.
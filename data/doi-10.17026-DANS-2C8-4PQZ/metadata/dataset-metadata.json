{"license":"DANS Licence","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, Het Molukse perspectief in oorlogstijd, interview 09"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:41439"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Museum Maluku (MuMa) ©"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"J.M. Vreeswijk-Manusiwa"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"JM  Vreeswijk Manusiwa"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Museum Maluku"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Geïnterviewde 09 is geboren op 25 april 1933 in Batavia, Java, Indonesië. Ze is opgegroeid in een gezin met vijf kinderen waarvan zij de jongste is. Voor de oorlog studeerde haar vader in Singapore voor predikant bij de Adventkerk. Haar moeder verdiende met bakken, koken en handwerken geld voor de studie van haar vader.Als de oorlog uitbreekt, reist het gezin van Batavia naar Surabaya om een ernstig zieke oom te bezoeken. In Surabaya verblijven ze bij familie. Ze vluchten naar een rubberplantage en daarna weer terug naar Surabaya. In 1943, de avond voor haar tiende verjaardag, wordt haar vader weggehaald door de Japanners. Hij is niet meer teruggekomen. Pas in 1946 horen zij en haar moeder hoe haar vader door de Japanners is vermoord.Tijdens de Bersiaptijd raakt ze haar moeder voor bijna een half jaar kwijt. Met een konvooi van Molukse KNIL-militairen wordt haar moeder weer bij haar gebracht.In Surabaya biedt een broer van haar moeder haar de mogelijkheid om voor een paar maanden mee naar Nederland te gaan. Het zou maar voor drie maanden zijn. Nu, zegt ze, woont ze al bijna 60 jaar in Nederland."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date Submitted: 2010-05-31"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"oral history"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Molukkers"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"WOII"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"vrouwen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Moluccans"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"WWII"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"women"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2009-11-25"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2010-06-01"},{"typeName":"dateOfDeposit","multiple
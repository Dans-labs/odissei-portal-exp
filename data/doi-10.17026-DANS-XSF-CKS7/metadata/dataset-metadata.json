{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Pre-COOL tweejarigencohort: overzicht en samengevoegde bestanden"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:266799"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"I. van der Veen"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Kohnstamm Instituut"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0001-7837-7789"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"I. van der Veen"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Kohnstamm Institute"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"De bestanden betreffen het tweejarigencohort van het pre-COOL-cohortonderzoek. Dit cohortonderzoek is in 2009 gestart met als doel zicht te krijgen op de effecten van verschillende vormen van kinderopvang en van voor- en vroegschoolse educatie en sluit (deels) aan op het Cohortonderzoek Onderwijsloopbanen 5-18 jarigen, afgekort COOL5-18. Het pre-COOL-onderzoek wordt uitgevoerd op verzoek van het ministerie van Onderwijs, Cultuur en Wetenschap in opdracht van NRO. Deze upload betreft vier documenten.1. Een handleiding met een overzicht van alle bij DANS beschikbare databestanden van het tweejarigencohort.2. en 3. Twee nieuwe bestanden met samengevoegde informatie uit verschillende metingen. Dit betreft de Citotoetsen en achtergrondgegevens van leerlingen. Hiervoor zijn namelijk bij elke meting, indien de gegevens niet compleet waren van voorgaande schooljaren, opnieuw de gegevens opgevraagd van de voorgaande schooljaren. Aanvullingen zijn niet met terugwerkende kracht gedaan in bestanden die al beschikbaar waren gesteld in DANS. Daarnaast zijn ook van de schooljaren waarin geen meting plaatsvond Citotoetsgegevens opgevraagd.4. Een bestand met enkele nummers van kinderen die in bestanden uit de beginperiode van pre-COOL voorkomen en hetzelfde kind betreffen."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"childcare"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"voor- en vroegschoolse educatie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"schoolloopbanen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"school career"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"social-emotional development"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"sociaal-emotionele ontwikkeling"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"basisschool"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"primary school"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch","English"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2022-12-12"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Project Leader"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"A. M. Veen (Kohnstamm Instituut)"}}]},{"typeName":"distributor","multiple":true,"typeClass":"compound","value":[{"distributorName":{"typeName":"distributorName","multiple":false,"typeClass":"primitive","value":"Kohnstamm Instituut"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2022-12-23"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2022-12-23"}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Dr. M. H. van Binsbergen (Kohnstamm Instituut)","Dr. M. H. van  Binsbergen (Kohnstamm Instituut)"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D50000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D50000","termName":[{"lang":"nl","value":"Gedragswetenschappen en onderwijskunde"},{"lang":"en","value":"Behavioural and educational sciences"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]}]},"dansDataVaultMetadata":{"displayName":"Data Vault Metadata","name":"da
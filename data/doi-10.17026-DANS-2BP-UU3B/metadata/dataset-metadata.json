{"license":"DANS Licence","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, Schiedamse kinderen op stap, interview 02"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:41454"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Nieuwendijk, C.I."}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Gemeentearchief Schiedam (©)"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"C.I.  Nieuwendijk"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Gemeentearchief Schiedam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"De geïnterviewde is twee keer uitgezonden. In 1942 ? hij was toen 7 jaar - verbleef hij drie weken bij een protestants gezin in Sassenheim. De tweede keer was begin 1945, in de hongerwinter, naar Goor (Overijssel). Dit tweede gezin was niet religieus en bestond uit een vrouw en haar vader. Later bleken ze pro-Duits te zijn, de vriend van de vrouw was een NSKK'er. De geïnterviewde heeft het er helemaal niet naar zijn zin gehad en was opgelucht dat hij op 3 juli - zijn verjaardag- 1945 naar Schiedam terugkeerde. Eén van de jongens met wie hij per vrachtwagen naar Goor was gekomen, is tijdens een bombardement op Goor om het leven gekomen. Een tante van hem is in Schiedam van de honger overleden."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Respondentnummer 44. De beschrijvingen van de bijgevoegde foto's zitten in het document GV_Schiedam_gastgezin1_02_fotodocumentatie. Document GV_Schiedam_gastgezin1_02_analyse_interview bevat een analyse van het interview."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Schiedam"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Hongertochten"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Hongerwinter"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Kinderuitzending"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Kinderen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Honger"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Hunger"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Hungerwinter"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Children"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Childrentransport"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Churches"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","va
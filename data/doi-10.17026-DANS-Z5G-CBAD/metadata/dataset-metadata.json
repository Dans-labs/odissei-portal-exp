{"license":"DANS Licence","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, Het Molukse perspectief in oorlogstijd, interview 05"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:41436"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Museum Maluku (MuMa) ©"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"J.M. Vreeswijk-Manusiwa"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"JM  Vreeswijk Manusiwa"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Museum Maluku"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Geïnterviewde 05  is geboren op 2 januari 1927 in Nalahia, eiland Nusalaut, Molukken, Indonesië. Hij groeide op in een gezin van negen kinderen. In 1938 overleed zijn vader, waardoor zijn moeder alleen voor het gezin moest zorgen. Hij hielp haar mee, door met haar in de tuinen te werken. Tot 1945 bleef hij in Nalahia wonen.In 1943 moesten alle jongens van het dorp voor de Japanners werken. In Pelau werkte hij drie maanden met geïnterneerden uit Amerika, Engeland, Australië en Nederland. Daar werd hij geslagen omdat hij de gevangenen kokosnoten gaf. Vervolgens werkte hij voor de Japanners in Liang op het vliegveld. Na de capitulatie is hij met ca. 20 man lopend en varend weer teruggekeerd naar Nalahia.In 1947 ging hij bij het KNIL. In Surabaya volgde hij de opleiding voor commando, om later ingezet te worden bij de actie in Yogya.  Hij vond het erg om zijn moeder in Ambon achter te laten en stuurde haar maandelijks zijn salaris. Met de Roma vertrok hij in 1951 naar Nederland. Kwam in Zeeland terecht, waar hij nog meehielp tijdens de watersnoodramp in 1953."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date Submitted: 2010-05-31"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Oral history"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Molukkers"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"WOII"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"KNIL"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Moluccans"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"WWII"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Bersiap"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"actie Bandung"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Watersnoodramp"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Noodhulp"}}]},{"typeName":"language","multiple
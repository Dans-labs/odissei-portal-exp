estments \/  ICT support and cooperation with other schools \/ available hardware \/ knowledge and skills of teachers \/ opinion about the application of ICT \/ position of respondent at school \/ nr. of pupils \/ nr. of years of teaching experience \/ computer use by pupils outside school \/ use of computer by parents of pupils at home<\/p>"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"education"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"information and communication technology"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"computers"}}]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2000-01-01"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Prof.Dr. J.M. Prof.Dr. Pieters, Universiteit Twente, Toegepaste Onderwijskunde (depositor)"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Onderzoekcentrum Toegepaste Onderwijskunde, Universiteit Twente (data collector)"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Onderzoekcentrum Toegepaste Onderwijskunde, Universiteit Twente, Universiteit Twente (data collector)"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2008-11-07"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2008-11-07"}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Unknown"]},{"typeName":"dansPersonal
ience<\/i>, 1-25. doi: <a href=\"https:\/\/doi.org\/10.1080\/23273798.2018.1552007\" target=\"_blank\">10.1080\/23273798.2018.1552007<\/a>"}},{"dansRelationType":{"typeName":"dansRelationType","multiple":false,"typeClass":"controlledVocabulary","value":"relation"},"dansRelationText":{"typeName":"dansRelationText","multiple":false,"typeClass":"primitive","value":"Faber, M., Mak, H.M.L. & Willems, R.M. (2020). Word skipping as an indicator of individual reading style during literary reading. <i>Journal of Eye Movement Research, 13<\/i> (3):2. doi: <a href=\"https:\/\/doi.org\/10.16910\/jemr.13.3.2\" target=\"_blank\">10.16910\/jemr.13.3.2<\/a>"}},{"dansRelationType":{"typeName":"dansRelationType","multiple":false,"typeClass":"controlledVocabulary","value":"relation"},"dansRelationText":{"typeName":"dansRelationText","multiple":false,"typeClass":"primitive","value":"de Vries, C., Reijnierse, W.G. & Willems, R.M. (2018). Eye movements reveal readers? sensitivity to deliberate metaphors during narrative reading. <i>Scientific Study of Literature, 8<\/i> (1), 135-163. doi: <a href=\"https:\/\/doi.org\/10.1075\/ssol.18008.vri\" target=\"_blank\">10.1075\/ssol.18008.vri<\/a>"}}]}]},"dansTemporalSpatial":{"displayName":"Temporal and Spatial Coverage","name":"dansTemporalSpatial","fields":[{"typeName":"dansTemporalCoverage","multiple":true,"typeClass":"primitive","value":["Collection period: start=2017-01-12; end=2017-09-19;"]}]},"dansDataVaultMetadata":{"displayName":"Data Vault Metadata","name":"dansDataVaultMetadata","fields":[{"typeName":"dansDataversePid","multiple":false,"typeClass":"primitive","value":"doi:10.17026\/DANS-ZQK-ZMQS"},{"typeName":"dansDataversePidVersion","multiple":false,"typeClass":"primitive","value":"1.1"},{"typeName":"dansBagId","multiple":false,"typeClass":"primitive","value":"urn:uuid:42ff40bf-cf95-48de-94e2-80bcb6b37d82"},{"typeName":"dansNbn","multiple":false,"typeClass":"primitive","value":"urn:nbn:nl:ui:13-k2-mzdb"}]}}}
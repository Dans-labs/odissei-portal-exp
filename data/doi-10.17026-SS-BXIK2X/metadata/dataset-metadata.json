{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"ONDERZOEK ONDERWEG IN NEDERLAND - ODiN 2022"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Informatiepunt, ipwvl"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Rijkswaterstaat"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Centraal Bureau voor de Statistiek"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"CBS"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Informatiepunt, ipwvl"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Rijkswaterstaat"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Het Onderzoek Onderweg in Nederland is een continu dagelijks onderzoek naar het verplaatsingsgedrag van de Nederlanders. Aan de respondenten wordt gevraagd om voor één bepaalde dag van het jaar bij te houden waar ze die dag naartoe gaan, met welk doel, met welk vervoermiddel en hoe lang het duurt om er te komen. Daarnaast wordt gevraagd naar enkele algemene persoons- en huishoudkenmerken en naar zaken zoals rijbewijs- en vervoermiddelenbezit. \nVanaf ODiN 2022 zijn vragen toegevoegd over woon-werk reiskostenvergoeding en vervoersarmoede.\n\nOp grond van dit onderzoek kan informatie worden verkregen over alle dagelijkse verplaatsingen door Nederlanders op Nederlands grondgebied.\n\nODiN is een voortzetting van het Onderzoek Verplaatsingen in Nederland (OViN) dat van 2010 t\/m 2017 door CBS is uitgevoerd als opvolger van het Mobiliteitsonderzoek Nederland (MON) dat van 2004 t\/m 2009 is uitgevoerd door Rijkswaterstaat. Voor 2004 werd het onderzoek onder naam van Onderzoek Verplaatsingsgedrag (OVG) door CBS uitgevoerd.\n\nHet ODiN wordt vanaf 2018 op een andere manier uitgevoerd dan voorheen het OViN. Daarom is er sprake van een methodebreuk tussen OViN en ODiN. Resultaten van ODiN analyses kunnen niet zomaar vergeleken worden met OViN analyses.\n\nVoor een juist gebruik van ODiN is het van groot belang om de onderzoeksbeschrijving te lezen. Weging en correct gebruik van de weegfactoren wordt daarin uitgelegd. In de onderzoeksbeschrijving en Plausibiliteitsrapportage ODiN2022 worden enkele belangrijke aandachtspunten en verschillen tussen het ODiN 2021 en ODiN2022 toegelicht."},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2022"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Other"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Mobiliteit"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Modal split"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"personenvervoer"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"vervoer"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Auto"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Bus"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tram"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Metro"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"fiets"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"e-bike"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"trein"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"vervoerwijzen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Openbaar vervoer"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Carpoolen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Beroepsmatige mobiliteit"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Vervoermiddelen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Reisduur"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Buitenlandse verplaatsingen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Studenten OV-chipkaart"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Transport"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"mobiliteitsonderzoek"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"vervoersarmoede"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2023-07-23"},{"typeName":"depositor","multiple":false,"typeClass":"primitive","value":"Informatiepunt, ipwvl"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2023-07-19"},{"typeName":"timePeriodCovered","m
{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Replication data for: Embedding planning support systems in spatial planning practice: the role of drift in implementing the Spatial Development Framework methodology"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"D.A. Oyeku"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Faculty of Geo-Information Science and Earth Observation"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0003-2903-9710"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"RDM-ICT"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Faculty of Geo-Information Science and Earth Observation"}},{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Oyeku, Deborah Adeola"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"This dataset was created as part of a PhD project that investigated the institutionalization of planning support systems in Rwandan spatial planning processes.\nIt contains anonymized interview transcripts and a data codebook used in the research to investigate the role of the drift concept in embedding planning support systems within Rwandan spatial planning processes. The data were collected from January to March 2020 during fieldwork and internship in Rwanda. The dataset includes an internship report. It also contains published supplementary materials on the overview of secondary data, primary data collection, data coding (themes and codes), and results. Data coding was done using the ATLAS.ti Version 8.4.24. Thematic analysis adopted the deductive and inductive coding methods."},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2025-12-02"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Earth and Environmental Sciences","Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Planning Support Systems"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"https:\/\/www.tandfonline.com\/doi\/full\/10.1080\/13563475.2024.2308867"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"PSS"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Spatial Development Framework methodology"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"https:\/\/www.tandfonline.com\/doi\/full\/10.1080\/13563475.2024.2308867"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"SDF"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Spatial planning practice"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"https:\/\/www.tandfonline.com\/doi\/full\/10.1080\/13563475.2024.2308867"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Drift concept"},"keywordT
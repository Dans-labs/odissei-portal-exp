{"license":"CC0-1.0","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Nederlandse oud-gevangenen van kamp Buchenwald,  interview 15,  Gerrit Petter"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:60680"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"NIOD Instituut voor Oorlogs-, Holocaust- en Genocidestudies"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"NIOD  Onderzoeksdata"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"NIOD Instituut voor Oorlogs-, Holocaust- en Genocidestudies"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"De heer Gerrit Petter vertelt dat hij tijdens de eerste oorlogsjaren weinig merkte van de bezetting. Hij weigerde om in Duitsland te gaan werken, werd op 25 januari 1944 opgepakt en kwam via Wolvega en Steenwijk in de gevangenis van Arnhem terecht. Van daaruit werd hij op 12 maart 1944 overgebracht naar kamp Amersfoort en vervolgens op 18 april doorgestuurd naar Buchenwald.In Buchenwald werd hij ondergebracht in barak 32 en 48. Hij werkte in de steengroeve, bij het Bahnhof Kommando en bij het houthakkerscommando.In november 1944 werd hij naar de munitiefabrieken van Dingelstädt gestuurd. Daar moet hij kisten in wagons laden, helpen bij de aanleg van ondergrondse tunnels, werken in de keuken en eenmansgaten langs de weg graven.Omstreeks 13 april 1945 naderden de Amerikanen, de Duitsers gingen er vandoor en Petter was vrij. Met een paar anderen ving hij te voet de thuisreis aan. Onderweg werden ze door de Amerikanen opgepikt en vijf dagen later keerden ze per trein naar Nederland terug."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date Submitted: 2015-03-02"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Buchenwald (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Second World War (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Concentratiekampen (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Concentration camps (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Herinneringen (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Memories (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Gevangenen (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Prisoners (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Overlevenden (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Survivors (NIOD)"}},{"keywordValue":{"typeN
{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Ziel van de Wederopbouw – Interview 032"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:144319"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"S. Dias"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Stichting Verhalenhuis Belvédère"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"M  Broekhuizen"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Vrije Universiteit Amsterdam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Vanwege de politieke instabiliteit verhuisde het 8-koppig gezin in 1974 naar Portugal, de voormalige kolonisator van Kaapverdië. In de jaren tachtig kwam de geïnterviewde naar Rotterdam, om te kijken naar het land, naar de stad waar zijn vader woonde en werkte. Hij voelde zich meteen welkom. Toen besloot ook hij hier te blijven, een leven op te bouwen. Hij volgde een studie maatschappelijk werk, werd marathonloper, ging werken voor de GGD en zette zich in voor allerlei groepen in Rotterdam, waaronder de Kaapverdische gemeenschap. Hij trouwde een Nederlandse en kreeg twee kinderen.Dit interview maakt onderdeel uit van het project Ziel van de Wederopbouw, wat in 2016 is ondernomen door Stichting Verhalenhuis Belvédère. In deze collectie zijn 86 levensverhalen van Rotterdammers van verschillende generaties, afkomsten en culturen opgenomen, allemaal met als centraal thema de Wederopbouw in de brede zin.\""}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Wederopbouw"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Migratie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Kaapverdianen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Zorg"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Gemengd huwelijk"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Dansfeesten"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Identiteit"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Gezin"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Oral History"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2016-02-05"},{"typeName":"distributor","multiple":true,"typeClass":"compound","value":[{"distributorName":{"typeName":"distributorName","multiple":false,"typeClass":"primitive","value":"Stichting Verhalenhuis Belvédère"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2019-10-10"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"pr
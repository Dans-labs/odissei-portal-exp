{"license":"CC0-1.0","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"De bevolking van Twente voor 1812 (\"Twentebestand\")"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"NHDA: D0143"}},{"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"NHDA: R0091"}},{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:40205"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Prof.Ir. H.C. Zorn"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"H.C.  Zorn"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"none"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Een bestand van personen die vóór 1 januari 1812 in Twente geboren zijn en er een gezin gesticht hebben. Het bestand omvat gegevens van 87.379 personen."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities","Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"social history"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"historical demography"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Prosopography"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"1986-01-01"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Prof.Ir. H.C. Zorn (research initiator)"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Prof.Ir. H.C. Zorn (data collector)"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2008-12-22"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2012-09-19"},{"typeName":"dataSources","multiple":true,"typeClass":"primitive","value":["De gegevens zijn voor circa 90% verkregen uit primaire bronnen (baptismal, marriage and burial registers, several genealogical registers\/censuses, judicial archives). Daarnaast is gebruik gemaakt van gepubliceerde genealogieën en vooroudertabellen (kwartierstaten), de bronnen zijn vermeld in de dataset. Gelegde relaties berusten vaak op vermoedens, gebruikers van de dataset dienen daarom alle gegevens aan de bronnen te verifiëren. Bovendien is het mogelijk dat daar nog aanvullende informatie te vinden is.       \n       \nDe spelling van de Nederlandse taal ligt pas sedert het begin van de 19e eeuw min of meer vast. Daarvoor spelde iedereen naar eigen goeddunken. Bijna iedere naam werd op meer dan een, soms wel 5 manieren gespeld. Daarom is hier een zekere standaardisering toegepast. Letters die niet uitgesproken worden zijn meestal weggelaten. Men dient te bedenken dat de uitgangen als ink, ing, ingh of inck in het bestand meestal als ink geschreven werden. Enige kennis van de Twentse streektaal is nuttig om de verschillende spellingen te begrijpen. Zo kan de klank a ook weergegeven zijn door o of ao. (Averink of Overing?) Men dient ook te bedenken dat de personen in dit bestand voor het overgrote deel analfabeet waren, ze konden zelf geen aanwijzingen geven over de spelling van hun naam."]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Unknown"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D34300","https:\/\/www.narcis.nl\/classification\/D64000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D34300","termName":[{"lang":"nl","value":"Moderne en contemporaine geschiedenis"},{"lang":"en","value":"Modern and contemporary history"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"},{"@id":"https:\/\/www.narcis.nl\/classification\/D64000","termName":[{"lang":"nl","value":"Demografie"},{"lang":"en","value":"Demography"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]},{"typeName":"dansRelation","multiple":true,"typeClass":"compound","value":[{"dansRelationType":{"typeName":"dansRelationType","multiple":false,"typeClass":"controlledVocabulary","value":"relation"},"dansRelationText":{"typeName":"dansRelationText","multiple":false,"typeClass":"primitive","value":"Website 'Twente Bestand'"},"dansRelationURI":{"typeName":"dansRelationURI","multiple":false,"typeClass":"primitive","value":"http:\/\/www.zornsoftware.com\/twentebestand\/"}}]}]},"dansTemporalSpatial":{"displayName":"Temporal and Spatial Coverage","name":"dansTemporalSpatial","fields":[{"typeName":"da
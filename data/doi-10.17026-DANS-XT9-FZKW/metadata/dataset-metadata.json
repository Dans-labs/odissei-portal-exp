{"license":"CC0-1.0","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"An Introduction to the African Commodity Trade Database, 1730-2010"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:75672"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"E. Frankema"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Wageningen University"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/203276957"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"P. Woltjer"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Wageningen University"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"A. Dalrymple-Smith"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Wageningen University"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"L. Bulambo"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Wageningen University"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Data  Librarian"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Wageningen UR"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"The African Commodity Trade Database (ACTD) aims to stimulate and deepen research on African and global economic history. The database provides export and import series at product level for more than two and a half centuries of African trade (1730-2010). This article introduces potential users to some of the major questions that can be explored with African commodity trade data, as well as the sources, structure and limitations of the dataset. The current version of the ACTD is downloadable from the data repository of the African Economic History Network  (www.aehnetwork.org\/data-research) and will be regularly updated with new data."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities","Business and Management"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"African commodity trade"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"economic history"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["English"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2017-01-01"},{"typeName":"distributor","multiple":true,"typeClass":"compound","value":[{"distributorName":{"typeName":"distributorName","multiple":false,"typeClass":"primitive","value":"Wageningen University"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2017-11-17"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2017-11
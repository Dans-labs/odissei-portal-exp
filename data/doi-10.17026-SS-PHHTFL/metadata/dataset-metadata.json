{"license":"CC-BY-4.0","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Vrijwilligerswerk voor vluchtelingen"},{"typeName":"subtitle","multiple":false,"typeClass":"primitive","value":"Focusgroepen en interviews in Nijmegen"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"M. Meijeren"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud Universiteit Nijmegen"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0003-2613-5256"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"N. Ellemers"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit Utrecht"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"M. Lubbers"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit Utrecht"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"P. Scheepers"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud Universiteit Nijmegen"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Meijeren, Maikel"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud Universiteit Nijmegen"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Van oktober 2021 tot en met februari 2022 is er kwalitatief onderzoek verricht onder vrijwilligers die vrijwilligerswerk voor vluchtelingen deden in Nederland. Deze vrijwilligers waren werkzaam op locaties in en rondom Nijmegen. Dit betroffen AZC’s, locaties waar vluchtelingenorganisaties werkzaam waren en een noodopvang waar Afghaanse vluchtelingen tijdelijk gehuisvest waren. In tien focusgroepen is met vrijwilligers gesproken. Verder zijn er vijf semigestructureerde interviews gehouden met coördinatoren van de vrijwilligers die hebben deelgenomen aan de focusgroepen. Dit onderzoek diende de beantwoording van de volgende overkoepelende vraagstelling: \n•\tWaarom doen mensen vrijwilligerswerk voor vluchtelingen en hoe ervaren zij hun vrijwilligerswerk?\nVoor de beantwoording van de overkoepelende vraagstelling zijn ook drie sub-vraagstellingen geformuleerd:\n•\tWat zijn motieven om vrijwilligerswerk voor vluchtelingen te doen? \n•\tHoe ervaren vrijwilligers de samenwerking met veldwerkpartners, andere vrijwilligers en betaalde krachten van de organisatie waar ze voor werken?\n•\tHoe reageert de persoonlijke omgeving van de vrijwilligers op het feit dat zij vrijwilligerswerk voor vluchtelingen doen?\n\nZie het informatiedocument voor verdere informatie over het onderzoek."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Civil society"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Vrijwilligerswerk"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Vluchtelingen"}}]},{"typeName":"notesText","multiple":fals
{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Social and Cultural Developments in the Netherlands 2021"},{"typeName":"alternativeTitle","multiple":true,"typeClass":"primitive","value":["Documentation of a national survey on social cohesion and modernization"]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Savelkoul, Michael"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud University \/ RSCR"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"van Groenestijn, Pieter"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud University \/ RSCR"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Scheepers, Peer"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud University \/ RSCR"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Loh, Renae"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud University \/ RSCR"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Eisinga, Rob"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud University \/ RSCR"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Savelkoul, Michael"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Department of Sociology \/ RSCR - Radboud University"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"National survey on social cohesion and modernization in the Netherlands.\nThis survey builds on earlier survey rounds of the Religion in Dutch society survey, which have been conducted in the winters of 1979\/1980, 1985\/1986, 1990\/1991, 1995\/1996, 2000\/2001, 2005\/2006, 2011\/2012, and the Social and Cultural Developments in the Netherlands survey 2017, 2018, 2019 and 2020.\n\nThey are part of a long-standing research program, aimed at longitudinal research with a strong (a) substantial multi-disciplinary focus on religiosity, values, in-group solidarity and out-group derogation as well as a strong (b) methodological focus on high quality data, valid measurements and innovative data-collection designs.\nThe most recent data collection for 2021 improves possibilities to test hypotheses on processes of secularization and individualization, spanning a period of more than forty years.\n\nRSCR Data Guide SOCON 2021 available (open access); dataset SOCON 2021 available as of September 2025 (restricted access)."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"conservatism"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"politics"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"health"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"ethnocentrism"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"longitudinal research"
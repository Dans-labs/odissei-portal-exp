{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Monitor kwaliteit van leven van naasten van mensen met een beperking"},{"typeName":"subtitle","multiple":false,"typeClass":"primitive","value":"Inzichten voor beleid, praktijk en onderzoek"},{"typeName":"alternativeURL","multiple":false,"typeClass":"primitive","value":"https:\/\/www.nivel.nl\/nl\/project\/kwaliteit-van-leven-ervaringen-en-ondersteuningsbehoeften-van-naasten-van-mensen-met-een"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Zonneveld, Ellen"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"https:\/\/ror.org\/015xq7480","expandedvalue":{"scheme":"http:\/\/www.grid.ac\/ontology\/","termName":"Netherlands Institute for Health Services Research","@type":"https:\/\/schema.org\/Organization"}},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0001-7263-9194"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Raad van Bestuur"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Nivel"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"De dataset bevat kwantitatieve en kwalitatieve data over de ervaringen van naasten van mensen met beperking en een daaruit voortvloeiende langdurige, intensieve zorgbehoefte. De data geven inzicht in hoe naasten, zoals ouders, broers en zussen, partners en kinderen, hun leven en de zorg ervaren en waarderen, welke behoeften zij hebben en hoe dit over de jaren heen verandert.\nDe data zijn verzameld middels vragenlijsten onder 348 naasten en 15 interviews met naasten. Dataverzameling vond plaats tussen 2023 en 2025. Het sluit aan op een in 2019 door ons eerder uitgevoerde eerste meting onder naasten."},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2025-07-08"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Medicine, Health and Life Sciences","Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Quality of Life"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"Quality of Life"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"https:\/\/www.ncbi.nlm.nih.gov\/mesh\/?term=quality+of+life"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Family Caregivers"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"Family Caregivers"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"https:\/\/www.ncbi.nlm.nih.gov\/mesh\/68017028"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Caregiver burden"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"Caregiver burden"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"https:\/\/www.ncbi.nlm.nih.gov\/mesh\/?term=care+burden"}},{"keywordV
{"license":"CC0-1.0","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Rekenen in Beeld"},{"typeName":"alternativeTitle","multiple":true,"typeClass":"primitive","value":["Images of Numeracy"]},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"ODB10068 (NWO-projectnummer)"}},{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:61569"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"K. Hoogland"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"APS"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"K.  Hoogland"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"APS"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"The project is conducted under the programe Onderwijsbewijs II (Evidence based Research in Education). The research question is: What is the effect on students' performance of changing the representation of the problem situation in mathematical contextual problems. In this randomized controlled experiment the representaion of the problem situation in 24 items is systematically changed form descriptive to depictive. In each test half of the items is randomly assigned one repesentation or the other.The article \"Word Problems versus Image-Rich Problems: Changing the Representation of Reality in Contextual Mathematical Problems\" reports on this research.---Het project is een onderzoek in het programma Onderwijsbewijs II, dat zich richt op \"evidence-based\" onderzoek naar onderwijspraktijken. In dit onderzoek wordt systematisch gekeken wat het effect is op de resultaten van leerlingen als in contextopgaven bij rekenen de verhalende representatie van de probleemsituatie systematisch wordt vervangen door een beeldende representatie van de probleemsituatie. In de ontwikkelde toets krijgen de deelnemers random de helft van de toets opgaven met een beschrijvende representatie van de probleemsituatie en de helft van de toets met en beeldende representatie. Dit onderzoeksontwerp voldoet aan de eisen van een \"randomized controled trial\".Het artikel \"Word Problems versus Image-Rich Problems: Changing the Representation of Reality in Contextual Mathematical Problems\" rapporteert over dit onderzoek."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"The code book is in English and in Dutch."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Word problems"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"image-rich numeracy problems"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Contextual Mathematical Problems"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Representation of Reality"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Randomized controled experiment"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Probit Analysis"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Onderwijsbewijs II"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"onderwijs"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"primair onderwijs"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"basisonderwijs"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"voortgezet onderwijs"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"middelbaar beroepsonderwijs"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"functioneel rekenen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"wiskunde"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"woord"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"taal"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"beeld"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch","English"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2013-12-31"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"J. de Koning (Erasmus University \/ SEOR)"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"O. Tanis (SEOR)"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Intraquest BV"}},{"contributorName":{"typeName":"
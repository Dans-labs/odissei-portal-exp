{"license":"DANS Licence","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, Het Molukse perspectief in oorlogstijd, interview 03"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:41434"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Museum Maluku (MuMa) ©"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"J.M. Vreeswijk-Manusiwa"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"JM  Vreeswijk Manusiwa"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Museum Maluku"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Geïnterviewde 03 is geboren op 5 februari 1924 in het dorp Oma, eiland Haruku, Molukken, Indonesië. Hij groeide op in een gezin van vader, moeder en vier kinderen. Hij was het tweede kind. In Oma maakte hij tijdens zijn kinderjaren twee grote branden (1928, 1938)en een aardbeving (1935) mee.Toen de Tweede Wereldoorlog begon, was hij nog in Oma, en hij maakte de Japanse aanval op het dorp mee. Gedurende de oorlog werkte hij voor de Japanners in Ambon en op het eiland Seram in de stad Piru. Van Piru vluchtte hij naar Loki, waar een oom van hem woonde, en waar hij een Japans verhoor overleefde.In 1947 tekende hij voor het KNIL. Vanuit Ambon vertrok hij achtereenvolgens naar, Namlea (Buru), Makassar, Surabaya en Tanjung Priok. Hij volgde een opleiding parachutist en commando en vocht mee tijdens de politionele acties. Hij was betrokken bij de acties in 1948 te Yogya, Jambi (Sumatra), Rengat (Sumatra) en Wonosari. In 1951 werd hij per vliegtuig naar Nederland gebracht."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date Submitted: 2010-05-31"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Oral history"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Molukkers"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"WOII"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Moluccans"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"WWII"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Bersiap"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"actie Bandung"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"KNIL"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Malay"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2008-08-06"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2010-06-01"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"prim
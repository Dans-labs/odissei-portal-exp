{"license":"CC-BY-SA-4.0","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Muurschilderingen van F.H. Bach te Beltrum"},{"typeName":"subtitle","multiple":false,"typeClass":"primitive","value":"een casus in het project Leren van restauratieve ingrepen van muurschilderingen uit de Moderne tijd (onderdeel van het Programma Erfgoed van de Moderne Tijd)"},{"typeName":"alternativeURL","multiple":false,"typeClass":"primitive","value":"https:\/\/images.memorix.nl\/rce\/download\/fullsize\/6c2ad3f0-028d-b297-1a98-391611cec699.pdf"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"B. Crijns"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"https:\/\/ror.org\/01rxwr703","expandedvalue":{"scheme":"http:\/\/www.grid.ac\/ontology\/","@type":"https:\/\/schema.org\/Organization"}},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ROR"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"R. Morelissen"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"https:\/\/ror.org\/01rxwr703","expandedvalue":{"scheme":"http:\/\/www.grid.ac\/ontology\/","@type":"https:\/\/schema.org\/Organization"}},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ROR"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"M. Lewis"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"https:\/\/ror.org\/01rxwr703","expandedvalue":{"scheme":"http:\/\/www.grid.ac\/ontology\/","@type":"https:\/\/schema.org\/Organization"}},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ROR"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"E. Teeuw"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"https:\/\/ror.org\/01rxwr703","expandedvalue":{"scheme":"http:\/\/www.grid.ac\/ontology\/","@type":"https:\/\/schema.org\/Organization"}},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ROR"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Teesing, Annemiek"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Deze rapportage is de weerslag van het vooronderzoek naar de muurschilderingen die F.H. Bach maakte voor de kerk van Beltrum.<br>\nHet doel van dit vooronderzoek is een weloverwogen besluitvorming bij ingrepen aan de muurschilderingen. Het vaststellen van de betekenis en de conditie van de schilderingen is daarvoor essentieel.<br>\nDit vooronderzoek is onderdeel van een casus binnen het RCE project Leren van restauratieve ingrepen aan muurschilderingen uit de Moderne Tijd. Binnen dit RCE project worden een aantal restauraties van belangrijke muurschilderingen uitgebreider\ngevolgd. De verschillende casussen worden door de RCE gebruikt voor het opstellen van richtlijnen om zorgvuldig met schilderingen om te gaan. Op die manier wil de RCE het erfgoedveld en de eigenaren helpen om muurschilderingen zo goed mogelijk te behouden voor de toekomst."},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2026-05-12"}}]},{"typeName":"sub
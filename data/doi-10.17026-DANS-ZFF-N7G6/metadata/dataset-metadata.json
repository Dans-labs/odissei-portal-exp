{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Sorbian language(s): revitalization efforts in different political systems"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:256500"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"N. Do'owy-Rybi'ska"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Polish Academy of Sciences"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"C. Ratajczak"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Sorbian Journal"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"NDR  Dolowy-Rybinska"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Using multilateral methods based on ethnographic and sociolinguistic research, the project aimed to analyze current official and bottom-up language policy. With a concentration on Upper and Lower Sorbian language speakers, we identified their perceptions and attitudes toward language and response to the needs of existing revitalization programs. We studied the influence of the state political system and its influence on minority language revitalization programs. The Upper and Lower Sorbian case study helped us understand the relationship between political systems, revitalization efforts, and people?s openness to maintain minority language."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Sorbian"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"language revitalization\/maintenance"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Sustaining Minoritized Languages in Europe"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Irish"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2019-06-30"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2029-06-30"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2022-09-12"}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Dr. N. Do'owy-Rybi'ska (Polish Academy of Sciences)"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Yes"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["English"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D36100","https:\/\/www.narcis.nl\/classification\/D36900"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D36100","termName":[{"lang":"en","value":"Linguistics"},{"lang":"nl","value":"Linguïstiek"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classifi
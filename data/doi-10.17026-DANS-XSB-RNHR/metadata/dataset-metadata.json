{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"ORA - Positive-Negative Asymmetry of Contact - Social Networks Schools"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:121806"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"E Jaspers"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Utrecht Universiteit"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Eva  Jaspers"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Utrecht University"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"The research project consisted of a non-invasive and observational study that examined the formation of social networks amongst secondary school students from different ethnic groups, as well as the consequences of network properties for students’ attitudes, opinions, and well-being. The focus was on first year students (age 12-13), since they do not yet have a fully formed network. This allowed us to more accurately investigate network formation. We collected three waves of data: at the beginning, the middle, and the end of the school year."}}]},{"typeName":"subject","multiple":true,"typeClass"
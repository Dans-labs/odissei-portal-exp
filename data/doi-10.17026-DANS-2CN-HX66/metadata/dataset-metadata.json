alse,"typeClass":"primitive","value":"boek"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"bruidschat"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"bijeenkomst"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"contact"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"dominee"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"dorp"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"dorpsschool\/onderwijzer"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"guru"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"discipline"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"ECK (evangelisch christelijke kerk)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"familieleden (familie)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"feest"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"gemeenschapsgevoel"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"gevoelens"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"heidenen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"islam"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"identiteit"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"internaat"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Japanners"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"jongens"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"kepala"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"kampong"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"kannibalen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"karaktertrekken"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"kazerne"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"kind"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2009-06-11"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Anke Kamerman"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2011-11-01"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2009-06-11"},{"typeName":"series","multiple":true,"typeClass":"compound","value":[{"seriesInformation":{"typeName":"seriesInformation","multiple":false,"typeClass":"primitive","value":"<p>In 1942 werd Nederlands-Indië, en daarmee ook Nieuw-Guinea, door Japan bezet. Toch slaagde de Japanners er niet in om geheel Nieuw-Guinea te veroveren. Nederlandse guerrillastrijders bleven strijd voeren en zouden zich voor een deel ook nooit overgeven. De bevolking van Nieuw-Guinea werd hierdoor geconfronteerd met bezetting en geweld, maar ook met een steeds sterker wordend Indonesisch nationalisme.<\/p><p>Na de capitulatie van Japan riep Soekarno de Republik Indonesia uit, die het gehele voormalig Nederlands-Indië moest omvatten. Nederland weigerde echter Nieuw-Guinea op te geven. Tot 1962 bleef dit gebied onderdeel uitmaken van het Koninkrijk. De dreiging van een Indonesische aanval, gecombineerd met forse diplomatieke druk vanuit de Verenigde Staten en de Verenigde Naties, zorgde er uiteindelijk voor dat Nederland zijn laatste koloniale ambities terzijde moest schuiven.<\/p><p>Stichting PACE heeft deze geschiedenis belicht door in dit project persoonlijke verhalen vast te leggen van 25 Papua's en anderen die in de periode 1940-1963 in Nieuw-Guinea verbleven. Zij vertellen over hun vroege jeugdherinneringen en de ervaringen tijdens de Tweede Wereldoorlog. Maar ook verhalen zij over hoe het, vaak gedwongen, vertrek naar Nederland hebben ervaren en hoe dit hun verdere leven heeft beïnvloed.<br><br>Papua's kennen een traditie van het mondeling overdragen van verhalen. De interviews die nu zijn vastgelegd, passen heel goed in deze traditie. Ze bieden bovendien een unieke inkijk in de gevolgen van grootschalig geweld binnen een geïsoleerde samenleving die op die manier hardhandig werd betrokken bij de wereldgeschiedenis.<\/p>"}}]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Stichting Papua Erfgoed"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D34300","https:\/\/www.narcis.nl\/classification\/D60000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D34300","te
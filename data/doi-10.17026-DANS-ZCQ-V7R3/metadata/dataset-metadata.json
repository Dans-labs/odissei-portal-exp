:[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"The 3B study stands for Baby, Breastfeeding and Back-to-work and aims to investigate whether, how, and under which conditions maternal work stress during the postpartum period affects maternal milk composition and infant behaviour. Data of 141 mothers and their infants is collected over two study days. The datasets consist of raw data, raw clean data, and scored data, and all data is accompanied with a codebook. For a general overview of the study at hand, see the document \"3B6m_ReadMe\". For a more detailed description of the study, including all materials and procedure, see the document \"3B6m_MethodologyFile\"."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Medicine, Health and Life Sciences","Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Maternal work stress"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"maternal milk"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"infant behaviour"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"baby"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"breastfeeding"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"work"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch","English"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2022-01-01"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2022-05-03"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2022-05-06"}]},"dansRights":{"displ
{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Survey integratie nieuwe groepen - SING 2009"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:51530"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Centraal Bureau voor de Statistiek - CBS"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"C.B.S.  Centraal Bureau voor de Statistiek"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Centraal Bureau voor de Statistiek"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Onderzoek naar de leefsituatie en integratie van  Afghanen, Somaliërs, Irakezen, Iraniërs, Polen en Chinezen in Nederland. Het betreft een landelijk onderzoek onder personen van 15 jaar en ouder. Per groep werden  ongeveer duizend interviews afgenomen.  Het onderzoek werd uittgevoerd op verzoek van de minister van Wonen, Wijken en Integratie.Dit betreft een beveiligd microbestand van het Centraal Bureau voor de Statistiek-CBS. Beveiligde micro-bestanden zijn bestanden die zodanig bewerkt zijn dat herkenning van individuen en huishoudens uitgesloten is.Uit oogpunt van anonimisering zijn niet alle antwoorden op de vragen opgenomen in deze dataset. Zo zijn de antwoorden op de vragen over de fysieke- en mentale gezondheid (vraag 2130 t\/m 2250 uit de vragenlijst van het veldwerkverslag)  door het CBS verwijderd. Voor een volledig overzicht van de opgenomen vragen, zie het bestand READ ME FIRST – VRAGEN SING 2009.pdf"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Afghanen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Somaliërs"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Irakezen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Polen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Chinezen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Integratie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Etnische minderheden"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"CBS BMB"}}]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2009-01-01"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Sociaal en Cultureel Planbureau - SCP"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2012-09-28"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2012-09-28"}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["CBS","SCP"]},{"typeName":"dansPersonalDataPresent","multiple":false,"
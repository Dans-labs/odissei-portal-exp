{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Mobility Mentoring in Alphen aan den Rijn"},{"typeName":"alternativeTitle","multiple":true,"typeClass":"primitive","value":["A process evaluation of an intervention to promote economic self-sufficiency"]},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:159478"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"S.C. Tonnon"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Univesity of Applied Sciences Utrecht"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0002-0595-4351"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"SC  Tonnon"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"University of Applied Sciences Utrecht"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"This data set contains the data of clients who sought help from the municipality of Alphen aan den Rijn in 2017\/2018 for problems on more than one of the following domains: housing, health, care for others, social support, education, debt, savings, income.  Clients were supported using an approach that is derived from Mobility Mentoring, which was developed by the organisation EMPath (Boston, USA). The data gives insight in the progress the clients made on the Bridge to Self-Sufficiency (economic self-sufficiency), Quality of Life and Scarcity. It furthermore contains data at 1 measurement point on work alliance between client and professional and the level of executive functioning of the client at the start of the trajectory. It indicates the duration of the trajectory, the number of appointments with the municipality, the number of goals the client planned and achieved, the steps he took to achieve his goal which were elligible for a financial incentive, and the duration of those steps. The data set also contains the duration of those same action steps performed by a control group that received no financial incentives."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"schulden"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"debt"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"inkomen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"income"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"multiproblematiek"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"multiproblem"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"begeleiding"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"coaching"}},{"keywordValue
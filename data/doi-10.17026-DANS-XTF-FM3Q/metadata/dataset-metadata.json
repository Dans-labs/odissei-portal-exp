ing c.q. tekstanalyse. De interviews kunnen (als video interviews) ook worden bekeken en doorzocht via www.getuigenverhalen.nl"}}]}]},"dansTemporalSpatial":{"displayName":"Temporal and Spatial Coverage","name":"dansTemporalSpatial","fields":[{"typeName":"dansTemporalCoverage","multiple":true,"typeClass":"primitive","value":["1940-1945"]},{"typeName":"dansSpatialCoverageText","multiple":true,"typeClass":"primitive","value":["Nederland, Nederlandse Antillen, Nederlands-Indie"]}]},"dansDataVaultMetadata":{"displayName":"Data Vault Metadata","name":"dansDataVaultMetadata","fields":[{"typeName":"dansDataversePid","multiple":false,"typeClass":"primitive","value":"doi:10.17026\/DANS-XTF-FM3Q"},{"typeName":"dansDataversePidVersion","multiple":false,"typeClass":"primitive","value":"1.1"},{"typeName":"dansBagId","multiple":false,"typeClass":"primitive","value":"urn:uuid:6507a15d-b202-4cb1-99c1-7ce7ef9d773e"},{"typeName":"dansNbn","multiple":false,"typeClass":"primitive","value":"urn:nbn:nl:ui:13-l4-bbl5"}]}}}
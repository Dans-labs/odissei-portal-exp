{"license":"CC-BY-NC-4.0","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Kaartenbestand 'Veilig' achter water"},{"typeName":"subtitle","multiple":false,"typeClass":"primitive","value":"De interactie tussen getijprocessen en militaire aanwezigheid in de vorming van een landschap: de geschiedenis van militaire inundaties in Noord-Vlaanderen (circa 1300 – 1945)"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"M. Buise"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"VU Amsterdam"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Buise, Marc"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"VU Amsterdam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Deze kaarten behoren bij het proefschrift 'veilig' achter water. De nummers corresponderen met die genoemd in het proefschrift. Het databestand betreft de overzichtskaarten behorende bij de diverse tijdsperioden die zijn onderscheiden. Verders zijn er zogenaamde winst\/verlies-kaarten die landverlies en landaanwinst weergeven in diezelfde tijdsperioden en kaarten die van de meeste jaren de omvang van de militaire inundaties weergeven."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"pr
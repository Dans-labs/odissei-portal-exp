{"license":"CC-BY-NC-4.0","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"On Track: Ability Tracking in Amsterdam Primary Schools"},{"typeName":"alternativeURL","multiple":false,"typeClass":"primitive","value":"https:\/\/osf.io\/4ts2y"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"S. Geven"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0003-1449-6513"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Geven, S."},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"This project involves a collaboration between a researcher (Geven) and Amsterdam school managements to collect and link data with the aim to shed more light on the role of teachers – individually and in teams – in (equality in) track recommendations. Data on sixth-grade students and their teachers in 63 Amsterdam schools will be used to formulate success criteria for tracking procedures (i.e., factors enhancing equality and uniformity in tracking decisions). \n\nThe project involves (1) survey responses from 867 sixth-grade students and their 133 teachers collected in 2022-2023, and (2) student data (i.e., performance and track recommendations) of 1033 students from the school managements. The first dataset is owned by the researcher, the second dataset is a property of the school managements. Both are deposited at Statistics Netherlands (CBS) and linked to student and school data from the Registers and the Netherlands Cohort Study on Education (NCO)"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["English"]},{"typeName":"producer","multiple":true,"typeClass":"compound","value":[{"producerName":{"typeName":"producerName","multiple":false,"typeClass":"primitive","value":"Sara Geven"},"producerAffiliation":{"typeName":"producerAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"}}]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2023"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Data Collector"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Sara Geven"}}]},{"typeName":"grantNumber","multiple":true,"typeClass":"compound","value":[{"grantNumberAgency":{"typeName":"grantNumberAgency","multiple":false,"typeClass":"primitive","value":"Amsterdam University Fund (AUF)"}},{"grantNumberAgency":{"typeName":"grantNumberAgency","multiple":false,"typeClass":"primitive","value":"Netherlands Organization for Scientific Research (NWO)"},"grantNumberValue":{"typeName":"grantNumberValue","multiple":false,"typeClass":"primitive","value":"#016.Veni.195.125"}}]},{"typeName":"depositor","multiple":false,"typeClass":"primitive","value":"Geven, S."},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2024-11-01
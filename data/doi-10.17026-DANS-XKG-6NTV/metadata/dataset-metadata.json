{"license":"CC0-1.0","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, De Russenoorlog, opstand Georgische troepen op Texel, interview 02"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:41730"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Stichting Traktor ©"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Arnold van Bruggen"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"A van Bruggen"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Stichting Traktor"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Aad Jesse (76) woonde gedurende de Tweede Wereldoorlog in Amsterdam. Hij vertelt uitgebreid over zijn belevingen in Amsterdam en over de vakanties op Texel, ook tijdens de oorlog. Tijdens de hongerwinter eind 1944 werd hij als zogenaamd 'Amsterdammertje' overgebracht naar Texel om daar te kunnen overleven. Zo maakt hij ook de Georgische opstand mee. Hiertoe gedwongen door Duitse soldaten ziet hij de executie van een Georgische opstandeling. Deze gebeurtenis verandert zijn leven, hij ziet letterlijk het licht en begint te geloven in God en wordt overtuigd pacifist."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Texel"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Georgians"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Uprising"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Georgiers"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Opstand"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Second world war"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"world war II"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"razzia"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"koude oorlog"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"amsterdammertje"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"kind"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"child"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"bombardment"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"bombardement"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"execution"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"executie"}},{"keywordValue":{"typeName":
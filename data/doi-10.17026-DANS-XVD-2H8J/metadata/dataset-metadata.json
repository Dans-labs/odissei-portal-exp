{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Istori Manokwari: Interview IM26"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:127452"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"E. Markus"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"E.M.  Markus"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"<p>Project ISTORIMANOKWARI \/ Interviewer: EM*2009.<br>Duur interview totaal (uren\/min): 41 min. (deel 1)        Interview in meerdere delen: 2<br>Dit interview bevat een levensbeschrijving van geïnterviewde.<\/p><p>Geïnterviewde, geboren in een groot samengesteld gezin. Vader plantage-eigenaar belandt tijdens de Bersiap met moeder en de kinderen in een gevangenis, waar gemarteld wordt. Vervolgens opgevangen door het Leger des Heils in Bandoeng. Waarna zij samen met zuster in een internaat belandt, terwijl ouders in Ransiki\/Manokwari als kolonist voet aan de grond kregen. Direct na haar overkomst belandde zij wederom in een internaat (in Manokwari, lagere school). Om na overlijden van haar zuster naar Ransiki terug te keren voor jarenlang hard werken. Na overtocht naar Nederland(1962) en diverse verhuizingen trouwt zij met haar penvriend en vormen samen een gezin.<\/p><p>LET OP: Aanvullende delen worden binnenkort gepubliceerd<\/p>"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities","Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Japanse bezetting Indië c.q. Bersiap"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"School c.q. internaat c.q jongerencultuur"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Ondernemen c.q. werken in Manokwari c.q. de Vogelkop"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2009-11-08"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2019-05-20"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2009-11-08"},{"typeName":"series","multiple":true,"typeClass":"compound","value":[{"seriesInformation":{"typeName":"seriesInformation","multiple":false,"typeClass":"primitive","value":"<p>IstoriManokwari is een “mondelinge geschiedenis project”. Het betreft Nederlandse cultuurgeschiedenis aangaande het gebiedsdeel Nederlands Nieuw Guinea, ontsloten door (levens)verhalen c.q. meningen\/reflecties van voormalige en huidige bewoners van de stadsregio Manokwari. Interviews die op geluidsband werden opgenomen van 1998 t\/m 2018. Samen vormen deze interviews de gelijknamige interviewcollectie ‘IstoriManokwari’. Na 2018 zal deze collectie worden aangevuld. IstoriManokwari belicht de geschiedenis “van binnenuit”. Het gaat om getuigenissen van Indische Nederlanders, Hollanders, Molukkers en Papua’s over de periode 1930 tot heden in Nederlands Indië, in Nederlands Nieuw Guinea en in Nederland. Met een accent op het koloniale tijdvak 1950 tot 1963. De gemeenschappelijke noemer (rode draad) van deze getuigenissen wordt gevormd door verhalen over Manokwari en omgeving. Persoonlijke getuigenissen dragen bij aan andere vormen van geschiedschrijving. Zo voegt deze interviewcollectie toe aan andere historische bronnen, zoals boeken, artikelen, kronieken, reisverslagen, films, radio- en televisiedocumentaires en… andere mondelinge geschiedenis-collecties aangaande het Nederlands koloniaal verleden. IstoriManokwari is een “particulier initiatief” van een voormalige bewoner van dit stadje in de laatste koloniale periode. Deze initiator, toentertijd nog een kind, heeft zich op latere leeftijd zonder winstoogmerk tot dit interviewen laten inspireren.<\/p>"}}]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["E.Markus"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D34300","https:\/\/www.narcis.nl\/classification\/D61000","https:\/\/www.narcis.nl\/classification\/D62000","https:\/\/www.narcis.nl\/classification\/D63000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D34300","termName":[{"lang":"nl","value":"Moderne en contemporaine geschiedenis"},{"lang":"en","value":"Modern and contemporary history"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"},{"@id":"https:\/\/www.narcis.nl\/classification\/D61000","termName":[{"lang":"nl","value":"Sociologie"},{"lang":"en","value":"Sociology"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"},{"@id":"https:\/\/www.narcis.nl\/classification\/D62000","termName":[{"lang":"nl","value":"Sociale geografie"},{"lang":"en","value":"Social geography"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"},{"@id":"https:\/\/www.narcis.nl\/classification\/D63000","termName":[{"lang":"nl","value":"Culturele antropologie"},{"lang":"en","value":"Cultural anthropology"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]},{"typeName":"dansCollection","multiple":true,"typeClass":"primitive","value":["https:\/\/vocabularies.dans.knaw.nl\/collections\/ssh\/6b27e854-fb88-4008-8065-818250636a67"],"expandedvalue":[{"@id":"https:\/\/vocabularies.dans.knaw.nl\/collections\/ssh\/6b27e854-fb88-4008-8065-818250636a67","vocabularyUri":"https:\/\/vocabularies.dans.knaw.nl\/collections"}]},{"typeName":"dansRelation","multiple":true,"typeClass":"compound","value":[{"dansRelationType":{"typeName":"dansRelationType","multiple":false,"typeClass":"controlledVocabulary","value":"relation"},"dansRelationText":{"typeName":"dansRelationText","multiple":false,"typeClass":"primitive","value":"\/domain\/dans\/user\/emarkus\/collection\/istorimanokwari\/presentation\/easy-dataset:127452"}},{"dansRelationType":{"typeName":"dansRelationType","multiple":false,"typeClass":"controlledVocabulary","value":"relation"},"dansRelationText":{"typeName":"dansRelationText","multiple":false,"typeClass":"primitive","value":"Thematische Collectie: Istori Manokwari"},"dansRelationURI":{"typeName":"dansRelationURI","multiple":false,"typeClass":"primitive","value":"https:\/\/doi.org\/10.17026\/dans-zs2-wzng"}}]}]},"dansTemporalSpatial":{"displayName":"Temporal and Spatial Coverage","name":"dansTemporalSpatial","fields":[{"typeName":"dansTemporalCoverage","multiple":true,"typeClass":"primitive","value":["1953-1963"]},{"typeName":"dansSpatialCoverageText","multiple":true,"typeClass":"primitive","value":["Malang","Nederlands Indië"]}]},"dansDataVaultMetadata":{"displayName":"Data Vault Metadata","name":"dansDataVaultMetadata","fields":[{"typeName":"dansDataversePid","multiple":false
{"license":"CC0-1.0","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Nederlandse oud-gevangenen van kamp Buchenwald,  interview 08, Jelle Timmers"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:60672"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"NIOD Instituut voor Oorlogs-, Holocaust- en Genocidestudies"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"NIOD  Onderzoeksdata"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"NIOD Instituut voor Oorlogs-, Holocaust- en Genocidestudies"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Toen de oorlog uirbrak was de heer Jelle Godefridus (Jelle) Timmers negentien jaar en werkzaam als worstenmaker. Hij werd als voormalig soldaat door een kennis benaderd om iemand te begeleiden die met een geheime opdracht naar Engeland moest. Onderweg, in de buurt van het Franse Bayonne, werden ze opgepakt. Timmers had militaire papieren op zak en werd tot levenslang veroordeeld.Na een periode in de gevangenis in Dax werd hij in 1943 via Bordeaux en Compiègne overgebracht naar Buchenwald. Daar verrichtte hij verschillende werkzaamheden; graaf- en metselwerk, ramen zetten, parket leggen en schoonmaken. Ook werkte hij in de Gustloff-Werke.Hij vertelt over allerlei aspecten in het kamp: het treiteren en het geweld, over de overlevingsstrijd en de rol van connecties daarbij, over de hiërarchie en de verhoudingen tussen de gevangenen onderling. Toen de Amerikanen het kamp naderden, kon Timmers actief deelnemen aan de bevrijding van het kamp door middel van een naar binnen gesmokkeld geweer.Eenmaal terug in Nederland ging hij meteen weer werken. Hij is teleurgesteld over het gebrek aan opvang en begrip. Op een gegeven moment is hij afgekeurd vanwege zijn KZ-syndroom."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date Submitted: 2015-03-02"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Buchenwald (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Second World War (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Concentratiekampen (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Concentration camps (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Herinneringen (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Memories (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Gevangenen (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Prisoners (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"
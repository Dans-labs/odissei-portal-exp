ekspartners gezamenlijk optrokken."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date Accepted: 2021-04-07"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"toekomstgerichte vaardigheden"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"21ste eeuwse vaardigheden"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"generieke vaardigheden"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"mbo"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"formatief beoordelen"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2021-04-07"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Project Leader"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"P. Baay (Expertisecentrum beroepsonderwijs (ecbo))"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2021-07-26"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2021-07-26"},{"typeName":"dataSources","multiple":true,"typeClass":"primitive","value":["Dit bestand bevat de data van de voormeting en nameting met een meetinstrument ('thermometer') dat is afgenomen bij studenten van vier mbo-instellingen."]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","m
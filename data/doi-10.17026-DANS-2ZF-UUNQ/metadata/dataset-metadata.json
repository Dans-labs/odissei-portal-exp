{"license":"CC0-1.0","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, Atlantikwall Den Haag, interview 14 - Jochem Knoester"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:50482"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Museon ©"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"HMF  Kockelkorn"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Museon"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Interview met Jochem Knoester (geboren 1932). Werden in verband met de bouw van de Atlantikwall geëvacueerd uit Duindorp. Kwamen eerst in de Katwijkstraat en vervolgens in de Noordwijkstraat terecht, in het Sperrgebiet: zijn vader werkte in de vis. Herinnert zich de verhuizing met paard en wagen. Ze konden niet alles meenemen; de rest werd elders opgeslagen. Vertelt hoe ze in leegstaande huizen op zoek gingen naar bruikbare spullen en over Duitsers die waarschuwden dat er een razzia zat aan te komen. Ook gingen ze aardappels stelen in het Westbroekpark, dat er vol mee stond. Reed wel eens mee op paard en wagen die was gevorderd voor het transport van materialen voor de bunkers. Na de Duitse capitulatie haalden ze ook wel spullen uit de huizen waar Duitsers hadden gewoond. De handgranaten die ze er vonden, gebruikten ze om oorlogje te spelen."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date Submitted: 2012-07-04"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Atlantikwall"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"bunkerbouw"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"schaarste"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"evacuatie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Oral history"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2011-01-18"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Verbaan, Danny (interviewer)"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Knoester, Jochem (geïnterviewde)"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2012-06-28"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2012-07-04"}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Unknown"]},{"typeName":"dansPersonalDataPres
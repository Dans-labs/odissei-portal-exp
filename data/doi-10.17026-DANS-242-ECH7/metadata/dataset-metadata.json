{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Jan Maartensz. Groen: Dagverhaal der merkwaardige Rampen en Wederwaardigheden (1783)"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:66097"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Stichting Vrijwilligersnetwerk Nederlandse Taal (©)"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"N van der Sijs"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/072728442"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"N. van der Sijs"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Stichting Vrijwilligersnetwerk Nederlandse Taal"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"<p>Dagverhaal der merkwaardige Rampen en Wederwaardigheden, overgekomen aan het Scheepsvolk van het Schip De Jonge Alida gevoerd geweest by Stuurman Frans van den Broek, Ter Vischvangst van Vlaardingen gedestineerd naar Ysland, den 9den Mei, en door den nood van het Ys op strand gezet den 27 Augustus, 1782. Behelzende: Deszelfs Zeetogt uit het Vaderland. &ndash; Sukkelen door het Ys, en wonderlyke uitredding, uit het oogschynlykst gevaar van door het zelve verbryzeld te worden. &ndash; Stranden op Ysland. &ndash; Elendige toestand daar ter plaatse. &ndash; Ontmoetingen met de bewoonders. &ndash; Gevaarlyke en moeijelyke togt door Ysland, over hemelhooge bergen, met sneeuw en ys bedekt. &ndash; Reis naar Koppenhagen. &ndash; Menschlievende behandeling en beminnelyk Caracter van den Hollandschen Afgezant aldaar. &ndash; Reis naar Hamburg en van daar naar het Vaderland, enz. door Jan Maartensz: Groen, een der Schepelingen. Te Rotterdam By J: Krap, A: Z:, op de Hoogstraat En te Vlaardingen, By K: Nykerk, 1783.<\/p>"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Fisheries Iceland"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Whaling"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Walvisvaart"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Unfortunate voyage"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2016-01-01"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Stichting Vrijwilligersnetwerk Nederlandse Taal (©), SVNT"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"H Beelen (Carl von Ossietzky Universität Oldenburg (D))"}}]},{"typeName":"distributionDate","multipl
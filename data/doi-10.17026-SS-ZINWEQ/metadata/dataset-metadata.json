{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Interviewtranscript 1G3 met derde generatie_kleinkind van oorlogsgetroffene dwangarbeid"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"van Huis, I.B."},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Iris van Huis Onderzoek"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Matthijs Kuipers"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Nationaal Comité 4 en 5 mei"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Interview in het kader van onderzoek naar de voortleving van de herinnering aan dwangarbeid (Arbeitseinsatz) in drie generaties. De titel van het onderzoek is 'Dwangarbeid tijdens de Tweede Wereldoorlog: herinneringen in drie generaties'. Er is in het onderzoek gekeken naar de manier waarop herinnering voortleeft in drie generaties, de rol van collectieve herinnering en herinneringspraktijken daarbij, de invloed op identiteit en psyche en naar hoe de herinnering aan gedwongen tewerkstelling zich verhoudt tot opvattingen over vrijheid en onvrijheid. Het onderzoek is onderdeel van een breder onderzoek genaamd 'Oorlog en vrijheid in drie generaties'."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeNam
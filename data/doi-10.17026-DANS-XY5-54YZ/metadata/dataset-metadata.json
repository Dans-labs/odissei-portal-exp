"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud University"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/072162090"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"M. Lubbers"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud University"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/229636756"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"M. van der Vleuten"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud University"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/369417054"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"R.N. Eisinga"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud University"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/074277707"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"M.J. Savelkoul"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"National survey on social cohesion and modernization in the Netherlands.This survey builds on earlier waves of the Religion in Dutch society survey, which have been conducted in the winters of 1979\/1980, 1985\/1986, 1990\/1991, 1995\/1996, 2000\/2001, 2005\/2006, 2011\/2012, and the Social and Cultural Developments in the Netherlands survey 2017 and 2018.They are part of a long-standing research program, aimed at longitudinal research with a strong (a) substantial multi-disciplinary focus on religiosity, values, in-group solidarity and out-group derogation as well as a strong (b) methodological focus on high quality data, valid measurements and innovative data-collection designs.The most recent data collection for 2019 improves possibilities to test hypotheses on processes of secularization and individualization, spanning a period of forty years.DANS Data Guide 19 available (open access); dataset SOCON 2019 available as of August 2021 (restricted access)."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"values"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"conservatism"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"politics"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"health"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"ethnocentrism"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"longitudinal research"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"secularization"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"religion"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"social capital"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"SOCON"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch","English"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2019-01-01"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2019-07-17"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2019-07-17"},{"typeName":"series","multiple":true,"typeClass":"compound","value":[{"seriesInformation":{"typeName":"seriesInformation","multiple":false,"typeClass":"primitive","value":"Documentation of a national survey on social cohesion and modernization in the Netherlands.These surveys builds on earlier waves of the Religion in Dutch society survey, which have been conducted in the winters of 1979\/1980, 1985\/1986, 1990\/1991, 1995\/1996, 2000\/2001, 2005\/2006, 2011\/2012, and the Social and Cultural Developments in the Netherlands survey 2017, 2018 and 2019.They are part of a long-standing research program, aimed at longitudinal research with a strong (a) substantial multi-disciplinary focus on religiosity, values, in-group solidarity and out-group derogation as well as a strong (b) methodological focus on high quality data, valid measurements and innovative data-collection designs."}}]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Radboud University"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass
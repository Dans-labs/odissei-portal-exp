ebied<br>De file 'bestandsbeschrijving' geeft inzicht in de inhoud van de bovendstaande onderdelen van het bestand.<br>Voor analyses op de data kunnen zowel SPSS - als EXCEL files gebruikt worden.<\/p>"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"secondary education"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"schools"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"examinations"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"school-leaving"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"voortgezet onderwijs"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"scholen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"examens"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"schoolverlaters"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2013-05-29"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2013-05-29"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2013-05-28"},{"typeName":"dataSources","multiple":true,"typeClass":"primitive","value":["Inspectie van het Onderwijs"]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Unknown"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","valu
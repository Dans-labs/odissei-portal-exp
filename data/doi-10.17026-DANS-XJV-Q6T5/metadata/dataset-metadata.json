 employees \/ background characteristics of employee. The data were collected in an organization-based two-stage design. The samples of plants were stratified  on the basis of industry and plant size and randomly selected within each stratum. The dataset contains responses of 52 American plants and of 46 Japanese plants. The sample of employees was stratified according to their position in the plant hierarchy and selected randomly from these strata."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Business and Management"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"employees"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"interpersonal relations"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"organizations"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"industries"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"conditions of employment"}}]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"1983-01-01"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"ICS, Fac. Sociale Wetenschappen, R.U. Groningen (depositor)"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"P. Muehlau, ICS, Fac. Sociale Wetenschappen (data collector)"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2008-11-07"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2008-11-07"}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multipl
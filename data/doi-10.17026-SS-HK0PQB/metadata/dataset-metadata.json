{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Acceptability of robot-like neurofeedback companions for neurofeedback training"},{"typeName":"subtitle","multiple":false,"typeClass":"primitive","value":"Perspectives from health professionals, self-reported clinical groups, and the general public"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"E. Grevet"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Institut de Neurosciences Cognitives et Intégratives d’Aquitaine"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"https:\/\/orcid.org\/0000-0001-5596-4796"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Grevet, Elise"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Institut de Neurosciences Cognitives et Intégratives d’Aquitaine"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"This dataset contains the anonymised participant-level data collected for the study “Acceptability of robot-like neurofeedback companions for neurofeedback training: Perspectives from health professionals, self-reported clinical groups, and the general public”. The study used an online multilingual questionnaire to assess perceived acceptability, design preferences, attitudes towards technology, neurofeedback familiarity, personality traits, demographic characteristics, clinical history, and self-reported cognitive difficulties in relation to a proposed robot-like neurofeedback companion intended to support neurofeedback training.\n\nThe dataset includes responses from 595 adult participants. Participants were classified into three mutually exclusive clinical-status groups: healthy participants, participants with self-reported subclinical cognitive complaints or suspected conditions, and participants reporting a formally diagnosed psychiatric or neurological condition. Health professionals were not treated as a separate clinical-status group and may belong to any of these categories.\n\nThe dataset has been anonymised before deposit. Direct identifiers have been removed, and variables that could increase the risk of indirect identification have been treated to protect participant privacy. Because the dataset contains sensitive participant-level information, including self-reported clinical status and cognitive complaints, access is restricted. ."},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2026-07-08"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Computer and Information Science","Medicine, Health and Life Sciences"]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["English"]},{"typeName":"productionPlace","multiple":true,"typeClass":"primitive","value":["University of Groningen"]},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Project Leader"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Stefanie Enriquez-Geppert"}},{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass"
{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Interview met L.A.Raeven, Online, 24 april 2024"},{"typeName":"subtitle","multiple":false,"typeClass":"primitive","value":"Over intentie, werkwijze, presentatie en behoud"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Stigter, S"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0001-5250-8461"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Stigter, S"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"}},{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Data Stewards Faculty of Humanities"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Interview met L.A. Raeven gericht op kunstenaarsintentie in het kader van een onderzoeksproject van de Universiteit van Amsterdam, Smart Care: Artist Intent and Artist Interviews. Tijdens dit kunstenaarsinterview geven Angelique Raeven en Liesbeth Raeven inzicht in hun werkwijze en wat ze met hun werk willen bereiken. Daarbij wordt veelvuldig ingegaan op sociaal-maatschappelijke thema's die te maken hebben met identiteit, kwetsbaarheid, anorexia en taboes in the samenleving zoals seksualiteit. Ze vertellen over hun tweeling-zijn, hun doelbewuste verschillende opleidingstraject, en hoe ze uiteindelijk aan de Jan van Eyck Academie gingen samenwerken. Ze gebruiken verschillende uitdrukkingsvormen, van advertentie tot performance, en van video-installatie tot bewegende sculptuur. Spontane acties tijdens hun deelname aan kunstbeurzen Art Basel en Art Miami zijn kenmerkend voor hun blik op de (kunst)wereld. Er wordt ingegaan op het onderhoud en het exposeren van de werken, zoals de interactieve menselijke sculptuur Annelies, Looking for Completion, en het tonen van werk dat eerder is uitgevoerd als performance, onder andere uitgelegd aan de hand van Wild Zone, waarbij de grenzen worden afgetast van wat toelaatbaar is in een publiek toegankelijke ruimte als het museum, terwijl ook internationale culturele verschillen worden benadrukt."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"L.A.Raeven"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"https:\/\/rkd.nl\/artists\/279770"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"RKD"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Liesbeth Raeven"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"https:\/\/rkd.nl\/artists\/430540"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"RKD"}},{"keywordValue":{"
{"license":"CC0-1.0","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Het Koninkrijk der Nederlanden in de Tweede Wereldoorlog"},{"typeName":"alternativeTitle","multiple":true,"typeClass":"primitive","value":["The Kingdom of the Netherlands during World War II"]},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:56100"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"L. de Jong"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"NIOD Institute for War, Holocaust and Genocide Studies"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/068202598"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"NIOD  Onderzoeksdata"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"NIOD"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"'The Kingdom of the Netherlands During World War II' is the standard reference on the history of the Netherlands during World War II. The series was written by Loe de Jong (1914-2005), director of the former Dutch Institute for War Documentation (Nederlands Instituut voor Oorlogsdocumentatie, or NIOD; currently known as NIOD Institute for War, Holocaust and Genocide Studies), and was published between 1969 and 1994. The series consists of 14 volumes, published in 30 parts. De Jong was commissioned to write the work in 1955 by the Ministry of Education, Culture and Science. This dataset is the digitized edition of scientific print version. Photographs and illustrations are excluded due to copyrights.'Het Koninkrijk der Nederlanden tijdens de Tweede Wereldoorlog' is het standaardwerk over de geschiedenis van Nederland tijdens de Tweede Wereldoorlog. De serie werd geschreven door Loe de Jong (1914-2005), directeur van het toenmalige Nederlands Instituut voor Oorlogsdocumentatie (momenteel bekend als NIOD Instituut voor Oorlogs-, Holocaust- en Genocidestudies), en werd gepubliceerd tussen 1969 en 1994. De serie bestaat uit 14 delen, uitgegeven in 30 banden. De Jong kreeg in 1955 van het Ministerie van Onderwijs, Cultuur en Wetenschap de opdracht om het werk te schrijven. Deze dataset is de gedigitaliseerde versie van de wetenschappelijke uitgave. Foto's en illustraties zijn verwijderd vanwege auteursrechten."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Second World War (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog (NIOD)"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2011-12-01"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2013-11-15"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"pri
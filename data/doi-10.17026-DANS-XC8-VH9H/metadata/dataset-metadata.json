{"license":"CC0-1.0","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"De bekendheid van Data Archiving and Networked Services - DANS en zijn diensten onder onderzoekers, promovendi en researchmaster studenten"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:49113"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Maurits van der Graaf"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Pleiade Management en Consultancy BV"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Ingrid Dillo"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Data Archiving and Networked Services - DANS"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Data Station Admin"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"DANS"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Onderzoek naar de naamsbekendheid en de diensten van Data Archiving and Networked Services - DANS, uitgevoerd door middel van online surveys onder onderzoekers, promovendi en researchmaster studenten uit de volgende wetenschappelijke disciplines: natuurwetenschappen en techniek, levenswetenschappen en geneeskunde, sociaal-culturele wetenschappen, geesteswetenschappen, maatschappijwetenschappen en gedragswetenschappen.DANS bevordert duurzame toegang tot digitale onderzoeksgegevens. Hiertoe stimuleert DANS dat wetenschappelijke onderzoekers gegevens duurzaam archiveren en hergebruiken. Tevens biedt DANS toegang tot duizenden wetenschappelijke datasets, e-publicaties en andere onderzoeksinformatie in Nederland. Daarnaast verzorgt het instituut training en advies en doet het onderzoek naar duurzame toegang tot digitale informatie. DANS zorgt er met zijn dienstverlening en deelname in (inter)nationale projecten en netwerken voor dat de toegang tot digitale onderzoeksgegevens verder verbetert.  DANS  is een instituut van de Koninklijke Nederlandse Akademie van wetenschappen en de Nederlandse Organisatie voor Wetenschappelijk Onderzoek – NWO."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Naamsbekendheidsonderzoek"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Wetenschapscommunicatie"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2012-01-01"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Brenda Sørensen"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Data Archiving and Networked Services - DANS"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2012-03-09"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2012-03-09"}]},"d
{"license":"CC0-1.0","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"The efficacy of mindfulness-based cognitive therapy as a public mental health intervention for adults with mild to moderate depressive symptomatology: a Randomized Controlled Trial"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:58402"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"W.T.M. Pots"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"University of Twente"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"P.A.M. Meulenbeek"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"University of Twente"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"M.M. Veehof"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"University of Twente"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/297555340"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"J. Klungers"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"E.T. Bohlmeijer"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"University of Twente"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/181015498"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"W.T.M.  Pots"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"University of Twente"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Although there has been a growing evidence for the efficacy of mindfulness- based cognitive therapy (MBCT) for different clinical populations, its effectiveness as a public mental health intervention has not been studied. The present study evaluates a community-based MBCT intervention for adults with mild to moderate depressive symptomatology in a large multi-site, pragmatic randomized controlled trial. Participants with mild to moderate depressive symptomatology were recruited from the general population and randomized to the MBCT intervention (n = 76) or to a waiting list control group (n = 75). Participants completed measures before and after the intervention to assess depression, anxiety, positive mental health, experiential avoidance, and mindfulness. Participants in the experimental conditions also completed these measures at a 3-month follow-up."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"depressive symptomatology"}},{
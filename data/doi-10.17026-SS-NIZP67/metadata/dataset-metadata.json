{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Interview met Winny Reichman Wattiez"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"A. Carlier"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Arq Kenniscentrum Oorlog, Vervolging en Geweld"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Renske Walsarie Wolff"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Arq Kenniscentrum Oorlog, Vervolging en Geweld"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"\"Winny Reichman Wattiez werd in 1937 in Batavia geboren en groeide op in een Indische familie. Haar jeugd stond in het teken van de Japanse bezetting, haar vaders krijgsgevangenschap en ontsnapping, het verborgen leven in een kamponghuisje en de onveiligheid tijdens de Bersiap. Na de oorlog kampte haar vader met ernstige longproblemen; haar moeder werkte als coupeuse en modeontwerpster om het gezin te onderhouden. In 1954 vertrok het gezin met de Sibajak naar Nederland. Het afscheid van Java en de aankomst in het koude Rotterdam maakten diepe indruk. Na een verblijf in Driebergen bouwde zij in Nederland een zelfstandig bestaan op.\n\nToen haar moeder en andere gezinsleden naar Californië emigreerden, bleef zij aanvankelijk achter. In 1962 volgde zij alsnog. In Los Angeles vond zij werk bij een bank en ontmoette zij haar latere echtgenoot. Samen bouwden zij zonder veel ondersteuning een bestaan op, met werk, een eigen huis en de opvoeding van hun dochter. De combinatie van voltijds werk, moederschap en beperkte hulp ervoer zij als zwaar. Geloof, muziek, dans en later linedancen vormden belangrijke bronnen van houvast.\n\nNa het overlijden van haar echtgenoot zette zij hun plan om naar Nederland terug te keren alleen voort. Met hulp van familie vond zij eerst tijdelijke huisvesting en daarna een eigen woning in Almelo. Haar levensverhaal verbindt oorlog, migratie, gezinsleven, verlies, geloof en het telkens opnieuw opbouwen van een bestaan.\""},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2026-07-14"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Verenigde Staten"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"https:\/\/data.indischherinneringscentrum.nl\/ied\/100613"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"Indisch Erfgoed thesaurus"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"https:\/\/data.indischherinneringscentrum.nl\/ied.html"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Migranten"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"https:\/\/data.indischherinneringscentrum.nl\/ied\/113143"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"Indisch Erfgoed thesaurus"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"https:\/\/data.indischherinneringscentrum.nl\
{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Longitudinaal Verplaatsingsonderzoek, meting 6, 1986 - LVO"},{"typeName":"alternativeTitle","multiple":true,"typeClass":"primitive","value":["Longitudinal transportation survey, wave 6, 1986 - LVO"]},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"STAR: P1042"}},{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:32830"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Meurs, H.J., Bureau Goudappel Coffeng * Deventer (primary investigator)"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Data Station Admin"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"DANS"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Monitoring the effects of tariff raises in public transport within the framework of the general mobility developments. This description comprises the sixth wave of the longitudinal mobility survey ( longitudinaal verplaatsingsonderzoek ). Subsequent waves will be stored under different study numbers. The survey monitors ( changes in ) transportational behaviour, mobility and effects of raising tariffs for public transportation. Data were gathered by questionnaire. Diaries had to be filled out, describing all mobility during one week. Detailed data were gathered on: family composition, financial situation of family, working hours, commuting, travelling allowances, car, train, use of reduced fare cards for public transport. This wave consists of five files, containing family-data( A=SPSS-file, D=raw data ), family member-data ( B=SPSS-file, E=raw data ), transfer-data ( C=raw data ) respectively. Background variables: basic characteristics\/ residence\/ household characteristics\/ occupation\/employment\/ income\/capital assets\/ education\/ consumption of durables"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Other"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"transport studies"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"transport"}}]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"1986-09-30"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Ministerie van verkeer en waterstaat * Den Haag Directoraat-Generaal voor Verkeer"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Projectbureau Integrale Verkeers- en Vervoersstudies * Den Haag (research initiator)"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Intomart bv * Hilversum (data collector)"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2013-08-23"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2013-08-23"},{"typeName":"dateOfCollection","multiple":true,"typeClass":"compound","value":[{"dateOfCollectionStart"
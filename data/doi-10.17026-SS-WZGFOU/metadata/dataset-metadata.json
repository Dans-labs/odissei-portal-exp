{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Covid Uncovered: Een visuele etnografie over de impact van COVID19 maatregelen op sociaal kwetsbare groepen"},{"typeName":"alternativeTitle","multiple":true,"typeClass":"primitive","value":["Covid Uncovered"]},{"typeName":"alternativeURL","multiple":false,"typeClass":"primitive","value":"https:\/\/www.coronatijden.nl\/covid-uncovered\/"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"D.H. de Vries"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"https:\/\/ror.org\/04dkp9463","expandedvalue":{"scheme":"http:\/\/www.grid.ac\/ontology\/","termName":"University of Amsterdam","@type":"https:\/\/schema.org\/Organization"}},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ResearcherID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0001-7455-0628"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"de Vries, D.H."},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Nu de COVID19 pandemie naar de achtergrond verdwijnt, is het belangrijk om te reflecteren op de maatregelen en de langdurige en aanhoudende impact hiervan op het dagelijks leven van deze sociaal kwetsbare groepen evenals hun sociale- en zorgnetwerken. Wat is er nog overgebleven van deze maatregelen? Welke effecten van de verschillende maatregelen zijn nu nog voelbaar? In hoeverre zitten deze effecten verankerd in programmatische en maatschappelijke structuren? En in hoeverre worden ze in stand gehouden door de doelgroepen zelf? Aan de hand van gefilmde diepte-interviews met sociaal kwetsbare mensen, hun sociale netwerk en (in\/formele) zorgverleners, hebben wij drie korte etnografische video’s gemaakt. Deze videos zijn openbaar en te vinden op de website https:\/\/www.coronatijden.nl\/covid-uncovered\/. Deze dataset bestaat uit de transcripten van de  gefilmde interviews die de basis zijn voor de drie films. Alle participanten leven in de regio Amsterdam - Zaanstreek. De volgende groepen met het aantal participanten hebben meegedaan: \n1. Zelfstandig wonende kwetsbare ouderen (70+) (3 ouderen, 3 mantelzorgers, 1 professional) \n2. Mensen met lichamelijke en verstandelijke beperkingen (3 LVB, 3 clientondersteuners)\n3. Dak- en thuislozen (3 daklozen, 3 professionals)."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"COVID19"}}]},{"typeName":"notesText","multiple":false,"typeClass":"primitive","value":"De dataset bestaat uit geautomatiseerde en geanonimiseerde transcripten van video materiaal. De video materialen zelf zijn niet deel van deze dataset."},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"producer","multiple":true,"typeClass":"compound","value":[{"producerName":{"typeName":"producerName","multiple":false,"typeClass":"primitive","value":"Danny de Vries"},"producerAffiliation":{"typeName":"producerAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit van Amsterdam"}}]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2024-10-1"},{"typeName":"productionPlace","multiple":true,"typeClass":"primitive","value":["Amsterdam"]},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Project Manager"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Ronja Jansz"}},{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Researcher"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Lianne Cremers"}},{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Researcher"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Wouter Massink"}},{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Project Leader"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Danny de Vries"}}]},{"typeName":"grantNumber","multiple":true,"typeClass":"compound","value":[{"grantNumberAgency":{"typeName":"grantNumberAgency","multiple":false,"typeClass":"primitive","value":"ZonMw"},"grantNumberValue":{"typeName":"grantNumberValue","multiple":false,"typeClass":"primitive","value":"10430372310019"}}]},{"typeName":"distributor","multiple":true,"typeClass":"compound","value":[{"distributorName":{"typeName":"distributorName","multiple":false,"typeClass":"primitive","value":"Danny de Vries"},"distributorAffiliation":{"typeName":"distributorAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit van Amsterdam"},"distributorAbbreviation":{"typeName":"distributorAbbreviation","multiple":false,"typeClass":"primitive","value":"UvA"}}]},{"typeName":"de
{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, Getuigenissen van Nederlandse vrouwen die een relatie hadden met een Duitse man, interview 02"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:41866"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Cogis"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Kennisinstituut voor de sociale en psychische gevolgen van oorlog, vervolging en geweld"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"C.F.  Huitema"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Arq Kenniscentrum Oorlog, Vervolging en Geweld"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Mevrouw groeide op in Edam waar haar vader een expeditiebedrijf had. Er waren drie kinderen, twee jongens en een meisje. Een broer zat in het verzet. Zij ontmoette haar Duitse militair in het strandbad van Edam aan de Zuiderzee. Tijdens de Duitse bezetting gingen ze openlijk met elkaar om. In mei 1945 werd mevrouw kaalgeschoren. Het contact met de Duitse militair ging verloren omdat er de eerste jaren geen briefverkeer met Duitsland mogelijk was.In 1950 trouwde mevrouw met een Nederlandse man, waarvan zij in 1970 scheidde. Zij hield ondertussen regelmatig contact met de Duitse militair. Na haar scheiding werd de omgang intensiever. Zij zagen elkaar regelmatig en ook had mevrouw contact met diens vrouw. Mevrouw heeft in haar familie nooit over deze relatie gesproken.\n\nToegang tot de files wordt verleend op voorwaarde dat de gegevens alleen voor wetenschappelijk onderzoek worden gebruikt. De methodologische kwaliteit moet voldoende zijn en de anonimiteit van de proefpersonen moet gegarandeerd zijn."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"middenstand"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"expeditiebedrijf"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"huishoudschool"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Schoevers"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"liberaal"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"vrijzinnig protestant"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"inkwartiering"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"oorlogsliefde"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"verzet"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"kaalschering"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"moffenmeiden"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":
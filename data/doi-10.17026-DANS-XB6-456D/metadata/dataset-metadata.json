,{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"values"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"conservatism"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"politics"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"environmentalism"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"health"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"ethnocentrism"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"longitudinal research"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"secularization"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"religion"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"SOCON"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["English"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2012-04-01"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"R. Eisinga, P. Scheepers, G. Kraaykamp, P. Thijs"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Funding Agency: NWO (481-08-010)"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2012-12-03"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2012-09-03"},{"typeName":"series","multiple":true,"typeClass":"compound","value":[{"seriesInformation":{"typeName":"seriesInformation","multiple":false,"typeClass":"primitive","value":"Documentation of a national survey on social cohesion and modernization in the Netherlands.These surveys builds on earlier waves of the Religion in Dutch society survey, which have been conducted in the winters of 1979\/1980, 1985\/1986, 1990\/1991, 1995\/1996, 2000\/2001, 2005\/2006, 2011\/2012, and the Social and Cultural Developments in the Netherlands survey 2017, 2018 and 2019.They are part of a long-standing research program, aimed at longitudinal research with a strong (a) substantial multi-disciplinary focus on religiosity, values, in-group solidarity and out-group derogation as well as a strong (b) methodological focus on high quality data, valid measurements and innovative data-collection designs."}}]},{"typeName":"dataSources","multiple":true,"typeClass":"primitive","value":["A two-step random sample of addresses from the full registry of postal codes in The Netherlands, followed by a random selection of an individual at the random address."]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Unknown"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["English"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D60000","https:\/\/www.narcis.nl\/classification\/D61000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D60000","termName":[{"lang":"en","value":"Social sciences"},{"lang":"nl","value":"Sociale wetenschappen"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"},{"@id":"https:\/\/www.narcis.nl\/classification\/D61000","termName":[{"lang":"nl","value":"Sociologie"},{"lang":"en","value":"Sociology"}],"vocabu
iarity offender in case  of sexual, physical violence \/ injuries \/ fear of crime  in local area \/ use of help agencies for victims \/\tsatisfaction with police behaviour \/ preferred legal  sanctions, punishment, length of detention, safety  precautions when leaving home \/ possession of gun \/  burglar alarm \/ insurance \/ frequency of going out. Background variables: basic characteristics\/ residence\/ housing situation\/ household characteristics\/ occupation\/employment\/ income\/capital assets\/ education\/ religion\/ consumption of durables.<br><br>Please use the following link for access to the updated version:<\/p>"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Law","Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"crime victims"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"crime"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"law"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"safety"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"violence"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"crime prevention"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"police services"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["English"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"1997-12-31"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"J. van Kesteren, INTERVICT, Tilburg University (depositor)"}},{"contributor
{"license":"DANS Licence","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"European Values Study 1999\/2000 - EVS'99\/2000  : Release I - September 2003 (ZA Study 3811)"},{"typeName":"alternativeTitle","multiple":true,"typeClass":"primitive","value":["European Values Study 1999\/2000 - EVS'99\/2000 : Release I - September 2003 (ZA Study 3811)"]},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:32149"}},{"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"STAR: P1460"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Halman, L.C.J.M. , Subfac. Sociale Wetenschappen , Universiteit van Tilburg (primary investigator)"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Data Station Admin"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"DANS"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"The European Values Study is designed to enable cross-national comparison of values, beliefs and attitudes, as well as preferences and priorities, and the changes in time concerning these issues. Uniform questionnaires were used to interview representative samples in 33 European countries: Austria, Belarus, Belgium, Bulgaria, Croatia, the Czech Republic, Denmark, Estonia, Finland, France, Germany, Great Britain, Greece, Hungary, Iceland, Ireland, Italy, Lithuania, Luxembourg, Latvia, Malta, Northern Ireland, the Netherlands, Poland, Portugal, Romania, Russia, Spain, Sweden, Slovakia, Slovenia, Turkey, and the Ukraine. The EVS 1999\/2000 is the third wave (after 1981 and 1990) covering the following fields: religion and morality \/ politics, society and economy \/ work and leisure-time \/  primary relations.  For more detailed information, and information about updates: see also the EVS website."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date Submitted: 2003-09-01"}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date Submitted: 2007-07-30"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"values and beliefs"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"religion"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"family life"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"crime"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"discrimination"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"interpersonal relations"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"leisure time"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"politics"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"economics"}},{"
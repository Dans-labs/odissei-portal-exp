{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Basismonitor Politiek Ambtsdragers (BPA) 2024 (gemeenten)"},{"typeName":"subtitle","multiple":false,"typeClass":"primitive","value":"Een onderzoek onder gemeenteraadsleden, wethouders en burgemeesters"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"H. Vollaard"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"https:\/\/ror.org\/04pp8hn57","expandedvalue":{"scheme":"http:\/\/www.grid.ac\/ontology\/","termName":"Utrecht University","@type":"https:\/\/schema.org\/Organization"}},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"H. van der Kolk"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"https:\/\/ror.org\/006hf6230","expandedvalue":{"scheme":"http:\/\/www.grid.ac\/ontology\/","termName":"University of Twente","@type":"https:\/\/schema.org\/Organization"}},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"B. Denters"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"https:\/\/ror.org\/006hf6230","expandedvalue":{"scheme":"http:\/\/www.grid.ac\/ontology\/","termName":"University of Twente","@type":"https:\/\/schema.org\/Organization"}}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"van der Kolk, Henk"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit Twente"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"De Basismonitor Politieke Ambtsdragers (BPA) brengt in kaart hoe gemeenteraadsleden, wethouders en burgemeesters invulling geven aan hun ambt en wat zij vinden van het functioneren van de lokale democratie. Het onderzoek is opgezet door wetenschappers van verschillende onderzoeksinstellingen en mede ontwikkeld met het Ministerie van Binnenlandse Zaken, de Nederlandse Vereniging voor Raadsleden, het Nederlands Genootschap van Burgemeesters, de Wethoudersvereniging, de Vereniging van Griffiers, het Kennispunt Lokale Politieke Partijen en de Vereniging van Nederlandse Gemeenten. \nDeze dataset is de tweede meting van de BPA op lokaal niveau en gehouden in 2024. Het veldwerk van deze meting is uitgevoerd door onderzoeksinstituut Centerdata in opdracht van Universiteit Utrecht."},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2025-09-11"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"ambtsdragers"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"gemeenteraadsleden"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"wethouders"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"burgemeesters"}}]},{"typeName":"notesText","multiple":false,"typeClass":"primitive","value":"Uit dit bestand zijn alle persoonsgevoelige gegevens verwijderd, zodat individuele bestandsgegevens redelijkerwijs niet herleidbaar zijn naar individuele respondenten of individuele gemeenten.  Het bijgevoegde codeboek beschrijft zowel de data uit het DANS-bestand als de data die beschikbaar zijn in het volledige bestand. Gebruik van het volledige bestand en van de koppelcodes kan alleen onder strikte voorwaarden en alleen als de anonimiteit van respondenten blijvend kan worden gegarandeerd. Hiervoor moet contact worden opgenomen met de databeheerder."},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2024-03-29"},{"typeName":"grantNumber","multiple":true,"typeClass":"compound","value":[{"grantNumberAgency":{"typeName":"grantNumberAgency","multiple":false,"typeClass":"primitive","value":"Ministerie van BZK"}}]},{"typeName":"depositor","multiple":false,"typeClass":"primitive","value":"van der Kolk, Henk"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2025-09-11"},{"typeName":"dateOfCollection","multiple":true,"typeClass":"compound","value":[{"dateOfCollectionStart":{"typeName":"dateOfCollectionStart","multiple":false,"typeClass":"primitive","value":"2024-01-29"},"dateOfCollectionEnd":{"typeName":"dateOfCollectionEnd","multiple":false,"typeClass":"primitive","value":"2024-03-15"}}]},{"typeName":"kindOfData","multiple":true,"typeClass":"primitive","value":["Survey data"]},{"typeName":"series","multiple":true,"typeClass":"compound","value":[{"seriesName":{"typeName":"seriesName","multiple":false,"typeClass":"primitive","value":"Basismonitor Politieke Ambtsdragers (BPA)"},"seriesInformation":{"typeName":"seriesInformation","multiple":false,"typeClass":"primitive","value":"Sinds 2019 brengt de Basismonitor Politieke Ambtsdragers (BPA) elke raadsperiode in kaart hoe gemeenteraadsleden, wethouders en burgemeesters invulling geven aan hun ambt en wat zij vinden van het functioneren van de lokale democratie. Daarnaast worden leden van Provinciale Staten en Waterschappen onderzocht. Dit is de tweede ronde binnen gemeenten."}}]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Stichting voor Onderzoek naar Democratische Vertegenwoordiging"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Yes"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D42000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D42000","termName":[{"lang":"nl","value":"Politieke wetenschappen en bestuurskunde"},{"lang":"en","value":"Political and administrative sciences"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]}]},"dansSocialSciences":{"displayName":"Social Sciences and Humanities","name":"dansSocialSciences","fields":[{"typeName":"dansCessdaClassification","multiple":true,"typeClass":"primitive","value":["https:\/\/vocabularies.cessda.eu\/vocabulary\/TopicClassification?v=4.2#Politics.PoliticalBehaviourAndAttitudes","https:\/\/vocabularies.cessda.eu\/vocabulary\/TopicClassification?v=4.2#SocietyAndCulture.CommunityUrbanAndRuralLife"],"expandedvalue":[{"@id":"https:\/\/vocabularies.cessda.eu\/vocabulary\/TopicClassification?v=4.2#Politics.PoliticalBehaviourAndAttitudes","vocabularyUri":"https:\/\/vocabularies.cessda.eu\/vocabulary\/TopicClassification?v=4.2"},{"@id":"https:\/\/vocabularies.cessda.eu\/vocabulary\/TopicClassification?v=4.2#SocietyAndCulture.CommunityUrbanAndRuralLife","vocabularyUri":"https:\/\/vocabularies.cessda.eu\/vocabulary\/
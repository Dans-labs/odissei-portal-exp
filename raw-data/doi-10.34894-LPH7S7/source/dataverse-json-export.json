              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Van het archeologisch onderzoek ter plaatse van de Mathildelaan en Emmasingel in Eindhoven is een monsters aangeleverd voor dendrochronologisch onderzoek. Het monster is afkomstig van een eiken (Quercus sp.) paal. Over de context van de vondst is geen aanvullende informatie verstrekt.\nHoewel het monster ruim voldoende jaarringen bevat, bleek het niet mogelijk goede resultaten te vinden, waardoor het monster vooralsnog ongedateerd blijft."
                },

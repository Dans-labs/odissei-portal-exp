            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Raw data of sitting postures from 38 participants are collected from pressure mat with grid size of 16x16 and from bioradar. Raw data is collected for 5 working days in office environment. Pressure mat is placed on the top of the office chair and bioradar is placed on the side of the table. Ground truth labelling of sitting posture is manually annotated from video recording (Kinect v1.8). Kinects are placed on the side of the table and under the table. The ground truth labelling included both upper and lower body parts. The description of posture labelling can be found further in the attached document. At the moment, only labelling from pressure mat data is openly available. The labelling from Bioradar data will follow.\n\nThe sitting posture labelling and the raw data from pressure mat and bioradar is structured per participant. These data is stored in .csv format. Preprocess pressure mat folder consists of merged pressure mat data and the labelling by their timestamp. Preprocess labelling folder consists of pressure mat labelling that have been integrated into one file for single day."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025"
                }
              }
            ]

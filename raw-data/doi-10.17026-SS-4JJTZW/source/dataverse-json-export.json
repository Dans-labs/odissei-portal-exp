            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The datasets contain information which was collected for a PhD dissertation on the perceived impacts of involuntary resettlement due to a dam construction on the people in two host communities: The case study of Bui Dam in Ghana. It contains interviews transcripts, focus groups and questionnaires used to evaluate the perceived impacts of site implementation processes of dam-induced involuntary resettlement programmes and their governance on the population in host communities in Bui Dam, Ghana."
                },
                "dsDescriptionDate": {

{"license":"DANS Licence","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, Nijkerk als toevluchtsoord tijdens WO II, Interview 10"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:41637"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Stichting Oud Nijkerk ©"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"S. van den Berg-Ebbenhorst"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Stichting Oud Nijkerk"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Chrisje van Norden (98) woonde tijdens de oorlog  met haar ouders bij het kerkje, de Evangelisatie in Driedorp. Op 3 november 1944 stierf haar vader bij een beschieting. Zij bleef achter met haar moeder en een neefje van 17 jaar.  Ook was er het gezin Hendriks van evacués in huis met een zoontje van 1 jaar. Dat gezin woonde in Limburg, maar was op 17 september in Hilsum op verjaardagsvisite en moest daarom vluchten.  Jaap Hendriks, belastingambtenaar, de man van het evacué-gezin, kreeg werk bij de zuivelfabriek in Nijkerk en had zo inkomsten. Het gezin had een eigen kamer. De relaties waren altijd goed. De hulp die ze in de oorlog gaf, was voor Chrisje vanzelfsprekend. Dat deed je gewoon.  Er kwamen relatief weinig passanten langs op hongertocht omdat Driedorp iets van de meest gelopen weg af lag, maar ze heeft wel eten gegeven: aardappels onder andere.  Ook overnachtten ze wel eens bij de evangelisatie. De schaarste betekende wel dat ze ook wel eens nee moest verkopen. Vader deed uit noodzaak ook wel wat aan zwarthandel."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date Submitted: 2010-03-19"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Arnhem"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Hilsum"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"evacués"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Driedorp"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"evangelisatie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"hongertochten"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Nijkerk"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Nijkerkerveen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Slichtenhorst"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"gezondheid"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"hongerwinter"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"voedselvoorziening"}},{"keywordValue":{"typeName":"keywordValue","multi
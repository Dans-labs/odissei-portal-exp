            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The data connected to this file is related to a series of tests performed in the facilities at TU Delft to understand the effects of fibre failure on compressive strength of CFRP laminates. \nFibre damage has been artificially introduced during layup by manually cutting the fibres. Since fibre failure always occurs in the plies closest to the specimen surfaces, the artificially damaged specimens all contain failure in the topmost plies.\nThe data set contains force-displacement data for a series of compression tests on laminates without fibre damage, and on laminates containing different damage configuraitons."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2021-02-11"
                }
              }

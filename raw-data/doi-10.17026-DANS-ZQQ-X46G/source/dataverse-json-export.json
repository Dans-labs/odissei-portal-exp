                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>XML-transcription of  the undertext of \"Greek NF MG 99\" from the library of St. Catherine’s Monastery of the Sinai (GA 0289). The file can be viewed in the editor by being uploaded at <a href=https://itsee-wce.birmingham.ac.uk/ote/transcriptiontool>https://itsee-wce.birmingham.ac.uk/ote/transcriptiontool</a>. The MSI images that were transcribed belong to the Monastery and can be accessed at <a href=https://sinai.library.ucla.edu>https://sinai.library.ucla.edu</a>, a publication of St. Catherine’s Monastery of the Sinai in collaboration with EMEL and UCLA. For an edition and discussion of the text please consult the article<br>Conrad Thorup Elmelund, “The Undertext of Greek NF MG 99 from Sinai (GA 0289),” <i>TC: A Journal of Biblical Textual Criticism</i>.27 (2022), <a href=http://jbtc.org/v27/TC-2022_Elmelund.pdf>http://jbtc.org/v27/TC-2022_Elmelund.pdf</a></p>"
                }
              }

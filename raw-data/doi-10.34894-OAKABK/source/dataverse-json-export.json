            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek op het plangebied Kwadrant 4 in ’t Zand is een aantal houten vondsten aangetroffen. Hierbij ging het om een aangepunt paaltje van wilgenhout (Salix sp.) en een grenen (Pinus sylvestris L.) plank. De laatste is dendrochronologisch onderzocht en hieruit volgde dat de laatste jaarring in 1582 dateert. De wankant ontbreekt, dus kan alleen de ondergrens van het kapinterval bepaald worden."
                },
                "dsDescriptionDate": {

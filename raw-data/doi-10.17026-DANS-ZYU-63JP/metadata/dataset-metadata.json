{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Voting Engagement Tools as Political Decision Aids"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"NWO grant 321-89-003"}},{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:65203"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"B.C. Holleman"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Utrecht Institute of Linguistics\/Onderzoekinstituut voor Taal en Spraak (UiL OTS) - Utrecht University"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/304825670"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"C.H. de Vreese"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"The Amsterdam School of Communication Research (ASCoR) - University of Amsterdam (UvA)"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/238009904"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"B.C.  UiL Holleman"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"In this project we investigate the effects of the use of VAAs on people's answers and attitudes, and on their political understanding (efficacy, knowledge). We also distinguish between different user types. In this specific subproject, we investigated the effect of valence framing in a VAA developed for the local elections in the city of Utrecht 2014 on the answers. We also investigated the rol of political sophistication as a moderator. We have presented these data at a number of conferences (ICA2015, ECPR2014) and hope to publish about these data in 2016, PLOS ONE. The first author can be reached through b.holleman@uu.nl"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"question framing in VAAs"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Voting Advice Applications"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"political preferences"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"question polarity"}}]},{"typeName":"notesText","multiple":false,"typeClass":"primitive","value":"The SAV and WSZ formats of the datafile 'data_plos' were deposited by the depositor. DANS added the DTA and POR formats of this file. The XLSX format of the file 'Experiment in excelKK met codering' was deposited by the depositor. DANS added the CSV format of this file. All formats added by DANS can be found in the map 'DANS added formats'."},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch","English"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2014-06-01"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"N. Kamoen (Tilburg University)"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2016-06-22"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2016-06-22"},{"typeName":"dataSources","multiple":true,"typeClass":"primitive","value":["VAA Kieskompas"]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Unknown"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["English"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D66000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D66000","termName":[{"lang":"nl","value":"Communicatiewetenschap"},{"lang":"en","value":"Communication sciences"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]},{"typeName":"dansRelation","multiple":true,"typeClass":"compound","value":[{"dansRelationType":{"typeName":"dansRelationType","multiple":false,"typeClass":"controlledVocabulary","value":"relation"},"dansRelationText":{"typeName":"dansRelationText","multiple":false,"typeClass":"primitive","value":"Website NWO about Voting Engagement Tools as political decision aids"},"dansRelationURI":{"typeName":"dansRelationURI","multiple":false,"typeClass":"primitive","value":"http:\/\/www.n
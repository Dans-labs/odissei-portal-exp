              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Van de stolpboerderij aan Westeinde 239 in Berkhout is een zwing bemonsterd voor dendrochronologisch onderzoek. Het gaat hierbij om een doorsnede van grove den (Pinus sylvestris L.) waarop de wankant aanwezig is.\nDe laatste jaarring dateert in 1607 waarmee een kapinterval in de herfst/winter 1607/08 bepaald kan worden. De stopboerderij is waarschijnlijk in 1608 opgetrokken."
                },
                "dsDescriptionDate": {

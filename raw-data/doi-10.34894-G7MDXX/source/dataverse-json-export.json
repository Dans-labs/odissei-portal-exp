            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The research question is How do Eritrean Unaccompanied Refugee Minors (URMs) in the Netherlands experience Second Language Anxiety (SLA) when they acquire Dutch?\nThe study consists of a questionnaire and interview data. \nThe goal of the study was threefold: to investigate under what circumstances these minors experience SLA, what linguistic and socio-emotional causes and effects might account for it, and how they feel this influences their L2 acquisition."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",

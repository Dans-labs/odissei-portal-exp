            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The dataset contains metadata of all letters written by and received by Albertine Agnes van Oranje-Nassau (1634-1696). Albertine Agnes van Oranje-Nassau is a direct ancestor of the current Dutch Royal family and exercised quite some political power in her role as regent for the Stadtholder. The data is originally from the EMLO portal, provided by Huygens ING and the Epistolary Project: Epistolary Power: the Correspondence of the wives of William of Orange, 1552-1617, and of the wives of the Dutch and Frisian Stadtholders, 1605-1725. Ambiguities in the dataset have been removed, names have been standardized. The dataset with persons has been enriched with classifications of their occupations. The EMLO ID’s of letters and persons have been added to the dataset."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2022-12-22"
                }
              }

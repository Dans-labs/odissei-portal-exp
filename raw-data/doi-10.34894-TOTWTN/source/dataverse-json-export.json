            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The Eet & Leef study contains data from participants who completed a three-part online quantitative survey and from the same sample, participants who participated in a qualitative interview. The study was conducted in the Netherlands between September 2019 and February 2020. The study participants were adults aged 18 to 65 years old and provided information about their lifestyle behaviours, psychosocial characteristics, perceptions of their living environment and address data that facilitates linkage with objective environmental exposures (the address data is not included in the current dataset due to privacy reasons)."
                },

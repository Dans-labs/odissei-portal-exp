            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van het Mercuriuspark te Nijmegen zijn de resten van twee waterputten uit de Vroege Middeleeuwen aangetroffen. Hiervan zijn vijf eiken (Quercus sp.) monsters aangeleverd voor dendrochronologisch onderzoek. Ondanks de beperkte afmetingen zijn er voldoende jaarringen aanwezig. De twee monsters uit spoornr. 40 zijn afkomstig uit dezelfde boom. Hiervoor is de boom-middelcurve 23.043.B01 gemaakt. Deze meting kan gedateerd worden in 847.\nVoor spoornr. 318 kan één monster gedateerd wordt en deze datering valt in 804.\nVoor beide waterputten geldt dat er geen afgebakend kapinterval bepaald kan worden omdat er geen spinthout of wankant aanwezig is. De dateringen passen echter goed bij de vermoedelijke ouderdom."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

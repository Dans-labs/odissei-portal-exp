{"license":"CC-BY-4.0","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Replication Data for Brand in de Stad: Nederlandse stedelijke brandkeuren en ordonnanties 1300-1600"},{"typeName":"subtitle","multiple":false,"typeClass":"primitive","value":"Regelgeving rondom brandpreventie en brandbestrijding in de laatmiddeleeuwse Lage Landen"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"NWO project (In)Flammable Cities"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"J. Coomans"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Utrecht University"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Coomans, Janna"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Utrecht University"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"This dataset contains a urban bylaws and ordinances concerning fire safety from cities in Netherlands issued between 1340-1590. The dataset summarizes the contents of the original Middle Dutch regulations in modern Dutch.  \nThe sources consist of published editions of medieval municipal records and legal texts that are available in the public domain. The editions are accessible online, allowing researchers to consult and verify the original texts. The selection focused on urban regulations explicitly related to fire prevention, fire control, and fire-related building instructions such as on roofs, chimneys or ovens. NOTE: This trial version contains data from 12 cities. Final version to be published in 2027. \n\nThe database was created through systematic reading and comparison of edited source collections. For each ordinance or bylaw, key elements such as location, date, type of regulation, and principal safety measures were extracted and summarized. The dataset is intended to facilitate comparative historical research into urban governance, public safety, and risk management in the medieval and early modern Low Countries. "},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2026"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Earth and Environmental Sciences","Medicine, Health and Life Sciences","Social Sciences","Other"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Urban History, Fire, Environmental History, Middle Ages, Netherlands, cities, firefighting, safety, architecture"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"producer","multiple":true,"typeClass":"compound","value":[{"producerName":{"typeName":"producerName","multiple":false,"typeClass":"primitive","value":"Janna Coomans"},"producerAffiliation":{"typeName":"producerAffiliation","multiple":false,"typeClass":"primitive","value":"Utrecht University"}}]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2026"},{"typeName":"productionPlace","multiple":true,"typeClass":"primitive","value":["Netherlands"]},{"typeName":"grantNumber","multiple":true,"typeClass":"compound","value":[{"grantNumberAgency":{"typeName":"grantNumberAgency","multiple":false,"typeClass":"primitive","value":"NWO Talent Programme
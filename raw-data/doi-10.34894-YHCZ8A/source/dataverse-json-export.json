            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek op de nieuwbouwlocatie Amerscamp-Plein in Werkendam zijn bewoningsporen uit de 17e tot 19e eeuw aangetroffen. Van twee waterputten is een monster aangeleverd voor dendrochronologisch onderzoek.\nEen plank van zilverspar (Abies alba Mill.) met vondstnr. 128 kan gedateerd worden in 1723. De wankant is niet aanwezig, dus kan alleen bepaald worden dat het hout ergens na 1723 gekapt is.\nHet eiken (Quercus sp.) monster met vondstnr. 204 uit een tonput kan niet gedateerd worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-02-04"
                }
              }

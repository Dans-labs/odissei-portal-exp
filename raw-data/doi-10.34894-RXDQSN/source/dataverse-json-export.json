          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset comprises two Excel .csv files and three Excel .xlsx files containing all field data collected in 2018. Additionally, it includes four R-scripts utilized to generate the results presented in the manuscript. The data consists of morphometric measurements of harbor seal (<i>Phoca vitulina vitulina</i>) pups and young weaners during their time at Sealcentre Pieterburen in 2018. The objective of our study was to identify body measurements that serve as accurate age estimators for young harbor seals (up to three months old), with a focus on non-invasive techniques applicable in field conditions."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-07-26"
                }
              }

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Liesboslaan 6 in Breda is een waterkuil uit de IJzertijd aangetroffen. De schacht van de waterkuil bestaat uit eiken (Quercus sp.) staken en hieruit is een selectie gemaakt voor dendrochronologisch onderzoek.\nDe vijf onderzochte staken lijken allemaal uit dezelfde boom afkomstig en hiervoor is een boom-middelcurve samengested (25.101.B01). Hoewel van voldoende kwaliteit kan er geen datering gevonden, noch voor de IJzertijd, noch voor een andere periode."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-05-26"
                }
              }
            ]

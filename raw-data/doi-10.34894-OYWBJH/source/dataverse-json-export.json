            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Enschotsebaan 3 te Tilburg zijn sporen van Volmiddeleeuwse bewoning aangetroffen, waaronder vijf boomstamputten. Van deze putten zijn monsters aangeleverd voor dendrochronologisch onderzoek. Verwacht wordt at deze in de 11e en 12e eeuw dateren.\nIn alle gevallen gaat het om eik (Quercus sp.), wat gebruikelijk is. Eén monster bevatte onvoldoende jaarringen. De overige vier zijn onderzocht. Hiervan konden er drie gedateerd worden. De dateringen van in de 12e, en aan het begin van de 13e eeuw. Omdat op alle monsters de wankant of zelfs de bast aanwezig is, kunnen nauwkeurige kapintervallen geschat worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2022-12-01"
                }
              }

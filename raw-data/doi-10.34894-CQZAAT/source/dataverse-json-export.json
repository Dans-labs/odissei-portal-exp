            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "We collected corpus (usage) and experimental (judgment) data by the same participants (i.e., native German speakers living in the Netherlands) to test their usage and judgment regarding German constructions potentially transferred from Dutch (i.e., the placement of prepositional phrases). We showed that their usage and judgments are related to each other, with participants being more likely to accept constructions that they use themselves."
                }
              }
            ]
          },

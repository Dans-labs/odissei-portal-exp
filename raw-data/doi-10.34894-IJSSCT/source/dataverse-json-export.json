            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van het Kerkplein in Zwammerdam is een aantal kleine houten vondsten aangetroffen. Hierbij gaat het hoofdzakelijk om grenen (Pinus sylvestris L) paaltjes. Verder is ook els (Alnus glutinosa Gaertn.) en fijnspar (Picea abies Karst.) aangetroffen. Ondank de beperkte afmetingen bevatte één van de paaltjes (vnr 53.1) voldoende jaarringen voor dendrochronologisch onderzoek. Hiervan kan de laatste jaarringen in 1713 gedateerd worden. Gezien het ontbreken van de wankant kan geen afgebakend kapinterval bepaald worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-05-01"
                }
              }

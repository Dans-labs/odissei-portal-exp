                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Bitswijk in Uden is een aantal houten vondsten aangetroffen. Deze zijn aangeleverde voor dendrochronologisch onderzoek. Uit de vier eiken (Quercus sp.) vondsten kan er één aangemerkt worden voor onderzoek. Dit monster leverde echter geen goede resultaten op, waardoor deze vooralsnog ongedateerd blijft."
                },

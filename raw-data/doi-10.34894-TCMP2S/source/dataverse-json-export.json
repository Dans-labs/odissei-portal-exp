            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij het archeologisch onderzoek ter plaatse van het Kransakkerdorp aan de Roskam bij Veldhoven is een vermoedelijk Romeinse waterput aangetroffen. Van twee eiken (Quercus sp.) planken is een monster aangeleverd voor dendrochronologisch onderzoek.\nEén hiervan bleek geschikt voor onderzoek en de datering van de laatste jaarring in 64 na Chr. bevestigd de Romeinse ouderdom. Er is geen spinthout of wankant aanwezig, waardoor een afgebakend kapinterval niet vastgesteld kan worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

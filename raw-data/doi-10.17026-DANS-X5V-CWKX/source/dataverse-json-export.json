            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Het onderzoek naar tijdsknelpunten in de samenleving beoogt inzicht te geven in de knelpunten die mensen in het dagelijks leven ervaren. Het is tevens gericht op het achterhalen van de mogelijke oplossingen voor tijdsknelpunten of verbetering in de balans tussen werk en privé. De doelgroep van het onderzoek is de bevolking van 20-65 jaar.</p>"
                }
              }
            ]

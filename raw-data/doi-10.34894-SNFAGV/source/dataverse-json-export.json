          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset consists out of four files, with data for bats, mice, moths and birds included in the paper indicated above.\r\n\r\nData on bats (Spoelstra_2015_philtrans_BatsPerNightPerTRfile.txt): \r\nrank = observation level random effect (unique per record)\r\nnight = night number, starting from the first of june 2013\r\nsite = site number, see table 'transects.csv'\r\ntransect = transect number, see table 'transects.csv'\r\ntreatment = light treatment, either dark, white, green or red\r\npasses = number of 5 second files with a pass of a pipistrellus species\r\nbuzzes = number of buzzes per night\r\n\r\nData on wood mice (2012-2015_SpeciesPerNightPerTransect.csv):\r\nrecID = observation level random effect (unique per record) \r\nsite = site number, see table 'transects.csv'\r\ntransect = transect number, see table 'transects.csv'\r\ntreatment = light treatment, either dark, white, green or red\r\ndate = date\r\nnightnr = night number after 1/1/2012\r\nyear = year\r\njuliandate = juliandate\r\nspecies = species\r\ndaytime = number of the species photographed in daytime\r\nnighttime = number of the species photographed in nighttime\r\ncam1 = camera at middel light post in the forest\r\ncam2 = camera at last light post in the forest\r\ncam3 = horizontal camera at middle light post in the forest\r\ntotalOFFtile = total individuals photographed not on the tile\r\ntotalONtile = total individuals photographed on the tile\r\ntotal = total individuals\r\n\r\nData on birds (Spoelstra_2015_philtrans_Sovon_DiffTransYear_2012_2014.txt):\r\nYear = year\r\nTrans = transect number, see table 'transects.csv'\r\nSpecies = species number, refer to SOVON for NL or Latin name\r\nNumber = number of individuals changed from Year to Year + 1\r\nSite = site number, see table 'transects.csv'\r\nTr = light treatment, either dark, white, green or red\r\n\r\nData on moths (Spoelstra_2015_philtrans_MothSpecPerTransFile_2012_2013.txt):\r\nspectranscode = combination of species code and transect\r\nspeciescode = code for moth species; see NL species list\r\nfamily = moth family\r\norder = moth order\r\ntransect = transect number, see table 'transects.csv'\r\nSite = site number, see table 'transects.csv'\r\nnr.2012 = number of individuals caught in 2012\r\nnr.2013 = number of individuals caught in 2013\r\ncatchnights.2012 = number of nights trapped in 2012\r\ncatchnights.2013 = number of nights trapped in 2013\r\nabsdiffyears = difference in individuals between 2013 and 2012\r\nreldiffyears = relative differentce (corrected for trapping nights)\r\nratioyears = ratio in numbers between 2013 and 2012\r\ntreatment = ight treatment, either dark, white, green or red\r\n\r\nData on transects (transects.csv - link between site, transect, treatment):\r\ncol1 = transect number\r\ncol2 = site number\r\ncol3 = NL name of site\r\ncol4 = treatment\r\ncol5 = data lights on for the first time"
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2017-02-20"
                }
              }

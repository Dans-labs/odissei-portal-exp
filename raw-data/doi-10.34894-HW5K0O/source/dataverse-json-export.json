              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains raw and processed RNA-seq data generated to study the cells residing in the zone of calcified cartilage during osteoarthritis. A detailed description of the background and aim of the analysis can be found in the `Research plan`. The data includes FASTQ files, count matrices, and metadata tables linking samples to experimental conditions. Due to patient privacy concerns of raw transcriptomic data, the FASTQ files will not be published open access, but can only be received upon reasonable request and the completion of a Data Transfer Agreement."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-11-07"
                }
              }
            ]

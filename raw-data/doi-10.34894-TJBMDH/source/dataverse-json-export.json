            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Voorafgaand aan het realiseren van nieuwbouw op het perceel aan de Lindtsebenedendijk 151-155 te Zwijndrecht is archeologisch onderzoek uitgevoerd. Hierbij is in een ophogingslaag een aantal houten vondsten aangetroffen. Hiervan zijn drie palen en twee planken, in alle gevallen eik (Quercus sp.), aangeboden voor dendrochronologisch onderzoek.\nDe palen zijn primair gebruikt, maar de planken zijn mogelijk hergebruikt. Vermoed wordt dat deze uit de 16e tot 19e eeuw dateren.\nVan de vijf monsters konden er twee gedateerd worden. Het gaat hierbij om palen waarop het spinthout en de wankant aanwezig is. Beide palen dateren in 1477. Voor vondstnr. 39 betekent dit dat het hout in het voorjaar van 1478 gekapt is. Vondstnr. 40 is in de herfst of winter van 1477/78 gekapt. Het hout zal dan ergens in 1478 verwerkt zijn."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-04-10"
                }
              }
            ]

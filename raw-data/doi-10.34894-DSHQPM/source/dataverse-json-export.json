                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains biographical observations about historical Japanese figures from the Tokugawa period (1600-1868) and related eras. The dataset captures various types of information including personal appellations, life events (births, deaths), occupational roles, and family relationships. While it includes interpreters who worked with the Dutch East India Company at Deshima, it also encompasses major political figures such as Tokugawa shoguns and other notable historical personalities."
                }
              }
            ]

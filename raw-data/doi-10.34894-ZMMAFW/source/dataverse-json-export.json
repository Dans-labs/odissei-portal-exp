            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Data from qualitative research, conducted as part of the BECA project (2025-04-22). The dataset contains results from semi-structured interviews with patients and doctors. The aim of the study was to gain a better understanding of the preferences of both patients with cardiovascular diseases regarding the use of smartwatch technology designed to detect cardiac arrest and alert emergency services, as well as the preferences of various medical specialists (cardiologists, ICU doctors, neurologists, general practitioners) concerning this technology. The patient questionnaire includes the following themes: demographic characteristics, general health and perceived risk of cardiac arrest, willingness to use smartwatch technology, symptoms of depression and anxiety, stress, hypochondria, optimism, personality traits, and (medical) trust."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-04-22"
                }
              }

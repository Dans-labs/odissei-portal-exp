              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset includes behavioral data (emotion labels, confidence ratings, intensity ratings and simplicity ratings), physiological data (facial muscle activity measured over the Corrugator Supercilii and Zygomaticus Major region) and questionnaire data related to clinical traits (social anxiety traits and autistic traits) to investigate ⁠modulations in the links between facial mimicry and emotion recognition, and metacognitive judgements and emotion recognition, by social anxiety trait levels and autistic trait levels."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

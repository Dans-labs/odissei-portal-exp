            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Dendrochronological research project. The measurement series on which the results are based, in part are unavailable. D.J. de Vries and H. Tisje performed the research and produced the initial dating resuls. Bennno Ridderhof (VU) digitized available analog measurement series (2010). E. Jansma was responsible for the digitization and development of the XML-files containing metadata and results (2011)."
                }
              },
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The year in which the research stored in https://dataverse.nl/dataverse/stichtingring took place, from 1985 onwards can be found in the report number, with for example ‘P:1997001’ implying that this particular study took place in 1997. Interpretations of the most likely wood provenance and estimations of the number of missing sapwood rings, if included in the original research report, are based on the knowledge at the time and may be subject to later refinement."
                }
              }
            ]

              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij verkennend onderzoek ter plaatse van de Oosterbank voor Goeree is een onbekend scheepswrak aangetroffen. Het gaat vermoedelijk om een 18e-eeuws Engels koopvaardijschip. Van het wrak zijn enkele monsters genomen en hiervan kon er één aangemerkt worden voor onderzoek. Hiervoor werden redelijke, maar niet overtuigende, resultaten voor 1750 gevonden. Aanvullend onderzoek door. C. Tyers  kon deze datering echter bevestigen."
                },
                "dsDescriptionDate": {

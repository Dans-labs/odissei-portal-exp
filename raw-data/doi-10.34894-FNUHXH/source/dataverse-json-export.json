            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Dataset of peroxisomal Pex3 rings and colocalization with its binding partner Atg30, in wildtype yeast Hansenula polymorpha (Pichia angusta) cells, imaged by STimulated Emission Depletion (STED) nanoscopy. The dataset contains the combined, raw STED and confocal image files (16bit .tiff format) of Pex3-Halo and Atg30-GFP on which the analysis was performed to determine the peroxisomal circumference, mean Atg30 signal per peroxisome, localization and its correlation with Pex3.\n\nAll script used for the analysis of this data can be found on Zenodo.org via: https://doi.org/10.5281/zenodo.11047200\n\nThis article is published in iScience at https://doi.org/10.1016/j.isci.2024.110481"
                }
              }
            ]

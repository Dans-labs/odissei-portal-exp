{"license":"DANS Licence","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, Nijkerk als toevluchtsoord tijdens WO II, interview 03"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:41425"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Stichting Oud Nijkerk"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"S. van den Berg-Ebbenhorst"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Stichting Oud Nijkerk"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Huisarts dr. Henk Schreuder,  94, verving in 1944 zijn gegijzelde collega Leerink in Nijkerk. Na diens terugkeer zette Schreuder een noodziekenhuis met diverse locaties op voor met name evacués uit Arnhem en omstreken. Daarnaast organiseerde hij met hulp van Nijkerkers, evacués en artsen van buiten een opvang voor mensen op hongertocht. Daarvoor moesten veel praktische problemen worden opgelost, zoals het maken van bedden, dagelijkse voedselvoorziening voor ruim 600 mensen,  verlichting, verwarming, latrines en het elke ochtend legen daarvan. (01:40)  Hij waardeert zwart slachten en zwarte handel positief omdat het veel mensenlevens redde. (45:08) De godsdienstige overtuiging van Nijkerkers gaf rust na de razzia op Putten en deel Nijkerk. Die houding werkte echter niet door in de houding tegenover de Duitsers. Daar was iedereen fel op tegen. (55:02 + 56:02) Hij zelf ontsnapte enkele malen aan arrestatie door zeer alert optreden, onder ander bleef hij zo uit handen van de Duitsers tijdens razzia van Putten. (00:15; 00:51)"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Arnhem"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"evacués"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"hongertochten"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Nijkerk"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"noodziekenhuis"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Nijkerkerveen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"gezondheid"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"koud"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"hongerwinter"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"voedselvoorziening"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"latrines"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"drinken"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"café De Bonte Koe"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primiti
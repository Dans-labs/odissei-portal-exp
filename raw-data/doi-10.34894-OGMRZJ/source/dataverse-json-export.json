            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Van het archeologisch onderzoek aan de Nieuwstraat te Arnhem, uitgevoerd door archeologisch adviesbureau RAAP, zijn vier monsters van eikenhouten palen aangeleverd voor dendrochronologisch onderzoek. Verdere contextinformatie over de vondsten is niet verstrekt. Van de vier monsters zijn er drie aangemerkt voor onderzoek. Hieruit bleek dat twee palen (M25 en M26) uit dezelfde boom afkomstig zijn. Hiervoor is de boom-middelcurve 22.059.B01 gemaakt. Deze kan gedateerd worden in 1510. Het overige monster (M18) dateert ruim een eeuw later in 1646. Aangezien er geen spinthout of wankant aangetroffen is, kan alleen de ondergrens van de kapintervallen bepaald worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

          {
            "typeName": "dansUniverse",
            "multiple": true,
            "typeClass": "primitive",
            "value": [
              "The sample consists of 309 Dutch individuals aged 17-68 with one or more doctor-diagnosed chronic illnesses, who have work (either paid or self-employed) and use prescribed medication."
            ]
          },
          {
            "typeName": "dansSamplingProcedureFreeText",
            "multiple": false,
            "typeClass": "primitive",
            "value": "Participants were drawn from the National Panel of the Chronically ill and Disabled (NPCD), a nationwide panel focused on people with a chronic condition and/or a physical disability. Panel members are recruited from random samples of general practices, drawn from the Dutch Database of General Practices. Within each selected practice, a random one third of eligible patients with a chronic condition is invited to participate in the panel. Patients are eligible for participation if they have a somatic chronic disorder according to the International Classification of Primary Care (ICPC), diagnosed by a certified general practitioner and are 16 years or older. Additionally, participants with physical disabilities are recruited from national population surveys conducted by Statistics Netherlands. People who are institutionalized, have a limited (<6 months) life expectancy or do not speak Dutch are excluded from participation. Eligible patients receive an invitation with an information letter and an informed consent form from their GP. Participants remain in the panel for a maximum of four years, new members are recruited annually. \nTo be included in the study for which this dataset was used, panel members needed to meet additional criteria, namely: being aged between 16 and 68 years old, having a paid job for at least 1 hour a week and being prescribed medication."
          },
          {
            "typeName": "dansDataCollectionSituation",
            "multiple": false,
            "typeClass": "primitive",
            "value": "Questionnaires are distributed by the Dutch research institute Nivel twice a year (in autumn and spring) to the panel members either online or on paper, as per the participant’s preference. The majority of data in this data-set was collected from the NPCD questionnaire of November 2020, complemented with self-efficacy data from the April 2022 questionnaire and medication use data from the April 2020 and April 2021 questionnaires. The data were compiled and accessed in May 2023."
          },
          {
            "typeName": "dansActionsToMinimizeLoss",
            "multiple": false,
            "typeClass": "primitive",
            "value": "Participants who had not yet completed the questionnaire, received two reminders (after five weeks and after eleven weeks)"
          },
          {
            "typeName": "dansResponseRate",
            "multiple": false,
            "typeClass": "primitive",
            "value": "Response rate of the questionnaire from which the majority of the data was collected was 77,98%"
          }
        ]

          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "\"Mady Schoenmaker-Ament werd in 1940 geboren in Malang en bracht haar vroege jeugd door in Nederlands-Indië. Tijdens de Japanse bezetting bleef zij met haar moeder, zus en broer buiten de kampen, terwijl haar vader gevangen zat. Na de oorlog volgden evacuaties, tijdelijke woonplekken en een hereniging met haar vader. Vanaf 1947 wisselde het gezin herhaaldelijk tussen Nederlands-Indië en Nederland. Schoenmaker-Ament woonde op verschillende adressen, ging steeds naar andere scholen en verbleef als kind langere tijd zonder haar ouders bij familie en andere gezinnen. Het gezin was daardoor slechts korte perioden compleet.\n\nDe vele verhuizingen en scheidingen leidden tot een sterk vermogen om zich aan te passen en plaatsen gemakkelijk los te laten. Tegelijk bemoeilijkten ze duurzame hechting aan vrienden en herkent zij in latere keuzes soms een neiging om moeilijke situaties achter zich te laten. Thuis zijn raakte voor haar minder verbonden met een huis dan met de aanwezigheid van vertrouwde mensen.\n\nNa opleidingen en uiteenlopende banen, onder meer als kleuterleidster, bij Hoogovens en de ANWB, richtte zij zich op haar gezin en langdurig vrijwilligerswerk. Haar betrokkenheid bij het Indië Monument in Deventer gaf ruimte aan het buitenkampverhaal en versterkte haar herkenning van een Indische identiteit. Boeken, familiebrieven en terugkeerreizen hielpen haar herinneringen te plaatsen. De oorlog blijft voor haar verbonden met bezorgdheid over kinderen die ook nu met oorlog en ontwrichting opgroeien.\""
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-7-28"
                }
              }

          {
            "typeName": "dateOfCollection",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dateOfCollectionStart": {
                  "typeName": "dateOfCollectionStart",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2015-10-01"
                },
                "dateOfCollectionEnd": {

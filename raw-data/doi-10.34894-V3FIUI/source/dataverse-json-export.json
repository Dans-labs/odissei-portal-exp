            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "A total of N = 102 young people (aged 16–26) with low to moderate CA were included\nin the study. We first investigated associations between friendship quality, mental health, and CA. \n\nIn a representative subset (n = 62), we assessed neural stress responses using the Montreal Imaging Stress Task. In our sample, CA was best described along two dimensions resembling threat or deprivation like experiences. Hence, we investigated both cumulative and dimensional effects of CA."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024"
                }
              }
            ]
          },

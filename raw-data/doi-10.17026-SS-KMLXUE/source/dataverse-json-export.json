                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This release contains data two separate datasets that both enable the researcher to reconstruct average male conscription height on a municipal level. Both datasets provide data for multi-year periods that encompass years of measurement. For the period 1863-1875, three governmental reports were used. The period 1921-1925 is based on a research publication from which the original sources have been lost."
                }
              }
            ]

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Dorpsstraat 29 te Nibbixwoud is een waterput aangetroffen. Hieruit zijn drie monsters genomen voor houtsoorten- en dendrochronologisch onderzoek. Twee grenen (Pinus sylvestris L.) planken zijn aangemerkt voor dendrochronologisch onderzoek. Een derde vondst, afkomstig van een wagenwiel bleek van beuk (Fagus sylvatica L.) gemaakt te zijn.\nOp basis van de sterke onderling gelijkenis mag aangenomen worden dat beide planken uit dezelfde boom afkomstig zijn. Hiervoor is de middelcurve 24.047.B01 gemaakt. Deze kan gedateerd worden in 1548. De wankant is niet aanwezig, waardoor alleen bepaald kan worden dat het hout ergens na 1548 gekapt is."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-08-06"
                }
              }

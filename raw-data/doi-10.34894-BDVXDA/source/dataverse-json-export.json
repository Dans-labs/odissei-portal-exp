            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Open Science creates an opportunity for researchers to improve their \nworkflow and numerical reproducibility of their results. This short \npresentation will preview tools they can use along the research process \nfrom data collection to publication. They include version control, \ngenerating synthetic data that can be publicly shared with the world, \ncreating R packages to facilitate dissemination of results and increase \nresearch impact, and automation with Make. Together, these tools offer \nmore transparency both between co-authors of a project but also to the \nresearch community in general. The goal is to motivate more academics to\n learn more about these practices and start using them too! <br>"
                }
              }
            ]
          },

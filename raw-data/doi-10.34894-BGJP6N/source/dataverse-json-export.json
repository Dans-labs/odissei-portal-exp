            "value": "We’ve got your back!"
          },
          {
            "typeName": "subtitle",
            "multiple": false,
            "typeClass": "primitive",
            "value": "Hoe onderwijsinstellingen in mbo, hbo en wo welzijn en binding van studenten kunnen versterken door sociale steun"
          },
          {
            "typeName": "alternativeTitle",

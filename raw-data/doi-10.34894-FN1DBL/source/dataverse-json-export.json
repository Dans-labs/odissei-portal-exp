          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This gazetteer is created as part of the Necessary Reunions Project from March to December 2025 funded by an NWO XS grant (File Number: 406.XS.24.02.046). It is a structured directory of place information for early modern Kerala for those places listed in a set of fifteen maps created in the seventeenth and eighteenth centuries by the Dutch East India Company (VOC) that are presently part of the Leupe collection and the collection of the Ministry of Colonies (MIKO) at the National Archives in The Hague. \n\nThis gazetteer \ni) maps historical toponyms in VOC maps to their modern equivalents and other names used in the textual archives of the VOC.\nii) identifies the location of places indicated on the maps\niii) identifies visual and textual elements indicating the geographical features (rivers, mountains) and place functions (towns, forts) and links them with the associated places.\niv) associates places to geographical regions or polities that the maps indicate they were part of."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-02-23"
                }

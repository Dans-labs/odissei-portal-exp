            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek op de locatie van de inmiddels gesloopte boerderij Kamerhof nabij Baakhoven zijn de resten van een vermoedelijk Romeinse waterput aangetroffen.\nUit de bekisting zijn drie monsters genomen en aangeleverd voor dendrochronologisch onderzoek. In alle gevallen gaat het om eik (Quercus spp.). De twee radiale planken met vondstnummers 222-7 en 22-10 blijken uit dezelfde boom afkomstig. Hiervoor is de middelcurve 25.050.B01 gemaakt en kunnen dezelfde resultaten aangehouden worden. Deze middelcurve kan in 159 na Chr. gedateerd worden. Het resterende monster (vondstnr. 22-6) laat een vergelijkbare datering zien in 135 na Chr. Omdat er geen spinthout aanwezig is kunnen er geen afgebakende kapintervallen bepaald worden. Vermoedelijk stamt de waterput uit het laatste kwart van de 2e eeuw."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-07-03"
                }
              }
            ]
          },

                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij het archeologisch onderzoek ter plaatse van de Bloemkampen te Nunspeet zijn bewoningssporen aangetroffen. Hierbij gaat het om een aantal duigen en vermoedelijke huispalen. Vijf eiken (Quercus sp.) monster zijn aangeleverd voor dendrochronologisch onderzoek waarvan één paal over voldoende jaarringen beschikt. Desondanks kon er geen datering gevonden."
                },

                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>This study on the labour participation of single parents in the Netherlands consists of two surveys: (a) 1063 single mothers on welfare (1998) + (b) 1140 single parents (1999): 452 single mothers who also participated a year before, and 688 economically independent single parents.</p>"
                }
              },

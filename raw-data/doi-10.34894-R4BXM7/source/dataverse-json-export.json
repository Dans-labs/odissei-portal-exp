              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "We created a land systems map for the high forest zone of Ghana. Based on this land systems map 3 scenarios were made with the CLUMondo model to depict possible futures of this region.\nThis data package provides the land systems map, the scenario results as well as the full model set-up for the scenarios. Documentation is provided on how the land systems map was created. For documentation about running the CLUMondo model we refer to the CLUMondo model documentation."
                }
              }
            ]

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Op de woningbouwlocatie De Tuit in Varsseveld is bij archeologisch onderzoek een laat-middeleeuwese huisplattegrond aangetroffen. Op het erf zijn drie boomstamputten aangetroffen, in alle gevallen eik (Quercus spp.). Daarnaast is er bij één van de boomstamputten een losse plank aangetroffen (eveneens eik).\nVondstnr. 140 bevatte niet voldoende jaarringen voor onderzoek. \nDe boomstamput met vondstnr. 171 kan gedateerd worden in de herfst/winter van 965/66 en de bijbehorende plank dateert in de herfst/winter van 964/65.\nDe resterende boomstamput met vondstnr. 162 bevat voldoende jaarringen, maar kan niet gedateerd worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-08-07"
                }
              }
            ]

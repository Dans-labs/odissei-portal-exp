                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This is the data for a survey and conjoint experiment, fielded in 2020, among leaders of agencies and educational institutions in Denmark. The study contains two parts. One part focuses on the perceived and desired steering by central government, utilizing the survey instrument on stewardship theory developed by Schillemans & Bjurstrom. The second part is a conjoint experiment on non-punitive accountability. Limited information about participants is available because of privacy."
                }
              }
            ]

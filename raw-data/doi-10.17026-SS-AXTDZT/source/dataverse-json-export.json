          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The first fourteen interviews were conducted in order to investigate multiple aspects: 1) how modellers make modelling decisions, 2) how modellers perceive automation in the modelling process, and 3) how modellers perceive standardisation in the form of guidelines for the modelling process. The interviews were semi-structured and lasted between 1 hour 15 minutes and 2 hours. All interviews were conducted in Dutch, except one, which was in English. These interviews give insight into the social aspects of hydrodynamic modelling, which will improve our understanding of the influence modellers have in general.\n\nThe next two interviews were conducted to further flesh out the third aspect, how modellers perceive standardisation in the form of guidelines for the modelling process. These interviews were also conducted in Dutch.\n\nThe final 20 interviews were conducted to explore how modellers perceive standardisation in the form of a common modelling platform. These interviews were conducted in Australia, in English."
                }
              }
            ]
          },

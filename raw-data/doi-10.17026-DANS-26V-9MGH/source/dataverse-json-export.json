                  "value": "A.F. Kabiri"
                }
              }
            ]
          },
          {
            "typeName": "distributionDate",
            "multiple": false,
            "typeClass": "primitive",
            "value": "2016-04-12"
          },
          {
            "typeName": "dateOfDeposit",
            "multiple": false,
            "typeClass": "primitive",
            "value": "2016-04-12"

              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "geslacht: M\nland van herkomst: Afghanistan\nleeftijd aankomst NL: 7\nstad: Den Haag\nvluchtreden: Taliban\nrelaties met eigen gemeenschap: opgegroeid zonder contact met de Afghaanse gemeenschap. Tijdens studententijd bij stichting voor integratie van Afghanen in Nederland\nopleiding:  Nederlands Recht\nwerk in NL:  Advocaat\nbijdrage aan de stad: heeft stichtingen helpen opzetten die gratis juridisch advies geven aan mensen die te weinig verdienen.\nopvallend/bijzonder: voelde zich aanvankelijk thuis in Nederland maar voelt zich door veranderend politiek klimaat steeds “vervreemder”, ook door het eenzijdigheid van het beeld dat de Nederlandse media laten zien van moslims en Afghanistan."
                }
              }
            ]
          },

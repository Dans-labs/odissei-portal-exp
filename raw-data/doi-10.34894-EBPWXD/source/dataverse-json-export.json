                  "typeName": "keywordValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "cilia, C. elegans, intraflagellar transport, kinesin-2, IFT-dynein, tubulin, transition zone, single-molecule imaging, particle tracking, axoneme"
                }
              }
            ]
          },

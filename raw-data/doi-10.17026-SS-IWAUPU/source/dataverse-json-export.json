            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This database was produced in the context of the dissertation \"A Truth Universally Acknowledged. Dutch Investment in French Colonial Resources, 1717-1792\", as part of NWO VICI project VI.C.191.027. This database documents 70 direct trade voyages during the Seven Years’ War (1756-1763). A direct trade voyage in this context is defined as departing from Amsterdam, destined to take freight in a French West Indian port, and returning to a Dutch port (in most cases again Amsterdam). The definition therefore relates to the planned voyage; in the majority of cases, however, the voyage did not pan out as intended or was diverted. The data on this is recorded in this database, and elaborated upon in the dissertation. All information on the archival sources, selection mechanisms, and forms of the database can be found in the protocol"
                }
              }
            ]

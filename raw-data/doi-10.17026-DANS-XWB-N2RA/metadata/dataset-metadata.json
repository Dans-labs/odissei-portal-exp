{"license":"CC0-1.0","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Mediatijdbestedingsonderzoek 2015 - MTBO2015"},{"typeName":"alternativeTitle","multiple":true,"typeClass":"primitive","value":["Media:Tijd 2015"]},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:121392"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Sociaal en Cultureel Planbureau (SCP)"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"SCP  Databeheerder"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Sociaal en Cultureel Planbureau"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Media:Tijd 2015 (MTBO2015) is een tijdbestedingsonderzoek (via dagboekmeting) met de focus op media. Alle grote dagelijkse activiteiten worden op hoofdlijnen in kaart gebracht, terwijl die van media binnen de mogelijkheden van een tijdbestedingsonderzoek zo specifiek mogelijk in kaart worden gebracht. Het is een aanvulling op de bestaande media-bereiksonderzoeken naar televisie, radio, papieren media en internet, die  informatie per medium meten. MTBO2015 Media:Tijd geeft inzicht in de onderlinge relatie van deze media en in mediagedrag dat niet door de bereiksonderzoeken wordt gemeten.In het huidige medialandschap is het moeilijk om het mediagebruik te onderscheiden van persoonlijke communicatie. De activiteiten kunnen deels via dezelfde apparatuur en soms gelijktijdig plaatsvinden. MTBO2015 biedt een gedetailleerd beeld van zowel het mediagebruik als van de persoonlijke communicatie via media op basis van nieuw mediatijdsbestedingsonderzoek. De data maken het mogelijk het lezen, luisteren, kijken, surfen, gamen en communiceren van de Nederlandse bevolking van 13 jaar en ouder in alle mogelijke hoedanigheden te onderzoeken. Bovendien kan worden nagegaan welke media Nederlanders naast elkaar gebruiken (media-diversiteit), en welke op hetzelfde moment (media-multitasking).De dataverzameling is betaald door SCP, NOM, NLO, SKO en BRO. NPO was coördinator van het traject."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"media"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"mediagebruik"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"media-multitasking"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"tijdsbesteding"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"televisie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"radio"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"papieren media"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"krant"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"nieuwsmedia"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"smartphone"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"tablet"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"internet"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"surfen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"kijken"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"luisteren"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"lezen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"communiceren"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"gamen"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2015-12-14"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Nederlandse Publieke Omroep (NPO)"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Nationaal Onderzoek Multimedia (NOM)"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Nationaal LuisterOnderzoek (NLO)"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Stichting KijkOnderzoek (SKO)"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Buitenreclame Onderzoek (BRO)"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2019-03-21"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2019-03-21"}]},"dansRights":
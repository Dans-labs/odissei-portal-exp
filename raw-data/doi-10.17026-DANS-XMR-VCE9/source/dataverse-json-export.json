                  "typeClass": "primitive",
                  "value": "F.D. von Meijenfeldt"
                },
                "datasetContactAffiliation": {
                  "typeName": "datasetContactAffiliation",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Stichting Bevordering Maatschappelijke Participatie (BMP)"

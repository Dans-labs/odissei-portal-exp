            "multiple": false,
            "typeClass": "primitive",
            "value": "The motivational properties of hope in goal striving [Dataset]"
          },
          {
            "typeName": "author",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "authorName": {

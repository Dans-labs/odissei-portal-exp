            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "We provide two spatial distributions on the degradation state within Central Asia between 2000 and 2019. \n\nThe file Degradation_status represents the overall degradation extent within the region (The file degradation_state_legend.txt provides the legend) .\n\nThe file Degradation_status_soils depicts land degradation status considering soil quility. Soil quality is represented by regionally specific integrated indicator on soil quality (so-called \"soil-bonitet\"). \n\nThe file Degradation_status_soils_legend provides the legend for the raster.  All files are in the geotiff format and can be opened in standard GIS software."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-06-24"
                }
              }

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Dutch Brazil was lost in 1654. The 25th article of the Peace of The Hague in 1662/63 stipulated that the Portuguese crown would pay a million guilders in salt to compensate owners of real estate and creditors for their losses. This dataeset contains the list of claimants, their claims and the verdict of the Raad van Brabant as to which claims were admissable to share in the \"million in salt\". The data contains valuable information on private investment in Dutch Brazil.</p>"
                }
              }
            ]

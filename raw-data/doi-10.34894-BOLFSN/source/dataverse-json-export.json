            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "In het kader van een onderzoek naar het plafond en de overige interieurafwerkingen van de Sint-Carolus Borromeuskerk te Antwerpen is een vijftal monsters van het spreidselplafond aangeleverd voor dendrochronologisch onderzoek.\nHet gaat hierbij om zeer smalle eiken (Quercus sp.) plankjes waarin vanwege de vrijwel radiale oriëntatie een groot deel van het jaarringtraject aanwezig is.\nVan de vijf delen kon worden vastgesteld dat twee paar monsters uit dezelfde boom afkomstig zijn. Hierbij gaat het om M1 en M2 en daarnaast M3 en M4. Hiervoor zijn de boom-middelcurves 24.041.B01 en B02 gemaakt. Het vergelijken van de middelcurven en de resterende meting levert in alle gevallen op. De meest recente jaarring valt in 1493 en aangezien er geen spinthout aangetroffen is kan alleen bepaald worden dat het hout op z’n vroegst aan het begin van de 16e eeuw gekapt is."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-03-21"
                }
              }
            ]
          },

            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This is a Access database containing biographical information about Dutch Pedlars in the period 1600-1850. It was created during a five year research project (subsidized by NWO) entitled: Pedlars and the dissemination of the printed word (1600-1850). The projectleader was dr Jeroen Salman of Utrecht University. The information is mainly based on archival sources in the archives of Utrecht and Amsterdam.  This database provided the data for my monograph Pedlars and the Popular Press. Itinerant distribution networks in England and the Netherlands 1600-1850 (Brill Publishers, Leiden and Boston, 2013)."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2013-07"
                }
              }
            ]
          },

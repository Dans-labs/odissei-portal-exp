          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The dataset is a vectorization of the landmark map \"Kaart van Suriname\" (Map of Suriname), a cartographic work compiled by L.A. Bakhuis and W. de Quant published in 1930. This map represented an update to the earlier colonial geography of J.F.A. Cateau van Rosevelt and J.F.A.E. van Lansberge (published in 1882). While it was partly based on the survey data originally collected Cateau van Rosevelt and Van Lansberge between 1860 and 1879, the 1930 map incorporated new information from scientific expeditions conducted between 1900 and 1927. This map is therefore the most suitable source for creating a precise vector layer of the Surinamese plantation landscape because it combines high geographical accuracy with the historical reality of a plantation system that was fading by 1930.\n\nThe vector annotations derived from the 1930 and 1882 maps are linked to the Suriname Slave and Emancipation Registers, which enables linking information about enslaved people to the geographical location of plantations.\n\nThe dataset consists of the following vector layers: 1) Plantations: Polygons representing Suriname's plantations; 2) Places: Point data for settlements and locations (such as Maroon and Indigenous settlements), including naming on both 1930 and 1882 maps; 3) Rivers and Creeks: Line features depicting the water networks, including names depicted on the 1930 and 1882 maps; 4) Infrastructure: Line features for (rail)roads (1930)."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-07-27"
                }
              }
            ]

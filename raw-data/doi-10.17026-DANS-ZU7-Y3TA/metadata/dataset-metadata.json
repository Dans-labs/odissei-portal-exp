zaam als arts bij opvang slachtoffers concentratiekampen, Limburg<\/p>"}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date Submitted: 2010-02-25"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities","Medicine, Health and Life Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Hojel-kazerne"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Coolsingelziekenhuis"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"coschappen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"bombardement"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"artsenbordje afgeplakt"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"huisartsenpraktijk"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"chef de clinique"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"insulinetekort"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"silbertannermoorden"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"tyfus"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"oral history"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2009-12-07"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitiv
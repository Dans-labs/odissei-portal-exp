          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This repository includes full text file of Multimodal Chinese Sarcasm Dataset (MCSD), a curated dataset for research on multimodal sarcasm detection in Mandarin Chinese publicly broadcasted stand-up comedy. The corpus is structured as follows:<br><br>\n<ul>\n<li>unique utterance ID for each transcribed segment.</li>\n<li>manually verified transcription of the spoken utterance (in Mandarin).</li>\n<li>pseudonymized speaker ID.</li>\n<li>annotated label (sarcastic / not sarcastic) for each transcription.</li>\n<li>aligned start and end timestamps.</li>\n<li>reference to the original publicly available video.</li>\n</ul>\nFor full <em>dataset description and annotation guidelines</em>, please see: <a href=\"https://github.com/x-y-g/MCSD/wiki\">Link</a><br><br>\n\n<h4>Contributors and roles</h4>\n<ul>\n<li>Xiyuan Gao (University of Groningen) – PhD researcher. Responsible for dataset design, transcription processing, annotation guideline.</li>\n<li>Dr. Bruce Xiao Wang (Hong Kong Polytechnic University) – Collaborator and linguistic expert. Contributed to the research framework, research methodology design, and Mandarin discourse insights.</li>\n<li>Meiling Zhang, Shuming Zhang, and Zhu Li – Carried out manual labeling of sarcasm in the transcribed data based on developed annotation protocols.</li>\n<li>Dr. Matt Coler & Dr. Shekhar Nayak (University of Groningen) – Supervisors. Provided research supervision and guidance on ethical compliance.</li>"
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-07-02"
                }
              }
            ]
          },
          {
            "typeName": "subject",
            "multiple": true,
            "typeClass": "controlledVocabulary",
            "value": [
              "Arts and Humanities",
              "Computer and Information Science"
            ]
          },
          {
            "typeName": "keyword",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "keywordValue": {
                  "typeName": "keywordValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "multimodal sarcasm detection, Mandarin Chinese, tonal language, prosody, humor detection, speech analysis, sentiment analysis, pragmatics, spoken language processing, cross-lingual NLP, annotated speech corpus, paralinguistic features, computational linguistics, benchmark sarcasm dataset"
                }
              }
            ]
          },
          {
            "typeName": "topicClassification",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "topicClassValue": {

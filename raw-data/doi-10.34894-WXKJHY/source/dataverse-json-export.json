            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Our study investigates the process of internationalizing the home scientific system in Colombia, a middle-income country on the scientific periphery of global knowledge. We focus on a subset of internationally mobile scientists, namely those who receive their PhDs from foreign institutions. We then ask whether co-authoring with these mobile scientists helps non-mobile scientists – those who stay in Colombia throughout their careers – collaborate more with foreign scientists and, critically, whether such collaborations lead to the formation of direct, unmediated ties between non-mobile and foreign researchers."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",

{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"International Comparative Study of Ethno-Cultural Youth 2006"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"P1843"}},{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:45274"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"ICSEY team"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Paul Vedder"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Rommert Casimir Institute"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Leiden University"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"P.H.  Vedder"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Rommert Casimir Institute, Leiden University"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"ICSEY is a large international study of the acculturation and adaptation of immigrant youth (aged 13 to 18 years) who are settled in 13 societies (N = 5,366), as well as a sample of national youth (N = 2,631). The study was guided by three core questions: How do immigrant youth deal with the process of acculturation? How well do they adapt? Are there important relationships between how they acculturate and how well they adapt? There were substantial relationships between how youth acculturate and how well they adapt."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"acculturation"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"psychological adaptation"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"sociocultural adaptation"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"youth"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"parents"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"intergenerational transmission"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"comparative research"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"cultural identity"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"perceived discrimination"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"immigrants"}}]},{"typeName":"notesText","multiple":false,"typeClass":"primitive","value":"Addition December 2017:\nThe variable 'gender' was missing from earlier versions. This has been corrected in the version of December 2017. The depositor deposited the .sav file, DANS converted it to .por and .dta for the benefit of STATA users and for durability purposes.\n\nAddition September 2015:\n\nThe depositor recently discovered an error which had happened during conversion in the 2006 data file: the UK and NZ were not in the list of countries defined anymore.\n\nTherefore, a new and better version of ICSEY has been uploaded, 'ICSEY distribution file 2015.sav'.\n\nBecause of durability and usability purposes DANS converted this file into:\n- 'ICSEY distribution file 2015.por' and\n- 'ICSEY distribution file 2015.dta'\n\nAll 3 files have been uploaded into this dataset September 16, 2015."},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["English"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2006-07-04"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Dr. C. Leung"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Dr. R. Pe-Pua"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Dr. R. Rooney"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Dr. D. Sang"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Dr. J.W. Berry"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Dr. K. Kwak"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Dr. K. Liebkind"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Dr. C. Sabatier"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Dr. P. Schmitz"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Dr. G. Horenczyk"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Dr. F. van de Vijver"}},{
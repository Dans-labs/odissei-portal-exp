            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The interview was conducted to gain information about the interviewee’s NFT artworks. This topic served as the interviewer’s main topic in her Master’s thesis research. In the interview, the artist explains his path as an artist thus far and using NFTs more recently in his art. He describes his reasons for using NFTs, and describes 81 Horizons in more detail. Finally the topic of preservation of blockchain-based artworks is discussed."
                },
                "dsDescriptionDate": {

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Design: The CAST is a pragmatic, open-label, multicenter, two-period cluster-randomized superiority trial. Enrollment took place from 30 May 2020 until 11 November 2021, and patients were followed for one year. \nSetting: Inclusion took place at the emergency department in ten hospitals located in the Netherlands.\nParticipants: Eligible participants had a displaced DRF that was acceptably aligned after closed reduction. \nInterventions: A below-elbow complete circumferential cast (CC) or a below-elbow plaster of Paris volar-dorsal splint (PS)."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",

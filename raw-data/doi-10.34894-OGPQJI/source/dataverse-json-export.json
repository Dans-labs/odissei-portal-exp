            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Van het archeologisch onderzoek op het plangebied Esrand te Wierden zijn drie monsters geselecteerd en aangeleverd voor dendrochronologisch onderzoek. Het gaat hierbij om betrekkelijk kleine eiken (Quercus sp.) palen en planken uit twee waterputten waar dankzij de trage aanwas voldoende jaarringen aanwezig zijn. \nDe dateringen vallen in de 8ste en 9e eeuw. Spinthout of de wankant is niet aangetroffen, waardoor alleen de ondergrens van het kapinterval bepaald kan worden"
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p dir=\"ltr\">The Flows of Knowledge evaluation method, as introduced by Meagher, Lyall and Nutley (2008) and described in Edwards and Meagher (2020), provides a framework for assessing the impacts of scientific research on policy and practice. This resource informs readers about the purpose of the method, its building blocks and how it can be used to assess the efficiency of knowledge exchange for societal impact.</p>"
                }
              }
            ]

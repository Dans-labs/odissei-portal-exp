            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This study examines the impact of Weather Index Insurance (WII) on social capital.\r\nWe measure social capital using a lab-in-the-field experiment and relate it to the actual\r\npurchase of WII. To account for the non-random uptake of WII, we use an instrumental variable approach. We find that WII crowds out social capital - insured households\r\ncontribute significantly less to the public good than uninsured households. Our findings from the experiment are corroborated using real-life measures of social capital,\r\nincluding informal transfers to fellow villagers and financial contributions to community projects. We find support for two channels underlying these results: (i) WII\r\ncreates positive externalities on uninsured households, which induces them to free-\r\nride. Anticipating this, insured households respond by lowering their investment in\r\nsocial capital. And (ii), WII increases perceptions of self-sufficiency that is, insured\r\nhouseholds need to rely less on others in times of need."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2021-08-30"
                }
              }
            ]

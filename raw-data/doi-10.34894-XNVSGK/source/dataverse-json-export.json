            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Despite early dietary galactose restriction, most patients with Classic Galactosemia (CG) develop long-term complications affecting the brain and ovaries. Prenatal contributions to disease pathology have been proposed. We investigated the developmental trajectory of CG-associated transcriptional signatures in our galt knockout (KO) zebrafish model. RNA sequencing was performed on galt KO and wild-type embryos, larvae and juvenile zebrafish. Differentially expressed genes were analyzed using KEGG and GO enrichment, and metabolic pathway changes were assessed with MetaPhOR."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This is the cleaned and anonymized dataset used for analysis, as\r\nwell as all scripts used for analysis, of the article “Trolls Without\r\nBorders”, currently under review. The goal of the present study\r\nwas to conduct an experiment in which victims from different\r\ncultural backgrounds were either flamed or ostracized during the\r\ngame “Cyberball” and their reactions (emotional, intentional,\r\nbehavioural) were documented. We were principally interested in\r\nhow angry and how embarrassed or humiliated participants across\r\nthese different settings would feel following insults or ostracism by\r\ningroup or outgroup members, and whether they would be\r\nmotivated to retaliate or would prefer to withdraw or to restore\r\nrelationships instead."
                }
              }
            ]
          },

{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, Getuigenissen van Nederlandse vrouwen die een relatie hadden met een Duitse man, interview 10"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:41861"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Cogis"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Kennisinstituut voor de sociale en psychische gevolgen van oorlog, vervolging en geweld"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"C.F.  Huitema"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Arq Kenniscentrum Oorlog, Vervolging en Geweld"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Mevrouw groeide op in Enschede. Zij werkte voor de Duitsers op het vliegveld Twente, wat was omgebouwd tot een zogenaamde Fliegerhorst. Zij leerde daar een Duitse man kennen. Tot een huwelijk kwam het niet, omdat mevrouw niet in Duitsland wilde wonen. De relatie werd verbroken. Een jaar later had zij een relatie met een andere Duitser. Na de oorlog werd zij kaalgeschoren.Mevrouw trouwde met een Nederlander en kreeg kinderen. Na het overlijden van haar man is ze naar haar eerste oorlogsliefde op zoek gegaan. Ze heeft hem echter niet teruggevonden.\n\nToegang tot de files wordt verleend op voorwaarde dat de gegevens alleen voor wetenschappelijk onderzoek worden gebruikt. De methodologische kwaliteit moet voldoende zijn en de anonimiteit van de proefpersonen moet gegarandeerd zijn."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"textielindustrie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"piloten"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"nachtjagers"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"motorordonnans"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"seksuele collaboratie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"moffenmeiden"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"voorbehoedsmiddelen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Dolle Dinsdag"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Wehrmachtsheim"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Duitse militairen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"officieren"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Volkspark Jensen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"illegaliteit"}},{"keywordValue":{"typeName":"keywordValue","multiple":f
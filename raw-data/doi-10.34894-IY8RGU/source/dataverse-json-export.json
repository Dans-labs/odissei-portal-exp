            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeoologisch onderzoek langs de Perreveld in Droeshout (B) werden de resten van twee waterputten aangetroffen. Van één waterput zjn drie monsters van planken en een paal aangeleverd voor dendrochronologisch onderzoek. Een fragment van de andere waterput bleek niet geschikt voor onderzoek. In alle gevallen ging het om eik (Quercus spp.).\nVan de drie onderzochte monsters kunnen er twee gedateerd worden aan het eind van de 1e eeuw (78 en 97 na Chr.). Spinthout of de wankant ontbreekt dus kan er geen afgebakend kapinterval bepaald worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-08-13"
                }
              }
            ]

{"license":"CC-BY-4.0","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, Vier verzetsvrouwen: Gewoon Doen en Fier Rechtopstaan, interview 04"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:41098"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Cultuur & Co."}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"a.j  stam"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"cultuur & co"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"<p>Geert van der Molen (1919-2008) is een schippersdochter uit Groningen, gereformeerd opgevoed en in haar jeugd communistisch geworden.<\/p><p>Zij is direct na de Februaristaking gearresteerd, gevangen gezet in het Oranjehotel, Schoorl en Ravensbrück, tijdens de oorlog vrijgelaten uit Ravensbrück, opnieuw in verzet gegaan en opnieuw gearresteerd.<br><br>Geerts oudste broer Evert is geïnterviewde 5 binnen dit project.<\/p>"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Verzet"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Communisme"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Nederlands Gereformeerd"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"gevangenissen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"kamp"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Canadees leger"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Schipperskind"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"de heer Buiten van Rottterdamsche Bank"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Ganzevoortsingel Groningen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Februaristaking"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"typen Noorderlicht"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Jo Sprietsma"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Nel Bollen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Gereformeerden"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Schip Walrus"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Jan Haak"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Esperantisme"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Orli Reichert"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Scholtenhuis"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Oranjehotel"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"gevangenis Amstelveenseweg - Huis van Bewaring II Amsterdam"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"gevangenis Weteringschans - Huis van Bewaring I Amsterdam"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Kamp Schoorl"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Ravensbrück"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"joodse vrouwen en zigeunervrouwen in Ravensbrück"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"groene en rode gevangenen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Rie Lips-Odinot"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Die Moorsoldaten"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Wolfgang Langhoff"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Dolle Dinsdag"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"gezonken schepen op de Maas"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"dwangarbeid"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"met 135 verzetsvrouwen in Westerbork tegen het eind van de oorlog"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Grijpskerk"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Zuidhorn"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Canadese bevrijders"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Ger Harmsen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"oral history"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}}]},{"typeName":"notesText","multiple":false,"typeClass":"primitive","value":"Er is een minimale edit gedaan door PEPfilm, Pepijn Kortbeek in Amsterdam. Het quicktime bestand bevat nog alle knipjes.  Een copie van dit bestand zal ook bij Aletta, Instituut voor Vrouwengeschiedenis worden gedeponeerd.              \n                \nGeert van der Molen is enkele maanden na het interview overleden. Op verzoek van Geerts dochter hebben we de afscheidsbijeenkomst van Geert van der Molen op 31 december 2008 gefilmd. De mpg file hiervan is ingekort en toegevoegd. De herdenkingstoespraak van een kameraad verzetsman staat er helemaal op. Deze toespraak is echter niet uitgetypt.\n\nBertien Minco (interviewer)  Cultuur & Co\nDineke Stam (filmcamera en interviewer) Cultuur & Co"},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch","German"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2008-09-22"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"B. Minco (Cultuur & Co.)"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"A.J. Stam (Cultuur & Co.)"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"P. Kortbeek (PEPfilm)"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2009-10-12"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2008-09-22"},{"typeName":"dataSources","multiple":true,"typeClass":"primitive","value":["foto1 Geert van der Molen Paspoortfoto uit ongeveer 1943, foto2 is een copie van het artikel uit Sporen van de Oorlog over het Noorderlicht, de reden dat zij werd gearresteerd. Foto 3 is een tekening van Geert van der Molen, getekend door Paula Bakker rond 2000   \n   \nNPS 1998, 'Levensverhalen', afl. Geert van der Molen. Een programma gemaakt door: Francois de Waal, Jim van der Hoeven. Een kopie is aanwezig bij Aletta, Instituut voor Vrouwengeschiedenis (IAV Amsterdam)               \n                \nAnne Frank Stichting, Sporen van de oorlog. Ooggetuigen over plaatsen in Nederland, 1940-1945, pagina 21 Groningen. ISBN 90 12 06311 6  Een kopie van het artikel is ge-upload.           \n           \nAlbert Boer, Het Kamp Schoorl (Schoorl, 1991) bevat 2 foto's waar Geert op staat (nrs 33 en 34)"]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Dineke Stam","Bertien Minco"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D34300"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D34300","termName":[{"lang":"nl","value":"Moderne en contemporaine geschiedenis"},{"lang":"en","value":"Modern and contemporary history"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]},{"typeName":"dansCollection","multiple":true,"typeClass":"primitive","value":["https:\/\/vocabularies.dans.knaw.nl\/collections\/ssh\/ce21b6fb-4283-4194-9369-b3ff4c3d76e7","https:\/\/vocabular
{"license":"CC0-1.0","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Nederlandse oud-gevangenen van kamp Buchenwald,  interview 26,  Gert Nales"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:60697"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"NIOD Instituut voor Oorlogs-, Holocaust- en Genocidestudies"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"NIOD  Onderzoeksdata"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"NIOD Instituut voor Oorlogs-, Holocaust- en Genocidestudies"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"De heer Gert Nales vertelt dat hij de oudste politieke gevangene van Nederland is. Hij werd al in augustus 1940 opgepakt vanwege deelname aan het Geuzenverzet. Zijn verzetsactiviteiten bestonden uit Duitsers verkeerd de weg wijzen, doorknippen van telefoonkabels en maken van tekeningen, onder andere voor de eerste Geuzenkrant.Na een verblijf in de gevangenis van Scheveningen werd hij april 1941 op transport gesteld naar Buchenwald. Via contacten in het kamp kwam hij in redelijke arbeidscommando's terecht.Na een jaar werd hij getransporteerd naar Natzweiler. Daar was het een hel. Er was nog niets gebouwd en de omstandigheden en arbeidscommando's waren er veel zwaarder. Uiteindelijk lukte het hem ook daar om in een goed commando terecht te komen. Door klachten aan zijn knie werd hij opgenomen in het Revier. Daarna ging hij in het ziekenhuis werken als verpleger en later als Kapo van de ordedienst. Hij was er onder andere getuige van de medische proeven op gevangenen.Toen de Amerikanen naderden, werden de gevangenen op transport gesteld naar Dachau. Vanwege zijn goede verdiensten in het Revier in Natzweiler, werd hij in Dachau als verpleger in de tbc-barak geplaatst.Vervolgens ging hij met een arts naar München, waar onder de Hollandse vrouwen die voor Agfa werkten, tyfus was uitgebroken. Nales werd gevraagd voor hen een geïsoleerde ruimte te creëren, waar ze konden worden verpleegd. Op verzoek van de Amerikanen is Nales na de bevrijding nog gebleven om te helpen totdat de laatste Nederlander naar huis was gegaan.Na de oorlog werd hij door Oorlogsdocumentatie (nu: NIOD) benaderd om zijn ervaringen vast te laten leggen. Er nam ook een Amerikaanse generaal contact met hem op en daardoor is hij kroongetuige geweest bij het Neurenberger proces."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date Submitted: 2015-03-02"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Buchenwald (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Second World War (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Concentratiekampen (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Concentration camps (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Herinneringen (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Memories (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Gevangenen (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Prisoners (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Overlevenden (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Survivors (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Oral history (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Verzet (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Resistance (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"De Geuzen (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Oranjehotel (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Gevangenissen (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Prisons (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Dachau (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Natzweiler (NIOD)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Gert Nales (1915-2009)"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionD
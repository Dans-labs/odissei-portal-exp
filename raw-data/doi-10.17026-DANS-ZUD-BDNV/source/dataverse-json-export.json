            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>AStri (AStri Beleidsonderzoek en -advies) en APE (Aarts De Jong Wilms Goudriaan Public Economics bv) hebben gezamenlijk bij UWV een voorstel ingediend om onderzoek te doen naar de groei van WIA-aanvragen. Dit voorstel komt neer op een replicatie van het eerdere “Weg naar de WIA” project uit 2007, dat wil zeggen dat een cohort vaste werknemers en een cohort vangnetters die minstens negen maanden ziek gemeld zijn gevolgd worden tot en met eventuele WIA-toetreding. Dit voorstel is aangenomen en uitgevoerd onder de naam \"Weg naar de WIA 2\". De cohorten werden in het najaar van 2012 aangeschreven en een tweede maal in de zomer van 2013. Door vergelijking van deze nieuwe cohorten met die uit 2007 kunnen effecten van een verslechterde conjunctuur en van een toegenomen aantal tijdelijke contracten onderzocht worden.</p>"
                }
              }
            ]

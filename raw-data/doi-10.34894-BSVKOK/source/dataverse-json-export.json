              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset includes the manipulation (Rumination Induction) procedure, answers to a Rumination Inventory, responses to the Thinking Component of the Dundee Stress State Questionnaire (which assesses Mind Wandering), eye tracking, and pitch and lexical data recorded during a word association task. There are both word files, and SPSS data syntax and output files."
                }
              }
            ]
          },

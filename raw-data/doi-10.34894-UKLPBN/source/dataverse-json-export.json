            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Op het perceel van de M. Nijhoffweg 3-5 is archeologisch onderzoek uitgevoerd. Hierbij is een aantal houten vondsten aangetroffen die zijn aangeleverd voor dendrochronologisch onderzoek. Hierbij gaat het om twee grenen (Pinus sylvestris L.) planken en twee eiken (Quercus sp.) duigen. Aanvullende informatie over de context is niet verstrekt.\nAlle monsters bleken geschikt voor onderzoek.\nHet onderzoek levert alleen voor de duigen resultaat op. De dateringen vallen in de 13e eeuw en aan het eind 16e eeuw. Spinthout of wankant zijn niet aanwezig, dus kan alleen de ondergrens van het kapinterval bepaald worden."
                },
                "dsDescriptionDate": {

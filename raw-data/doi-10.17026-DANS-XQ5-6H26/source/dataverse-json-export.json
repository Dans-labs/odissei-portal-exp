                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Interview with Wijo Koek about his artwork Meanwhile from 1983. The artwork is part of a series of 12 artworks made by 12 different artists for a travelling exhibition called Grenzeloze Inhoud. In this interview the meaning, the current condition and the desired state of the artwork are discussed.</p>"
                }
              }

            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains pseudonymised interview transcripts between data author Penders with the other data authors (as interviewer and interviewee, respectively). The data description file discloses which authors are the authors of which of the data files. All data authors agreed to disclose their identity as interviewer and interviewees, respectively.\n\nThe seven interview transcripts that are available here are part of a larger dataset of thirteen interviews. For the remaining six, the interviewees did not provide permission for sharing. They are stored on Maastricht University servers and are not available for sharing."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-03-15"
                }
              }
            ]
          },

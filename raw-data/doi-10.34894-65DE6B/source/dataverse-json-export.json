            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Van het archeologisch ondezoek ter plaatse van het Hof van Rijnsburg in Nootdorp is een aantal houten vondsten aangeleverd. Het gaat hier om een paaltje en drie duigen van twee tonputten. In alle gevallen is eik (Quercus spp.) gebruikt. Alleen de twee duigen van spoornr. 457 komen in aanmerking voor dendrochronologisch onderzoek en beiden kunnen gedateerd worden.\nOp vondstnr. 631.1 is een klein restje spinthout aanwezig en hoewel dit te samengedrukt is om te kunnen meten is de aanwezigheid voldoende om een kapinterval te schatten. Dit valt rond 1373.\nDe datering voor vondstnr. 630.1 in 1310 zonder spinthout lijkt hier bij te passen."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This data set contains the script used for calculating crop suitability in the paper \"Climate change impacts on tree crop suitability in Southeast Asia\" (https://doi.org/10.1007/s10113-023-02111-5). The script replicate the EcoCrop model and is written to run in R, specifically for climate data for Southeast Asia to calculate crop suitability for coconut, oil palm, and rubber. See further specifications on methodology in the R-script and the published paper.\nFurther a series of output files for the script is included, showing the crop suitability for coconut, oil palm, and rubber in 30 arcseconds resolution for Southeast Asia. The files include historical suitability (1981-2010) and average modelled future suitability in 2041-2070 for SSP1-2.6 and SSP5-8.5, based on data from five General Circulation Models (GFDL-ESM4, IPSL-CM6A-LR, MPI-ESM1-2-HR, MRI-ESM2-0, and UKESM1-0-LL) for CMIP6 from the Climatologies at High resolution for the Earth’s Land Surface Areas (CHELSA) v2 database."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-07-17"
                }
              }
            ]

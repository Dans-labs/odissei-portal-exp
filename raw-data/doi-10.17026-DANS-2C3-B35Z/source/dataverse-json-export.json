            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Nederlands databestand van het PIAAC-project: internationaal OECD-onderzoek naar kennis en vaardigheden (taalvaardigheid, rekenvaardigheid en probleemoplossend vermogen in digitale omgevingen) van volwassenen (16-65 jaar). Het onderzoek bestaat uit een combinatie van een survey en een cognitieve test en is in 2012 uitgevoerd in 24 landen.</p>"
                }
              }
            ]

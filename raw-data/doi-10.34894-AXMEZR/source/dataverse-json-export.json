            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset is part of the project called “Towards reporting guidelines of\r\nresearch using whole-body vibration in human subjects – A Delphi consensus\r\nstudy”. Whole-body vibration (WBV) utilizes vibrating platforms to expose\r\nindividuals to mechanical vibration. In order to improve the quality of\r\nreporting and increase comparability of studies in this field, reporting\r\nguidelines are aimed to be established. To this end the Delphi methodology\r\nwas employed. The integrated knowledge of WBV experts was collected to\r\ndistil the specific aspects of WBV methodology that should be included in\r\nsuch guidelines. Over three rounds of completing online questionnaires, the\r\nexpert panel rated candidate items. All three rounds of this questionnaire\r\ncan be found in this dataset. On the basis of this study the executive\r\ngroup will establish reporting guidelines."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2020"
                }
              }
            ]

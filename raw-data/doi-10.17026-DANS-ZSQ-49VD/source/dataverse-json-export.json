            "typeClass": "compound",
            "value": [
              {
                "keywordValue": {
                  "typeName": "keywordValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Militaire patrouiles naar infiltranten eind 50ger jaren"
                }
              }
            ]
          },

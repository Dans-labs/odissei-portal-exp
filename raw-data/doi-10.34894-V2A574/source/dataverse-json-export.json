              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij een duikinspectie in het IJsselmeer nabij Enkhuizen is een scheepswrak aangetroffen.\nOm te bepalen of verder onderzoek noodzakelijk is zijn twee monsters genomen voor dendrochronologisch onderzoek. Een monster van een huidplank (M01) bevatte voldoende jaarringen. De meetreeks leverde echter geen betrouwbare resultaten op.\nAanvulende monsters kunnen eventueel meer inzicht verschaffen."
                },

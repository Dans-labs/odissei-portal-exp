                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Data, ethical approval and experimental video game. Empathy and immersion toward virtual animal characters. The main research questions addressed in the experimental design are as follows: \r\n(1) Does game character appearance (Artificiality and Expressiveness) influence the level of self-reported situational empathy?\r\n(2) Does game character appearance (features pertaining to Artificiality and Expressiveness) influence the level of immersion? (3) Does dispositional, self-reported situational empathy correlate with immersion?"
                }
              }
            ]

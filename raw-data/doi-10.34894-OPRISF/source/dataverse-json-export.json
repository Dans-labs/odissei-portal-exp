            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij de inrichting van het natuurgebied “Over de Maas” is een aantal scheepswrakken aangetroffen. Van het wrak ODM12 zijn zes monsters genomen en aangeleverd voor dendrochronologisch onderzoek. In alle gevallen gaat het om eik (Quercus sp.).\nUit vier metingen kan een middelcurve (26.043.M01) samengesteld worden die in 1437 gedateerd kan worden. Op de gedateerd monsters is geen spinthout aanwezig, dus kan alleen de ondergrens van het kapinterval bepaald worden.\nVoor de overige monsters kunnen geen goede resultaten gevonden worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The data repository contains three datasets, a read me file and a data dictionary. \n\nThe three datasets are named:\n•\tRHI biomarkers extracted data natural exposure.csv\n•\tRHI biomarkers extracted data experimental exposure.csv\n•\tRHI biomarkers extracted data experimental exposure controlled studies.csv\n\nThe read me file is named: \n•\tReadme extracted data RHI biomarkers.docx\n\nThe data dictionary is named: \n•\tData dictionary RHI biomarkers.csv\n\nNatural exposure extracted data\nThe extracted data for all included studies on natural exposure to repetitive head impacts can be found in “RHI biomarkers extracted data natural exposure.csv”. \n\nExperimental exposure extracted data\nThe extracted data for all included studies for the analysis of a pre- post change in fluid biomarker concentration after exposure to football heading can be found in “RHI biomarkers extracted data experimental exposure.csv”. For the analysis of the difference in pre- post change in fluid biomarker concentration after exposure to football heading between a heading group and a control group, the extracted data can be found in “RHI biomarkers extracted data experimental exposure controlled.csv”. The header ‘EXPERIMENTAL’ refers to the data of the experimental (heading) group, and the header ‘CONTROL’ refers to the data of the control group."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "17-7-26"
                }
              }

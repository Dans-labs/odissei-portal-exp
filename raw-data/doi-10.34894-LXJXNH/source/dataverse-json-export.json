            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek op de borgstee Nittersum te Stedum zijn houten resten van een niet nader omschreven constructie aangetroffen. Hieruit zijn monsters genomen en aangeleverd voor dendrochronologisch onderzoek. In alle gevallen ging het om eik (Quercus sp.). Eén hiervan bleek geschikt te zijn voor onderzoek. De overige beschikten niet over voldoende jaarringen.\nHet onderzoek leverde consistente, maar zwakke resultaten op voor een positie in 1509. \nAanvullend onderzoek door P. Borghaerts kon deze datering echter bevestigen. \nSpinthout of de wankant ontbreekt echter, waardoor geen afgebakend kapinterval bepaald kan worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This scoping study was produced as part of the project “Whole of Society Conflict Prevention and Peacebuilding”, which aims to enhance the EU’s peacebuilding and conflict prevention capabilities. This paper is part of the first series of orientation papers that were intended to indicate lines of inquiry and propose research questions, as a basis for discussion and input for the project's Theoretical and Methodological Framework. They seek to provide an overview of scholarly knowledge about the EU’s capabilities and means for conflict prevention and peacebuilding in relation to several cross-cutting themes and clusters that the project focuses on. More information at www.woscap.eu"
                }
              }

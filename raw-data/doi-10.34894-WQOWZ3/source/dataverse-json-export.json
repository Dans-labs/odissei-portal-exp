            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Koolstraat te Berlare (B) is door All-Archeo een waterput aangetroffen. Deze stamt vermoedelijk uit de middeleeuwen. Om de ouderdom te achterhalen zijn 9 planken bemonsterd voor dendrochronologisch onderzoek.\nHierbij gaat het in alle gevallen om eik (Quercus sp.). 4 monsters konden aangemerkt worden voor onderzoek. Uit 3 monsters kon een middelcurve samengesteld worden (22.027.M01) die aan het eind van de 11e eeuw gedateerd kon worden. Spinthout is niet aanwezig op de monsters, dus een afgebakend kapinterval kan niet bepaald worden, maar vermoedelijk is het hout in het eerste kwart van de 12e eeuw gekapt."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2022-07-06"
                }
              }
            ]

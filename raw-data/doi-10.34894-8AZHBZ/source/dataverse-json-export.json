            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter hoogte van de Harmenjansweg 4 in Haarlem is een bodem van een ton aangetroffen. Omdat op de planken merktekens aanwezig zijn is de bodem aangemerkt voor conservering en kon daarom niet destructief bemonsterd worden. De bodem bestaat uit drie grenen (Pinus sylvestris L.) delen waarbij de buitenste twee voldoende jaarringen voor dendrochronologisch onderzoek bevatten. Deze delen zijn ingemeten langs de buitenzijde.\nVan één van de delen kan de laatste jaarring in 1888 gedateerd worden. De wankant ontbreekt uiteraard, dus is het hout ergens na 1888 gekapt."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-10-29"
                }
              }
            ]

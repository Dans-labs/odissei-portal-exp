            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Door Archeologie West-Friesland is een aantal monsters van het archeologisch onderzoek aan de Dorpsstraat 318 te Zwaag aangeleverd voor dendrochronologisch onderzoek. Hierbij gaat het om eiken (Quercus sp.) duigen en grenen (Pinus sylvestris L.) planken. Daarnaast is een plank voor enkel houtanatomisch onderzoek aangeleverd. Hier bleek het ook om grenen te gaan.\nDe twee onderzochte duigen lijken op basis van de sterke onderlinge gelijkenis uit dezelfde boom afkomstig te zijn. Hiervoor is de middelcurve 22.072.B01 gemaakt. Deze kan gedateerd worden in 1504. Beide grenen planken kunnen eveneens onderling gedateerd worden, maar noch de metingen, noch de middelcurve die hieruit samengesteld kan worden (22.072.M01) laat goede resultaten zien."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-01-19"
                }
              }
            ]

            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek aan de Scheepsdalelaan in Brugge zijn drie tonputten aangetroffen. Per tonput is één duig aangeleverd voor dendrochronologisch onderzoek. Het gaat hier in alle gevallen om eik (Quercus sp.). Eén duig (uit spoornr. 39) bevat te weinig jaarringen. Van de twee onderzochte duigen kan de duig uit spoornr. 44 niet gedateerd worden, terwijl de duig uit spoornr 54 in 1312 gedateerd kan worden. Zoals gebruikelijk is er geen spinthout of wankant aanwezig, waardoor alleen de ondergrens van het kapinterval bepaald kan worden. Dit interval valt na 1321."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Archol BV voerde archeologisch onderzoek uit op het plangebied “Huysakkers” nabij Veldhoven. Hierbij is een aantal planken van enkele waterputten geborgen en aangeboden voor onderzoek. Bij eerder onderzoek van deze locatie zijn structuren uit de IJzertijd, Romeinse periode en de Vroege en Volle Middeleeuwen aangetroffen. Voor het hier beschreven onderzoek konden 8 monsters aangemerkt worden. Hierbij ging het in alle gevallen om eik (Quercus sp.).\nVoor één van de waterputten kan een middelcurve gemaakt worden (22.012.M01), maar hiervoor kon geen datering gevonden worden. De beschikbare datering zijn afkomstig van individuele monsters en hiermee kan voor 3 van de 4 waterputten een datering gevonden worden. Deze vallen in de IJzertijd en de Volle Middeleeuwen."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2022-08-03"
                }
              }
            ]

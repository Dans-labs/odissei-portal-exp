            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Although formal guidelines require supervisors to engage in direct observations, research demonstrates that trainees are infrequently observed. We conducted an exploratory quantitative study, using the Theory of Planned Behaviour (TPB) as our theoretical framework. The relationships between the TPB measures of our questionnaire were explored by computing bivariate correlations using Pearson’s R tests. Hierarchical regression analysis was performed in order to assess the impact of the respective TPB measures as predictors on the intention to perform direct observations. Our study suggests that supervisors use their past experiences to form intentions to perform direct observations in a careful, thoughtful manner and, in doing so, also take the preferences of the learner and other stakeholders potentially engaged in direct observations into consideration.\nThe files  datafocusgroup 1 and 2 TPB study LPJWMdejonge.docx contain the transcripts of focusgroup 1 and 2. \nThe file data TPBstudy LPJWM de Jonge.pdf contains the raw output of our questionnaire-data as composed by SPSS."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

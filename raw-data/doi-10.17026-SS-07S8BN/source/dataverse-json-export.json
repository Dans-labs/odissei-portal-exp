            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bevat de codeboeken behorende bij vier substudies van het PET@home project. \nDe codeboeken horen bij een systematische review, en drie kwalitatieve studies. Het doel van het project was om de rol van huisdieren voor langdurige thuiszorgcliënten inzichtelijk te maken, inzicht te krijgen in uitdagingen en ondersteuningsbehoeften bij cliënten, mantelzorgers, en zorgprofessionals. Wat heeft geleid tot de ontwikkeling van een toolkit om ondersteuning te bieden rondom huisdiergerelateerde kwesties in de thuiszorg."
                }
              }
            ]
          },

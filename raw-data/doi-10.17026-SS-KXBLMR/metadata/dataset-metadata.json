{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Werkonderzoek 2024"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Centraal Bureau voor de Statistiek, C.B.S."},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Centraal Bureau voor de Statistiek"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"J. Strieker"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Ministerie BZK"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Het Werkonderzoek 2024 betreft een enquêteonderzoek onder medewerkers in de publieke sector. Het onderzoek is een coproductie van het ministerie van Binnenlandse Zaken en Koninkrijksrelaties (BZK) en het Centraal Bureau voor de Statistiek (CBS).\n\nDe belangrijkste resultaten van het onderzoek worden opgenomen in het Kernrapport Werkonderzoek 2024. Dit rapport zal in juni\/juli 2025 worden gepubliceerd op: www.werkonderzoek.nl\n\nDit microdatabestand is samengesteld voor DANS in opdracht van het Ministerie van Binnenlandse Zaken en Koninkrijksrelaties (BZK).\nDeze documentatie geeft een beschrijving van de variabelen die zijn opgenomen in het microdatabestand dat via DANS beschikbaar is gesteld.\nDit DANS Werkonderzoek 2024 bestand wijkt (op onderdelen) af van het microdatabestand dat onder bepaalde voorwaarden voor statistisch en wetenschappelijk onderzoek toegankelijk is in de beveiligde microdata omgeving van het CBS. Voor nadere informatie microdata@cbs.nl.\n\nBij deze documentatie zijn de volgende bijlagen beschikbaar:\n• Dans_Werkonderzoek2024variabelenwaarden;\n• DANS_Werkonderzoek2024MU_argus;\n• Werkonderzoek2024Routingschemas;\n• Werkonderzoek2024Vraagteksten;"},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2025-03-10"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Business and Management","Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Arbeidstevredenheid"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Arbeidsmobiliteit"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"Organisatiecultuur"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Organisatieprestaties"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Employability"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Inzetbaarheid"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Sociale veiligheid"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Integriteit"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Leiderschap"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"CBS BMB"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"
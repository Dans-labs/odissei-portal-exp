                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Van het archeologisch onderzoek ter plaatse van de Paardenbrugstraat in Tienen is een monster van een eiken (Quercus sp.) plank aangeleverd voor dendrochronologisch onderzoek.\nOver de context van de plank is geen informatie verstrekt.\nDe laatste jaarring dateert in 1512. Het geschatte kapjaar komt daarmee rond 1532 te liggen."
                },

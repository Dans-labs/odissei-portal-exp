                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>This is an addition to the research within police registrations in other districts. The aim was to obtain insight in experiences with and views on the treatment of notifications of incidents of family violence. Also attention is paid to views of police officers on their own tasks performance in this type of crime.</p>"
                }
              },
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Data available in consultation with NSCR. Please contact the datamanager [datamanagement@nscr.nl]</p>"

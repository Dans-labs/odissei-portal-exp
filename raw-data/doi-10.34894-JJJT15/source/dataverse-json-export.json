          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij een archeologische begeleiding ter plaatste van de de Slotstraat 3 in ’s Heer Arendskerke is een mestvaalt met een vermoedelijke datering rond 1900 aangetroffen. Voor de mestvaalt is een aantal naaldhouten palen en planken gebruikt. Uit houtanatomisch onderzoek blijkt dat moerasden (Pinus palustris Mill.) is; een soort die afkomstig is uit het zuisoosten van de Verenigde Staten. Daarnaast is een hergebruikte eiken (Quercus sp.) paal en een iepen (Ulmus sp.) paal aangetroffen.\nUit twaalf palen van moerasden zijn monsters genomen voor dendrochronologisch onderzoek. Uit onderlinge synchronisatie volgt dat deze allemaal uit drie bomen afkomstig zijn. Hiervoor zijn boom-middelcurven samengesteld waarvoor de dateringen tussen het einde van de 18e en 19e eeuw vallen, in lijn met de verwachte datering rond 1900.\nDrie onderzochte planken van moerasden dateren rond het eind van de 18e en het begin van de 19e eeuw. Het verschil in datering met de palen ligt vermoedelijk aan de bewerkingswijze van het hout waarbij meer materiaal verwijderd is.\nDe hergebruikte eiken paal dateer in 1782. Het spinthout ontbreekt hier, waardoor alleen bepaald kan worden dat het ergens na 1791 gekapt is."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-05-12"
                }
              }
            ]

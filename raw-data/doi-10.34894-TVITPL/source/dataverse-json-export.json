            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "* Nienke Kerver and Elise Karssies contributed equally to the publication associated with this dataset.\n<br> <br>\nCSV/Excel-file with survey results from people with upper limb absence (N=242) in the Netherlands. In the survey participants were asked to complete the EQ-5D-5L, the patient-reported outcome measure to assess the preferred usage features of upper limb prosthesis (PUF-ULP), and a cost questionnaire (societal perspective). Due to the small group of people with ULA in the Netherlands, we do not provide any personal details in this dataset. The dataset only contains data from the participants that were included in the analyses. A codebook to interpret the data was added as a PDF file."
                }
              }
            ]

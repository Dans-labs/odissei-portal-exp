            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Supporting material, containing codes and code groups, which led to initial themes in qualitative data analysis. Illustration of qualitative data analysis. Based on interviews before and after project participation and online meetings with participating teachers. Procedure qualitative data analysis: Online group meetings with piano teachers and interviews were recorded and transcribed in Teams. The interview transcriptions were checked and corrected in Atlas.ti. Online group meetings were summarized in short memos. Statements from group meetings that seemed important for the study were transcribed verbatim in Atlas.ti. We did not use the AI option for analysis in Atlas.ti. Data were analysed using Thematic Analysis as described by Braun & Clarke (2012)."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

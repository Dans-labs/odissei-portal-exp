            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset was produced for doctoral research about the practice of Eucharistic hospitality in ecumenical monastic communities. It contains in-depth biographic interviews with members of the communities of Taizé (Burgundy, France) and Bose (Piedmont, Italy) focusing on their experiences with the practice and the (theological) meaning they attribute to it. The interviews (conducted in 2017) were analysed in order to articulate theological implications of the practice for the debate on this issue within Catholic theology."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2022-05-27"
                }
              }

            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "De afdeling ruimte en erfgoed van de gemeente Breda leverde een boomstamput aan voor dendrochronologisch onderzoek. De boomstamput – aangeduid als waterput 64 – is bij archeologisch onderzoek in 1995 aangetroffen ter plaatse de Emerakker, naast het huidige Rath Verleghstadion. De boomstamput maakte deel uit van Merovingische bewoningssporen die zijn aantroffen. Een nabijgelegen boomstamput (waterput 63) werd dendrochronologisch gedateerd tussen 682 en 690.\nOndanks de lange tijd die is verstreken tussen berging en onderzoek is de boomstamput is goede conditie. Er zijn voldoende jaarringen aanwezig en het spinthout is intact bewaard gebleven.\nDe boomstamput is gekapt in de herfst of winter van 696/97 na Chr."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2022-10-12"
                }
              }

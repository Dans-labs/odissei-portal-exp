          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The dataset (anonymized) contains outcomes of several patient reported outcome measures (PROMs) completed by inpatients and outpatients of 14 rehabilitation institutions in the Netherlands at three time points: start of rehabilitation treatment (T0), six months later (T1), and two weeks after T1 (T2). Participants were included if they were at least 18 years old , scheduled for multidisciplinary rehabilitation treatment for at least four weeks, and were diagnosed with the following diagnosis: acquired brain injury, spinal cord injury, chronic pain, neurological disorder and oncology. The PROMs assessed the following outcomes: quality of life, participation, physical function, self regulation, mental well being, fatigue, and pain"
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-07-23"
                }
              }

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter hoogte van Kamershoek 3 in Zele (B) zijn de resten van een waterput aangetroffen. Uit de bekisting van de put zijn drie monsters genomen en aangeleverd voor onderzoek; twee planken en een balk of paal. In alle gevallen gaat het om eik (Quercus spp.). Beide planken zijn afkomstig uit dezelfde boom, maar hebben verschillende spoornummers. Hiervoor is de boom-middelcurve 25.053.B01 gemaakt. Deze kan gedateerd worden in 112, maar spinthout of de wankant is niet bewaard gebleven.\nDe balk kan gedateerd worden in 159. Hier lijkt de spinthoutgrens aanwezig, waarmee het kapjaar ond 179 komt te liggen."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

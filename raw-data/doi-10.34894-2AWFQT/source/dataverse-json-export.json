            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij de inrichting van het natuurgebied “Over de Maas” is een grote hoeveelheid archeologisch vondstmateriaal aangetroffen. Eén van deze vondsten bleek een 4e eeuwse Romeinse brugpijler. Een vergelijkbare, nabije vondst deed vermoeden dat deze tweede paal een vergelijkbare functie en ouderdom had.\nOp de ouderdom hiervan te bepalen is een dwarsdoorsnede aangeleverd voor dendrochronologisch onderzoek. Hieruit volgt een datering van de buitenste jaarring in 1527. Dit lijkt te corresponderen met de spinthoutgrens waarmee een kapjaar rond 1548 geschat kan worden. Een Romeinse ouderdom kan hiermee uitgesloten worden en daarmee rijst ook de vraag of het hier om een brugpijler gaat."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-10-20"
                }
              }
            ]

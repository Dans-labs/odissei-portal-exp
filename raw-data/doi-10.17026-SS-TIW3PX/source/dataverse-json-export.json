          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Interviews in het kader van onderzoek naar de doorwerking van de herinneringen aan de Holocaust in de Tweede Wereldoorlog in drie generaties. De titel van het onderzoek is \"Oorlog en vrijheid in drie generaties: Herinneringen aan de Holocaust in Joodse families.\" Voor dit onderzoek zijn drie generaties van zes families geïnterviewd: zes Joodse Holocaustoverlevenden (66-76 jaar), die in 1995 en 1996 meededen aan het Survivors of the Shoah project; zes kinderen (56-82 jaar) en zes kleinkinderen (22-54 jaar). De interviews gingen over herinneringen aan de periode van Jodenvervolging in de Tweede Wereldoorlog, over de bevrijding en terugkeer naar Nederland en de opvang hierna, de ervaren invloed op het lichamelijk en psychisch welbevinden, relaties, identiteit, vrijheidsbeleving en perspectieven op herdenken en collectieve herinneringspraktijken. Het onderzoek is onderdeel van een breder onderzoek genaamd 'Oorlog en vrijheid in drie generaties'. Met toestemmng van de families zijn in totaal vijf (geanonimiseerde) transcripten van de derde generatie vrijgegeven."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-01-22"
                }
              }

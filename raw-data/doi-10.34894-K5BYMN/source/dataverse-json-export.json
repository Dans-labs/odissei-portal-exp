            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset gives an overview of people appearing in the inventories of deceased people created by the Orphan Chamber of the Cape of Good Hope from 1673-1844. It consists of structured data derived from the transcriptions of the TEPC-project (Transcription of Estate Papers at the Cape of Good Hope), enriched with new datapoints. Specifically, it includes the people tagged by the TEPC-project as ‘person’: the deceased with any potential partners, and the enslaved people they owned."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",

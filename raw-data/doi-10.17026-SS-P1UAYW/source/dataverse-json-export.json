          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The interview focused on the museum’s potential decision to retain artworks or their assets. Soeluh van den Berg, head of collections at the Eye Filmmuseum, acknowledged the artwork’s deteriorated state but expressed a personal desire to preserve it if possible. He discussed the role of a collection manager in determining an artwork’s fate, emphasizing institutional policies and practical limitations. While official documents would reflect policy-based reasoning, his oral testimony revealed a more nuanced perspective, blending institutional decision-making with personal sentiments about the artwork’s value."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-01-13"
                }

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This database was produced in the context of the dissertation \"A Truth Universally Acknowledged. Dutch Investment in French Colonial Resources, 1717-1792\", as part of NWO VICI project VI.C.191.027. The database consists of 581 Dutch-based investors in French annuités viagères (life annuities or lijfrenten) in the second half of the eighteenth century. It lists metadata related to their identities and investment. A protocol is attached containing details about the archival source, the selection mechanisms, and the form of the database."
                }

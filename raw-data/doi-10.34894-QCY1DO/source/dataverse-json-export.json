            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Writing a data management plan (DMP) is becoming a standard step at the beginning of a research project. It is required by both national and international funders; it is also part of the ethics review application at ESHPM. A DMP helps you to think ahead about your data, appropriate storage solutions and access, establish continuity in case of unforeseen circumstances, make your data FAIR (Findable, Accessible, Interoperable, and Reusable), and share and archive your data after the end of the project."
                }
              }
            ]
          },

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The data are field notes and reporting files for the works of the Local Just Transition Alliances (LJTAs) within the research project BOLSTER - Bridging Organizations and marginalized communities for Local Sustainablity Transitions in EuRope.\nThe LJTAs played an advisory role for the project. They consisted of influential stakeholders, deeply involved in planning and implementation of the just transition policies. The LJTAs were organised in seven regions: Halle (DE), Silesia (PL), Istria (HR), Prahova (RO), Leon (ES), Stara Zagora (BG), Hainaut (BE) and had been meeting iteratively to feed-in various processes within BOLSTER. <br><br>\nDue to the sensitivity of the data, they are not stored in DataverseNL but in a secure location at Tilburg University. If you would like to request access to the data file(s), please use the Contact Owner button on the dataset’s landing page."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-07-30"
                }
              }
            ]
          },

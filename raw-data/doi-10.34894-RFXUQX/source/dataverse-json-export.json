            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Chronoshop is designed for circadian analysis in behavioral data. The program is capable of:\r\n\r\n-\tQuickly browse through you activity data files and view activity patterns\r\n-\tPlotting actograms in a qualitative and quantitative way\r\n-\tDirectly batch process all data files present in one folder\r\n-\tPlotting data modulo variable cycle durations\r\n-\tRunning periodograms based on Sokholove and Bushell and Lomb-Scargle algorithms\r\n-\tDetect phase markers such as Centerpoints of Gravity and on- and offset of activity\r\n-\tProject phase markers on activity data\r\n-\tPlotting behavioral data on top of meta data such as light/dark information \r\n-\tExport data series for making custom graphs with (external) plotting software\r\n-\tCalculate phase shift in activity\r\n"
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2016-01-01"
                }
              }
            ]
          },

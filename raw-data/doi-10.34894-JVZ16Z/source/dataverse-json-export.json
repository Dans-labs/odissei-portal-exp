            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This includes the cleaned data and the analyses performed for the study listed in the title. Description. The data is the result of several rounds of a League of Legends-based online experiment. The goal was to have two confederates troll one another in-game and see how this affected the a) cognitions, b) emotions, and c) behaviours of naïve bystander participants who were on their team. Specifically, we wanted to see if they would or would not report in-game trolls for poor behaviour."
                },
                "dsDescriptionDate": {

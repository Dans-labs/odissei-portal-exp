            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This study explores novice emergency medicine trainees’ experiences with uncertainty in their clinical work, seeking to understand how appraisals of comfort manifest in these moments, the origins of these appraisals, and how these appraisals impact how these clinicians move through these challenging moments in practice. We also explored the impact of supervision, and the ways in which supervision shapes trainees’ experiences with uncertainty."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2021-07-08"
                }
              }

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains all the raw and processed data related to the publication \"Giant magnetocaloric effect in a rare-earth-free layered coordination polymer at liquid hydrogen temperatures\". It contains powder and single-crystal X-ray diffraction, atomic force microscopy, transmission electron microscopy, Fourier-transform infrared spectroscopy, magnetisation versus temperature and applied magnetic field, heat capacity versus temperature and applied magnetic field, adiabatic temperature change versus applied magnetic field. \n\nThe readme.txt file contains a detailed description of the contents of the data set and explains which figures in the article the data files correspond to."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-09-13"
                }
              }

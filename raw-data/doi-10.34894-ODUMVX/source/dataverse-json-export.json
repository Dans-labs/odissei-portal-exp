            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "In these files the data are presented on a Delphi study on sex support and education for people with mild intellectual disabilities. \nThe main research question is: “What is the experts' consensus regarding the conducive conditions to successful sex support and education for people with mild intellectual disabilities?” Description of data files, supplemental material, and structure data package are available in the data report."
                }
              }
            ]
          },
          {
            "typeName": "subject",
            "multiple": true,
            "typeClass": "controlledVocabulary",
            "value": [
              "Social Sciences"
            ]
          },

                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Appendices belonging to the PhD thesis Making Messages Memorable, published in 2021. The dissertation investigates how rhetorical techniques in speeches can enhance information retention by the audience. This dataset contains supplementary data related to three parts of the study: \r\nA) Supplement to analysis public-speaking textbooks;\r\nB) Supplement to analysis public-speaking practice (scholars, politicians and TED talks);\r\nC) Supplement to experimental studies on the effects of rhetorical retention techniques.\r\nThe published dissertation contains references to the appendix numbers that are used in this dataset."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

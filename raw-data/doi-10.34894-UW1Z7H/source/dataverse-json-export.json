            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek op het plangebied Kampershoek Noord fase 7 te Weert zijn bewoningsporen aangetroffen van de IJzertijd tot de Nieuwe Tijd. Van een IJzertijd waterput zijn drie monsters aangeleverd voor dendrochronologisch onderzoek.\nIn alle gevallen gaat het om eik (Quercus sp.).\nDe monsters laten geen onderlinge gelijkenis zien en ook op individuele basis kunnen geen resultaten gevonden worden."
                },
                "dsDescriptionDate": {

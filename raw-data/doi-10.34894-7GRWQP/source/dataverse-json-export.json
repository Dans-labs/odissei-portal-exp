            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Lage Gouwe in het centrum van Gouda is een aantal boormonsters genomen van een niet nader omschreven constructie. Daarnaast is een dwarsdoorsnede van een losse vondst genomen.\nHierbij gaat het grove den (Pinus sylvestris L.), fijnspar (Picea abies Karst.) en één maal eik (Quercus sp.).\nAlleen de losse grenen vondst (vondstnr. 26) bevat voldoende jaarringen voor onderzoek.\nDe laatste jaarring hiervan dateert in 1560. De wankant is echter niet aanwezig waardoor alleen de ondergrens van het kapinterval bepaald kan worden. Gezien de zeer trage aanwas van de buitenste jaarringen correspondeert een gering materiaalverlies al snel enkele tientallen jaren. Een kapjaar ergens aan het eind van de 16e eeuw lijkt dan ook waarschijnlijker."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-10-25"
                }
              }
            ]

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Does president Trump’s use of Twitter affect financial markets? \r\nThe president frequently mentions companies in his tweets and, as such, tries to gain leverage over their behavior. We analyze the effect of president Trump’s Twitter messages that specifically mention a company name on its stock market returns. We find that tweets from the president which reveal strong negative sentiment are followed by reduced market value of the company mentioned, whereas supportive tweets do not render a significant effect. Our methodology does not allow us to conclude about the exact mechanism behind these findings and can only be used to investigate short-term effects."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2020"
                }
              }

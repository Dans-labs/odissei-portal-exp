            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter hoogte van de Vaaltweg 6 in Borne zijn twee waterputten aangetroffen. Van beide waterputten is een eiken (Quercus spp.) monster aangeleverd voor dendrochronologisch onderzoek.\nBeide monsters kunnen gedateerd worden aan het begin van 9e eeuw.\nM1 uit spoornr. 1 dateert in 825. Op basis van de aanwezigheid van de spinthoutgrens kan een kapinterval rond 845 geschat worden.\nM2 uit spoornr. 2 dateert in 814 en hiervoor kan alleen de ondergrens van het kapinterval (na 821) bepaald worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-02-25"
                }
              }
            ]

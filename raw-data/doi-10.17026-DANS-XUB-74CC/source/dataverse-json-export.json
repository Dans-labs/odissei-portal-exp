                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Ondernemen c.q. werken in Manokwari c.q. de Vogelkop"
                }
              },
              {
                "keywordValue": {
                  "typeName": "keywordValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Periode rond of na na de overdracht (1962)"
                }
              }
            ]
          },

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Deze dataset geeft een overzicht van geïdentificeerde generale missiven binnen 1.04.02, het archief van de Vereenigde Oostindische Compagnie in het Nationaal Archief. De periodisering van de dataset is 1618 tot 1793. De geïdentificeerde generale missiven zijn voorzien van gestructureerde informatie, waaronder de datum van het stuk, de locatie van het stuk in de gedigitaliseerde VOC-archieven van het Nationaal Archief, en een eventuele transcriptie van de tekst in de RGP-uitgave van de Generale Missiven."
                }
              }
            ]
          },

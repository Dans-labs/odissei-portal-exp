            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Last April 2021 ERIM ran the Open Science Survey among all ESE and RSM researchers. In this session we will focus on the top 5 concerns researchers rose in the survey about opening their data. In this panel, Thomas Peeters (ESE), Aurelie Lemmens (RSM), Robin van Vleuten (ESE, Privacy Officer), Marianne Groep-Foncke (RSM), and Armel Lefebvre (ERIM, Information Manager) will tell us how to tackle these concerns so that your data can also be shared publicly (or parts of it)."
                }
              }
            ]
          },

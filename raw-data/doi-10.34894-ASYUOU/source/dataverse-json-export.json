            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Social inclusion—the ability to belong, participate, and build meaningful connections—is often difficult for people living with schizophrenia spectrum disorder (SSD). The PhD thesis “Tracing Social Inclusion Throughout the Life-Course in Schizophrenia Spectrum Disorder” investigates the life-course of SSD to deepen the understanding of its progression, using social inclusion as a lens. Rather than a mere treatment goal, social inclusion is also an integral part of SSD development.<br>\n\nThis dataset contains the supplementary materials of the thesis, conducted at the University Medical Center Groningen, University of Groningen. The contents include: methodological appendices, supplementary tables, and figures. These materials are intended for academic use, replication, and methodological reference. Please cite the thesis and corresponding publications when using this repository.<br>\n\nFor questions regarding the files or data, please contact the author."
                }
              }
            ]
          },

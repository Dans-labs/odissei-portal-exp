                }
              }
            ]
          },
          {
            "typeName": "distributionDate",
            "multiple": false,
            "typeClass": "primitive",
            "value": "2016-05-25"
          },
          {
            "typeName": "dateOfDeposit",
            "multiple": false,
            "typeClass": "primitive",

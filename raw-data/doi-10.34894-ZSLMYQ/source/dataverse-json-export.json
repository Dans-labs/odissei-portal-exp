            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Native polysaccharides are major carbon sources for microbes, fully degraded and recycled in ecosystems. Aeromonas species, found even in nutrient-poor drinking water systems, can break down chitin and possibly a broader range of biopolymers. Here we studied the ability of Aeromonas to utilize various biopolymers and secreted proteins involved in their degradation."
                }
              }
            ]

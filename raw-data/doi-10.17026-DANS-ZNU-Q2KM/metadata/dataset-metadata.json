{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, Getuigenissen van Nederlandse vrouwen die een relatie hadden met een Duitse man, interview 09"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:41873"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Cogis"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Kennisinstituut voor de sociale en psychische gevolgen van oorlog, vervolging en geweld"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"C.F.  Huitema"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Arq Kenniscentrum Oorlog, Vervolging en Geweld"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Mevrouw groeide op in een welgesteld gezin in Amsterdam-Zuid. Haar vader was een fabrikant en anti-Duits. Zij leert in 1941 een Duitse piloot kennen. Ze trouwt met hem en ze krijgen een dochter. Na drie en een half jaar huwelijk stort haar man met zijn vliegtuig neer. Dit wordt haar door zijn commandant medegedeeld, die misbruik maakt van de situatie. Mevrouw trouwt later met een Nederlandse man, maar scheidt weer snel van hem. Haar dochter voedt ze alleen op. Ze blijft lang in het ouderlijk huis wonen. Mevrouw praat lange tijd niet over de oorlog, behalve met vriendinnen die hetzelfde hebben meegemaakt.\n\nToegang tot de files wordt verleend op voorwaarde dat de gegevens alleen voor wetenschappelijk onderzoek worden gebruikt. De methodologische kwaliteit moet voldoende zijn en de anonimiteit van de proefpersonen moet gegarandeerd zijn."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"fabrikantengezin"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"welgesteld"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"katholiek"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"lyceum"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"liefdadigheid"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"joden"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"onderduiken"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Duitse militairen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"piloten"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"STUKA-vlieger"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Hitler"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Aus der Fuenten"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"moffenmeiden"}},{"keywordValue":{"typeName":"keywordVa
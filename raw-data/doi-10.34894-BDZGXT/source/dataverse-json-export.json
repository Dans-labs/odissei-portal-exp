          },
          {
            "typeName": "dataSources",
            "multiple": true,
            "typeClass": "primitive",
            "value": [
              "I collected 6,059 Chinese articles and 2,250 US articles with the search term “Made in China” (MIC) between 2006 and 2018 in two ways. The articles collected through the database LexisNexis cover six Chinese English-language newspapers (i.e., CD, SCMP, GT, XH, SD, and CP) and two US newspapers (i.e., NYT and USA-T), and the articles from WSJ and WP were manually collected. Through the corpus tool LancsBox, I found 671 and 80 MIC c-collocations in Chinese and US newspapers respectively."
            ]
          }

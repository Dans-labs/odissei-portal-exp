          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This data repository contains back-scattered electron (BSE) images of 1006 micrometeorites from the Budel collection, the Netherlands, including the polished sections of 115 micrometeorites. Chemical energy-dispersive x-ray spectroscopy (EDS) data is available for a selection of the particles, along with data on classification and particle properties. Additionally, optical images show surface characteristics of weathered vitreous micrometeorites, and 161 BSE images show common anthropogenic contaminant particles frequently encountered in rooftop samples. Photographs and videos illustrate the separation methods used to extract micrometeorites from the rooftop sample. The MATLAB code can be used for micrometeorite shape analysis on BSE images. When using these data in future work, please adhere to CC license agreements and cite accordingly."
                }
              }
            ]
          },

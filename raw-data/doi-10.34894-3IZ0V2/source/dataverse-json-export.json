            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek op het perceel aan de Korteweg 2 in Oud-Beijerland is een beerput aangetroffen. Van een grenen (Pinus sylvestris L.) funderingsplank is een monster genomen voor dendrochronologisch onderzoek. Hiervan dateert de laatste jaarring in 1592. Aangezien de wankant niet aanwezig is kan alleen de ondergrens van kapinterval (1592) vastgesteld worden."
                },
                "dsDescriptionDate": {

              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This data set contains intraoperative electrocorticography (ioECoG) data from 91 patients collected during epilepsy surgery performed in the University Medical Center Utrecht, the Netherlands. It is made public as supplementary data to support the findings of the manuscript by <a href=\"https://doi.org/10.1016/j.clinph.2024.08.012\"> Hoogteijling et al. (2024) </a> entitled <i>'Machine learning for (non-)epileptic tissue detection from the intraoperative electrocorticogram'</i>, published in Clinical Neurophysiology. Please cite this article in any project using this data set. See also: <a href=\"https://github.com/UMCU-EpiLAB/umcuEpi_explainable_AI\">github.com/UMCU-EpiLAB/umcuEpi_explainable_AI</a>"
                }
              }
            ]

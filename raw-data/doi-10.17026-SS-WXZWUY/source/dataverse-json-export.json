            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "De forensische geneeskunde staat onder grote druk vanwege een groeiend tekort aan forensisch artsen. Andere zorgprofessionals, zoals basisartsen,\nverpleegkundigen specialisten of physician assistents kunnen mogelijk taken overnemen van forensisch artsen om deze zorg toegankelijk te houden,\nmaar ook hier geldt krapte op de arbeidsmarkt. Dit project brengt in kaart welke taken op welke wijze onder welke omstandigheden door wie kunnen\nworden uitgevoerd in de forensische geneeskunde, zonder in te boeten aan kwaliteit. Om de (meer)waarde van taakherschikking voor het oplossen van\nhet capaciteitsprobleem te bepalen, worden succesfactoren, belemmeringen, risico’s en effecten van taakherschikking op de huidige organisatie van de\nforensische zorg onderzocht en gewogen."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",

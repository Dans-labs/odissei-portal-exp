            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Historical demographers have designed schemas and vocabularies to standardize historical data. CLAIR-HD gathered these schemes to create an overview of the existing languages used in historical demography. The state of the field was summarised in 2024 by Mourits, Stapel, and Riswick.\n<br>\n<br>\nThis database contains <br>\n - An output table that summarise how variables are named within historical demography.<br>\n - An output table that shows the existing open access conversion tables.<br>\n - The documentation of IDS, Mosaic, and Persons in Context on which the schema table is based. See also https://www.ipums.org, https://mosaic.ipums.org/, https://www.nappdata.org/, and https://personsincontext.org/ for more information. <br>\n- The documentation of the conversion tables on which the conversion table overview is based. The related output table contains links to the relevant produce pages.\n<br>\n<br>\nPlease use the tree function for a clear overview of the files."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-10-22"
                }
              }
            ]
          },

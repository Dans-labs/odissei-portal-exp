                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Preregistrations are thought to strengthen the credibility and \ntransparency of research. This talk will review some arguments authors \nhave provided in favour of preregistering qualitative research. An \nonline Delphi study was conducted to understand what parts of \npreregistration templates researchers would find helpful. This resulted \nin an agreement-based form for the preregistration of qualitative \nstudies that consists of 13 items. The talk will close with showcasing a\n few examples of qualitative preregistrations, and by providing some \nreflections on Open Science and qualitative research."
                }
              }
            ]
          },

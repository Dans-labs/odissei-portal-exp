          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Onderzoek naar de gezondheid en het welzijn van scholieren van groep 6,7 en 8 in het basisonderwijs en scholieren in het hele voortgezet onderwijs. In 2022 is een herhaling uitgevoerd van het HBSC-onderzoek (Health Behaviour in School-aged Children) van 2021 met als belangrijkste doel een jaar na de coronapandemie cijfers over het welzijn van scholieren in Nederland te verzamelen. De vragenlijst voor groep 8 en het voortgezet onderwijs was grotendeels hetzelfde als de vragenlijst van HBSC 2021. Hiernaast is op de basisschool aanvullend onderzoek gedaan bij leerlingen van groep 6 en 7 met een aangepast korte vragenlijst.\n\nEen van de doelen van het onderzoek was om mogelijke effecten te meten van interventies van scholen gericht op het verbeteren van het welzijn van leerlingen. De middelen voor deze interventies werden beschikbaar gesteld via het Nationaal Programma Onderwijs (NPO). Om gegevens te verzamelen over de inzet en effecten van de middelen uit het NPO zijn vragenlijsten afgenomen bij de schoolleiding van de deelnemende scholen."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-03-15"
                }
              }
            ]

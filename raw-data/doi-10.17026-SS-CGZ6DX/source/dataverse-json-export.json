              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains the files for a study on the impact of a teacher professional development program on primary school teachers’ skills and self-efficacy for integrated language arts and science and technology instruction. The dataset includes data from an online questionnaire about self efficacy and data from semi-structured interviews (transcripts). Each interview was conducted after a lesson observation, but to protect the anonymity of the participants these video recordings are not included in this dataset."
                }
              }
            ]

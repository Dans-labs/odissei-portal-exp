          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Langs het tracé van een aan te leggen hoogspanningsleiding tussen Oisterwijk en Best is archeologisch onderzoek uitgevoerd. Van dit onderzoek is een aantal vondsten aangeleverd voor dendrochronologisch en houtsoortenonderzoek.\nIn totaal zijn 13 monsters aangeleverd, afkomstig van twee waterputten en een paalkuil.\nHierbij gaat het om eik (Quercus sp.) en beuk (Fagus sylvatica L.). Hiervan zijn er vier aangemerkt voor dendrochronologisch onderzoek.\nVan twee beuken planken kan bepaald worden dat deze uit dezelfde boom afkomstig zijn. Hiervoor is de middelcurve 22.034.Bo1 gemaakt. Deze kan gedateerd worden in 1038. Het eiken monster uit hetzelfde spoornummer (62) laat een vergelijkbare datering in 1019 zien.\nSpinthout of de wankant ontbreekt in beide gevallen, waardoor er geen afgebakend kapinterval geschat kan worden, maar het mag aangenomen worden dat dit ergens in de 11e eeuw ligt.\nVoor spoornr. 17 kan geen datering gevonden worden.\nDe combinatie van eiken en beuken in dezelfde structuur komt zelden voor, maar lijkt een typisch verschijnsel voor de 11e eeuw en deze resultaten passen daarbij."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-07-03"
                }
              }
            ]

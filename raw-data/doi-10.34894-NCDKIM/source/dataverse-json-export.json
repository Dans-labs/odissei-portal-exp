            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ten behoeve van de plaatsing van een aantal vuilcontainers in Enklhuizen is een klein aantal houten vondsten aangetroffen. Hierbij gaat het om bouwhout in de vorm van een grenen (Pinus sylvestris L.) paal en eiken (Quercus sp.) planken van hergebruikt scheepshout, en twee kleine paaltjes van els (Alnus glutinosa Gaertn.). Daarnaast is een natuurlijke vondst in een veenlaag aangetroffen. Dit is eveneens els.\nHet bouwhout is dendrochronologisch onderzocht. De grenen paal dateert in 1605. Het is niet duidelijk of de wankant aanwezig is, of een enkele jaarring ontbreekt, maar hoe dan ook valt het kapinterval in of kort na 1605.\nHet hergebruikte scheepshout dateert op verschillende momenten in de 15e eeuw. Zonder spinthout kan er echter geen afgebakend kapinterval bepaald worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-07-08"
                }
              }
            ]

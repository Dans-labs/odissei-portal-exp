            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The dataset \"Old Frisian: Kinship\" is a set of Old Frisian lexical items that belong to the semantic field of kinship. These lexical items (i.e., entries and their senses) have been positioned in the taxonomy of <i>A Thesaurus of Old English</i> (https://oldenglishthesaurus.arts.gla.ac.uk/) through referencing the relevant IRIs. The resulting dataset can be browsed as a textual thesaurus within the web application Evoke, at <a href=\"http://evoke.ullet.net/content\">http://evoke.ullet.net/content</a>, and thus facilitates comparative research in this specific field for Old Frisian and Old English."
                }
              }
            ]
          },

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Respondents were pre-screened using the Prolific platform's filters with the following criteria: i) they should be all employed in a manufacturing company, ii) they should be in a managerial position at least at a middle manager level, iii) they should have all at least two subordinates, iv) they should be all fluent in English. To ensure that all the interviewees represented an optimal target company, we introduced the following screening section: “Our company manufactures products which, among others, are also marketed through the online distribution channel”, and respondents negatively answering the question were not considered."
                }
              }
            ]
          },

{"license":"DANS Licence","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, Schiedamse kinderen op stap, interview 03"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:41457"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Nieuwendijk, C.I."}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Gemeentearchief Schiedam (©)"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"C.I.  Nieuwendijk"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Gemeentearchief Schiedam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Het gezin waarin de geinterviewde als kind opgroeide leed aan ondervoeding, wat bij haar in een slechte gezondheid resulteerde. Ze heeft gedurende de oorlogsjaren difterie en TBC gehad. Op voorspraak van haar huisarts is zij driemaal uitgezonden: naar Reuver, Oudenbosch en Florennes (België). In Reuver, waar ze zes weken zou blijven, had ze het niet naar haar zin. Aan het einde van haar verblijf kreeg ze difterie en kwam ze in een ziekenhuis in Venlo terecht, waar ze lange tijd heeft verbleven. In totaal duurde haar verblijf in Limburg zes ? zeven maanden. Bij haar tweede uitzending kwam de geinterviewde bij een gezin in Oudenbosch terecht, waar zij het wel erg naar haar zin heeft gehad. Ten tijde van de bevrijding leed ze aan TBC, waardoor zij niet aan de feestelijkheden kon deelnemen. Na de oorlog is ze door bemiddeling van het Rode Kruis naar Florennes uitgezonden, waar zij een jaar is gebleven en twintig kilo is aangekomen. Daar heeft ze een erg goede tijd gehad."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Respondentnummer 34. De beschrijvingen van de bijgevoegde foto's zitten in het document GV_Schiedam_gastgezin1_03_fotodocumentatie. Document GV_Schiedam_gastgezin1_03_analyse_interview bevat een analyse van het interview."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Schiedam"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Hongertochten"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Hongerwinter"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Kinderuitzending"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Kinderen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Honger"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Hunger"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Hungerwinter"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Children"}},{"keywordValue":{"typeName
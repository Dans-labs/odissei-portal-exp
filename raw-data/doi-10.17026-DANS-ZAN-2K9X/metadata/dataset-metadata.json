{"license":"CC0-1.0","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"A true denial or a false confession? Assessing veracity of suspects' statements using MASAM and SVA"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:77877"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"B.W. Wojciechowski"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"University of Silesia"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"B.W.  Wojciechowski"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Previous research on statement analysis has mainly concerned accounts by witnesses and plaintiffs. In our studies we examined true and false statements as told by offenders. It was hypothesized that SVA and MASAM techniques would enhance the ability to discriminate between true and false offenders' statements. Truthful and deceptive statements (confessions and denials) were collected from Swedish and Polish criminal case files. In Experiment 1, Swedish law students (N = 39) were asked to assess the veracity of statements either after training in and usage of MASAM or without any training and using their own judgements. In Experiment 2, Polish psychology students (N = 36) assessed veracity after training in and usage of either MASAM or SVA or without prior training using their own judgements. The veracity assessments of participants who used MASAM and SVA were significantly more correct than the assessments of participants that used their own judgements. The highest accuracy rate was for true confessions using MASAM (77,53%) and the lowest accuracy rate was for false denials using MASAM (38,78%). Both total SVA and MASAM scores differentiated between lies and truths. The criteria most strongly associated with correct assessments were: logical structure, contextual embedding, self - depreciation, volume of statement, contextual setting and descriptions of relations. Results show, that SVA is a better lie detection tool, than MASAM and trained coders are better at distinguishing between truths and lies than lay evaluators. The results are discussed in relation to statement analysis of offenders' accounts."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Law","Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"True and false statements"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Offenders"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Confessions and denials"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Veracity of suspects' statements"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Multivariable Adults' Statements Assessment Model"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Statement Validity Assessment"}}]},{"typeName":"notesText","multiple":false,"typeClass":"primitive","value":"The depositor provided the data files in SAV format. DANS added the POR and DTA formats."},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["English"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2018-01-30"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Other"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"M. Gräns (Uppsala University)"}},{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Other"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"M. Lidén (Uppsala University)"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2018-01-31"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2018-01-31"}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Unknown"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["English"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D51000","https:\/\/www.narcis.nl\/classification\/D41300"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D51000","termName":[{"lang":"en","value":"Psychology"},{"lang":"nl","value":"Psychologie"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"},{"@id":"https:\/\/www.narcis.nl\/classification\/D41300","termName":[{"lang":"nl","value":"Straf(proces)recht en criminologie"},{"lang":"en","value":"Criminal (procedural) law and criminology"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]}]},"dansTemporalSpatial":{"displayName":"Temporal and Spatial Coverage","name":"dansTemporalSpatial","fields":[{"typeName":"dansSpatialCoverageControlled","multiple":true,"typeClass":"controlledVocabulary","value":["Poland","Sweden"]},{"typeName":"dansSpatialCoverageText","multiple":true,"typeClass":"primitive","value":["Katowice","Uppsala"]}]},"dansDataVaultMetadata":{"displayName":"Data Vault Metadata","name":"dansDataVaultMetadata","fields":[{"typeName":"dansDataversePid","multiple":false,"typeClass":"primitive","value":"doi:10.17026\/DANS-ZAN-2K9X"},{"typeName":"dansDataversePidVersion","multiple":false,"typeClass":"primitive","value":"2.1"},{"typeName":"dansBagId","multiple":false,"typeClass":"primitive","value":"urn:uuid:392ae3e5-5b4d-4635-b217-a42bb9058fb6"},{"typeName":"dansNbn","multiple":false,"typeClass":"primitive","value":"urn:nbn:nl:ui:13-9q-z72a"}]}}}
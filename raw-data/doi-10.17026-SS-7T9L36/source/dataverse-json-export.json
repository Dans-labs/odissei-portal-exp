            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataverse includes the data collected for the study \"Dealing with uncertainty: a care-ethical, phenomenological study of people with relapsing-remitting Multiple Sclerosis\". The aim of the study was to understand how people with relapsing-remitting Multiple Sclerosis (RRMS) experience uncertainty and how the phenomenon of uncertainty appears in Dutch healthcare practice surrounding the care for people with RRMS. 17 people with a recent diagnosis of RRMS were interviewed about their experiences with uncertainty (2021-2022). 15 of them were prospectively followed and observed during hospital appointments (2021-2024). At this point, the anonymized interview transcripts are available and can be accessed upon request."
                }
              }
            ]
          },

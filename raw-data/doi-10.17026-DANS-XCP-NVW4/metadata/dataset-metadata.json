>Beschikbare jaren: 2002, 2004, 2005, 2006, 2010, 2011 (gedeeltelijk), 2012, 2013, 2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021 en 2022. Het jaar 2002 is alleen als tekstbestand beschikbaar, de andere jaren in MS Access en CSV.<br>Deze dataset betreft het archief van 2022. Voor 2002-2016, 2017, 2018, 2019, 2020, 2021 zie het veld Relations voor de link naar de aparte datasets.<\/p>"}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date: 2023-01-23"}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date Submitted: 2023-01-23"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Computer and Information Science"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"VSOI (Voorloop Systeem Onderzoek Informatie)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"onderzoeksprojecten"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"wetenschappelijke organisaties"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"onderzoekers"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"hoogleraren"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch","English"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2023-01-23"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2023-01-23"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2023-01-23"}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["B. Beunk (DANS)",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van Horn 38 in Lutjebroek zijn enkele houten vondsten aangetroffen. Uit de fundering van een waterkelder zijn twee monsters genomen; een vuren (Picea abies Karst.) plank en een grenen (Pinus sylvestris L.) balkje. Beiden bevatten voldoende jaarringen, maar alleen het grenen balkje levert goede resultaten op en kan in 1826 gedateerd worden. Omdat de wankant ontbreekt kan er geen afgebakend kapinterval bepaald worden.\nDaarnaast is er een monster van een paaltje aangeleverd voor houtsoortenonderzoek. Het bleek hier om els (Alnus glutinosa Gaertn.) te gaan."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-07-29"
                }
              }

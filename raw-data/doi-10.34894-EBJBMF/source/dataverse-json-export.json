          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The current dataset belongs to a manuscript titled \"Evolution of wheelchair racing propulsion technique over three weeks of wheeling practice on an instrumented ergometer in able-bodied novices\". The aims of the study were to investigate the acquisition of wheelchair racing propulsion technique in a sample of novices and compare their technique to that of an experienced athlete. The dataset contains data of 15 subjects that completed a standardized three-week submaximal uninstructed practice protocol. During these three weeks, they practiced three sessions per week and performed three blocks of four minutes of exercise per session in a racing wheelchair on an instrumented wheelchair ergometer. Kinematics, physiological, and kinetics data were recorded."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2021"
                }
              }
            ]

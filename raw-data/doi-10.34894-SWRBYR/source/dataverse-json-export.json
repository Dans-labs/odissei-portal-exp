            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains all data and scripts used to generate figure 1, \"Determination of Whi5 concentration with widefield fluorescence microscopy may be confounded by photobleaching\".\n\n- The ImageJ macro (\"Macro_bleaching.ijm\") is used to background correct the unprocessed bleaching movies, \nwhich are stored in the folders \"Bleaching GFP (movies)\" and \"Bleaching RFP (movies)\" respectively. \n- The Python notebook (\"Fig1_data_analysis.ipynb\") contains all code needed to analyze the bleaching movies and generate figure 1."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2022"
                }
              }
            ]

{"license":"CC0-1.0","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Survey on CNR researchers' attitudes on data sharing in environmental sciences"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:53292"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"D. Luzi"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"National Research Council. Institute for Research on Population and Social Policies - CNR-IRPPS"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"D.  Luzi"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"National research council"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Suvey on researchers' attitudes and practices of data sharing in the area of Environmental sciences. It is based on an online questionnaire submitted to CNR researchers belonging to the 13 Institutes of the Department of Earth and Environment. It is a semi- structured questionnaire of 40 questions that consists of two main parts. the first one aims to gain insight into research practices that may influence data sharing (research context, data acquisition, data managment, data re-use). The second part is focused on capturing perceived barriers and enablers that may motivate data sharing.This part contains also a selection of questions submitted in large-scale international survey, in order to explore commonalitiy and differences in attitudes. The survey survey period was June-September2012. The response rate reached 48%."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Datafile and questionnaire available; publication not yet available."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities","Earth and Environmental Sciences","Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"research data"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"researchers' attitudes"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"research practices"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"data sharing"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"data re-use"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"environmental sciences"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Grey Literature"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["English","Italian"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2013-01-10"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2013-02-01"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2013-02-01"},{"typeName":"dataSources","multiple":true,"typeClass":"primitive","value":["Data originate from the quest
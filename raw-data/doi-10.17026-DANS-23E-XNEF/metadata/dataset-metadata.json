{"license":"CC0-1.0","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Vrouwen In Besluitvorming 2014 - VIB2014"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:65621"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Sociaal en Cultureel Planbureau (SCP)"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"SCP  Databeheerder"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Sociaal en Cultureel Planbureau"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Sinds het voorjaar 2000 laat het Sociaal en Cultureel Planbureau tweejaarlijks een onderzoek uitvoeren om het aandeel van vrouwen in besluitvormende posities in de markt en de civiele maatschappij te meten. Dit onderzoek wordt gehouden in het kader van de Emancipatiemonitor, die ten doel heeft een dwarsdoorsnede te geven van het verloop van het emancipatieproces. Het onderzoek werd uitgevoerd onder 553 organisaties."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Er worden meer antwoordcategorieën getoond bij Vraag V9A in het veldwerkverslag dan bij de bijbehorende variabele in het databestand. Dit komt omdat bij deze variabele alleen de door de respondenten  gekozen antwoordcategorieën in het databestand worden weergegeven.Om de anonimiteit van de deelnemende organisaties te bewaren is de variabele behorende bij Vraag V9B verwijderd.Het .SAV bestand is door het SCP geleverd. Op basis van dit bestand heeft DANS de .POR en .DTA versie toegevoegd."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"besluitvorming"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"emancipatie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Emancipatiemonitor"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"vrouwen"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2014-01-01"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Panteia"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2014-01-01"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2016-08-02"},{"typeName":"series","multiple":true,"typeClass":"compound","value":[{"seriesInformation":{"typeName":"seriesInformation","multiple":false,"typeClass":"primitive","value":"Sinds 2000 laat het Sociaal en Cultureel Planbureau tweejaarlijks een onderzoek uitvoeren om het aandeel van vrouwen in besluitvormende posities in de markt en de civiele maatschappij te meten. Dit onderzoek wordt gehouden in het kader van de Emancipatiemonitor, die ten doel heeft een dwarsdoorsnede te geven van het verloop van het emancipatieproces. De respons inclusief organisaties waarvan informatie via internet is verkregen, is in ViB2020 414 organisaties: 163 ondernemingen, 167 non-profit instellingen en 84 maatschappelijke organisaties.Bij het opstellen van het databestand is bij de bepaling van de variabelenamen in de recentere metingen gekozen voor de longitudinale opzet."}}]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Unknown"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D60000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D60000","termName":[{"lang":"en","value":"Social sciences"},{"lang":"nl","value":"Sociale wetenschappen"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]},{"typeName":"dansCollection","multiple":true,"typeClass":"primitive","value":["https:\/\/vocabularies.dans.knaw.nl\/collections\/ssh\/33201279-989a-4ccc-9599-9a7440721798"],"expandedvalue":[{"@id":"https:\/\/vocabularies.dans.knaw.nl\/collections\/ssh\/33201279-989a-4ccc-9599-9a7440721798","termName":{"lang":"nl","value":"Vrouwen in Besluitvorming"},"vocabularyName":{"lang":"nl","value":"DansCollections"},"vocabularyUri":"https:\/\/vocabularies.dans.knaw.nl\/collections"}]},{"typeName":"dansRelation","multiple":true,"typeClass":"compound","value":[{"dansRelationType":{"typeName":"dansRelationType","multiple":false,"typeClass":"controlledVocabulary","value":"relation"},"dansRelationText":{"typeName":"dansRelationText","multiple":false,"typeClass":"primitive","value":"Thematische collectie: Vrouwen in
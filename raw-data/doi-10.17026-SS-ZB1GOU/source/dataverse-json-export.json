            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The current study examines the relative impact of take home (open book) examinations (THE) and in class (closed book) examinations (ICE) on student academic performance and wellbeing outcomes. The data follow four cohorts of a social science bachelor and a master level course that implemented either THE or ICE in successive years. Survey data were collected amongst the students four to six months after course completion. The survey included wellbeing and academic performance measures as well as a 10-item knowledge retention quiz."
                }
              }
            ]

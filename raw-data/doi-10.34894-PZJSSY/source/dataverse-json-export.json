              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains all data and scripts required to replicate the results in the paper and consists of three zipped folders. Each folder contains a script folder with the necessary R-scripts as well as a data folder that contains all data necessary to replicate the results. These include raw single-beam data of the Marsdiep tidal basin and GIS layers of bathymetry and bathymetric instability used in the paper, and R-scripts used to calculate Terrain Ruggedness Index from single-beam data and scripts used for the analysis."
                },

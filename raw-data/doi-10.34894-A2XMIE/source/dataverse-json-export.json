            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek aan de Herenweg 41 in Hoogwoud is een vermoedelijk 16e of 17e eeuwse waterput aangetroffen. Onder de waterput is een velg van een wiel en een funderingsplank aangetroffen.\nVoor de velg is beuk (Fagus sylvatica L.) gebruikt en voor de plank grove den (Pinus sylvestris L.). De grenen plank is aangemerkt voor dendrochronologisch onderzoek, maar kan niet gedateerd worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-07-02"
                }
              }

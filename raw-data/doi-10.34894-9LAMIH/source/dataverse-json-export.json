            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Het onderzoek richt zich op jongeren tussen de 16 en 25 jaar die voornamelijk behoren bij de gemeenten van de Gereformeerde Bond en confessionele gemeenten binnen de PKN. De onderzoeksvraag luidt als volgt: Wat is het missionair bewustzijn en handelen van christelijke jongeren (16-25 jaar, in de achterban van de GZB, HGJB en IZB) en welke rol spelen geloof en kerk hierin?\nMiddels een survey met meerkeuze vragen en openvragen wordt dit onderzocht. Deze survey is in het najaar van 2019 ingevuld."
                }
              }
            ]
          },

            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Als deel van een inventarisatie van resterende 14e eeuwse gebouwen in Kampen is het pand aan de Oudestraat 25 bemonsterd voor dendrochronologisch onderzoek. Van de balklaag op de begane grond zijn zes boormonsters genomen en aangeleverd voor onderzoek.\nIn alle gevallen gaat het om eik (Quercus spp.) en in alle gevallen is de wankant aanwezig.\nVier monsters bevatten lange jaarringreeksen van grofweg 100 of meer jaarringen. Hiervan kunnen er drie gedateerd worden aan het eind van de 13e en begin 14e eeuw. Het hout is op verschillende momenten gekapt; in de zomer van 1299, de zomer van 1304 en de herfst/winter van 1304/05 waarmee het bouwjaar waarschijnlijk in 1305 komt te liggen.\nDe overgebleven twee monsters bevatten te weinig jaarringen om op eigen gelegenheid te dateren, maar voor één monster (MB4) kan aansluiting gevonden worden bij MB8 voor nog een kapinterval in de herfst/winter van 1304/05."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-08-06"
                }
              }
            ]

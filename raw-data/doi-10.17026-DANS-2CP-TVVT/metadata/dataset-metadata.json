{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Veteranen Instituut, IPNV, interview 932"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:42005"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Veteranen Instituut"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"ICNV  Nederlands Veteraneninstituut"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Nederlands Veteraneninstituut"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"De geïnterviewde vertelt over de patrouille met de Dolfijn in Nieuw Guinea in 1962. In een eerder interview is hier al over gesproken. De geïnterviewde vertelt over de situatie voor en na de wapenstilstand. Op de terugweg was men erg opgelucht en vielen de spanningen van de operatie weg. De geïnterviewde geeft zijn mening over de operatie en over hoe het er aan toe ging. In 1963 werd hij opnieuw op een onderzeeboot geplaatst. Hij klom op tot commandant. Hiervoor moest hij eerst de NAVO-cursus COQC volgen, dit was erg moeilijk. Hierna verbleef hij maar een klein deel van zijn loopbaan aan boord. Een periode moest hij spioneren in NAVO-verband nabij Noorwegen. De geïnterviewde had een aantal keren problemen met zijn meerede vanwege zijn commentaar of activiteiten. Hij meldde een voorval bij de Marineraad. De geïnterviewde heeft het moeilijk met de gedwongen beëindiging van zijn commando. Hij vertelt over zijn loopbaan hierna, zijn werk als marinecommandant, het werk in de burgermaatschappij en zijn activiteiten in de Tweede Kamer."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"De Dolfijn"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Patrouilles"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Wapenstilstand"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"VN"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Terugreis"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Rapporten missie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Commandant"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"NAVO-cursus COQC"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Spioneren"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Sovjet-vloot"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Russen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Spanning"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Koninklijke Marine"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Oefeningen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Loopbaan na dienst"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Burgerbestaan"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Conflict"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Reflectie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Sociale verhoudingen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Marineraad"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Kamer"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2010-03-09"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2010-10-14"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2010-10-14"},{"typeName":"series","multiple":true,"typeClass":"compound","value":[{"seriesInformation":{"typeName":"seriesInformation","multiple":false,"typeClass":"primitive","value":"De collectie van het Interview-project Nederlandse Veteranen (IPNV) bestaat uit meer dan duizend  biografische interviews, die gehouden zijn met veteranen van nagenoeg alle conflicten en militaire missies waar Nederland bij betrokken is geweest.Van soldaat tot generaal, van hospik tot para, van gevechten op Nederlandse bodem in de Mei-dagen van 1940 tot de slag bij Chora in Afghanistan, alles komt aan bod in deze gevarieerde collectie. De geïnterviewden hebben bijgedragen aan een schat aan informatie voor onder andere beleidsmakers, onderzoekers, media en het geïnteresseerde publiek.Onderstaand treft u de links naar de metadata van alle interviews. De  interviews zijn om privacyredenen alleen na toestemming van het Veternanen Instituut toegankelijk. Deze toestemming kunt u aanvragen per dataset via tabblad 'Permission\".In het kader van het project Living Oral History Workbench, zijn een aantal interviews via automatische spraakherkenning geïndexeerd zodat ze doorzoekbaar zijn. Zie de onderstaande link naar Interviews Project Living Oral History Workbench."}}]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Unknown"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D34300"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D34300","termName":[{"lang":"nl","value":"Moderne en contemporaine geschiedenis"},{"lang":"en","value":"Modern and contemporary history"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]},{"typeName":"dansCollection","multiple":true,"typeClass":"primitive","value":["https:\/\/vocabularies.dans.knaw.nl\/collections\/ssh\/7e30e380-9e02-4b15-a0af-f35286c3ecec","https:\/\/vocabularies.dans.knaw.nl\/collections\/ssh\/213a59ea-8d36-42c6-b30b-474ebbdef61d","https:\/\/vocabularies.dans.knaw.nl\/collections\/ssh\/cfa04ed6-4cd0-4651-80cb-ed4ca8fa14f3","https:\/\/vocabularies.dans.knaw.nl\/collections\/ssh\/078ae626-cf18-4986-b1c8-883c2ab634fb"],"expandedvalue":[{"@id":"https:\/\/vocabularies.dans.knaw.nl\/collections\/ssh\/7e30e380-9e02-4b15-a0af-f35286c3ecec","vocabularyUri":"https:\/\/vocabularies.dans.knaw.nl\/collections"},{"@id":"https:\/\/vocabularies.dans.knaw.nl\/collections\/ssh\/213a5
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Door Trident Archeologie is een inventarisatie van een onbekend scheepswrak in de Grevelingen uitgevoerd. Uit de boeg van wrak – aangeduid als GR-2 - is een monster genomen voor dendrochronologisch onderzoek. Afhankelijk van de ouderdom wordt bepaald verder onderzoek noodzakelijk is.\nHet monster is afkomstig van een zware balk (c. 43 bij 45 cm), maar bevat vanwege een zeer snelle aanwas “slechts” 100 jaarringen. De laatste jaarring kan gedateerd worden in 1584. Het spinthout of de wankant ontbreekt, waardoor alleen de ondergrens van het kapinterval bepaald kan worden. Dit valt grofweg aan het eind van de 16e eeuw."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2022-12-15"
                }
              }

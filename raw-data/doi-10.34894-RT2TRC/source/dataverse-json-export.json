            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset includes the absolute numbers of all first and second choice antibiotics that qualify for respiratory tract infections in primary care according to the Dutch antibiotic guidelines. The following selection of antibiotics are included: Doxycycline, Amoxicillin, Augmentin, Phenoxymethylpenicillin, Macrolides, and Pheneticillin. The prescribed antibiotics are linked to individual general practitioners from three Dutch cities: The Hague, Rotterdam and Amsterdam. In the dataset we also included the number of prescribed antibiotics for all infections (regardless of the indication) per individual general practitioner. All data refer to antibiotics that are prescribed within primary care. The data was collected during multiple winter months:\nNovember 2018 – April 2019; November 2019 – April 2020; November 2020 – April 2021; November 2021 – April 2022. \nThe data only contains numbers about the antibiotic prescription behavior of the Dutch general practitioners and no individual background characteristics of the general practitioners."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Data for: Negative body experience in a clinical sample of mental disorders:  associations with PTSD, mood disorders, and personality disorders.\nFor this study, patients from the PsyQ mental health center in The Hague, the Netherlands were included between 2008 and 2017. At the start of their treatment, participants provided written consent for the use of their anonymized clinical data, as obtained during their treatment, for the purpose of scientific research. All participants filled out one or more of three questionnaires covering three main domains of body experience (see measures paragraph), as a standard part of their intake for PMT. Not every participant filled out all three questionnaires. The institution’s medical board approved our data collection and analysis methods and deemed a review by a Medical Ethics Review Committee unnecessary, because the study required no additional effort or activities from the participants."
                },
                "dsDescriptionDate": {

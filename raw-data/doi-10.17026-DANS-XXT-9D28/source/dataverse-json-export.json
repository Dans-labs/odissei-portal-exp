          {
            "typeName": "notesText",
            "multiple": false,
            "typeClass": "primitive",
            "value": "Rijkswaterstaat heeft de databestanden geleverd in SAV en XLS formaat. DANS heeft voor het SAV bestand de POR en DTA formaten toegevoegd en voor de XLS bestanden de CSV formaten toegevoegd. Deze bestanden zijn te vinden in de map 'DANS toegevoegde formaten'."
          },
          {
            "typeName": "language",
            "multiple": true,

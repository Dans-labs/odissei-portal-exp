            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Een boomstam is dendrochronologisch onderzocht, met als doel de ouderdom van het\nhout te bepalen. Het hout is afkomstig van een eiken boomstam die door K3Delta is gevonden tijdens werkzaamheden in een kleigroeve in 2022 in de Gendtse Waard. De meetreeks 23GV0010 telt 160 jaarringen. Datering van het hout op basis van de jaarringen is niet mogelijk. Daarom is een sub-sample van het hout ingestuurd voor radiokoolstofdateringsonderzoek, om de vraag over de ouderdom van de boomstam te beantwoorden."
                }
              }
            ]
          },

{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"The Social and Individual Outcomes of Community-Based Sociotherapy: 2023"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Ubels, Tessa"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud University"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Kinsbergen, Sara"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud University"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Tolsma, Jochem"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud University; University of Groningen"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Koch, Dirk-Jan"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud University"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Ubels, Tessa"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"This dataverse includes all data collected in the context of the study ‘The Social and Individual Outcomes of Community-Based Sociotherapy’ (January - November 2023). The aim of the study was to understand the social and individual outcomes, and the pathways between these outcomes, of Community-Based Sociotherapy (CBS) in Nakivale settlement, Uganda. CBS is a group-based mental health and psychosocial support intervention (MHPSS), with the goal to support people in dealing with their daily challenges, and to cope with the disruption of their lives by conflict, displacement and other traumatic events. It is implemented by TPO Uganda and ICBS. The CBS groups are led by trained facilitators who, in most cases, originate from the same community as the participants. The study follows one cohort of refugees who participated in the third implementation pilot round of CBS (N = 162). This codebook document describes the quantitative and qualitative data that has been collected in the context of this mixed-method study."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"refugees"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Community-Based Sociotherapy"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["English"]},{"typeName":"productionPlace","multiple":true,"typeClass":"primitive","value":["Nakivale settlement, Uganda"]},{"typeName":"depositor","multiple":false,"typeClass":"primitive","value":"Ubels, Tessa"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2024-05-29"},{"typeName":"dateOfCollection","multiple":true,"typeClass":"compound","value":[{"dateOfCollectionStart":{"typeName":"dateOfCollectionStart","multiple":false,"typeClass":"primitive","value":"2024-01-16"},"dateOfCollectionEnd":{"typeName":"dateOfCollectionEnd","multiple":false,"typeClass":"primitive","value":"2024-10-30"}}]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Radboud Un
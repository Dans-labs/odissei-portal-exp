              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains a spreadsheet with the metadata blocks and fields of the DANS Data Station Social Sciences and Humanites (SSH) as of December 2025.\n<br>\n<br>\nThe DANS Data Station SSH is a trustworthy digital repository for research data in the SSH domain offered by DANS in the Netherlands. https://ssh.datastations.nl/ \n<br>\n<br>\nThis dataset provides an overview of the metadata fields the Data Station SSH offers and can be used as a reference document. \n<br>\n<br>\nThe Spreadsheet contains the following headings: <br>\n- Metadata block: with the name of the metadata block a field belongs to <br>\n- Field label: with the label of the metadata field <br>\n- Field Obligatory?: with a Yes or No indicating whether the field is obligatory (yes) or not (no)<br>\n- Description: with the description of the field.<br>"
                }
              }
            ]
          },

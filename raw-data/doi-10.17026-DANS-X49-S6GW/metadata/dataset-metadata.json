"}},{"dansRelationType":{"typeName":"dansRelationType","multiple":false,"typeClass":"controlledVocabulary","value":"relation"},"dansRelationText":{"typeName":"dansRelationText","multiple":false,"typeClass":"primitive","value":"Dit is de eerste druk van een werk dat in 1684 in tweede druk is verschenen onder de titel: De Seldsaame en Noit Gehoorde Wal-Vis-Vangst, (zie de link in Relations). De verschillen tusen de eerste en de tweede druk zijn aanzienlijk en vertellen veel over de werkwijze van P.P.V.S., de tot dusver onbekende auteur van proza- en poezieteksten, van wie we alleen de initialen kennen. [H. Beelen]"}}]}]},"dansTemporalSpatial":{"displayName":"Temporal and Spatial Coverage","name":"dansTemporalSpatial","fields":[{"typeName":"dansTemporalCoverage","multiple":true,"typeClass":"primitive","value":["1682"]},{"typeName":"dansSpatialCoverageControlled","multiple":true,"typeClass":"controlledVocabulary","value":["Netherlands"]},{"typeName":"dansSpatialCoverageText","multiple":true,"typeClass":"primitive","value":["Groenland","St. Anna-Land"]}]},"dansDataVaultMetadata":{"displayName":"Data Vault Metadata","name":"dansDataVaultMetadata","fields":[{"typeName":"dansDataversePid","multiple":false,"typeClass":"primitive","value":"doi:10.17026\/DANS-X49-S6GW"},{"typeName":"dansDataversePidVersion","multiple":false,"typeClass":"primitive","value":"1.1"},{"typeName":"dansBagId","multiple":false,"typeClass":"primitive","value":"urn:uuid:a3f07f3b-cb80-4e47-bdea-74407146c715"},{"typeName":"dansNbn","multiple":false,"typeClass":"primitive","value":"urn:nbn:nl:ui:13-oo3i-yt"}]}}}
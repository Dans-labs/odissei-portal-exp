                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek in de wijk Ertbrugge in Wijnegem zijn de resten wat een waterput aangetroffen. Uit de houten bekisting is een monster genomen voor dendrochronologisch onderzoek. De laatste jaarring van dit monster dateert in 1064.\nHet spinthout is niet aanwezig, dus kan alleen bepaald worden dat het hout ergens na 1075 gekapt is."
                },

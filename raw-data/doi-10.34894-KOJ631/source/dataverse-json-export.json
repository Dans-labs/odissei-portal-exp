              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<B>Short description of the study</B><BR><BR>\nThis study involved a systematic literature review of studies investigating the effectiveness of simulation-based training to teach flexible bronchoscopy skills to novice trainees. Study methodology can be found in the published research article.<BR><BR>\n<B>Short description of the data files</B><BR><BR>\n-\tthe “221123 extraction form.xlsx” file contains all included studies and their characteristics: general information, study eligibility, MMERSQI, general features, instructional design features.<BR><BR>\n-\tthe “Risk of bias systematic review.xlsx” file contains the risk of bias information of all included studies. Either Yes, No, or Cannot Determine/Not Reported/Not Applicable.<BR><BR>"
                },
                "dsDescriptionDate": {

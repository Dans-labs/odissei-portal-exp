            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "In opdracht van Galerie Salomon Lilian is een paneelschilderij dat is toegeschreven aan Jan Steen (1626 – 1679) dendrochronologisch onderzocht.\nHet paneel verbeeld een tafereel uit de Griekse mythologie waarin Erysichthon zijn dochter Mestra verkoopt.\nHet paneel bestaat uit een enkele eiken (Quercus sp.) plank. Hierin zijn 223 jaarringen aanwezig. Er is geen spinthout aanwezig.\nDe laatste jaarring kan gedateerd worden in 1623. Om de ondergrens van het kapinterval te bepalen moeten hier rekening gehouden worden met minimaal negen ontbrekende spinthoutringen, plus een aantal jaar voor het drogen van het hout.\nHiermee komt het vroegst mogelijke kapjaar in 1632 te liggen, hoewel dit realistischer een aantal jaren later valt en daarmee overeenkomt met de actieve periode van Jan Steen."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-01-15"
                }
              }
            ]

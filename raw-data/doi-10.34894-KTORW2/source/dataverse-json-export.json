            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Erfgoed Delft voerde archeologisch onderzoek uit op de locatie van het voormalige Ursulaklooster in Delft. Op deze locatie is in de 17e eeuw een woonwijk en plateelbakkerij gebouwd. Uit de fundering van de laatste zijn drie monsters genomen voor dendrochronologisch onderzoek. Hierbij gaat het in alle gevallen om grove den (Pinus sylvestris L.). Op één van de monsters is de wankant aanwezig en hiervan kan bepaald worden dat deze in de herfst/winter van 1669/70 gekapt is. Dit komt in grote lijnen overeen met de start van de pottenbakkerij in 1678. De overige dateringen spreken dit niet tegen."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-03-15"
                }
              }
            ]

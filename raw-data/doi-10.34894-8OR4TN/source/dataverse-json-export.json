            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Door Studiebureau Archeologie is een plank van een waterput met niet nader toegelichte context aangeleverd. Het gaat om een zware, radiaal georiënteerde plank, met meer dan voldoende jaarringen. Spinthout of de wankant is niet aangetroffen.\nDe laatste jaarring kan gedateerd worden in 645 na Chr. Het vroegst mogelijke kapjaar is 654 na Chr. Het hout is waarschijnlijk ergens in de 2e helft van de 7e eeuw gekapt."
                },
                "dsDescriptionDate": {

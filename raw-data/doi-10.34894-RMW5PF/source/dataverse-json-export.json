              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains the <b>general description and publishable summaries</b> of the EU project <b>Aircraft and Rotorcraft Pilot Couplings - Tools and Techniques for Alleviation and Detection (ARISTOTEL)</b>.<br> \r\n<br>The aim of this 3-year project was to advance in the understanding, prediction and alleviation of a particularly unfavourable category of phenomena, the so-called <b>aircraft-pilot-couplings and rotorcraft-pilot-couplings (A/RPCs)</b>, which may lead to catastrophic failures.<br> \r\n<br>At the end of the project, the ARISTOTEL consortium successfully developed <b>design and simulation guidelines for A/RPCs</b>. A list of all <b>journal articles and conference proceedings</b> related to this project can be found in the metadata tab."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2019-08-29"
                }
              }
            ]

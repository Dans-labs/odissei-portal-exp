{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Interview met Sjoerd Buisman, Haarlem, 23 mei 2024"},{"typeName":"subtitle","multiple":false,"typeClass":"primitive","value":"Over intentie, werkwijze, presentatie en behoud"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Sanneke Stigter"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit van Amsterdam"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0001-5250-8461"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Interview met Sjoerd Buisman gericht op kunstenaarsintentie in het kader van een NWO-onderzoeksproject van de Universiteit van Amsterdam, Smart Care: Artist Intent and Artist Interviews. In zijn atelier in Haarlem wordt gesproken over zijn missie als kunstenaar, de ideale manier van tentoonstellen en het gewenste uiterlijk van zijn werk. Hem wordt gevraagd naar zijn belangrijkste werk, materiaalkeuze, het gewenste patina van (metalen) beelden en het bedoelde effect van onder meer zijn 'groeiwerken', waaronder de zogenoemde aardappelpanelen, onder andere uit de collectie van de Rijksdienst voor het Cultureel Erfgoed; ouroboros werken; en 'De Dennenwal' (1984) uit de collectie van het Kröller-Müller Museum."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"ty
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The dataset presents the list and excerpt of 49 judicial review cases in Constitutional Court of Republic of Indonesia from 2006 to 28 September 2016 that challenge the constitutionality of Indonesian Criminal Procedural Law (Act 8/1981 or KUHAP). The excerpt consists of:\r\n(1) Case Number;\r\n(2) Status of Applicant;\r\n(3) Articles of KUHAP (that were reviewed by Constitutional Court);\r\n(4) Court's verdict (Overruled, Declared Inadmissible, Granted, and Partially Granted);\r\n(5) Court's Main Consideration.\r\n\r\nIt also lists the articles of KUHAP (and their frequency of attempts) that the Applicants brought to Indonesian Constitutional Court. The articles are divided into four categories (Investigation, Prosecution, Trial, and Mix)."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2016-09-28"
                }
              }

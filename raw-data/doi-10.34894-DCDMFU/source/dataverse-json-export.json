            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Study 1: Effects of implementing time variable postgraduate training programmes on the organization of teaching hospital departments. Qualitative interview study to describe the effects of time variable medical training on teaching hospital departments. Interviews where held with clinical teachers and medical managers of teaching hospital departments that where implementing time variable medical training. Participants where purposeful sampled by the size of their training program (small, medium and large) and, in addition, departments that where showcase projects by the Dutch Rio project were also included."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2019-06-19"
                }
              }
            ]
          },

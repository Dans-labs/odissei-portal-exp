            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek aan het Laarspad in Gilze is een boomstamput aangetroffen. Van de put is een monster genomen voor dendrochronologisch onderzoek. Daarnaast is een monster aangeleverd uit de vulling van de waterput. In beide gevallen gaat het om eik (Quercus spp.).\nHet hout voor de boomstamput is gekapt in de herfst/winter van 740/41 terwijl voor de vondst uit de vulling bepaald kan worden dat deze in de herfst/winter van 763/64 gekapt is.\nAls de vulling correspendeert met het in onbruik raken van de waterput dan is deze 23 jaar in gebruik geweest."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-12-04"
                }
              }
            ]

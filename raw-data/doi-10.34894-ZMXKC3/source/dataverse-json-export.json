            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "In het waarderingsonderzoek is boomstamput vnr. 266 van waterput S5066 geschikt bevonden voor dendrochronologisch onderzoek. Het constructiehout uit de overige waterputten van deze site is ongeschikt. Er zijn twee stukken van de boomstamput vnr. 266 gezaagd, zodat zowel het dikste gedeelte met de meeste jaarringen, als een\ndeel met complete spinthout en schors kan worden geanalyseerd. De dendrochronologische metingen resulteert in twee meetreeksen. De wankant is waargenomen. De twee meetreeksen zijn vanwege gelijkvormige\njaarringpatronen te clusteren tot boomseries 24BM_1_2_T. De meetdata zijn vergeleken met de referentiekalenders voor eik. De vergelijkingen van de meetreeksen hebben echter geen match opgeleverd met de beschikbare referentiekalenders. Het hout van boomstamput S5066 blijft ongedateerd."
                }
              }
            ]
          },

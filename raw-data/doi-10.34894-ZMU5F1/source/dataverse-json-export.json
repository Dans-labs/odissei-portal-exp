            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p dir=\"ltr\">What does making positive societal impact mean to you? How do you map current and potential partners and beneficiaries? How to align your work to their needs? This workshop package offers a brief printable worksheet with accompanying presentation slides, designed for academics to consider how their project or individual work relates to society.</p><p dir=\"ltr\"><b>Who can primarily benefit from this tool?</b><br>Individual researchers and research teams, academics and professional staff holding impact workshops for academics.</p><p><br></p><p dir=\"ltr\"><b>In which context is this tool useful?</b><br>When thinking about your impact goals, partners and beneficiaries, and engagement plan - alone or in a workshop setting.</p><p><br></p><p dir=\"ltr\"><i>This material has been developed by the Evaluating Societal Impact strategic team for a workshop given at a the ‘Next steps in Convergence Health & Technology’ event in 2024. It consists of a short guide, a printable and an adjustable template, and a slide deck to support you in giving similar workshops.</i></p>"
                }
              }
            ]

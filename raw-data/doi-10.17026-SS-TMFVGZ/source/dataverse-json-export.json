            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "De monitor cultuureducatie vo is een instrument dat periodiek wordt ingezet om de stand van zaken omtrent cultuuronderwijs in kaart te brengen. Door middel van online vragenlijsten voor schoolleiders en docenten wordt bekeken in hoeverre cultuuronderwijs in Nederland is ingebed in het voortgezet onderwijs en hoe deze inbedding is ontwikkeld ten opzichte van vorige metingen. Daarnaast wordt in kaart gebracht hoe cultuureducatie zich verhoudt tot de hedendaagse visie van het ministerie op cultuuronderwijs. ResearchNed heeft de eerder gebruikte vragenlijsten waar nodig geactualiseerd en een nieuwe verankeringsmaat berekend, waarbij trends met eerdere metingen zijn behouden. Naast de vragenlijsten is een kwalitatieve verdieping uitgevoerd in de vorm van casestudies."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023"
                }
              }

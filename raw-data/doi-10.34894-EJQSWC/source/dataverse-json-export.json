            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Het pand aan de Hollumerweg 3 te Ballum op Ameland is een voormalige opslagschuur van de strandvonderij. Om de leeftijd van dit historische gebouw te bepalen is een dwarsdoorsnede van een grenen (Pinus sylvestris L.) muurplaat aangeleverd voor dendrochronologisch onderzoek.\nDe laatste jaarring hiervan valt in 1790. Omdat de wankant aanwezig is kan bepaald worden dat het hout in de herfst of winter van 1790/91 gekapt is. Hiermee lijkt een bouwjaar in (of anders kort na) 1791 voor de hand liggend."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-5-27"
                }
              }
            ]

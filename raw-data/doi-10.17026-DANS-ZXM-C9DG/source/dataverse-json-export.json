            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>This data set contains a list of Dutch occupations in the period of the 15th-19th century, based on censuses, migration lists, tax registers, etc. Occupations are classified according to an adaptation of the Dutch Census of 1889. A distinction is made between male and female occupations and information about the actual meaning of the occupation name is added. Data are divided in occupational groups, the old and the new codes and the exact title of the occupation.</p>"
                }
              }
            ]

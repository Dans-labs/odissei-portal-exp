            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Respondent K2G1 is kind van Holocaust overlevenden. Nadat hij zijn leven lang gefocust was op werk en daarin succesvol was, staat sinds zijn pensioen het Holocaust verleden steeds meer op de voorgrond. Hij is aan het onderzoeken hoe hij zijn depressie kan verklaren en welke middelen hij daartegen kan inzetten. Centrale vragen zijn nu voor hem: ‘heb ik eigenlijk bestaansrecht?’ en ‘waarom is publieke erkenning zo noodzakelijk?’. </p>"
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

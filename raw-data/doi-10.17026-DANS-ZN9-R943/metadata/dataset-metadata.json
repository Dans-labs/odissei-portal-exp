{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Narrated (In)justice - Casus 1: De koloniale schadeclaims, Interview 10"},{"typeName":"alternativeTitle","multiple":true,"typeClass":"primitive","value":["De weduwen en kindslachtoffers van Sulawesi"]},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:99990"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"N.L. Immler"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"NIOD Instituut voor Oorlogs-, Holocaust- en Genocidestudies"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/395957656"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"NIOD  Onderzoeksdata"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"NIOD"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"De familie van Ibu Ceddung (1928-2015), uit Pinrang, Zuid-Sulawesi, vertelt over Ibu Ceddung, wiens echtgenoot werd doodgeschoten bij het bloedbad in Suppa op 28 januari 1947. Haar kleinzoon Mutawakkil vertelt dat oma heel verrast was toen ze het geld kreeg, ze had nooit gedacht dat dit echt zou gebeuren. ‘Met het geld wilde oma graag een auto kopen, omdat ze haar familie niet vaak genoeg zag. Oma overleed vier maanden geleden. Ze zei altijd dat we de auto moeten gebruiken om anderen te helpen, bijvoorbeeld als mensen ziek zijn en naar het ziekenhuis moeten.’"}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date: Interviews gehouden in oktober 2015"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities","Law"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Koloniale geschiedenis"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Dekolonisatie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Indonesische onafhankelijkheidsstrijd"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Politionele acties"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Oorlogsmisdaden"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Oorlogsslachtoffers"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Weduwen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Kinderen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Rechtspraak"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Transitional Justice"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Rechtsherstel"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Schadevergoedingen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Naoorlogse periode"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["English","Indonesian"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2017-10-30"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"S. Liem"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"A. Rum"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2018-07-23"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2018-05-22"},{"typeName":"series","multiple":true,"typeClass":"compound","value":[{"seriesInformation":{"typeName":"seriesInformation","multiple":false,"typeClass":"primitive","value":"Narrated (In)justice is een onderzoeksproject (2014-2016) van historica Nicole L. Immler dat in beeld brengt hoe historisch onrecht in toenemende mate door middel van financiële compensatie claims publieke aandacht vraagt. Wereldwijd zijn de laatste jaren compensatiebetalingen voor slachtoffers een belangrijk onderdeel geworden van ‘erkenning’. In Nederland hebben de recente betalingen aan Joods-Nederlandse slachtoffers een rol gespeeld in de claims van slachtoffers van de dekolonisatieoorlog in Indonesië (de zogenaamde Rawagede casus) en zijn ook referentiepunt in de claims van nazaten van voormalige tot slaaf gemaakten uit de voormalige koloniën Suriname en de Nederlands Antillen.Op basis van drie Nederlandse casussen – met betrekking tot de Holocaust, kolonialisme en slavernij – laat het project zien hoe de ervaring van onrecht in families over de generaties doorverteld wordt, wat de motivatie achter compensatie claims is, en wat de perceptie en de betekenis van zulke maatregelen is. De vraag is of dergelijke compensatie ook voldoet aan de verwachtingen die mensen ervan hebben.Het onderzoek Narrated (In)Justice is mogelijk gemaakt door een Marie Curie Fellowship in het 7th European Community Framework Program, uitgevoerd binnen het onderzoeksprogramma ‘Understanding the Age of Transitional Justice: Narratives in Historical Perspective’ van het NIOD Instituut voor Oorlog, Holocaust en Genocide Studies."}}]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["NIOD Instituut voor Oorlogs-, Holocaust- en Genocidestudies"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Yes"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D30000","https:\/\/www.narcis.nl\/classification\/D40000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D30000","termName":[{"lang":"nl","value":"Geesteswetenschappen"},{"lang":"en","value":"Humanities"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"},{"@id":"https:\/\/www.narcis.nl\/classification\/D40000","termName":[{"lang":"nl","value":"Recht en bestuur"},{"lang":"en","value":"Law and Public Administration"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]},{"typeName":"dansCollection","multiple":true,"typeClass":"primitive","value":["https:\/\/vocabularies.dans.knaw.nl\/collections\/ssh\/15a2730f-244b-48f1-b1ce-8d98509c181d","https:\/\/vocabularies.dans.knaw.nl\/collections\/s
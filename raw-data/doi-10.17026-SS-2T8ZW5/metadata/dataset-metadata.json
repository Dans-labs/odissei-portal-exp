{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Replication Data for: Towards an early warning system for pandemics: The case of COVID-19 in Ghana"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Akyereko,Ernest"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Faculty of Geo-Information Science and Earth Observation"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Akyereko,Ernest"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Faculty of Geo-Information Science and Earth Observation"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"The COVID-19 pandemic is one of the greatest health challenges humanity has faced in the 21st century. Ghana recorded its first cases on 12 March 2020 and has since implemented several response activities. The incidences and mortalities and their impact on the limited resources require a system to prompt health professionals for early response. Spatio-temporal statistical modelling is essential to understand these dynamics, but it is still lacking implementation in developing countries, especially Ghana. This dataset collection provides district-level data describing the epidemiological progression of COVID-19, associated demographic characteristics, and climatic variables across Ghana between March 2020 and February 2022. The datasets were used in multiple peer-reviewed studies examining spatiotemporal dynamics, climatic influences, and epidemiological modeling of COVID-19 trends in Ghana"},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2026-01-6"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Medicine, Health and Life Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"COVID-19"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Spatio-temporal analysis"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"cluster analysis"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"cartogram"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Spatial Epidemiology"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Flexible Scan Statistics"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Spatially Varying Coefficient model"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["English"]},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Researcher"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Akyereko,Ernest"}},{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Supervisor"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Stein,Alfred"}},{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":
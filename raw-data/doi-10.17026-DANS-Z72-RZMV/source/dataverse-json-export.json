            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Survey over geloof en kerkelijkheid onder Nederlanders 18 jaar en ouder in 1996 (vervolg op God in Nederland 1966 en 1979). Opinieonderzoek naar geloof en kerk. Het onderzoek God in Nederland wordt af en toe in min of meer vergelijkbare vorm herhaald om zicht te krijgen op verschuivingen in de christelijke godsdienst, de godsdienstigheid van Nederlanders en de rol van de kerken in het publieke debat.</p>"
                }
              }
            ]
          },

              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The materials and datasets accompanying the paper \"Mitigating Perceived Polarization by Acknowledging Subjectivity: An Experimental Study of the Impact of Differently Phrasing Comments in Online News Discussions.\" In this paper we report on an experiment in which we aimed to reduce perceived polarization in online news discussions by inserting subjectivity markers: explicit acknowledgements that a statement represents the writer’s perspective, e.g., “I <i>think</i> that is not true”."
                }
              }
            ]
          },

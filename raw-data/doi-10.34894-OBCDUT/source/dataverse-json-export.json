          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van De Bocht 15 in Enkhuizen zijn enkele funderingspalen aangetroffen. Mogelijk gaat het (deels) om hergebruikt hout. Voor het dendrochronologisch onderzoek zijn zes monsters aangeleverd. In alle gevallen ging het om eik (Quercus sp.). Een aantal van de monsters laat een zeer onregelmatig groeipatroon zien, wat echter geen obstakel voor het onderzoek bleek. Twee van de monsters (M4 en M9.2) laten dezelfde verstoorde groei zien en hier is aangenomen dat beide palen uit één boom afkomstig zijn. Hiervoor is boom-middelcurve 24.56.B01 gemaakt.\nDe palen dateren in de 15e een 16e eeuw, maar alleen voor de 16e-eeuwse dateringen kunnen afgebakende kapintervallen bepaald worden, waarbij de datering voor M6 met wankant in de herfst/winter van 1577/78 de meest nauwkeurige is. De kapintervallen voor M2 en M6 lijken aan te geven dat er sprake is van een eerdere fase (of hergebruikt hout) dat dateert rond 1563."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-08-06"
                }
              }
            ]
          },

{"license":"CC0-1.0","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, De Russenoorlog, opstand Georgische troepen op Texel, interview 10"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:41767"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Stichting Traktor ©"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Arnold van Bruggen"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"A van Bruggen"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Stichting Traktor"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Jaap Schoorl (92) beleeft een moeilijke opstand. Zijn vader en broer zijn betrokken bij de NSB en hij vertoont compensatiegedrag. In een – onder andere vanwege de leeftijd – moeizaam interview beschrijft Schoorl zijn band met zijn broer en vader. De band was goed, maar bij aanvang van de opstand moest Jaap Schoorl alle zeilen bijzetten om hen veilig te houden uit de handen van onder andere Huug Snoek (getuigen verhalen, De Russenoorlog, interview 5). Schoorl verleent hand en spandiensten voor het verzet. Na de oorlog komen zijn vader en broer in een Nederlands strafkamp en Jaap Schoorl probeert hen eruit te krijgen."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Texel"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Georgians"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Uprising"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Georgiers"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Opstand"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Second world war"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"world war II"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Den Burg"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"NSB"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Ukraine"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Oekraine"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Nazi"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"farm"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"boerderij"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"poster"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"resistance"}
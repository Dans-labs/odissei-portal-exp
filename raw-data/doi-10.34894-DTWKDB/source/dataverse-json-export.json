          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset was collected as part of the research “The expected benefits of the use of social robots when working with institutionalised older people” led by Hanze University of Applied Sciences Groningen, RUG/UMCG (Health Psychology) and HKU University of Arts. The data contains transcripts of Focus Group Discussions of 24 Healthcare professionals, a tabular dataset of the transcripts, protocols of the sessions and a codebook. The aim of this study was to explore what healthcare professionals expect to be the added value of using a social robot in the daily care for older adults in a nursing home."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",

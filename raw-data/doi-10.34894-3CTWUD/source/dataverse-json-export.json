            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Liesboslaan 6 in Breda is een tonput aangetroffen. Van de tonput is een aantal duigen aangeleverd waaruit een selectie van negen monsters gemaakt is voor dendrochronologisch onderzoek. In alle gevallen gaat het om eik (Quercus spp.). Uit zes van de duigen is een middelcurve samengesteld (26.015.M01) die in 1592 gedateerd kan worden.\nOp de duigen is geen spinthout aangetroffen worden waardoor alleen de ondergrens van het kapinterval bepaald kan worden. Vermoedelijk is het hout in de eerste helft van de 17e eeuw gekapt."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",

            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Uit het vierkant van de gesloopte stolpboerderij aan de Dr. Nuijensstraat 29 te Westwoud is een aantal dwarsdoorsnedes gezaagd voor dendrochronologisch onderzoek. Het gaat hier om elf monsters, van grove den (Pinus sylvestris L., zes stuks) en eik (Quercus sp., vijf stuks). Mogelijk vertegenwoordigen de verschillende houtsoorten verschillende bouwfases.\nDe dateringen laten zien dat dit niet het geval is. Waar de wankant aanwezig is op het grenenhout dateert deze in 1656/57 met een enkele datering in 1655/56. Bij het eikenhout is op één monster de wankant aanwezig en deze dateert eveneens in 1656/57.\nDe overige dateringen vallen enkele jaren daar voor en de geschatte kapintervallen komen overeen met de bovengenoemde datering.\nHet lijkt hier dan ook om één fase te gaan die in 1657 of kort daarna is opgetrokken.\nVoor de eiken monsters is op basis van onderlinge synchronisatie de middelcurve 24.053.M01 samengesteld aangezien de individuele metingen nauwelijks resultaat opleveren."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-07-23"
                }
              }
            ]

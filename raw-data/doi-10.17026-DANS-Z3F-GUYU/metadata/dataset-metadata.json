{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Data Spiritualiteit en Maatschappelijke Vernieuwing, interview met Dette Glashouwer (over geld; initiatief Money Money Money)"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:59857"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"E.H. Hense"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud Universiteit Nijmegen"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/071809481"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"E. H.  Hense"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud Universiteit"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Spiritualiteit en maatschappelijke vernieuwing - negen initiatieven van maatschappelijke vernieuwing rond eten, zorg en geld in Nederland.Vanuit hun persoonlijke toe-eigening van een gegeven maatschappelijk probleem en hun eigen creatieve vermogen om de dingen anders aan te pakken, dragen vernieuwers in Nederland bij aan een andere inrichting van de samenleving rond de thema’s eten, zorg en geld. Wie zijn bij deze initiatieven betrokken, wat doen zij precies, hoe doen zij dat en waartoe leidt dit?Deze vragen worden per initiatief in detail onderzocht. Deze initiatieven zijn: Uit Je Eigen Stad, Hotspot Hutspot, Thuis Afgehaald, Zorgcoöperatie Hoogeloon, Unal zorg, Eigen Kracht Centrale, Stro, Qoin en Money Money Money. De data van dit project bestaat uit transcripties van afgenomen interviews.Dit is het interview over geld met Dette Glashouwer van het initiatief Money Money Money. Dit interview is op aanvraag beschikbaar. Onder het tabblad 'Data files' vindt u de knop 'Request permission' om uw aanvraag in te dienen."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities","Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Spiritualiteit"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Maatschappelijke vernieuwing"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Zorg"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Eten"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Geld"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Levenskwaliteit"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Waarden"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Zorg voor het zelf"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Reflexieve praktijken"}},{"keywordValue":{"typeName":"keywordValue","multiple"
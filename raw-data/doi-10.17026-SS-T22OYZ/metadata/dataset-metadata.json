{"license":"CC0-1.0","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Who did all the work? The hidden labour of colonial science"},{"typeName":"alternativeURL","multiple":false,"typeClass":"primitive","value":"https:\/\/nodegoat.leidenuniv.nl\/viewer.p\/82\/4312\/types\/all\/list\/"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"H. Vellinga"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit Leiden"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0009-0002-7232-0065"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"F. Sysling"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit Leiden"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0001-8097-1568"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"S. Kompier"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit Leiden"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0009-0008-8889-4737"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"T. Niederer"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit Utrecht"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Sysling, Fenneke"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit Leiden"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Dit is een database met biografische informatie over niet-Europese bijdragers aan de veldwetenschappen (botanie, zoölogie, antropologie, geologie, paleontologie) in Nederlands-Indië tussen 1890 en 1962. Deze informatie komt hoofdzakelijk uit gepubliceerde reis- en expeditie-verslagen van Europese wetenschappers. De dataset is bedoeld om verder onderzoek naar de rol van inheemse mensen in koloniale wetenschap in Nederlands-Indië aan te moedigen, door het toegankelijker maken van biografische informatie. \n\nZie de handleiding voor meer informatie over de inhoud van de database en hoe hij te gebruiken is.\n\nDe database is tevens te gebruiken in een interactieve omgeving, gemaakt met Nodegoat. (https:\/\/nodegoat.leidenuniv.nl\/viewer.p\/82)\n\nDe database is gecreëerd voor het project ‘ Who did all the work? The hidden labour of colonial science’ aan de Universiteit Leiden, wat liep van september 2023 tot maart 2024. (universiteitleiden.nl\/en\/research\/research-projects\/humanities\/who-did-all-the-work-the-hidden-labour-of-colonial-science)\n\nDe dataset bestaat uit bestanden over (1) personen (2) onderzoeksprocessen (3) bronnen (4) relaties tussen personen, bronnen en onderzoeksprocessen en (5) import voor in Nodegoat."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"History of Science"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Wetenschapsgeschiedenis"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Colonialism"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Kolonialisme"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Dutch East Indies"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Nederlands-Indië"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Wetenschappelijke expedities"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Scientific expeditions"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2024"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Project Leader"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"F. Sysling"}},{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Researcher"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"H. Vellinga"}},{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Researcher"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"S. Kompier"}}
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This database was produced in the context of the dissertation \"A Truth Universally Acknowledged. Dutch Investment in French Colonial Resources, 1717-1792\", as part of NWO VICI project VI.C.191.027. This database lists the accreditation status of 33 brokers (makelaars or courtiers) in French cash crops, active in Amsterdam in the eighteenth century. The accreditation status of these brokers was checked in two source types. The first are the notarial archives of Amsterdam, preserved by the Amsterdam City Archives. The second are early modern Dutch newspapers, preserved by the Royal Library of the Netherlands. All information on the archival sources, selection mechanisms, and form of the database can be found in the protocol."
                }
              }
            ]

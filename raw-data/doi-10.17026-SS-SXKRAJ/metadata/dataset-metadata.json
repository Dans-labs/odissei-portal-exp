{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Diasporische herinneringen van Bosnische Nederlanders, interview 02"},{"typeName":"subtitle","multiple":false,"typeClass":"primitive","value":"Levensverhalen van Bosnische Nederlanders die zich actief bezighouden met de herinnering aan de genocide in Srebrenica"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"M. Uittenbogaard"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"https:\/\/ror.org\/04dkp9463","expandedvalue":{"scheme":"http:\/\/www.grid.ac\/ontology\/","termName":"University of Amsterdam","@type":"https:\/\/schema.org\/Organization"}},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"https:\/\/orcid.org\/0000-0001-7177-436X"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Uittenbogaard, Marjolein"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Meneer groeide op in de Bosnische regio Republika Srpska en in Kroatië. Hij maakt het uitbreken van de oorlog in Kroatië mee in Zagreb. Hij vlucht eind 1992 vanuit daar naar Nederland, waar uiteindelijk zijn gezin herenigd wordt. Na een tijd in opvangcentra te hebben gewoond, vestigt de familie zich in Nederland. Meneer spreekt positief over zijn leven in Nederland en de band met zijn familie. \n\nVerder komen aan bod de relatie die meneer voelt tot beide Kroatië en Bosnië-Herzegovina. Ook reflecteert hij op de rol die de genocide in Srebrenica en de bredere Joegoslavische Oorlogen in zijn leven spelen, de impact die deze geschiedenis op hem heeft gehad, en hoe de collectieve omgang hiermee is veranderd over de jaren heen."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Srebrenica genocide"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Joegoslavische Oorlogen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Bosnië-Herzegovina"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Kroatië"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Zagreb"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Oorlogsvluchteling"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Verwerking"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Diaspora"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"oral history"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2023-04-20"},{"typeName":"depositor","multiple":false,"typeClass":"primitive","value":"Uittenbogaard, Marjolein"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2024-06-18"},{"typeName":"series","multiple":true,"typeClass":"compound","value":[{"seriesInformation":{"typeName":"seriesInformation","multiple":false,"typeClass":"primitive","value":"In dit onderzoek worden de Nederlandse nationale herinnering aan de genocide in Srebrenica en activistische herinneringen hiervan onder de Bosnische diaspora in Nederland onderzocht, met een focus op hoe deze herinneringen worden beïnvloed door ideeën van slachtofferschap en daderschap. Om dit te doen worden culturele en persoonlijke expressies van herinneringen geanalyseerd. De oral history interviews die worden afgenomen in het kader van dit onderzoek ondersteunen de analyse van persoonlijke herinneringen van leden van de Bosnische diaspora in Nederland die zich actief bezighouden met de herinnering aan de Srebrenica genocide."}}]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Marjolein Uittenbogaard"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Yes"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D34000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D34000","termName":[{"lang":"nl","value":"Geschiedenis"},{"lang":"en","value":"History"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]},{"typeName":"dansCollection","multiple":true,"typeClass":"primitive","value":["https:\/\/vocabularies.dans.knaw.nl\/collections\/ssh\/cfa04ed6-4cd0-4651-80cb-ed4ca8fa14f3"],"expandedvalue":[{"@id":"https:\/\/vocabularies.dans.knaw.nl\/collections\/ssh\/cfa04ed6-4cd0-4651-80cb-ed4ca8fa14f3","vocabularyUri":"http
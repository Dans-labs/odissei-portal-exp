          {
            "typeName": "dataSources",
            "multiple": true,
            "typeClass": "primitive",
            "value": [
              "The survey was offered to a random sample of clients registered with the Institute for Employee Benifit Schemes (Uitvoeringsinstituut WerknemersVerzekeringen UWV). Only clients were selected who had recently experienced chronic health problems that limited their labour participation, who consequently received (parial) disability benifits according to the 2006 legislation. This sample was supplemented with persons for whom the 'Return to work scheme for the partially disabled' (Regeling werkhervatting gedeeltelijk arbeidsgeschikten, WGA) had stopped during the period 2006-2008."
            ]
          }
        ]

            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij de inrichting van het natuurgebied “Over de Maas” is een aantal scheepswrakken aangetroffen. Van het wrak ODM7 is een reeks geselecteerde monsters aangeleverd voor dendrochronologisch onderzoek. Nadat enkele ingemeten monsters minder jaarringen bleken te bevatten dan ingeschat was is voor de rest een nieuwe selectie gemaakt waarij drie monsters gedeselecteerd zijn. In totaal zijn 11 monsters onderzocht; één beuken (Fagus sylvatica L.) plank en tien eiken (Quercus spp.) elementen. Hiervan kunnen er 7 gedateerd worden, waaronder de beuken plank.\nDe meest nauwkeurige datering komt van het berghout met vondstnr. 330. Hiervoor kan een kapinterval rond 1483 geschat worden. De overige dateringen – zonder spinthout -  vallen enekele decennia eerder, wat te verwachten valt.\nTwee elementen (vondstnr. 269 en 329) zijn uit dezelfde boom afkomstig. Hiervoor is de middelcurve 25.041.B01 gemaakt."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-03-30"
                }
              }

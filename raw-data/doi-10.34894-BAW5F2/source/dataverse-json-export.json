            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset is connected to the NWO project \"The Everyday Life of Media Fans\" (PGW.19.024). <br>\n\nIt contains: <br>\n(a) Survey results of an exploratory survey on fictional worlds, fandom, and everyday life, held to obtain initial information on what draws fans to their favorite fictional worlds and what routines and experiences they have surrounding these worlds; <br>\n(b) Interview guide for semi-structured interviews and media go-alongs focused on research participants' fandom history, their affinity with fictional worlds, their fan accounts, and their everyday life; <br>\n(c) Materials for conducting a solicited diary study on fandom activities: diary instructions, diary entry forms, and a debrief guide."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026"
                }
              }
            ]

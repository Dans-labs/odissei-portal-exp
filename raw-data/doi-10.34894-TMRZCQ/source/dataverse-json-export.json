          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset was produced as part of the research project that aims to investigate the relationship between academic stress, mental fatigue and training load in adolescent soccer players. Using a prospective cohort design, 35 players (age 16.1 ± 1.2 years; length ± 8.8 cm; body mass 64.4 ± 9.9 kg)  were monitored for the second half of the 2022-2023 season. Players reported academic stress, mental fatigue and rating of perceived exertion on a daily basis. In addition, anonymized GPS and heart rate data were collected during training sessions using Polar Team Pro. After multiple imputation, multilevel analysis was conducted to predict internal load, i.e. Rate of Perceived Exertion (RPE) and Training Impulse (TRIMP).\n\nThe dataset contains the anonymized data from the training sessions, as well as the accompanying codebooks, documentation and scripts. As the dataset does not contain sensitive information, it can be used freely."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-06-19"
                }
              }

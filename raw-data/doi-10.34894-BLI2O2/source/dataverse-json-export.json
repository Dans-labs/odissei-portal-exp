                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Poortstraat 70 te Oldenzaal is een eiken (Quercus sp.) paalstomp aangetroffen. Uit het dendrochronologisch onderzoek volgt een datering van de laatste jaarring in 1511. Dit correspondeert met de spinthoutgrens, waarmee het kapinterval rond 1526 komt te liggen."
                },

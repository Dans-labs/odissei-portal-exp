              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij de inrichting van het natuurgebied “Over de Maas” is een aantal scheepswrakken aangetroffen. Van het wrak ODM5 is een monster aangeleverd voor dendrochronologisch onderzoek. Het lijkt om een eiken (Quercus sp.) huidplank te gaan.\nDe laatste jaarring van het monster valt in 1440. Het spinthout ontbreekt dus kan alleen bepaald worden dat het hout ergens na 1449 gekapt is."
                },

                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij het archeologisch onderzoek ter plaatse van de Rode Weeshuisstraat te Groningen is een boomstamput aangetroffen. Na waardering is hier een monster van aangeboden voor dendrochronologisch onderzoek om de ouderdom vast te stellen. Hoewel er voldoende jaarringen aanwezig waren, kon er geen bevredigende gelijkenis met het referentiemateriaal gevonden worden."
                },

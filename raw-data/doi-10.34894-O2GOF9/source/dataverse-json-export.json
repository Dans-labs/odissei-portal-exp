            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Selection policy for the DANS Data Stations. The DANS Data Stations are domain-specific repositories hosted by DANS, the Dutch national centre of expertise and repository for research data. The selection policy records the criteria under which the presented datasets or other digital objects meet the goals for which DANS has implemented the Data Stations, namely for the archiving and publication of research data to enable reuse. It specifies the adopted criteria which DANS uses to determine whether a dataset or another digital object will be accepted into the Data Stations.\n\nThe document consists of an English and a Dutch version of the Policy."
                }
              }
            ]

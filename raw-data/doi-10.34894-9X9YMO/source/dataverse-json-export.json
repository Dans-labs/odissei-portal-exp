            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The repository includes:\n- A data file containing 1) the experimental results of one strain of Microcystis sp. in batch cultures conditions (high CO2 levels, N-limitation, P-Limitation and Light limitation); 2) the field results from the cyanobacterial community of size 0.5 to 10 micrometers, including the abundance and trait values; 3) the environmental variables of Lake Grote Plas; 4) Raw data from flow cytometry clustering of Microcystis cultures; 5) Results of nutrient bioassays.\n- A R markdown file containing the README of the code.\n- 4 R codes to reproduce statistical analyses and figures."
                },
                "dsDescriptionDate": {

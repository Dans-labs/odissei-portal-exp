                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The purpose of this research and dataset was to evaluate the implementation of a 9-month practice nurse led physical activity (PA) program deliverd from general practice at a patient level. Specific aims were to:<br>\n1) compare characteristics between patients participating in the PA program and patiënt not participating, <br>\n2) to evaluate changes in health outcomes (i.e. fatigue, depression, anxiety, quality of life, physical function, PA) over time, <br>\n3) to evaluate program adherence (i.e. attendance of counseling sessions, activity tracker use)."
                },
                "dsDescriptionDate": {

              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This data set contains meta data about more than a million third-party Android application that were collected from the Google Play store between 2017 and 2019. Two privacy scores were calculated for each application based on: permission requests, broadcast receivers, and user's privacy preferences. The scores also depend on other applications in the app's category. The scores were calculated based on two published formulas. The first fomulas was proposed by Mohsel et al. and published in TrustCom '18, \"Countering intrusiveness using new security-centric ranking algorithm built on top of elasticsearch\". The second formula was published in SPSM '16 Taylor, and Martinovic, \"SecuRank: Starving Permission-Hungry Apps Using Contextual Permission Analysis\"s"
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2021"
                }
              }
            ]
          },

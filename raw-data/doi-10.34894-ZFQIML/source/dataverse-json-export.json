          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Van de opgraving ter plaatse van de Kattenbrug te Groningen zijn 16 monsters aangeleverd voor dendrochronologisch onderzoek. Over de context van de monsters is geen aanvullende informatie verstrekt. De monsters lijken afkomstig van palen en enkele zware planken.\nHet gaat hierbij om eik (Quercus sp.) en grove den (Pinus sylvestris L.).\nVan de 16 monsters zijn er 14 aangemerkt voor dendrochronologisch onderzoek.\nIn twee gevallen is vastgesteld dat vondsten uit dezelfde boom afkomstig zijn. Voor de twee grenen planken met vondstnr.1 en M4 is de middelcurve 22.100.B01 gemaakt en voor de twee eiken balken met vondstnr. 52 en 62 is de middelcurve 22.100.B02 gemaakt.\nDe dateringen van het eikenhout vallen consistent rond het midden van de 17e eeuw. Aan de hand van de wankant op vondstnr. 52 kan een kapinterval in de herfst/winter van 1652/53 vastgesteld worden. De kapintervallen voor de monsters met incompleet spinhout vallen ook rond dit jaartal. \nHet grenenhout dateert overwegend in de 16e eeuw. De wankant is echter nergens bewaard gebleven, waardoor geen afgebakende kapintervallen bepaald kunnen worden. Het is niet duidelijk of dit contemporain is met het eikenhout. De datering van vondstnr. 13.1 aan het begin van de 18e eeuw lijkt nergens bij te passen."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-04-05"
                }
              }
            ]

              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset is a collection of quotes from local and international newspapers on hard coal phase-out in Romania (translated into English), collected for the period of 1962-2015 published within three weeks around a pre-selected key event (see paper) and on every fifth Day of the Miner starting with 1962.\nThe newspapers included are:\nAdevărul\nScânteia\nRomânia Liberă\nCronica Văii Jiului\nZori Noi\nCurierul Văii Jiului\nZiarul Văii Jiului\nCuvîntul Liber\nSteagul Roșu\nDrumul Socialismului\nFinancial Times"
                }
              }
            ]

          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Op de nieuwbouwlocatie ’t ValkenTij in Valkenburg is archeologisch onderzoek uitgevoerd waarbij de een pannenfabriek en een kalkovencomplex is aangetroffen. Hiervan wordt vermoed dat deze uit de 16e of 17e eeuw dateren.\nVoor een nauwkeurigere datering zijn enkele monsters uit de houten fundering genomen voor dendrochronologisch onderzoek. Hierbij gaat het om vier maal grove den (Pinus sylvestris L.) en één maal eik (Quercus sp.).\nDe dateringen lijken op meerdere faseringen te wijzen. De oudste fase volgt uit kapseizoenen in de herfst/winter van 1589/90 en 1590/91 voor respectievelijk vondstnr. 175 en 113.\nEen volgende fase is gebaseerd op de kap van vondstnr. 102 en valt kort na 1627.\nVoor vondstnr. 54 kan geen afgebakend kapinterval bepaald worden, maar een kapjaar ergens na 1694 past niet bij de eerdere fases.\nVoor vondstnr. 101 kan op vergelijkbare wijze geen afgebakend kapinterval bepaald worden. Dit valt ergens na 1587 en kan niet met zekerheid tot één van de fases gerekend worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-06-01"
                }
              }
            ]
          },

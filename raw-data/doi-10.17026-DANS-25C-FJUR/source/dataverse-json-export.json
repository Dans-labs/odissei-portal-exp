                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>HANDLEIDING TOT DE KENNIS VAN ONZE VADERLANDSCHE SPREEKWOORDEN EN SPREEKWOORDELIJKE ZEGSWIJZEN, BIJZONDER AAN DE SCHEEPVAART EN HET SCHEEPSLEVEN, HET DIERENRIJK EN HET LANDLEVEN ONTLEEND, DOOR J.P. SPRENGER VAN EYK, PREDIKANT TE ROTTERDAM, Lid der Maatschappij van Nederlandsche Letterkunde te Leiden en van het Provinciaal Utrechtsch Genootschap van<br>Kunsten en Wetenschappen. Te Rotterdam, bij J. VAN BAALEN & ZOON, MDCCCXLIV.<br><br>Transcriptie.</p>"
                }
              },

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Pragmatic multicentre open-label randomized controlled trial conducted in seven centres in the Netherlands (n=308), comparing Treat-to-Target (T2T) versus Treat-to-Avoid-Symptoms (T2S) strategies in patients with early gout. Participants were followed for 24 months. Data include baseline characteristics, laboratory measurements (including serum urate and eGFR), medication use, gout flares, adverse events, and patient-reported outcome measures collected every three months. Data were captured using Castor EDC. Access to the data is subject to consent and approval by VieCuri Medical Center."
                }
              }
            ]
          },

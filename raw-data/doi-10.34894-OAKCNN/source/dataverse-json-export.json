            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Literature has established that, on a macroeconomic level, income inequality has a negative effect on average life satisfaction. An unresolved question is, however, which income groups are harmed by income inequality. In this paper we investigate this relationship at the microeconomic level combining national indicators of income inequality with individual data of life satisfaction from the World Values Survey for 39 countries over a period of 25 years."
                }
              }
            ]
          },

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Dit zijn de shapefiles van vier van de acht steden die onderdeel uitmaken van het grotere project Ranking the towns:  Amsterdam, Utrecht, Den Bosch en Deventer. Voor elk van deze vier steden is een shapefile gemaakt met de ontwikkeling van het stedelijk oppervlak tot omstreeks 1560 en een shapefile met bouwblokken omstreeks 1560. Voor Amsterdam is ook een shapefile met bijzondere gebouwen gemaakt.</p>"
                }
              }
            ]

            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The purpose of this dataset is to investigate the relationship between reclaims (financial repayments required after overpayments of social welfare) and the non-take-up of social welfare benefits. Through two preregistered experiments with a total of 472 participants, the study explores whether the experience of reclaims discourages individuals from continuing to access social welfare, particularly when reclaims lead to indebtedness."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025"
                }
              }
            ]

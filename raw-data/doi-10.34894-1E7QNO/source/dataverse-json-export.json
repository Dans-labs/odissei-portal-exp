              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains a spreadsheet with an overview of the controlled vocabularies used in the DANS Data Station Social Sciences and Humanities (SSH) as of December 2025.\n<br>\n<br>\nThe DANS Data Station SSH is a trustworthy digital repository for research data in the SSH domain offered by DANS in the Netherlands. https://ssh.datastations.nl/ \n<br>\n<br>\nIn the spreadsheet the metadata fields are listed for which a user of the DANS Data Station SSH can select a term from an existing vocabulary. Next to the field, the Vocabulary Name is provided and a URI where more information about the Vocabulary can be found.\n<br>"
                }
              }
            ]

{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Interview met Sanneke Stigter over Oral History, Amsterdam, 20 januari 2025"},{"typeName":"subtitle","multiple":false,"typeClass":"primitive","value":"Over interviews en mondelinge geschiedenis voor het vakgebied conservering"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Josephine Kymmell"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Josephine Kymmell"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit van Amsterdam"}},{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Data Steward"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit van Amsterdam"}},{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Sanneke Stigter"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit van Amsterdam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Sanneke Stigter is Assistent Professor van de master Conservation and Restoration of Cultural Heritage aan de Universiteit van Amsterdam. Ze is gespecialiseerd in hedendaagse kunst en kunstenaarsinterviews. Sinds 2003 geeft ze hier les in in Finland en Denemarken en sinds 2007 aan de UvA. In dit interview vertelt ze over de museumpraktijk en welke rol interviews en restauratoren daarin spelen. Het gaat ook over de waardering van restauratoren. Ze vertelt over het gebruik van interviews en mondelinge geschiedenis voor het museum en tentoonstellingen, alsook over Inside Installations en de etnografische onderzoeksmethode (autoethnography)."},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2025-01-25"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"oral history (discipline)"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"Art and Architecture Thesaurus"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"http:\/\/vocab.getty.edu\/page\/aat\/300054402"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"conservators"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"conservation of cultural heritage"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"collections management functions"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"collections management functions"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"http:\/\/vocab.getty.edu\/page\/aat\/300417636"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"collections care"},"keywordVocabulary":{"typeName":"keywordVocabula
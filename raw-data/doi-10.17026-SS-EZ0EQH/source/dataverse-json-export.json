            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Prof.dr. Loet Leydesdorff (1948-2023) was a highly impactful and prolific researcher who was one of the first to publish both code and data related to his publications on a website (Scopus h-index of 89, Google Scholar 124). \nHe maintained the website himself. Over the years, this website has grown into a significant archive of his published data, and many of his publications refer to locations on https://www.leydesdorff.net.\nThe heirs of Loet are committed to preserving the website and its data for the scientific community. While the website will remain online for the foreseeable future, this dataset provides a more durable, permanent archive."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-06-09"
                }
              }
            ]

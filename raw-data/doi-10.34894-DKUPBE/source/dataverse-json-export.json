            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Om de ouderdom van de boerderij aan Dal 4 te Paasloo te bepalen is een aantal boorkernen genomen. Het gaat hier om vijf elementen van eik (Quercus spp.) en grenen (Pinus sylvestris L.), waarvan er één geschikt bleek voor onderzoek. De laatste jaarring van dit monster dateert in 1600. De wankant is hier niet aanwezig, waardoor alleen bepaald kan worden dat het hout ergens na 1600 gekapt is."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",

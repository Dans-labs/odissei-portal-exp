            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Dorpstraat 42 in Ouderkerk aan den IJssel zijn twee beerputten aangetroffen. Van de bodemplanken van de beerputten zijn monsters genomen voor dendrochronologisch onderzoek.\nHierbij gaat het om planken van fijnspar (Picea abies Karst.) en grove den (Pinus sylvestris L.). Alleen vondstnr. 115.2 kon voor onderzoek aangewezen worden.\nHiervoor konden echter geen resultaten geworden worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-10-03"
                }
              }

                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains information about the controlled vocabulary IdentifierType used in the DANS Data Station Social Sciences and Humanities (SSH).\n<br>\n<br>\nThe DANS Data Station SSH is a trustworthy digital repository for research data in the SSH domain offered by DANS in the Netherlands. https://ssh.datastations.nl/ \n<br>\n<br>\nIn the DANS Data Station SSH various vocabularies are used. This dataset provides information about the IdentifierType vocabulary. It lists the elements a user can chose from as well as the source from which the vocabulary term was selected (if applicable). \n<br>"
                }

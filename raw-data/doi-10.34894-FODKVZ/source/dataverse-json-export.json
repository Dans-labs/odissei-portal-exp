            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Monument Vandekerckhove voerde archeologisch onderzoek uit er plaatse van de Oude Burgseweg te Oudenburg (B). Van het aangetroffen houten vondstmateriaal zijn drie monsters aangeleverd voor dendrochronologisch onderzoek. Het gaat hierbij om eik (Quercus sp.) en twee maal beuk (Fagus sylvatica L.). Over de context van de vondsten is geen informatie verstrekt.\nAlleen het eiken monster bevatte voldoende jaarringen voor dendrochronologisch onderzoek.\nOndanks de uitstekende kwaliteit van het monster konden geen resultaten gevonden worden."
                },
                "dsDescriptionDate": {

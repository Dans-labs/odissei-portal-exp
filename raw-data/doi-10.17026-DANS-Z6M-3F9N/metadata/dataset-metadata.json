{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Sociale impact van fysieke afstand op kwetsbare populaties tijdens COVID-19 (2020): herhaalde interviews met mensen met licht verstandelijke en andere beperkingen"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:215972"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"D.H. de Vries"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit van Amsterdam"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0001-7455-0628"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"D.H. de Vries"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Deze dataset is gecollecteerd in het kader van het ZonMw gefinancierde project “Sociale impact van fysieke afstand op kwetsbare populaties tijdens COVID-19” in 2020 (projectnummer 10150062010007). In dit project onderzochten we de effecten van sociale isolatie op kwetsbare groepen in Nederland ten tijde van ‘de lockdown’ periode (van 15 maart 2020 tot 23 mei 2020) en de periode van ‘de versoepeling’ van de maatregelen tot het einde van het onderzoek (de periode na 23 mei 2020-1 juli 2020). Voor meer informatie zie ook www.coronatijden.nl.Deze dataset beschrijft de ervaringen van mensen met licht verstandelijke of andere beperkingen. In de periode van half april tot half juni zijn 22 mensen met licht verstandelijke of andere beperkingen individueel geïnterviewd. De data is gecollecteerd door een ‘samengesteld’ team van onderzoekers verbonden aan HvA (FMR\/Lectoraat Langdurige zorg en ondersteuning), Clientenbelang Amsterdam, UvA (FMG\/Programmagroep Political Sociology: Power, Place and Difference) en het Ben Sajet Centrum. Voor meer informatie zie de metadata file in de dataset."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date: april- juni 2020 (data collection)"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Medicine, Health and Life Sciences","Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"COVID-19"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"corona"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"sars-cov-2"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"sociale isolatie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"fysieke afstand"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"thuisisolatie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"beleid"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"sociale kwetsbaarheid"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Mensen met licht verstandelijke beperkingen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"LVB"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"longitudinaal"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"kwalitatief"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"zorg"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"preventie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"kwetsbare burgers"}}]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2021-07-10"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Other"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"R. Kwekkeboom (Hogeschool van Amsterdam)"}},{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Researcher"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"M. Van Schravendijk (Hogeschool van Amsterdam)"}},{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Researcher"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"P. Willems (Clientenbelang Amsterdam)"}},{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Researcher"},"contributorName":{"typeName":"contributorName",
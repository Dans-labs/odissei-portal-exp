          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This re-labeled dataset builds upon the initial systematic review by van de Schoot et al. (2018; DOI: 10.1080/00273171.2017.1412293), which included studies on post-traumatic stress symptom (PTSS) trajectories up to 2016, sourced from the Open Science Framework (https://osf.io/vk4be/). Originally consisting of 7,511 records, additional de-duplication, and stricter inclusion criteria—such as the requirement for a persistent identifier (e.g., DOI, PubMed ID)—reduced the dataset to 4,544 records and was added to the SYNERGY collection and published at DataverseNL (De Bruin et al., 2023; doi:10.34894/HE6NAQ0).\n\nWe revisited the labeling decisions as part of the FORAS project (funded by the Dutch Research Council and pre-registered at PROSPERO ID; under no. CRD42023494027). We comprehensively reviewed and re-applied inclusion criteria, incorporating updates such as stricter definitions of PTSS, acceptance of treatment studies, inclusion of PTSD cluster subscores, allowance for overlapping datasets, and the correction of a few labeling errors. The detailed screening logbook is available at OSF (https://osf.io/b9gd3/). \n\nThe re-labeled dataset is available under a permissive license. Full methodological details, including updates and modifications, are documented in the accompanying codebook."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-11-20"
                }
              }
            ]

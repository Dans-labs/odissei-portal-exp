            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains a data-version of the indexes of the archives of the Dutch East India Company, specifically the 'Overgekomen Brieven & Papieren' or 'OBP'. It combines the digitized indexes generated by TANAP (Towards a New Age of Partnership), which covered most of the archival indexes (inv. no. 1053-1669; 2325-3987; 7527-9179; 10406-10435; 12362-12369) with new indexes drawn from typoscripts found in the Dutch National Archives (1053-2325; 4374-4447) that fill in the gaps left by TANAP due to time constraints."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025"
                }
              }
            ]
          },

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Full new transcriptions of the subscriptions to Mark's Gospel in the manuscripts included in the ECM (<i>Editio Critica Maior</i>) of Mark with corrections to both the ECM apparatus and the transcriptions of the NT.VMR (<a href=https://ntvmr.uni-muenster.de/>https://ntvmr.uni-muenster.de/</a>) database. The transcriptions presented in the data will be presented in two articles that will be referenced here when published. The first appeared as Elmelund, Conrad Thorup, and Tommy Wasserman. “The Subscriptions to Mark’s Gospel and History of Reception.” <i>New Testament Studies</i> 69, no. 4 (2023): 429–44. https://doi.org/10.1017/S0028688523000139.</p>"
                }
              },
              {
                "dsDescriptionValue": {

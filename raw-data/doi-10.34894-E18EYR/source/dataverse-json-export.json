          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Data were collected in a mixed-method survey study conducted in 2024, in which the perspectives of Dutch L1 teachers on generative AI were assessed. In the study, teachers were asked to indicate the current state of affairs regarding the use of generative AI in their schools (by both teachers and students). Moreover, their willingness to adopt generative AI was examined, using statements from TAM3 (technology acceptance model). The degree of concern regarding a number of GenAI-related issues was assessed, and the teachers were asked to describe the possibilities and challenges they see for the future implementation of generative AI in L1 education. Participants were teachers of the school subject Dutch Language and Literature in Dutch secondary education. They teach different educational levels: lower vocational (vmbo), higher vocational (havo), and pre-university (vwo) education. A representative sample of schools was taken. 124 teachers participated in the survey study."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-04-03"
                }

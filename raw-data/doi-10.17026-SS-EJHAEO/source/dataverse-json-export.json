            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The HBO Monitor is an annual survey amongst higher professional education graduates. It provides insight into the labour market position of graduates and shows to what extent study programmes prepare students for the labour market. The HBO Monitor has been conducted for more than 30 years. Every survey year, in the autumn (September/October), graduates of hbo associate degree, bachelor and master programmes are approached with the request to participate in the study by filling in an online questionnaire. The HBO Monitor sample is based entirely on the participation of individual universities of applied sciences."
                }
              }
            ]

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Bovenkerkseweg te Stolwijk is een aantal houten vondsten aangetroffen. Het gaat hierbij voornamelijk om constructiehout in de vorm van palen en planken. Het hout dat hiervoor gebruikt is lijkt een mix van lokaal aanwezig hout zoals populier (Populus sp.) en wilg (Salix sp.) en geïmporteerd hout zoals grove den (Pinus sylvestris L.) en fijnspar (Picea abies Karst.). Daarnaast is een eiken (Quercus sp.) duig dendrochronologisch onderzocht (vondstnr. 158). De laatste jaarring hiervan dateert in 1652. Omdat er geen spinthout of wankant aanwezig is kan hiervoor geen afgebakend kapinterval bepaald worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",

                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Om de invloed van de kiesdeler als kiesdrempel te bepalen bij gemeenteraadsverkiezingen heb ik de uitslagen van de >100.000 gemeenten in 2022 bekeken. Dit zijn de berekeningen voor het bepalen hoe de zetelverdeling na de gemeenteraadsverkiezingen eruit had gezien indien een lijst pas in aanmerking zou komen voor een restzetel bij het behalen van de kiesdeler."
                },

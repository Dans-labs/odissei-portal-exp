          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset consists of the (1) invitational letter, (2) interview guide, and (3) transcripts of the focus group discussions with lay citizens. This data is restricted in view of the philosophical character of its content, which the GDPR considers sensitive data. For access to this dataset, please contact the authors. \r\n\r\nIn addition to the data stored in this set, we have also conducted one focus group interview with ethicists and lawyers. The transcript of this focus group with experts and ensuing code list cannot be made available to safeguard the participants' anonymity in view of the small pool of expertise on the topic."
                }
              }
            ]

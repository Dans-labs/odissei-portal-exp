              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Data derived from weekly public opinion polls in the Netherlands in 1962 concerning social and political issues. Samples were drawn from the Dutch population aged 21 years and older.</p><p>All data from the surveys held between 1962 and 2000 are available in the DANS data collections.</p><p>Background variables:<br>Sex / age / religion / income / vote recall latest elections / party preference / level of education / union membership / professional status / < self > left-right rating / party alignment / province / degree of urbanization / weight factor.</p><p>Topical variables:<br>n6235: Knowledge about treaty between the Netherlands and Indonesia over New Guinea / Judgment about treaty and why.<br>n6242: People from other countries who resemble the Dutch.<br>n6249: Charity action on radio and TV, see the study number P0001d in Open het dorp 1962 : Marathon radio en TV campagne / Radio-TV campaign for handicapped people 1962.</p>"
                }
              }
            ]
          },

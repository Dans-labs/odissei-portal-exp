              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "J. Verrijckt Archeologie & Advies voerde archeologisch advies uit ter plaatse van de Koningsbaan in Heist-op-den-Berg. Hierbij is een beukenhouten (Fagus sylvatica L.) boomstamput aangetroffen. Dit is zeer ongebruikelijk aangezien hier doorgaans eik (Quercus sp.) voor gebruikt wordt. Bij de auteur is één ander beukenhouten exemplaar bekend. Deze is aangetroffen in Simpelveld (NL) en dateert in of kort na 1022. \nHet hier beschreven exemplaar bevat ondanks de bescheiden afmetingen voldoende jaarringen en kan gedateerd worden in 1101. Het is niet duidelijke of de wankant aanwezig is, gezien de oppervlakkige verwering. Het kapjaar van het hout komt daarmee in of kort na 1101 te liggen."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-11-28"
                }
              }

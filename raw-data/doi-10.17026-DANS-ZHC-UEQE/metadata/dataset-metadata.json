ple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"<p>Art conservators Tirza Mol and Sanneke Stigter talk with Alessandro Mendini and his brother Francesco Mendini about the drawer cabinet 'Nigritella Nigra' (1993) from the Museum Market furniture series, produced by Design Gallery Milano. The production process, techniques and materials used are discussed in light of the idea of the design. The aim is to gain more insight into the relation between the work's concept and its current physical condition to inform decision-making for the conservation and presentation of the artwork as part of the Rijksmuseum collection.<\/p>"}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Modified: 2019-04-23"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Alessandro Mendini"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"http:\/\/vocab.getty.edu\/page\/ulan\/500013850"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Francesco Mendini"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"http:\/\/vocab.getty.edu\/page\/ulan\/500069555"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Nigritella Nigra"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Restoration"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"http:\/\/vocab.getty.edu\/page\/aat\/300053742"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"prim
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains metadata from online news coverage of the arrest and prosecution of female TikTok influencers in Egypt, a case labelled by the media as \"the TikTok Girls\" case. The data were collected from five major Egyptian and Arabic-language news websites between 2020 and 2024. It includes article-level metadata (such as titles, publication dates, authors, and URLs). The dataset was compiled to examine how these prosecutions and the women involved have been represented and debated in digital news media during this period."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>\"Elly Go werd in 1933 geboren in Bandung en groeide op in een groot Chinees-Indisch gezin. Tijdens de oorlog ging zij naar de Chinese school en leerde het gezin zich aanpassen aan moeilijke omstandigheden. Er werd meegewerkt in het gezin, handel gedreven en geprobeerd te overleven, terwijl angst, controle en discriminatie deel uitmaakten van het dagelijks leven. Na de oorlog volgde zij onderwijs in Bandung en behaalde zij eindexamen. In 1955 vertrok zij met haar ouders per boot naar Nederland, waar haar broers al woonden.</p><p>\n\nIn Nederland bouwde Elly Go stap voor stap een zelfstandig bestaan op. Zij volgde opleidingen tot apothekersassistente, medisch analist en later farmacie, terwijl zij bleef werken en mede zorgde voor haar moeder. Ze werkte onder meer als analist, verbleef drie jaar in Canada en werd uiteindelijk apotheker in Bussum. Familie, doorzettingsvermogen en onderlinge steun lopen als vaste lijnen door haar verhaal. Ook de geschiedenis van haar broer, de oprichter van Go-Tan, en de betrokkenheid van de familie bij eten, ondernemerschap en pasar malams komen aan bod. Terugkijkend benadrukt zij eenvoud, nieuwsgierigheid, hard werken en het besef dat zij, ondanks moeilijkheden, een goed leven heeft gehad.\"</p>"
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-05-26"
                }
              }

          {
            "typeName": "title",
            "multiple": false,
            "typeClass": "primitive",
            "value": "Interview met Elly Go"
          },
          {
            "typeName": "subtitle",
            "multiple": false,
            "typeClass": "primitive",
            "value": "Apotheker Elly Go over jeugd in Bandung, migratie naar Nederland en een leven van hard werken, familie en zelfstandigheid"
          },
          {
            "typeName": "author",
            "multiple": true,
            "typeClass": "compound",

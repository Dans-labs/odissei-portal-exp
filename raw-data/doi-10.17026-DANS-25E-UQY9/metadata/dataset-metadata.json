{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Bridging Cultures-Comparison between refugees from war and non-war countries v2"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:93500"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"B.L. Leyendecker"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Ruhr-Universität Bochum"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"T.B.  Buchmüller"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Ruhr-Universität Bochum"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Since 2015 an increasing number of refugee children arrived in Germany. The federal government aims to facilitate these children’s access to German culture and language as early as possible. So-called Bridging Projects have been established to facilitate refugee children’s transition to public daycare centers. In this part of our study we focused on teacher reports (CTRF 1.5-5) of 116 young children aged 1.5 to 5 years of age from war vs. non-war torn countries and compared the groups regarding their mental health patterns and prevalence rates."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"'CTRF' and 'CBCL' are used interchangeably.The depositor provided the data file 'CTRF_merged_archiv_Dans_070917' in SAV format. DANS added the POR and DTA formats of this file to ensure preservation and accessibility."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Refugees"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Specificity"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Risk-Factors"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Mental Health"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Early Childhood"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Prevalence"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"PTSD"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"CTRF"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["English","German"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2017-06-06"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"T.B. Buchmüller (Ruhr-Universität Bochum)"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2018-06-25"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2018-05-07"}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRight
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset forms the supplementary of the article: Asymmetrical steps: Osteomorphological and metric patterns of cattle phalanges to determine anatomical position. <br><br>\nSupplementary 1 and 2 are the raw data. Supplementary 1 contains specimens with known phalangeal position, and supplementary 2 contains specimens with unknown phalangeal position. <br>\nSupplementary 3 is the R code used to process the raw data. <br>\nSupplementary 4 are the results of the statistical analyses and the principal component analysis (PCA). <br>\nSupplementary 5 is the excel template in which users can enter their own measurements to obtain probability scores of anterior versus posterior position of the phalanges."
                },
                "dsDescriptionDate": {

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains processed data supporting the publication \"Flexible and Skin-conformal Polypyrrole-based pH Sensors via Oxidative Chemical Vapor Deposition\". It has data related to 4-point probe measurements, X-ray scattering, UV-Vis, Fourier-transform infrared spectroscopy, XPS, stylus-profilometry, digital multimeter measurements, and analysis of SEM images. The accompanying Excel worksheet is organized with all data indexed by figure numbers corresponding to the main manuscript and supplementary information."
                },
                "dsDescriptionDate": {

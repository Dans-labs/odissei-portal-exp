          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de nieuwbouwloctie Laarveld bij Weert zijn de resten van enkele prehistorische waterputten aangetroffen. Om de ouderdom nader te bepalen zijn zeven monsters van drie waterputten aangeleverd voor dendrochronologisch onderzoek. Hiervan zijn er zes geschikt bevonden voor onderzoek. Het gaat hier telkens om planken van radiaal gekliefd eikenhout (Quercus spp.).\nVoor spoonr. 2105 zijn drie monsters aangeleverd. Deze zijn allemaal afkomstig uit dezelfde boom. Hiervoor is de middelcurve 25.098.B01 gemaakt. Deze kan gedateerd worden in 818 voor Chr. Op basis van de incomplete buitenste jaarring kan bepaald worden dat het hout in de zomer van 817 voor Chr. gekapt is.\nVoor spoornr. 2014 zijn twee monsters aangeleverd, waarvan er één (met wankant) gedateerd kan worden in 312 voor Chr. Dit hout is gekapt in de herfst/winter van 312/11 voor Chr.\nHet enige monster voor spoornr. 2122 dateert in 696 voor Chr. Spinthout of de wankant ontbreekt hier, dus kan er geen afgebakend kapinterval bepaald worden. Vermoedelijk is het hout ergens in de tweede helft van de 7e eeuw voor Chr. gekapt."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-12-01"
                }
              }
            ]

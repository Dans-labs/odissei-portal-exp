            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Labour Relations in India: 1800, 1900 and 2000 based on research conducted by Jan Lucassen and Rombert Stapel, some data corrected by Daan Jansen.\n\nData for 1800 is limited to Deccan. Data on Deccan has been included in a separate database for 1900, and data on Bihar has been included in a separate database for 1900 and 2000.\n\nIn addition, a digitization of Sykes's report on the Deccan used for the 1800 dataset has been uploaded."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-03-27"
                }
              }
            ]
          },
          {
            "typeName": "subject",
            "multiple": true,
            "typeClass": "controlledVocabulary",

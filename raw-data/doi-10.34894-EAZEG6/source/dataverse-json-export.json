            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The data was recorded from primary school children visiting a VR simulation. It contains questionnaire data on knowledge (about space), compassion and awe, the overview effect, presence and immersion. It also contains gaze data (angle of gaze away from center point area of interest in VR). In this study we investigated whether the overview effect could be recreated for these children, and what its impact was on learning."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2021-03-01"
                }

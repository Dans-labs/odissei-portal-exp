            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij het archeologisch onderzoek op het plangebied “De Hoge Regt” in Beek en Donk zijn twee boomstamputten aangetroffen. Dit is niet ongebruikelijk voor Middeleeuwse contexten, maar in dit geval zijn de putten aangetroffen in een Romeinse nederzetting. Dit is opmerkelijk en dendrochronologisch onderzoek moet uitsluitsel geven over de ouderdom van de boomstamputten. Hoewel beide boomstamputten voldoende jaarringen bevatten bleek het niet mogelijk goede resultaten te vinden.\nVoor zowel de Romeinse periode als de Middeleeuwen is voldoende regionaal referentiemateriaal beschikbaar, dus het ontbreken van resultaten is geen indicatie voor een Romeinse of andere ouderdom."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

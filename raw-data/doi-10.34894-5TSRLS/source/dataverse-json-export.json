            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Doel van dit onderzoek is om inzicht te krijgen in de voorkeuren van ziekenhuispatiënten en de variabelen die van invloed zijn op de wens om de voedings- en vochtinname te monitoren. In een crosssectioneel onderzoek zijn 150 patiënten in een Nederlands ziekenhuis bevraagd over algemene kenmerken, gezondheidsvaardigheden, digitale vaardigheden en voorkeuren ten aanzien van het zelf monitoren van hun voedings- en vochtinname."
                }
              }
            ]

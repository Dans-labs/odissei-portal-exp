            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Van het archeologisch onderzoek ter plaatse van de Vergrote Voorhaven Noord te Well zijn vier monsters aangeleverd voor dendrochronologisch onderzoek. Hierbij gaat het in alle geval om eiken (Quercus sp.) planken van enkele waterputten. \nUit het onderzoek blijkt dat M213 en M214 uit dezelfde boom afkomstig zijn en dat de vondsten uit de Romeins periode stammen. Er is geen spinthout of wankant aanwezig, waardoor er geen afgebakende kapintervallen geschat kunnen worden. De dateringen voor de verschillende spoornummers liggen echter betrekkelijk ver uit elkaar waardoor er niet waarschijnlijk lijkt dat de vondsten contemporain zijn."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-06-27"
                }
              }
            ]

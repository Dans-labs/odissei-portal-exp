            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This metadata set is designed to accompany the primary dataset of 366 documents that supports an academic paper examining the discursive construction of DigiD in Dutch political discourse. Specifically, the research focuses on how sociotechnical imaginaries of DigiD—its role, purpose, and evolution—are shaped through policy discussions and government communications.\n\nThe metadata provides comprehensive details about each document’s key attributes, facilitating the analysis of DigiD's role in Dutch governance from 2004 to 2023. The metadata is structured to help researchers navigate and interpret the primary dataset by outlining the following information for each document: document ID, document title, document URL, type of document, date of publication, document description, issuing instituition, source reference, and the citation fomat used in the paper."
                },
                "dsDescriptionDate": {

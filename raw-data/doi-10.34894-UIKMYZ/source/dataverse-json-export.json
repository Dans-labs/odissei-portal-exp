            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij het archeologisch onderzoek op de locatie van een 19e-eeuws erf aan de Graafland 83 in Groot-Ammers zijn enkele houten vondsten aangetroffen. Voor dendrochronologisch onderzoek is een paal en één element van een tonput aangemerkt. Hierbij ging het om eik (Quercus spp.). Daarnaast is een aangepunt paaltje op houtsoort onderzocht. Dit bleek populier (Populus sp.).\nHoewel beide dendrochronologische monsters van voldoende kwaliteit zijn kunnen er geen dateringen gevonden worden. Mogelijk ligt dit aan het gegeven dat het om losse monsters gaat eventueel in combinatie met de (vermoedelijk) recente aard van de context waarvoor weinig referentiemateriaal beschikbaar is."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-05-26"
                }
              }
            ]

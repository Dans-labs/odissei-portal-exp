            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Replication data for Chapter 4: The dataset named \"Chapter4_Dataset.dta\" and the Stata do-file \"Chapter4_DoFile.do\" are used in Chapter 4 of the thesis. The chapter uses data from students from the University of Campinas (UNICAMP), Brazil, between 2010 and 2020. The data comes from the university's Academic Board and International Office , shared after receiving the approval of the Brazilian Research Ethics Committee (Protocol 25285919 6.0000.8142). Given that the data used in this chapter is sensitive, containing information that can identify UNICAMP's students, the final dataset is encrypted and cannot be shared. To analyse the data, a combination of Propensity Score Matching and Difference in Differences is used."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

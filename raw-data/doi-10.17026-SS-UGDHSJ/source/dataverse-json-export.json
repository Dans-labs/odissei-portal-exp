          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Deze rapportage is de weerslag van het vooronderzoek naar de muurschilderingen die F.H. Bach maakte voor de kerk van Beltrum.<br>\nHet doel van dit vooronderzoek is een weloverwogen besluitvorming bij ingrepen aan de muurschilderingen. Het vaststellen van de betekenis en de conditie van de schilderingen is daarvoor essentieel.<br>\nDit vooronderzoek is onderdeel van een casus binnen het RCE project Leren van restauratieve ingrepen aan muurschilderingen uit de Moderne Tijd. Binnen dit RCE project worden een aantal restauraties van belangrijke muurschilderingen uitgebreider\ngevolgd. De verschillende casussen worden door de RCE gebruikt voor het opstellen van richtlijnen om zorgvuldig met schilderingen om te gaan. Op die manier wil de RCE het erfgoedveld en de eigenaren helpen om muurschilderingen zo goed mogelijk te behouden voor de toekomst."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-05-12"
                }
              }
            ]

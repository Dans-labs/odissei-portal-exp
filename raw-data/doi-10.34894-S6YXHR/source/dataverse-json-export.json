            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Als aanvulling op eerder onderzoek van de Kolksluis te Spaardam zijn drie monsters dendrochronologisch onderzocht. Twee monster bevatten ruim voldoende jaarringen, maar geen spinthout of wankant. Het derde monster is matig geschikt, maar hierbij is een deel van het spinthout bewaard gebleven.\nVoor de eerste twee monsters kunnen dateringen gevonden worden in de 18e en 19e eeuw. Hiervoor kan alleen de ondergrens van het kapinterval bepaald worden, maar het lijkt onwaarschijnlijk dat deze dezelfde fase vertegenwoordigen.\nHet monster met spinthout kon niet gedateerd worden. Vergelijkingen met het eerder onderzochte materiaal levert eveneens geen nieuwe resultaten op."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-03-21"
                }
              }

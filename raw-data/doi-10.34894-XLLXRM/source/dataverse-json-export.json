            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This repository contains an early modern Portuguese HTR model created at the IISH, designed for use in Loghi, an open-source HTR tool created at the Dutch Academy of Arts and Sciences Humanities Cluster (KNAW HuC). The model is designed to work primarily on early modern Portuguese material.\n\nThe repository contains the model along with a data envelope with information about the HTR model and the training pipeline, documenting the ground truth material used to train the model and the training parameters."
                },

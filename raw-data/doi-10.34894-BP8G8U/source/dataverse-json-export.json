            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This is a digital dataset of games in the Ludii General Game System and with related archaeological, historical, and anthropological evidence. It was created for the Digital Ludeme Project drawing from multiple disciplines, studies and perspectives. It documents the rules for games from 3500 BCE until the present day from around the world, and records the source of the information about the rules of games from the past. Relevant information recorded for each game includes geographical location, time period, rules, historical sources, and additional contextual details such as player age, gender and social status.\n\nThe latest version of this database can be found at:\n<a href=https://github.com/Ludeme/GameDatabase>https://github.com/Ludeme/GameDatabase</a>"
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",

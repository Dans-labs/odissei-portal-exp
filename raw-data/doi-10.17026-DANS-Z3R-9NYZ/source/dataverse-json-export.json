            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Dataset containing locations of theatres in the city of Amsterdam. Created by Charlotte Vrielink as part of her pre-PhD project at CREATE programme, University of Amsterdam, based on the print publication:  Logger, Bob, and Xandra Knebel. Theaters in Nederland sinds de zeventiende eeuw. Amsterdam: Theater Instituut Nederland, 2007, with the assistance of students Theatre Studies at the same university, supervised by Rob van der Zalm and Frans Blom. See also the online map created on the basis of the data: https://arcg.is/1ffD9T (27-05-2020). See also (in the documentation): C. Vrielink, 'In kaart gebracht. Een digitale theatergeschiedenis van Amsterdam. GIS als brug tussen distant en close reading,' 38.1 (2019) Ex Tempore, pp. 96-113.</p>"
                }
              }
            ]

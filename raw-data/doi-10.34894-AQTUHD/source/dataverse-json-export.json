          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "UKB’s working group Research Data has created an overview of research data management course materials from universities across the Netherlands. All working group members, as well as members of the associated National Coordination Point of Research Data Management (LCRDM), were asked to provide information on their RDM courses.\r\n<br><br>\r\nThe Data Information Literacy Competences Matrix by Purdue University (Nelson, S., & Megan, R., 2016) was used as a framework to collect this data. In an online spreadsheet, members filled in how their course mapped onto the framework, in terms of the content of their courses (if it addressed e.g. quality assurance, data visualisation, and data analysis), and at which level this content was offered (undergraduate, graduate, or senior). Other details such as schedules, trainers, and re-use licences were also registered. In addition to filling in the spreadsheet, members were asked to share their course materials in an online environment.\r\n<br><br>\r\nThe poster gives a visual overview of the collected data, clearly showing the landscape of RDM courses in the Netherlands, as mapped onto the Purdue competence matrix. A gap analysis has been performed late 2017 to investigate which aspects are not yet covered and possibly need further attention. Results of this gap analysis are added to the poster.The poster provides also details on where the data and course materials can be found. Both the data and the materials are made available on this publically accessible platform."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2018-01-17"
                }
              }
            ]

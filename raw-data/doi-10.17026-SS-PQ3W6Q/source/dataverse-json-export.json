            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Het SCP heeft in 2022 een online enquête laten uitvoeren onder jongeren. In deze enquête werd aan jongeren gevraagd hoe zij denken over de toekomst, de coronamaatregelen, over zichzelf en over hun relaties.\nDe dataverzameling is uitgevoerd door I&O Research in de periode mei tot juni 2022. De steekproef voor deze enquête is getrokken door het CBS. Jongeren van 12-15 jaar zijn benaderd via hun ouders. In totaal zijn 11.200 jongeren aangeschreven, er zijn 2092 (19%) complete vragenlijsten ontvangen."
                }
              }
            ]
          },

k de uitkomsten van deze kwantitatieve analyse. De resultaten van deze corpusanalyse zijn beschreven in Sangers, N. L., Evers-Vermeul, J., Sanders, T. J. M., & Hoeken, H. (2021). Narrative elements in expository texts: A corpus study of educational textbooks. Dialogue & Discourse, 12(2), 115–144. https:\/\/doi.org\/10.5210\/dad.2021.204<\/p>"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"kwantitatieve corpusanalyse"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"educatieve teksten, ,"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"concreetheid"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"voorstellingsvermogen"}}]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2018-12-12"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Other"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"J. Evers-Vermeul (Utrecht University)"}},{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Other"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"J.A.L. Hoeken (Utrecht University)"}},{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Other"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"T.J.M. Sanders (Utrecht University)"}}]},{"typeName":"grantNumber","multiple":true,"typeClass":"compound","valu
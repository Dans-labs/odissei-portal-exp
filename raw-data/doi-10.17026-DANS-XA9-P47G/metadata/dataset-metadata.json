{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Ziel van de Wederopbouw – Interview 035"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:144310"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"L. Schalkwijk"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Stichting Verhalenhuis Belvédère"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"M  Broekhuizen"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Vrije Universiteit Amsterdam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Voor ze het wist speelde ze in het Ro Theater als één van de twee Sissies. Later vormde ze 12, 13 jaar lang een muzikaal duo 'Breng je moeder mee' met Ina, de moeder van Loes Luca. Ze speelden in wijkcentra in en rond Rotterdam. De geïnterviewde is geboren in Noord, maar groeide op in Zuid, in de Goereesestraat, de laatste straat van Rotterdam, waar ze uitkeek op de oneindige grasvlaktes. Ze was enig kind, volgde als een van de eerste lichting meisjes de HBS-B; ongebruikelijk in die tijd. Ze schreef ook boeken, waaronder een over haar jeugd. Later werd ze directeur van de Schouwburg in Dordrecht en zakelijk leider van Meekers Danscompany.Dit interview maakt onderdeel uit van het project Ziel van de Wederopbouw, wat in 2016 is ondernomen door Stichting Verhalenhuis Belvédère. In deze collectie zijn 86 levensverhalen van Rotterdammers van verschillende generaties, afkomsten en culturen opgenomen, allemaal met als centraal thema de Wederopbouw in de brede zin."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Arbeid"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Werk"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Toneel"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Muzikant"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Wederopbouw"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Familie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Katholiek"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Onderwijs"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Oral History"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Oorlog"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2016-01-01"},{"typeName":"distributor","multiple":true,"typeClass":"compound","value":[{"distributorName":{"typeNa
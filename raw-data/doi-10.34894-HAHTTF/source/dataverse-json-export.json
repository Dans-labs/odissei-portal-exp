            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Spekkestraat te Lier zijn twee waterputten aangetroffen; een boomstamput (spoornr. 262) die niet in aanmerking kwam voor onderzoek en een bekiste waterput waarvoor 11 monsters aangeleverd zijn. Hiervan konden er acht aangemerkt worden voor dendrochronologisch onderzoek. Op één monster na ging het in alle gevallen om eik (Quercus sp.).\nUit onderlinge synchronisatie blijkt dat de acht planken uit vijf verschillende bomen afkomstig zijn. Alle metingen kunnen opgenomen worden in een middelcurve (24.011.M01) die in 1077 dateert. Waar het spinthout bewaard is gebleven lijkt dit nagenoeg compleet. Echter alleen voor MH01 kan dit met zekerheid vastgesteld worden. Dit hout is in het voorjaar of de zomer van 1077 gekapt. De geschatte kapintervallen laten in de meeste gevallen vrijwel zeker een te recent interval zien. Als kapjaar kan 1077 of mogelijk 1078 aangehouden worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-05-08"
                }
              }
            ]

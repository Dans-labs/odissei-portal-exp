              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Patients with COVID-19, admitted from March 2020 to June 2020, and a pre-COVID-19 cohort of patients with (suspected) infections admitted between September 2016 to September 2018 to the University Medical Centre of Utrecht, a tertiary care teaching academic hospital in the Netherlands.\nVariables: \n-\tBaseline characteristics (age, sex, dementia, malignancy, Charlson Comorbidity Index, Modified Early Warming Score, housing situation before admission, transfer from another hospital, infection site)\n-\tCode status documentation (is a code registered, is this code discussed with patient/family, are there any treatment limitations, limitation in resuscitation, limitation in ventilation, limitation in ICU admission, other treatment limitation)."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2021-07-30"
                }
              }
            ]

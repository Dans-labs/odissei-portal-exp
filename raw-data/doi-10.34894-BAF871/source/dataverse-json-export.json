              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "We exploratively compared preadolescents (M = 10.48, SD = .93) with (N = 8) and without (N = 207) hearing loss in their continuous schoolyard interactions during 21 recess assessments, using proximity sensors and field observations, alongside measurements of peer acceptance, friendships and sense of connectedness, based on peer nominations and self-reports."
                },
                "dsDescriptionDate": {

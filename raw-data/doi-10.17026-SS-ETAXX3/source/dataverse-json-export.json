                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains quantitative and qualitative data collected for the evaluation of the PACE-NL Programme, an adapted Dutch version of the PACE Steps to Success Programme aimed at improving palliative care in long-term care facilities. Data include questionnaire data from care staff, qualitative interviews with professionals and bereaved relatives, Mentimeter open-text responses collected during training sessions, attendance lists, and processed results from electronic health record documentation audits."
                },

              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Telefoongesprek met Jan Dibbets over het tentoonstellen van conceptueel werk en de benodigde kennis aan de hand van zijn ruimtelijke installatie Alle schaduwen die mijn zijn opgevallen … zijn afgeplakt met tape (1969) uit de collectie van het Kröller-Müller Museum. Verschillende uitvoeringen worden besproken.</p>"
                }
              }

nitor, die ten doel heeft een dwarsdoorsnede te geven van het verloop van het emancipatieproces. De respons inclusief organisaties waarvan informatie via internet is verkregen, is in ViB2020 414 organisaties: 163 ondernemingen, 167 non-profit instellingen en 84 maatschappelijke organisaties.Bij het opstellen van het databestand is bij de bepaling van de variabelenamen in de recentere metingen gekozen voor de longitudinale opzet."}}]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Sociaal en Cultureel Planbureau (SCP)"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D61000","https:\/\/www.narcis.nl\/classification\/D69000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D61000","termName":[{"lang":"nl","value":"Sociologie"},{"lang":"en","value":"Sociology"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"},{"@id":"https:\/\/www.narcis.nl\/classification\/D69000","termName":[{"lang":"en","value":"Gender studies"},{"lang":"nl","value":"Gender studies"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]},{"typeName":"dansCollection","multiple":true,"typeClass":"primitive","value":["https:\/\/vocabularies.dans.knaw.nl\/collections\/ssh\/33201279-989a-4ccc-9599-9a7440721798","https:\/\/vocabularies.dans.knaw.nl\/collections\/ssh\/371eda80-0caa-420f-b0f5-0d3c0daf4d51"],"expandedvalue":[{"@id":"https:\/\/vocabularies.dans.knaw.nl\/collections\/ssh\/33201279-989a-4ccc-9599-9a7440721798","termName":{"lang":"nl","value":"Vrouwen in Besluitvorming
{"license":"DANS Licence","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, Het Molukse perspectief in oorlogstijd, interview 38"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:41450"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Museum Maluku (MuMa) ©"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"J.M. Vreeswijk-Manusiwa"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"JM  Vreeswijk Manusiwa"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Museum Maluku"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Geïnterviewde 38 is geboren op 27 september 1932 in Malang, Java, Indonesië. Hij komt uit een gezin met drie kinderen, waarvan hij de oudste is. Zijn vader diende bij het KNIL en kwam tijdens de Japanse bezetting in een kamp terecht, in Ciajur. Het gezin bleef achter in een kamp, waar het zelf voor eten moest zorgen.In 1947 ging het gezin met verlof naar Ambon. Terwijl zijn vader weer teruggeroepen werd naar Semarang, bleef het gezin achter in Ambon. Dit vanwege een knieblessure van geïnterviewde. Ze bleven zo lang in Ambon, dat geïnterviewde betrokken raakte in de RMS strijd, in 1950. Hij vertelt over het hevige verzet van jonge jongens en meisjes tegen de aanval van het Indonesische leger op Ambon. Door een zeeblokkade leed de bevolking op Ambon wederom honger. Hij kwam te werken bij de voedselbevoorrading, waardoor hij RMS gevangenen van voedsel kon voorzien.In 1951 werd het gezin weer met vader herenigd, en vetrok de familie naar Nederland met de Goya. Enige jaren later besloot het gezin echter weer terug te keren naar Ambon, dit keer met de Willem Ruys."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date Submitted: 2010-05-31"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Oral history"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Molukkers"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"WOII"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"RMS"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Moluccans"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"WWII"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Malay"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2008-08-07"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2010-06-01"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2008-08-07"}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":
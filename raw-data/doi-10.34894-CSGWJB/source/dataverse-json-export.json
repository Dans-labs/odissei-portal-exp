              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset is comprised of people observations from the footnotes of the General Missives RGP volumes. It focuses on linking Dutch versions of non-Western names to the biographical details in the footnotes. The aim was to both create more structured data on non-Western people important to the Dutch East India Company, and to link the versions of their names appearing in the archive to more modern appellations."
                }
              }
            ]

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Data on unruly people and beggars in Amsterdam and Delft in the seventeenth and eighteenth centuries are included in this dataset. Registration data on the penitentiaries and the houses of correction are used. Date of entry of the beggar, time spent in the house, behaviour and the reason of departure are included. When the duration of stay is shortened or extended, the reason, the total duration and the number of shortenings or extensions are included.</p>"
                }
              }
            ]
          },

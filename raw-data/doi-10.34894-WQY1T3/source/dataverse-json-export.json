          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Geschreven bronnen voor de de Monnikhof aan het Lutterkerkpad 11 in De Lutte gaan terug tot de volle middeleeuwen. Hoe oud de huidige boerderij is echter niet duidelijk en daarom is op 25 november 2024 een aantal boormonsters genomen uit de gebintconstructie. Deze monsters zijn aangevuld met een twee stukken hout die beschikbaar zijn gekomen na een recente verbouwing en een ingreep in 2015. In totaal ging het hiermee om acht monsters, in alle gevallen afkomstig van eiken (Quercus spp.) elementen.\nHet onderzoek bleek niet eenvoudig. Twee monsters kunnen op individuele basis gedateerd worden. Deze lijken tot dezelfde fase te behoren, waarbij de datering van M5 in de herfst/winter van 1605/06 de beste benadering geeft. Vervolgens zijn twee middelcurves gemaakt uit twee metingen elk; 24.127.M01 uit M2 en M4 en 24.127.M02 uit M6 en M7. Gezien de beperkte lengte van de metingen en het onregelmatige jaaringpatroon berust de onderlinge synchronisatie op visuele gelijkenis en niet zo zeer een statistische onderbouwing omdat deze in dit soort situaties weinig effectief is. De middelcurven laten onderling geen gelijkenis zien, hoewel het om dezelfde fasering gaat. Het kapinterval van M2 in de zomer van 1738 geeft de meest nauwkeurige datering, maar de kapintervallen van M4 en M6 in de hersft/winter van 1736/37 geven aan dat hier hout meerdere jaren verwerkt is.\nHet beeld wat hiermee geschetst wordt is dat de boerderij in 1738 gebouwd is en dat daarbij voor enkele elementen hout hergebruikt is. Mogelijk zijn deze afkomstig uit een voorganger op dezelfde locatie, maar dit kan niet aangetoond worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-03-05"
                }
              }
            ]

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek op de nieuwbouwlocatie De Heul in Wijk bij Duurstede is een tonput aangetroffen. Van vier duigen zijn monsters aangeleverd voor dendrochronologisch onderzoek. Het gaat hierbij in alle gevallen om zilverspar (Abies alba Mill.).\nUit onderlinge vergelijking blijkt dat deze allemaal uit dezelfde boom afkomstig zijn. Hiervoor is de boom-middelcurve 26.008.B01 gemaakt. Deze middelcurve kan in 770 gedateerd worden.\nDe wankant is niet aanwezig, dus kan alleen bepaald worden dat het hout ergens na 770 gekapt is."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

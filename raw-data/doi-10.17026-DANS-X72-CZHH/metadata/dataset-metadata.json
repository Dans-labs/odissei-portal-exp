{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"E-mail interview Ko de Jonge over Grenzeloze Inhoud"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:189604"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Marie Ducimetière"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit van Amsterdam"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Floortje Evelein"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit van Amsterdam"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Faculty of Humanities"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit Van Amsterdam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Ko de Jonge took part in the project “Traveling exhibition” in 1983. He created a suitcase filled with many letters, part of a set of 12 suitcases. In 2019 and 2020, the suitcases have been treated by the contemporary art master student at the University of Amsterdam. This interview gives more insight on the artist intent and the creation process."},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2020-05-21"}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"This interview consists on an email exchange between Ko de Jonge, the artist, and Floortje Evelein, master student. Marie Ducimetière is the student working on the restoration of the suitcase “Greetings from…”. In this interview, we learn that the original intent of the artist has never been followed."},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2026-01-04"}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Interview per email met kunstenaar Ko de Jonge over zijn bijdrage aan de reizende tentoonstelling Grenzeloze Inhoud in 1983 met de koffer Greetings from…. Dit is een koffer gevuld met brieven en vormt onderdeel van 12 koffers gevuld door verschillende kunstenaars met het thema De Reis, later als Grenzeloze Inhoud tentoongesteld. In 2019–2020 zijn deze koffers uit de collectie van de Rijksdienst voor het Cultureel Erfgoed onderzocht en geconserveerd door masterstudenten Conservering en Restauratie van Cultureel Erfgoed in de specialisatie Hedendaagse Kunst aan de Universiteit van Amsterdam. Dit interview is daar een onderdeel van en geeft inzicht in de ideeën van de kunstenaar en het creatieproces."},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2026-01-04"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Ko de Jonge"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"https:\/\/rkd.nl\/artists\/42720"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Rijksdienst voor het Cultureel Erfgoed Collectie"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"https:\/\/www.wikidata.org\/wiki\/Q18600731"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Nederlandse Kunststichting"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"https:\/\/www.wikidata.org\/wiki\/Q106988309"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"BK-informatie"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"https:\/\/rkd.nl\/library\/400000469"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Universiteit van Amsterdam"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"https:\/\/www.wikidata.org\/wiki\/Q214341"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2020-03-21"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Supervisor"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Sanneke Stigter"}}]},{"typeName":"distributor","multiple":true,"typeClass":"compound","value":[{"distributorName":{"typeName":"distributorName","multiple":false,"typeClass":"primitive","value":"Universiteit van Amsterdam"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2020-10-09"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2020-10-09"}]},"dansRights":{"displayName":"Rights Metadata","name":
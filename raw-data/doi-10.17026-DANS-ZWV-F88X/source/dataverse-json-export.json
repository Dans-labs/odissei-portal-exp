                  "typeClass": "primitive",
                  "value": "N.I.D.I.  Netherlands Interdisciplinary Demographic Institute (info@nidi.nl)"
                },
                "datasetContactAffiliation": {
                  "typeName": "datasetContactAffiliation",
                  "multiple": false,
                  "typeClass": "primitive",

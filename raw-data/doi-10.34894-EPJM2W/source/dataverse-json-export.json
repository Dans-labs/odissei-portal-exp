            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek aan de Fazantlaan in het buurtschap Luchen is een waterput uit de prehistorie aangetroffen. Om deze datering te verfijnen zijn vijf eiken (Quercus sp.) monsters aangeleverd voor dendrochronologisch onderzoek.\nUit het onderzoek volgt dat de metingen een hoge onderlinge gelijkenis zien. Hieruit kan geconcludeerd worden dat de monsters allemaal uit dezelfde boom afkomstig zijn. Hiervoor is de boom-middelcurve 25.122.B01 gemaakt.\nOndanks de goede kwaliteit van de middelcurve kan (op dit moment) geen datering gevonden worden voor de IJzertijd of andere perioden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-02-12"
                }
              }
            ]

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains pseudonymized quantitative data for a study comparing wearable augmented-reality translation glasses and a handheld mobile translation application in co-located Chinese-English multilingual team communication. The study examined perceived accommodation, collaborative efficacy, language-related cognitive load, translation-tool burden, counterpart-language proficiency, and participants’ qualitative reflections during a structured entrepreneurial teamwork task. Directly identifiable information has been removed from the deposited files."
                },

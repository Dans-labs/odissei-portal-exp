            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset reports the values for vitamin c, vitamin b2, glutathione and carotenoids measured in four spinach varieties under different environmental conditions. There were three different vapour pressure deficit (VPD) and two different light spectrum conditions (control and high blue). The GSH and GSSG content were measured by an enzymatic assay, whereas the rest of the compounds were measured via HPLC."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-12-26"
                }
              }
            ]
          },

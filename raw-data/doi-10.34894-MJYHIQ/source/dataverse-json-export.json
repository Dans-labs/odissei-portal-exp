                  "value": "antioxidants"
                }
              },
              {
                "keywordValue": {
                  "typeName": "keywordValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Spinacia oleracea L."
                }
              },
              {
                "keywordValue": {
                  "typeName": "keywordValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "vitamin content"
                }
              }
            ]
          },
          {
            "typeName": "notesText",
            "multiple": false,
            "typeClass": "primitive",
            "value": "VPD1, VPD2, VPD3 correspond to the three different VPD conditions that the spinach were grown in. The light treatment ST is control, whereas HB is the light spectrum with more blue light. The names of the four spinach varieties are anonymized for confidentiality reasons. Green1 and Green2 are completely green, whereas Red1 and Red2 have red veins."
          },

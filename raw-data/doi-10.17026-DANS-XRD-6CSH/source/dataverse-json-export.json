                  "typeClass": "primitive",
                  "value": "Projectcoördinatie: Rosemarijn Hoefte (KITLV) en Hariëtte Mingoen (STICHJI)"
                }
              }
            ]
          },
          {
            "typeName": "distributionDate",
            "multiple": false,
            "typeClass": "primitive",
            "value": "2010-01-01"
          },
          {
            "typeName": "dateOfDeposit",
            "multiple": false,

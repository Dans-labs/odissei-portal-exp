              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>This dataset contains daily retail gasoline prices, for the fuel types diesel and euro95, in The Netherlands for the period October 1, 2005 to April 25, 2011 for almost every gasoline station selling fuel to consumers.</p>"
                }
              },
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Explanation tab 'Data files':<br>- The folder 'orginal' contains project documentation, XML file and STATA files as deposited by the depositor.<br>Part of these files, the STATA files, have been converted into SPSS sav and por files by DANS for sustainability purposes and the benefit of SPSS users. You can find these files in the folder 'SPSS conversions by DANS'.</p>"
                }
              }
            ]

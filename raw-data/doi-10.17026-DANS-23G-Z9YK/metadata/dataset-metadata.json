{"license":"CC0-1.0","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Nulmeting van de publieke opinie over nanotechnologie"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"www.nanopodium.nl"}},{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:42737"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Commissie Maatschappelijke Dialoog Nanotechnologie"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"AJA  Nooijen"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Secretariaat Nanopodium - Technopolis BV"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"In een online onderzoek onder 2545 consumenten is onderzocht wat consumenten weten over en vinden van nanotechnologie. Daarnaast is dit onderwerp in vijf groepen met 45 consumenten besproken. Er zijn zes toepassingsgebieden van nanotechnologie behandeld: elektronica, energie, gezondheidszorg, materialen, persoonlijke verzorging en voeding. Er werd hierbij geen onderscheid gemaakt in gebruik voor proces of product. Het onderzoek is gedaan bij aanvang van de maatschappelijke dialoog over nanotechnologie, zodat de Commissie Maatschappelijke Dialoog Nanotechnologie kan zien welke effecten de dialoog heeft op de kennis en houding van mensen ten aanzien van nanotechnologie. De bevindingen van het onderzoek zijn samengevat in het rapport '“Het giga van nano: Een nulmeting van de publieke opinie over nanotechnologie” | september 2009'"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Business and Management","Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Nanotechnologie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Nanotechnology"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Public perspective"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Publieksperspectief"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Publieke opinie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Public opinion"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Nulmeting"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Baseline study"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Nieuwe technologie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"New technology"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Nanopodium"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2009-09-01"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributor
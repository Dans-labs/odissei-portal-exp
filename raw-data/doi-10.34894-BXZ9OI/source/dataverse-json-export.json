            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek op het plangebied Delversduin te Egmond aan Zee is een tonput aangetroffen. Van vijf duigen zijn monsters aangeleverd voor dendrochronologisch onderzoek. In alle gevallen gaat het om eik (Quercus sp.). Eén van de duigen bevat voldoende jaarringen voor dendrochronologisch onderzoek. Het bleek echter niet mogelijk een datering te vinden voor het monster."
                },

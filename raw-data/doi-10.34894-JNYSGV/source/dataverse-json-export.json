            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van het Schuttersplein te Groessen zijn bewoningsporen uit de Vroege en Volle Middeleeuwen aangetroffen. Hieronder bevonden zich twee tonputten (M10 en M59). Alleen uit M59 konden bruikbare monsters geselecteerd worden.\nHet gaat hier om twee eiken (Quercus sp.) duigen, waarvan er één gedateerd kon worden.\nDe laatste jaarring hiervan valt in 860. Aangezien er geen spinthout bewaard is gebleven kan alleen de ondergrens van het kapinterval bepaald worden (in dit geval 869).\nBij duigen gaat het vaak om hout dat over enige afstand verplaatst is, maar in dit geval zijn er geen specifieke aanwijzingen over de herkomst."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

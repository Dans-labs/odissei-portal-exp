.<\/p>"}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date: 2017-11-02"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"veerkracht"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"weerbaarheid"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"resilience"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"trauma"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"zingeving"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"meaning in life"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Holocaust"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"generaties"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"transmission"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"erkenning"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"narrativiteit"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Oral History"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2018-01-15"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"ty
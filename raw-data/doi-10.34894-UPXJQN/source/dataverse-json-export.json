            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The data are field notes and reporting files for the works of the Multi Actor Forums (MAFs) within the research project BOLSTER - Bridging Organizations and marginalized communities for Local Sustainablity Transitions in EuRope. \nMAFs were participatory platforms for key actors affected by the transition and potentially left behind. Their aim was to increase the social acceptance of transition plans by better accommodating the needs of marginalised groups. MAFs included a wide variety of stakeholders. They were platforms where the voice of representatives of various marginalised communities was heard and taken into account. The MAFs were organised in seven regions: Halle (DE), Silesia (PL), Istria (HR), Prahova (RO), Leon (ES), Stara Zagora (BG), Hainaut (BE) and had been meeting iteratively to feed-in various processes within BOLSTER.<br><br>\nDue to the sensitivity of the data, they are not stored in DataverseNL but in a secure location at Tilburg University. If you would like to request access to the data file(s), please use the Contact Owner button on the dataset’s landing page."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-06-20"
                }
              }
            ]
          },

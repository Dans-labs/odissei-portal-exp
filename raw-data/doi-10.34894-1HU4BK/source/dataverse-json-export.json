            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek langs de Kerkhoflaan in Sas van Gent zijn de resten van oude vestingwerken aangetroffen. Hierin was een aantal houtvondsten aanwezig waarvan er twee aangemerkt konden worden voor dendrochronologisch onderzoek. In beide gevallen gaat het om grove den (Pinus sylvestris L.).\nVondstnr. 90 is een plank waarop de wankant aanwezig lijkt. De laatste jaarring hiervan valt in 1657. Uit hetzelfde spoornummer is een houten schijf afkomstig (vondstnr. 92). Ook hier lijkt de wankant aanwezig, maar valt de laatste jaarring in 1681."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-05-20"
                }
              }
            ]

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "We use data from experiments on finitely repeated dilemma games with fixed matching to investigate the effect of different types of information on cooperation. The data come from 71 studies using the voluntary contributions paradigm, covering 122 data points, and from 18 studies on decision-making in oligopoly, covering another 50 data points. \r\n\r\nWe focus on the effect of different kinds of feedback subjects in experiment are provided: feedback about earnings (of themselves or others), choice of others, or a combination of these."
                },
                "dsDescriptionDate": {

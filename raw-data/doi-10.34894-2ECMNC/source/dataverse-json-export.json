            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek langs de Oude Rijn in Bodegraven zijn de resten van een sluis een oudere brug aangetroffen. Om de ouderdom te bepalen zijn vier monsters aangeleverd voor dendrochronologisch onderzoek. Voor de sluis ging het om drie vuren (Picea abies Karst.) monsters, waarvan er één voldoende jaarringen voor onderzoek had, maar niet gedateerd kon worden. Voor de brug is een dwarsdoorsnede van een zware eiken (Quercus sp.) paal aangeleverd. Hiervan kan de laatste jaarring in 1808 gedateerd worden. Spinthout of de wankant ontbreekt, dus een afgebakend kapinterval kan niet bepaald worden, maar vermoedelijk is het hout ergens rond het midden van de 19e eeuw gekapt."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

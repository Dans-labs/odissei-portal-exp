          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Schoonstraat te Evergem zijn twee waterputten aangetroffen. Hiervan zijn monsters genomen en aangeleverd voor dendrochronologisch onderzoek. Het gaat hierbij om een vermoedelijk middeleeuwse waterput die is samengesteld uit eiken (Quercus sp.) hoekpalen en grotendeels beuken (Fagus sylvatica L.) planken. Uit de planken van de bekisting is een aantal planken geselecteerd voor onderzoek. Hieruit volgt dat het meeste beukenhout gekapt is 1072/73, met uitzondering van M38 die een jaar later gekapt is. De twee eiken planken die onderzocht zijn kunnen ook gedateerd worden, maar hiervoor kan geen exact kapseizoen bepaald worden. Deze lijken echter wel te passen bij de bovengenoemde dateringen.\nDaarnaast is een vermoedelijk Romeinse waterput onderzocht. Hiervan kan alleen bepaald worden dat de zes onderzochte planken uit drie bomen afkomstig zijn. Hiervoor is een aantal boom-middelcurven samengesteld (23.089.B01, B02 en B03), maar deze leveren geen verdere resultaten op, waardoor de exacte ouderdom onbekend blijft."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-03-18"
                }
              }

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Willemstraat 59 in Bodegraven zijn twee eiken (Quercus sp.) palen geborgen en bemonsterd voor dendrochronologisch onderzoek.\nOver de context van de vondsten is geen informatie verstrekt.\nBeide monsters kunnen gedateerd worden in de eerste eeuw na Chr.\nVondstnr. 21.2 dateert in 61 na Chr. en uit de aanwezigheid van de wankant volgt een kapseizoen in de herfst/winter van 61/62 na Chr.\nVondstnr.22.2 dateert in 28 na Chr. Het spinthout is deel bewaard gebleven en hiermee kan een kapinterval rond 35 na Chr. geschat worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-02-03"
                }
              }

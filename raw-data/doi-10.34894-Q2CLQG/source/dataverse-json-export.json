            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Door Stichting Archeos Fryslân is een aantal monsters genomen van een wrak dat is aangetroffen nabij Kornwerderzand. Het gaat om een wrak van een dubbelwandig schip dat het Nationaal Contact Nummer (NCN) 34303 en de naam “Double Dutch” heeft meegekregen.\nIn totaal zij tien monsters genomen van eiken (Quercus sp.) en grenen (Pinus sylvestris L.) elementen. Hiervan zijn er vijf geschikt bevonden voor onderzoek.\nUit onderlinge synchronisatie blijkt dat de buitenste huidplanken nr. 2 en 3 uit dezelfde boom afkomstig zijn. Hiervoor is de boom-middelcurve 23.100.B01 gemaakt.\nDeze middelcurve kan gedateerd worden in 1671.\nDaarnaast kan een eiken huidplank gedateerd worden in 1650. Hierop zijn enkele spinthoutringen bewaard gebleven, waardoor een kapinterval geschat kan worden. Dit valt rond 1673.\nVoor de overige twee monsters konden geen goede resultaten gevonden worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-04-08"
                }
              }
            ]

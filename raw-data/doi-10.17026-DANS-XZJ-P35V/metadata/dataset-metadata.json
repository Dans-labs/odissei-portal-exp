{"license":"CC-BY-4.0","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Permission to bail out EU’s national flag carriers?"},{"typeName":"alternativeTitle","multiple":true,"typeClass":"primitive","value":["Technocratic and political determinants of Commission approval of state aid to national airlines in difficulties in the pre-COVID era"]},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"690779"}},{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:221122"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"R.J. van Druenen"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud University"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/419619402"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"RU  Radboud University"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Dataset used for analyses in article about political and technocratic factors that determine whether the European Commission approves or does not approve state aid to national airlines.  The dataset consists of 14 cases of state aid to national airlines in difficulties between January 2004 and December 2018.  The dataset displays some important characteristics of these state aid cases, such as the procedure followed, the degree of market distortion associated with aid and the economic size of an airline to which state aid is granted. The data in this file are derived from the European Commission's publicly available State Aid Register and from individual decisions by the European Commission that can also be obtained through the State Aid RegisterThe article is currently under review for an international peer-reviewed journal and is also included as chapter 5 in the following dissertation:Van Druenen, R. (forthcoming). Enforcing state aid rules in the EU: between law and politics. Radboud University."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"EU enforcement"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"national airlines"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"QCA"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"state aid policy"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"technocracy."}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["English"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2021-01-01"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2021-08-24"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2021-09-09"}]},"dansRights":{"displayName":"Rights Metadata","n
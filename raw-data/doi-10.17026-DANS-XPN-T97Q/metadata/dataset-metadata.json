{"license":"CC0-1.0","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, De Russenoorlog, opstand Georgische troepen op Texel, interview 05"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:41755"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Stichting Traktor (copyright)"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Arnold van Bruggen"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"A van Bruggen"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Stichting Traktor"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Huug Snoek (89) was aangesloten bij het Texelse verzet. Tijdens de deportatie van de jonge Texelse mannen naar Assen in najaar 1944 was hij ondergedoken in Leeuwarden. Hij vertelt hoe hij terugkomt naar Texel en hoort over de plannen voor een Georgische Opstand. Meteen de eerste nacht doet hij mee met de opstand, opent het stadhuis, brengt NSB-ers op en vecht mee met de Georgiers als het Duitse leger de opstand de kop inslaat. Het grootste deel van de opstand duikt hij onder in het bos. Als hij daar wordt opgepakt redt een bevriende Duitse soldaat op het nippertje zijn leven."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Texel"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Georgians"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Uprising"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Georgiers"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Opstand"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Second world war"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"world war II"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"resistance"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"verzet"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"arbeitseinsatz"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"oudeschild"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"texla"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"den helder"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"leeuwarden"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"assen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"bos"}},{"keywordValue"
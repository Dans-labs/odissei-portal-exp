            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains the <b>deliverables</b> of the EU project <b>Aircraft and Rotorcraft Pilot Couplings - Tools and Techniques for Alleviation and Detection (ARISTOTEL)</b>. <br>\r\n<br>The aim of this 3-year project was to advance in the understanding, prediction and alleviation of a particularly unfavourable category of phenomena, the so-called <b>aircraft-pilot-couplings and rotorcraft-pilot-couplings (A/RPCs)</b>, which can lead to catastrophic failures. <br>\r\n<br>The project was divided into 7 work packages (WP):<br> \r\n<ul>\r\n<li>WP1 - The Anatomy of A/RPC</li> \r\n<li>WP2 - Rigid Body Modelling and Prediction of A/RPC</li>\r\n<li>WP3 - Aero-servo-elastic Modelling and Prediction for A/RPC</li> \r\n<li>WP4 - Testing and Validation for A/RPC</li>\r\n<li>WP5 - Design Guidelines and Methodologies for A/RPC Prevention</li>\r\n<li>WP6 - Dissemination and Exploitation</li>\r\n<li>WP7 - Management</li>\r\n</ul>\r\n<br>At the end of the project, ARISTOTEL successfully delivered <b>design and simulation guidelines for A/RPCs</b>."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2019-08-29"
                }
              }
            ]

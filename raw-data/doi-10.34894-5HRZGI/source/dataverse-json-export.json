            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The Track & Trace study is a prospective cohort study in patients with glioblastoma, where we aim to investigate the amount and phenotype of T-cells in the peripheral blood, and see if T cells can be used as a biomarker for disease progression. We will include 30 glioblastoma patients. For 12 of these patients we will compare in-depth T cell phenotypes in the peripheral blood to tumor-infiltrating lymphocytes at baseline using a 37-marker spectral flow cytometry panel. For all 30 patients, we will collect PBMCs at different time points during their treatment (estimated around 8 time points). This dataset contains the research protocol and data management plan. (Meta)data will follow once the work has been published."
                },
                "dsDescriptionDate": {

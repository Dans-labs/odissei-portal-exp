            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>This dataset presents the geographical indices of the 14 volumes of the RGP editions of the <i>Generale Missiven der V.O.C.</i> (GM) (1960-2007) in a structured format. The RGP General Missiven are a published selection of the General Letters from the period 1610 to 1767. These were summarising reports written by the Governor General in Batavia to the directors of the Dutch East India Company in Amsterdam. The volumes can be accessed at: <a href=\"https://resources.huygens.knaw.nl/vocgeneralemissiven\">https://resources.huygens.knaw.nl/vocgeneralemissiven</a>\n</p>\n<p>\nThese published volumes include geographic indices covering toponyms (place names), ethnonyms (e.g. 'Afghanen') and titles related to place (e.g. 'China, keizer van'). The majority of the toponyms in the indices relate to places within the VOC's Asian area of operations, which ranged from Yemen to Japan.\n</p>"
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-04-09"
                }
              }
            ]
          },

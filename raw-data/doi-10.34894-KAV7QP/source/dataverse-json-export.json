            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter hoogte van de Westerstraat 1a in Hoorn is een aantal houten vondsten aangetroffen. Hiervan zijn monsters aangeleverd voor houtsoorten- en dendrochronologisch onderzoek. Een drietal kleine vondsten, afkomstig van balkjes en vlechtwerk, is in alle gevallen els (Alnus glutinosa Gaertn.). Het zwaardere hout bestaat uit een eiken (Quercus sp.) dorpel. Uit het dendrochronologisch onderzoek volgt een datering voor de laatste jaarring in 1504. Spinhout of de wankant is niet aanwezig, dus een afgebakend kapinterval kan niet bepaald worden. Waarschijnlijk is het hout in de eerste helft van de 16e eeuw gekapt."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The purpose of this study is to examine the reliability of the Reconstruction of Life Events (RE-LIFE)  questionnaire. This questionnaire is designed to better understand how people cope with significant life events. One such significant life event could be \na cancer diagnosis. A diagnosis can affect quality of life. People may struggle with existential questions or questions of meaning. This questionnaire is designed to provide insight into how people cope with major life events and to enable further research on this topic.\n\nThis dataset contains the available data used in the validation study of the RE-LIFE questionnaire. It contains the description of the conducted analyses, the questionnaire, the used informed consent form, and data dictionaries. The data is unavailabile because no consent was given by the participants to share the data. The type of data we collected is included in the data dictionary."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

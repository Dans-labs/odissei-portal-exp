          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains anonymized survey data from a vignette experiment with 140 secondary school teachers in the Netherlands. Each teacher evaluated 6 out of 32 random selected vignettes. The vignettes described hypothetical students whose characteristics were systematically varied: socioeconomic status (SES), ethnic background, gender, work effort, and heterogeneous track-type. For each vignette, teachers reported their academic expectations and transfer recommendations. The dataset has 721 vignette evaluations in total. Data were collected between April and July 2025 via an online Qualtrics survey. All responses were anonymized before archiving. All participants gave active informed consent for data sharing."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",

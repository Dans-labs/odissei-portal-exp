            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The 1088 '****.bin' files (distributed over two zip files) contain transponder record data for each individual mouse tagged with a transponder in the outdoor enclosures at the Stony Ford field station of Princeton University. Transponder counts are in 2 minute bins binary coded with a short integer (16 bits). Each file has 7 headers: bin size (in min.), ID, year, month, day, hour, minute. Data can be viewed and analyzed with the freely available ChronoShop software (https://nioo.knaw.nl/en/employees/kamiel-spoelstra#quicktabs-pp_test_tabs=5) . The ID_link_table.xlsx contains data to - via ID - to sex, genotype, release date, enclosure number and transponder code."
                },
                "dsDescriptionDate": {

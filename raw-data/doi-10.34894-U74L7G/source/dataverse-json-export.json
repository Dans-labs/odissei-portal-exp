                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek op het plangebied De Leet te Ieper zijn bewoningssporen aangetroffen waarvan de oudste vóór 1100 dateren. Uit deze context is een dwarsdoorsnede van een paal aangeleverd voor dendrochronologisch onderzoek.\nDe buitenste jaarring van dit monster dateert in 1058 en aan de hand van het aanwezige spinthout kan een kapinterval rond 1069 geschat worden."
                },

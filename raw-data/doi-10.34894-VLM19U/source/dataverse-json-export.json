            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek op het perceel aan de IJsseldijk 363 in Krimpen aan den IJssel zijn enkele houten vondsten aangetroffen. Deze zijn aangeleverd voor dendrochronologisch en houtsoortenonderzoek.  Het gaat hierbij om een plank van zilverspar (Abies alba Mill.) en een paal van fijnspar (Picea abies Karst.). De eerste bleek geschikt voor dendrochronologisch onderzoek en hieruit volgde een datering in 1878. De wankant is niet aanwezig, dus kan alleen de ondergrens van het kapinterval bepaald worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-03-11"
                }
              }

                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This is an anonimized version of the dataset resulting from  the Nijmegen experiment with social assistance, between 2017 and 2020. In the experiment, the effects of a social assistance regime based on trust and unconditionalllity are compared to the regular Dutch social assistance regime (as regulated by the Participation Act). The dataset includes a large number of potentially relevant outcomes, including health, wellbeing, social and political trust, and work-related outcomes."
                }
              }
            ]

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The aim of this study was to examine the effect of autonomy-groups in patients with anxiety disorders (RCT: treatment vs waitlist). Questionnaires (on autonomy and symptoms/mental health) were completed before, halfway, and at the end of treatment. \r\n\r\nHypotheses: \r\n1. Patients with anxiety disorders show an increase of autonomy after the Autonomy treatment;\r\n\r\n2. Patients with anxiety disorders show a decrease of their symptoms after the Autonomy treatment."
                }
              }
            ]

                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "We have reached the end of the DataFest campaign, to remind us why we \ncare about open data Prof. dr. Enrico Pennings  (ESE Vice-Dean and \nResearch Director) will share a few words. To tell us how the future of \nopen data looks like, we invited Mark Hahnel, the founder of Figshare \n(the platform that the EUR Data Repository uses). We will have a “hats \non, hats off” game about the DataFest."
                }
              }

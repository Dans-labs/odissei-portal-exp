          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "These data were collected in spring 2025 from participants in the Ipsos panel in the Netherlands. Participants were invited to join a data donation study that involved the donating some of their Instagram data in addition to completing a questionnaire. The questionnaire data includes: 1) background characteristics of the participants 2) political preference 3) media usage 4) life satisfaction 5) trust in the government. The donated Instagram data consists of: 1) lists of Instagram creators whose content the participant had interacted with during the four months prior to requesting the data from Instagram. See readme.txt for the complete codebook of the questionnaire data and a description of the donated Instagram data. Of the 1,103 participants who expressed willingness to participate, 481 ultimately donated their Instagram data (see the readme.txt for what parts exactly). The primary objective of collecting this dataset was to test a federated learning approach for data donation."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-05-01"
                }
              }
            ]

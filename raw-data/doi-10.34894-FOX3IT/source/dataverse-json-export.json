            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Hunsingosluis in Zoutkamp is een aantal houten vondsten aangetroffen. Van twee grenen vondsten (een paal en een zware plank of balk) zijn monsters aangeleverd voor dendrochronologisch onderzoek.\nDe paal kan gedateerd worden in 1756 en aangezien de wankant aanwezig is, kan bepaald worden dat het hout in de herfst/winter van 1756/57 gekapt is.\nHet tweede monster kan niet gedateerd worden. Hierin is een periodieke verstoring aanwezig die iedere zeven tot elf jaar optreedt. Waarschijnlijk is dit als gevolg van menselijk ingrijpen, hoewel niet direct duidelijk wat deze activiteit is."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-03-21"
                }
              }

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This study employed a longitudinal design (T0, T1, T2), with two-week intervals between each measurement. Data was collected through an online questionnaire in collaboration with Flycatcher, a research agency based in Maastricht, the Netherlands. The target population consisted of residents of the Netherlands aged 18 years and older. A stratified sampling method was used to select participants based on gender, age, SEP, and region, ensuring that the sample was representative of the Dutch population. \nDatasets consist of (1) measurements from T0, (2) measurements of T0 (n=1001), T1 (n= 714) and T2 (n=543) combined."
                },
                "dsDescriptionDate": {

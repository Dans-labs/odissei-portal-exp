            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Om de geschiedenis van een klein paneelschilderijtje te documenteren is een dendrochronologisch onderzoek uitgevoerd. Het eiken (Quercus spp.) paneel meet een bescheiden c. 22 bij 19 cm. en beeldt een tronie van een oude man af. Stylistisch lijkt het bij de Rembrandtse school te horen. Een etiket op de achterzijde vermeld Rembrandt als schilder, maar er zijn geen gegevens die dit ondersteunen.\nDe jaarringen zijn aan de rechtkant vastgeteld. Ondanks een ontbrekend hoekje is hier de langste ononderbroken jaarringreeks is zichtbaar. De meting bevat 151 jaarringen en kan gedateerd worden in 1608. Op z’n vroegst is het hout gekapt na 1617, maar rekening houdend met ongemeten jaarringen, droogtijd en een gemiddeld aantal spinthoutringen zal deze ondergrens eerder rond het midden van de 17e eeuw liggen."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-07-14"
                }
              }

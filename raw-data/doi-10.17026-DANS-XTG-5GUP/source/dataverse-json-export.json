            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>This dataset includes expert estimates on the policy positions of 14 Greek political parties on more than 40 policy issues as well as scaled positions on the left-right and pro/anti-memorandum dimensions. Expert estimation was conducted through the Delphi method. The data were previously used in the Choose4Greece (http://www.choose4greece.com/) voting advice application (VAA) which was launched during the May and June 2012 parliamentary elections in Greece.</p>"
                }
              }
            ]

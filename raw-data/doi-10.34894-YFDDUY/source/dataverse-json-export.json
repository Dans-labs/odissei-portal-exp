            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Tijdens fase 10 van het archeologisch onderzoek ter plaatse van het plangebied Zanderij te Katwijk zijn de resten van enkele Vroegmiddeleeuwse waterputten aangetroffen. Van acht verschillende waterputten zijn monsters genomen en aangeleverd voor dendrochronologisch onderzoek. Voor zeven hiervan waren geschikte monsters aanwezig. Twee monsters uit spoornr. 536 bleken afkomstig uit dezelfde boom. Hiervoor is de middelcurve 23.108.B01 gemaakt.\nDeze boom-middelcurve is, samen met andere metingen, gebruikt om twee kleine middelcurven samen te stellen (23.018.M01 en M02) die tegen referentiecurven uit de regio gedateerd konden worden. Deze dateringen vallen rond het midden van de 6e eeuw. Omdat de wankant doorgaans aanwezig is kunnen nauwkeurige kapintervallen bepaald worden.\nVondstnr. 412 dateert te vroeg om deel uit te kunnen maken van de middelcurven. Spinthout of de wankant ontbreekt hier echter, waardoor geen afgebakend kapinterval geschat kan worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-04-06"
                }
              }

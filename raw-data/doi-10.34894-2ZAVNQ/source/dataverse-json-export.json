                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This survey aims to gauge opinions on the welfare state in the Netherlands, in particular with respect to the universal basic income policy proposal. It includes attitudes on seven themes: rights and obligations in the welfare state, functioning of the welfare state, work and leisure, universal basic income policy, social assistance policy, politics, and respondents’ labour market position."
                }
              }
            ]

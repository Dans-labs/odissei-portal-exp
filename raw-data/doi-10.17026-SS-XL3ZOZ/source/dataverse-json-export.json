              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This database was produced in the context of the dissertation \"A Truth Universally Acknowledged. Dutch Investment in French Colonial Resources, 1717-1792\", as part of NWO VICI project VI.C.191.027. This database consists of 3,065 notarial deeds related to Dutch investment in French colonial resources, extracted from the Amsterdam notarial archives and preserved in the Amsterdam City Archives. All information on the archival material, selection mechanisms, and the form of the database can be found in the protocol."
                }
              }
            ]

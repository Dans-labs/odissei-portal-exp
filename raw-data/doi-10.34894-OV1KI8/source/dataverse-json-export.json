                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek op de nieuwbouwlocatie “De Welder 2” in Haghorst is een vermoedelijk middeleeuwse boomstamput aangetroffen. Hiervan is een fragment aangeleverd voor onderzoek. Dendrochronologisch onderzoek van het fragment leverde geen overtuigende resultaten op, waardoor de ouderdom niet verder aangescherpt kan worden."
                },

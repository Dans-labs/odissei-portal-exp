{"license":"CC-BY-4.0","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Culturele Veranderingen in Nederland 2004 - CV'04"},{"typeName":"alternativeTitle","multiple":true,"typeClass":"primitive","value":["Cultural Changes in the Netherlands 2004 - CV'04"]},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"STAR: P1692"}},{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:33366"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Sociaal en Cultureel Planbureau - SCP"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Data Station Admin"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"DANS"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Trend study on changes in social and cultural  opinions and attitudes  of the Dutch population regarding a wide range of topics.Safety and crime \/ satisfaction with life \/ social contacts \/ spending leisure time \/ possessions and income \/ prosperity \/ health and handicaps \/ work \/ use of internet \/ economic well-being \/ values and beliefs \/ satisfaction with government  \/ religious issues and philosophy of life \/ political participation  and interest \/ emancipation of women \/ opinions on immigrants."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"sociology"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"crime"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"safety"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"living conditions"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"interpersonal relations"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"leisure"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"finance"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"health"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"work"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"technology"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"values and beliefs"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"politics"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"religion"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"women"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"ethnocentrisme"}}]},{"typeName":"notesText","multiple":false,"typeClass":"primitive","value":"The original data files in .por have been available from deposit onwards. On June 8th, 2017 DANS converted these .por files into STATA (.dta) files by using StatTransfer13, and .sav files by using SPSS, and uploaded these files in this dataset."},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2004-11-02"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Intomart GfK - United Fieldwork Organisation - Ufo"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2010-08-11"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2010-08-11"},{"typeName":"dateOfCollection","multiple":true,"typeClass":"compound","value":[{"dateOfCollectionStart":{"typeName":"dateOfCollectionStart","multiple":false,"typeClass":"primitive","value":"2004-09-14"},"dateOfCollectionEnd":{"typeName":"dateOfCollectionEnd","multiple":false,"typeClass":"primitive","value":"2004-11-02"}},{"dateOfCollectionStart":{"typeName":"dateOfCollectionStart","multiple":false,"typeClass":"primitive","value":"2004-09-14"},"dateOfCollectionEnd":{"typeName":"dateOfCollectionEnd","multiple":false,"typeClass":"primitive","value":"2005-01-11"}}]},{"typeName":"series","multiple":true,"typeClass":"compound","value":[{"seriesInformation":{"typeName":"seriesInformation","multiple":false,"typeClass":"primitive","value":"Het Sociaal en Cultureel Planbureau (SCP) voert sinds 1975 (twee)jaarlijks het onderzoek Culturele Veranderingen in Nederland uit. De reeks bestaat inmiddels uit 30 onderzoeken en bevat zo’n 3500 variabelen en gegevens over meer dan 50.000 respondenten.De onderzoeken Culturele Veranderingen in Nederland (CV) en SCP Leefsituatie Index (SLI) worden sinds 2004 tweejaarlijks gecombineerd uitgevoerd in samenwerking door het Sociaal Cultureel Planbureau (SCP) en het Centraal Bureau voor de Statistiek (CBS).Doel van CV is vaststellen welke opvattingen “de Nederlander” heeft over samenleving en cultuur en hoe deze in de loop van de tijd zijn veranderd. Doel van SLI is het ontwikkelen van een indicator om de sociale leefsituatie van Nederland in kaart te brengen en het monitoren van de ontwikkeling van de sociale leefsituatie van de Nederlandse bevolking.De onderzoeken liggen aan de basis van veel onderzoek uit het werkprogramma van het SCP. Door het CBS zullen de data vooral worden gebruikt ten behoeve van het speerpunt Sociale Samenhang."}}]},{"typeName":"dataSources","multiple":true,"typeClass":"primitive","value":["Sociaal en Cultureel Planbureau, SCP * Den Haag (primary investigator)\nSociaal en Cultureel Planbureau, SCP * Den Haag (depositor)\nIntomart GfK - United Fieldwork Organisation - Ufo (data collector)"]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Sociaal en Cultureel Planbureau (SCP)"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D60000","https:\/\/www.narcis.nl\/classification\/D61000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D60000","termName":[{"lang":"en","value":"Social sciences"},{"lang":"nl","value":"Sociale wetenschappen"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"},{"@id":"https:\/\/www.narcis.nl\/classification\/D61000","termName":[{"lang":"nl","value":"Sociologie"},{"lang":"en","value":"Sociology"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]},{"typeName":"dansCollection","multiple":true,"typeClass":"primitive",
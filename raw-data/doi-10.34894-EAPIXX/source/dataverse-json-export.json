            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Van het archeologisch onderzoek aan de Harmenjansweg te Haarlem is een aantal monsters aangeleverd voor dendrochronologisch onderzoek. Hierbij gaat het om twee stuks grove den (Pinus sylvestris L.) en één maal eik (Quercus sp.).\nOver de context van de vondsten is geen informatie verstrekt.\nUit het dendrochronologisch onderzoek blijkt dat het om 19e-eeuwse vondsten gaat. Spinthout of de wankant is niet aanwezig waardoor alleen de ondergrens van de kapintervallen bepaald kan worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

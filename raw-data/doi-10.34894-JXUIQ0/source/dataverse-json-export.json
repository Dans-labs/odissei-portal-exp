            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Onderdijk 71 in Westerhoof is een grenen (Pinus sylvestris L.) beschoeiingspaal in een sloot aangetroffen. Hiervan is een monster genomen voor dendrochronologisch onderzoek. De laatste jaarring hiervan dateert 1676. De wankant is vanwege oppervlakkige aantasting niet meer aanwezig waardoor een klein aantal jaarringen bij de datering opgeteld moet worden. Het kapinterval kan daarmee tussen 1676 en 1681 geschat worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",

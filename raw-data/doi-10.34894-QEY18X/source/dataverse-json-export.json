            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This chapter evaluates firms’ innovation and productivity performance by linking firm data with patent data for 1999-2007. The chapter identifies the positive STP effect on innovation and productivity of firms. Firms located within STPs are more innovative than off-park firms in terms of new product innovation and patent applications. Subgroup analysis shows that STPs located in lower-tier cities benefit most from STP policy. Analysis performed on a smaller set of firms for which we can establish movement from outside to within STP reveals that the positive effect of entering STP is only significant for the probability of developing new products."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

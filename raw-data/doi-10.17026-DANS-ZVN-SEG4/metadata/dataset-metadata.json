{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Effectiviteit van vrijwilligers in de schuldhulpverlening: final data"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:161137"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"BHH Boksebeld"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Saxion University of Applied Sciences"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0001-5253-8046"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"BHH  Boksebeld"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Saxion University of Applied Sciences"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"De data betreffen een door ZonMw gefinancierd onderzoek naar de effectiviteit van vrijwilligers in de schuldhulpverlening. Het onderzoek richtte zich op de hulpverlening aan burgers die een minnelijke schuldregeling doorlopen. Voor elk van de activiteiten van vrijwilligers (praktische ondersteuning, aanleren van nieuw gedrag en belangenbehartiging) is nagegaan na wat de toegevoegde waarde was – bovenop de hulp vanuit de professionele schuldhulpverlening - als het gaat om (1) de mate van uitval gedurende het traject en (2) de mate waarin de berekende afloscapaciteit ook daadwerkelijk wordt gerealiseerd. Verder is onderzocht (3) welke effecten de begeleiding door de vrijwilliger had op het financiële gedrag van de cliënt. Data zijn verzameld door middel van dossieronderzoek en interviews met cliënten en vrijwilligers. Cases waarin een cliënt met schulden begeleid was door uitsluitend een betaalde schuldhulpverlener werden vergeleken met cases waarin, naast een beroepskracht, ook een vrijwilliger ondersteuning had geboden."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date: Dataverzameling januari 2018 - mei 2019"}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date: 2018-01-04"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"vrijwilligerswerk; schulden; social work; sociaal werk; schuldhulpverlening; volunteering; debt support"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2019-09-27"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2020-03-30"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2020-03-24"}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["MSc. BHH Boksebeld (Saxion University of Applied Sciences)","MSc. BHH Boksebeld (Saxion University of Applied Sciences)"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D61000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D61000","termName":[{"lang":"nl","value":"Sociologie"},{"lang":"en","value":"Sociology"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]},{"typeName":"dansRelation","multiple":true,"typeClass":"compound","value":[{"dansRelationType":{"typeName":"dansRelationType","multiple":false,"typeClass":"controlledVocabulary","value":"is referenced by"},"dansRelationText":{"typeName":"dansRelationText","multiple":false,"typeClass":"primitive","value":"10.13140\/RG.2.2.27803.00808"},"dansRelationURI":{"typeName":"dansRelationURI","multiple":false,"typeClass":"primitive","value":"https:\/\/doi.org\/10.13140\/RG.2.2.27803.00808"}},{"dansRelationType":{"typeName":"dansRelationType","multiple":false,"typeClass":"controlledVocabulary","value":"is referenced by"},"dansRelationText":{"typeName":"dansRelationText","multiple":false,"typeClass":"primitive","value":"10.1007\/s41196-019-0031-4"},"dansRelationURI":{"typeName":"dansRelationURI","multiple":false,"typeClass":"primitive","value":"https:\/\/doi.org\/10.1007\/s41196-019-0031-4"}},{"dansRelationType":{"typeName":"dansRelationType","multiple":false,"typeClass":"controlledVocabulary","value":"is referenced by"},"dansRelationText":{"typeName":"dansRelationText","multiple":false,"typeClass":"primitive","value":"Vrijwilligers in de schuldhulpverlening; goedkoper kunnen ze het niet maken, wel beter"},"dansRelationURI":{"typeName":"dansRelationURI","multiple":false,"typeClass":"primitive",
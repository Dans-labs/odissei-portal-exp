          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "\"Ati Luhulima-Mustamu werd geboren in 1939 op Tual en groeide op in Nieuw-Guinea, vooral in en rond Merauke. Haar vader was onderwijzer en dominee en werd verschillende keren overgeplaatst. Daardoor maakte zij als kind verplaatsingen mee tussen plaatsen als Po Epe, Okaba en Merauke. De oorlog herinnert zij vooral vanuit kindperspectief: de aanwezigheid van geallieerden, bombardementen op afstand en een Japans vliegtuig dat zij zich nog altijd voor de geest kan halen. Na de oorlog ging zij naar school in Merauke, waar zij ook pesterijen en kwetsende opmerkingen van andere kinderen meemaakte. Na haar schooltijd werkte zij vanaf jonge leeftijd administratief op het residentiekantoor.\n\nIn 1962 vertrok zij, zwanger van haar eerste kind, naar Nederland. De reis liep via Biak, Bangkok, Karachi, Frankfurt, Amsterdam en Wezep naar Scheveningen. In Nederland bouwde zij met haar gezin een bestaan op, eerst in Scheveningen en later in Leiden. Haar levensverhaal verbindt familiegeschiedenis, geloof, werk, zorg voor anderen, herinneringen aan Nieuw-Guinea en terugkeerreizen naar onder meer Merauke, Tual, Ambon en Ceram. Terugkijkend benadrukt zij naastenliefde, doorgaan en actief blijven.\""
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-06-24"
                }
              }

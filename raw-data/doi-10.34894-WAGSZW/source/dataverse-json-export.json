            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset was produced as part of the funded research project 'Bewust in actie’ led by the Hanze University of Applied Sciences Groningen and Koninklijk Nederlands Genootschap Fysiotherapie. The aim of the research project was to understand the level of awareness of physiotherapists and exercise therapists in recognizing patients with limited health literacy, and how much they adapt their communication accordingly. It also seeks to identify implementation strategies to enhance this awareness. \n\nThe dataset contains anonymized survey data from 175 respondents (physiotherapists and exercise therapists in The Netherlands), and the accompanying codebooks and documentation, providing comprehensive insights into therapists' awareness and communication practices regarding health literacy. As the dataset does not contain sensitive information, it can be used freely."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

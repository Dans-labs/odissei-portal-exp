{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Ziel van de Wederopbouw – Interview 041"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:144321"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"L. Schalkwijk"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Stichting Verhalenhuis Belvédère"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"M  Broekhuizen"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Vrije Universiteit Amsterdam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Een groot deel van zijn leven speelde zich in het centrum van Rotterdam af. Als klein Jongetje kwam hij al kijken naar de aanleg van de metro (1966) en de huldiging van Feyenoord (1970, Europacup I). Waarna hij direct fan werd van de voetbalclub. Later ging hij werken bij de eerste McDonald's van de stad aan de Coolsingel, bij platenzaak Dankers, bij de PTT en bij Nationale Nederlanden. Zo zag hij de stad die 's avonds uitgestorven was veranderen tot een stad met een bruisend hart.Dit interview maakt onderdeel uit van het project Ziel van de Wederopbouw, wat in 2016 is ondernomen door Stichting Verhalenhuis Belvédère. In deze collectie zijn 86 levensverhalen van Rotterdammers van verschillende generaties, afkomsten en culturen opgenomen, allemaal met als centraal thema de Wederopbouw in de brede zin."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Wederopbouw"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Feyenoord"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Rotterdamse Metro"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"RET"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Uitgaansleven"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"C70"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Post"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Postkantoor"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"McDonald's"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Oral History"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2016-02-06"},{"typeName":"distributor","multiple":true,"typeClass":"compound","value":[{"distributorName":{"typeName":"distributorName","multiple":false,"typeClass":"primitive","value":"Stichting Verhalenhuis Belvédère"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2019-10-10"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":
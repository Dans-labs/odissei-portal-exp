entifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/298978458"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"M. Kleinjan"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud University"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/298201879"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"E.N. Kuntsche"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud University"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/31875164X"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"RU  Radboud University"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"<p>the current study exists of a three-year longitudinal study, involving multiple data acquisition waves among multiple informants, i.e., adolescents and their mothers. Questionnaires were produced in Qualtrics for both. Starting in May 2015 (cohort 1) and November 2015 (cohort 2), over a period of 36 months, young adolescents are asked to complete questionnaires every six months (seven times in total) and the mothers are asked to complete questionnaires online annually (four times in total).<\/p><p>For  this study's purpose, this dataset contains data on drinking motives and alcohol use of 210 adolescents, taken from the seven wave dataset (\"Vidi Kuntsche_Project B\", linked to this dataset). The data (drinking motives and current alcohol use and binge drinking) of 210 adolescents were taken at the time point when they consumed at least one standard glass of alcohol for the first time (i.e., between 6 months and the t0 assessment; n=210). To answer the second and third research question, we included data (i.e., drinking motives and current alcohol use) of those who also consumed at least one standard glass of alcohol between t0 and the next time point, six months later (t1; n=88).<\/p>"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Drinking Motives"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"alcohol initiation"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"adolescence"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch","English"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2020-01-01"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2020-07-29"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2020-08-14"}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Radboud University"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName"
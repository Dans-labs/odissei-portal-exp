            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Dušan Ljubičić was born in the village Krupa, near Obrovac, Croatia, in 1952. Before the Homeland war he worked as a mechanic in Zagreb Transport. During the war he was a member of Civil Protection of the Republic of Serb Krajina and organized the evacuation of civilians from Obrovac during the operations Storm. Following the operation Storm he lived with his family as a refugee in Novi Sad, Serbia. He returned to Croatia in 1998. Today he lives with his family in Krupa and is the president of the Serb National Council in Obrovac, Croatia.</p>"
                }
              },
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Date Submitted: 2013-09-24"
                }
              }
            ]

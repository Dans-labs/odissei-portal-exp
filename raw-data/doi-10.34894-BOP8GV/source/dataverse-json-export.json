            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "In dit project is op basis van een systematische literatuurstudie en interviews onderzoek gedaan naar de toegankelijk van jeugdzorg voor jongeren en gezinnen. Er is onderzocht wat verklaringen zijn voor (eventuele) verminderde toegankelijkheid en is nagegaan wie er volgens onderzoekers, professionals en cliënten aan zet is om de toegankelijkheid te vergroten. \n\nDe dataset bestaat uit transcripties van 22 interviews gehouden met onderzoekers, professionals en cliënten die met jeugdhulp binnen de Nederlandse setting van doen hebben."
                }
              }
            ]
          },

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Dataset contains data of 180 participants, collected in the general\r\nDutch population. Data was collected on age gender, education,\r\nbasic values (measured by PVQ-40), psychopathic traits (four\r\nfacets, measured by SRP-SF) and aggression (reactive and\r\nproactive, measured by RPQ). The first goal of the research was to\r\ninvestigate if the basic value Power, psychopathic traits and\r\nproactive aggression were correlated. The second goal was to\r\ninvestigate if Power moderated the effect of psychopathic traits on\r\nproactive aggression."
                }
              }
            ]
          },

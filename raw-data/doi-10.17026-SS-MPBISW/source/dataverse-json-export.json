            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This database was produced in the context of the dissertation \"A Truth Universally Acknowledged. Dutch Investment in French Colonial Resources, 1717-1792\", as part of NWO VICI project VI.C.191.027. It documents the debts of 34 individuals (33 crewmembers, one passenger) aboard slave ship De Paulus. Captained by Jacob Belendorp, it departed from Amsterdam in 1758 and delivered 364 African captives in Saint-Domingue in 1759. The voyage was eventful, with high levels of conflict and mortality among the crew. All information on the archival sources, selection mechanisms, and form of the dataset can be found in the protocol"
                }
              }
            ]

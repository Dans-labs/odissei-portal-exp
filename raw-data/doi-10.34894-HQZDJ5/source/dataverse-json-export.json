                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Door Cambium Botany is een monster van het archeologisch onderzoek de op de locatie De Finne te IJsbrechtum aangeleverd voor dendrochronologisch onderzoek. Het gaat om een dwarsdoorsnede van een vuren (Picea abies Karst.) paaltje. Informatie over de verdere context is niet verstrekt. Voor het monster konden geen goede resultaten gevonden worden.\nDit is niet onverwacht gezien het lage slagingspercentage voor fijnspar."
                },
                "dsDescriptionDate": {

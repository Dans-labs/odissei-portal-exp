            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Van het archeologisch onderzoek aan het Europlein te Heemskerk is een aantal monsters aangeleverd voor houtsoorten- en dendrochronologisch onderzoek. Over de context is geen aanvullende informatie verstrekt.\nIn totaal zijn acht monsters aangeleverd. Hierbij gaat het om een vrij gebruikelijke mix van (deels) geïmporteerde houtsoorten zoals eik (Quercus sp,) en grove den (Pinus sylvestris L.) met daarnaast inheemse en minder duurzame soorten als els (Alnus glutinosa Gaertn.) en wilg (Salix sp.). Van de eiken vondsten konden er twee aangemerkt worden voor dendrochronologisch onderzoek, waarvan er één rond het midden van de 16e eeuw gedateerd kan worden. Hierop is geen spinthout of wankant aanwezig, waardoor er geen afgebakend kapinterval bepaald kan worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

{"license":"DANS Licence","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, Een kerkscheuring in oorlogstijd, interview 04"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:41640"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Historisch Documentatiecentrum voor het Nederlands Protestantisme ©"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"W.P.  Beekers"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Vrije Universiteit"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"De heer Vonkeman groeide op in een gereformeerd gezin in Amersfoort, waar zijn vader als machinaal handwerker werkte in de timmerfabriek van zijn opa. Het timmerbedrijf had last van de crisis tijdens de jaren dertig. Zoals zoveel gezinnen werd ook het gezin Vonkeman na de Duitse inval geëvacueerd, in hun geval naar Bergen (Noord-Holland). Het gezin Vonkeman raakte bij terugkeer in Amersfoort sterk betrokken bij het verzet: vader Vonkeman was koerier voor Trouw en zoon Johan liep ook met Trouw. De timmerfabriek werd tegen het eind van de oorlog een opslagplaats voor wapens.Het gezin koos tijdens de kerkscheuring tegen het eind van de oorlog de kant van degenen die zich ‘vrijmaakten’ van de synodale gereformeerde kerken. Terugblikkend ziet Vonkeman geen verband tussen oorlog en kerkscheuring: de oorzaken daarvan gingen volgens hem terug tot spanningen van decennia daarvoor."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date Submitted: 2010-03-19"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Kerken"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"gereformeerden"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"aannemers"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"evacuaties"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"onderwijs"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Vrijmaking"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"verzet"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Nationaal-Socialistische Beweging"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Kamp Amersfoort"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"onderduik"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"bevrijding"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"oral history"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}}]},{"typeName":"language","multiple":true,"typeCla
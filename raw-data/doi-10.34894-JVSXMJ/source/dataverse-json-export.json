            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek op het plangebied Laauwik te Lent zijn twee tonputten uit de Romeinse Rijd aangetroffen. Van beide tonnen is een aantal duigen aangeleverd voor dendrochronologisch onderzoek. Hierbij gaat het om een ton van zilverspar (Abies alba Mill.) en eik (Quercus sp.). Zilverspar wordt in deze rol wel vaker aangetroffen, maar eiken duigen op de Romeinse Tijd zijn bij de auteur onbekend. Uit de eiken ton zijn vier duigen geselecteerd. Hiervan kunnen er drie onderling gedateerd worden en hieruit is de middelcurve 24.007.M01 samengesteld. Deze kan gedateerd worden in 54 voor Chr. Er is geen spinthout aangetroffen dus kan alleen de ondergrens van het kapinterval bepaald worden.\nVan de ton van zilverspar konden twee duigen aangemerkt worden voor onderzoek, maar hiervoor konden geen resultaten gevonden worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-03-04"
                }
              }

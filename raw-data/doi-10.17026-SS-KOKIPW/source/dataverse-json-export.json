              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Interview in het kader van onderzoek naar de voortleving van de herinnering aan dwangarbeid (Arbeitseinsatz) in drie generaties. De titel van het onderzoek is 'Dwangarbeid tijdens de Tweede Wereldoorlog: herinneringen in drie generaties'. Er is in het onderzoek gekeken naar de manier waarop herinnering voortleeft in drie generaties, de rol van collectieve herinnering en herinneringspraktijken daarbij, de invloed op identiteit en psyche en naar hoe de herinnering aan gedwongen tewerkstelling zich verhoudt tot opvattingen over vrijheid en onvrijheid. Het onderzoek is onderdeel van een breder onderzoek genaamd 'Oorlog en vrijheid in drie generaties'."
                }
              }
            ]

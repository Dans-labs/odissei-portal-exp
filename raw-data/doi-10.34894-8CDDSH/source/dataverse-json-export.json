          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van het Bunderhof in Haasdonk (B) is door Acke & Bracke bvba een vermoedelijk Romeinse waterput aangetroffen. Van de houten bekisting zijn monsters genomen en aangeleverd voor dendrochronologisch onderzoek om de ouderdom nader te bepalen.\nUit de aangeleverde monsters zijn tien monsters geselecteerd voor dendrochronologisch onderzoek. Hierbij is de voorkeur gegeven aan monsters met veel jaarringen en/of (intact) spinthout.\nOp basis van onderlinge synchronisaties blijkt dat een aantal planken uit dezelfde boom afkomstig is. Drie planken zijn opgenomen in de boom-middelcurve 23.005.B01 en vier in 23.005.B02. De verschillende bomen laten ook onderlinge gelijkenissen zien, maar deze zijn in vergelijking tot de synchronisaties met referentiecurven betrekkelijk zwak. Hierom zijn geen verdere middelcurven gemaakt.\nAan de hand van de wankant die op een aantal monsters aanwezig is, kunnen twee momenten van houtkap bepaald worden; één in de zomer van 98 na Chr. en één in 100 na Chr.\nDit komt overeen met de vermoede Romeinse ouderdom."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-03-21"
                }
              }
            ]
          },

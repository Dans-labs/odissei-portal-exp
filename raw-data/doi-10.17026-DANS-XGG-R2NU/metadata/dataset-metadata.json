{"license":"CC0-1.0","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Research commercialisation in Europe: a matter of governance of university TTOs"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:75117"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"P.H. van Dongen"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Netherlands Patent Office"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"P.H. van Dongen"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Netherlands Patent Office"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"The project is a study into the various models of organisation and management of Technology Transfer Offices at universities in Europe. We found that different models may have their influence on the technology transfer of patents and research results.An international survey was organised to collect data about their involvement with research commercialisation from individual scientists directly. The unit of analysis in this research is a scientist, which has been engaged in RC with or without the services from TTO staff in the years between 2010 and 2015. The collected data have been categorised by TT governance model and TTO location."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date: 2017-09-27"}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"The primary datasets have been converted into sets of variables. These conversions have been explained in the datasets.There is no data for the TTO category ‘Discipline-specialised’ in the file ’Repository with codebook 2, Academic patents in The Netherlands (1994-2014)’ because no respondents chose this category.From the 2665 respondents, 21 did not meet the target group (tenured position at a faculty of a European university). The number of valid responses is therefore 2644. Of these 2644 respondents, 329 work at a Dutch university.The percentages on academic patents (patents in which at least one scientist with a position at a Dutch university is involved as creator) in the file ’Repository with codebook 2, Academic patents in The Netherlands (1994-2014)’ do not always add up to 100 percent because patents of single individuals are not taken into account. This occasionally also applies to patents of non-Dutch organisations.Of the 60.000 email addresses of European scientists that were selected, over 30.000 turned out to be incorrect, closed, or moved to a different and unknown email address. The response figure of 8.9 percent is therefore based on the 2665 respones from 30.000 valid email addresses.The depositor provided the data files in XLSX format. DANS added the ODS format of these files to ensure preservation. For the same reason, a PDF\/A format of the DOC file was added."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Business and Management","Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"research commercialisation (RC)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Technology Transfer office (TTO)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"patents"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"spin-offs"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"patent ownership"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Technopartner program"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["English"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2017-09-27"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2017-11-05"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2017-10-30"}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Unknown"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["English"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D42100","https:\/\/www.narcis.nl\/classification\/D70000","https:\/\/www.narcis.nl\/classification\/D60000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D42100","termName":[{"lang":"nl","value":"Politicologie"},{"lang":"en","value":"Political science"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"},{"@id":"https:\/\/www.narcis.nl\/classification\/D70000","termName":[{"lang":"nl","value":"Economie en bedrijfskunde"},{"lang":"en","value":"Economics and Business Administration"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"},{"@id":"https:\/\/www.narcis.nl\/classification\/D60000","termName":[{"lang":"en","value":"Social sciences"},{"lang":"nl","value":"Sociale wetenschappen"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]}]},"dansTemporalSpatial":{"displayName":"Temporal and Spatial Coverage","name":"dansTemporalSpatial","fields":[{"typeName":"dansTemporalCoverage","multiple":true,"typeClass":"primitive","value":["2010 - 2015"]},{"typeName":"dansSpatialCoverageText","multiple":true,"typeClass":"primitive","value":["The Netherlands","Europe"]}]},"dansDataVaultMetadata":{"displayName":"Data Vault Metadata","name":"dansDataVaultMetadata","fields":[{"typeName":"dansDataversePid","multiple":false,"typeClass":"primitive","value":"doi:10.17026\/DANS-XGG-R2NU"},{"typeName":"dansDataversePidVersion","multiple":false,"typeClass":"primitive","value":"2.2"},{"typeName":"dansBagId","multiple":false,"typeClass":"primitive","value":"urn:uuid:5cb30e0a-75c8-4dd1-9cac-cfe208f4bb6d"},{"typeName":"dansNbn","multiple":false,"typeClass":"primitive","value":"urn:nbn:nl:ui:13-qxou-fq"}]}}}
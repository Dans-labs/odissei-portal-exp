            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Diestseweg en de Cipalstraat in Geel zijn de resten van twee waterputten aangetroffen; een boomstamput en een bekiste waterput.\nHieruit zijn drie monsters genomen voor dendrochronologisch onderzoek. In alle gevallen gaat het om eik (Quercus spp.).\nDe boomstamput kan in 1125 gedateerd worden. Het meeste spinthout is bewaard gebleven, dus kan bepaald worden dat het hout hoogstens enkele jaren later gekapt.\nDe twee planken van spoornr. 3076 dateren in 783 en 816. Hier is geen spinthout aanwezig, dus kan alleen gesteld worden dat het hout waarschijnlijk ergens in de 9e eeuw gekapt is."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-05-11"
                }
              }

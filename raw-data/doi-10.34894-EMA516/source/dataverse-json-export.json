            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p dir=\"ltr\">\nThis resource informs readers about the SIAMPI framework for impact assessment introduced by Spaapen and Van Drooge (2011), enriched with the experiences of the Evaluating Societal Impact team at EUR using the method in two case studies. The document summarizes the main components of the method and how it can be used to make the ‘productive interactions’ (mechanisms that might bring about societal impact) visible between researchers and their collaborators in society.</p>"
                }
              }
            ]

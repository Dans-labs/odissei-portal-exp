            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>This dataset contains behavioural data from two experiments studying the affect of unfamiliar musical chords. Participants were listening to unfamiliar musical chords and were subsequently asked to rate their perceived pleasantness or happiness. The dataset contains those affective ratings, which chords were tested, as well as demographic information and information about participant's musical sophistication. Also included are values of the predictors used to model the affective ratings (roughness, 12TET-dissimilarity, harmonicity, spectral entropy, average pitch height).</p>"
                }
              }
            ]

            "typeName": "title",
            "multiple": false,
            "typeClass": "primitive",
            "value": "Friends in a Cold Climate: Velenje-1"
          },
          {
            "typeName": "subtitle",
            "multiple": false,
            "typeClass": "primitive",
            "value": "How the ideology of a peaceful and united Europe was married to the emerging youth culture of the sixties and seventies."
          },
          {

{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Pre-COOL tweejarigencohort zevende meting"},{"typeName":"alternativeTitle","multiple":true,"typeClass":"primitive","value":["Pre-COOL tweejarigencohort zevende meting groep 8"]},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:266689"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"I. van der Veen"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Kohnstamm Instituut"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0001-7837-7789"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"I. van der Veen"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Kohnstamm Institute"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"De bestanden betreffen de verzamelde data van de zevende meting van het tweejarigencohort van het cohortonderzoek ‘jonge kind’, het pre-COOL-cohortonderzoek. Het pre-COOL-cohortonderzoek is in 2009 gestart met als doel zicht te krijgen op de effecten van verschillende vormen van kinderopvang en van voor- en vroegschoolse educatie. Het onderzoek is gericht op het beantwoorden van de vraag wat de effecten zijn van kinderopvang, peuterwerk en voor- en vroegschoolse educatie (vve) op de cognitieve en sociaal-emotionele ontwikkeling van jonge kinderen. Het pre-COOL onderzoek sluit aan op het Cohortonderzoek Onderwijsloopbanen 5-18 jarigen, afgekort COOL5-18. In het pre-COOL-onderzoek worden twee cohorten kinderen gevolgd in hun ontwikkeling en schoolloopbanen: een vierjarigen en tweejarigencohort. Deze data betreffen het tweejarigencohort: de zevende meting op 11-jarige leeftijd (groep 8). Het pre-COOL-onderzoek wordt uitgevoerd op verzoek van het ministerie van Onderwijs, Cultuur en Wetenschap en in opdracht van NRO."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"childcare"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"voor- en vroegschoolse educatie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"schoolloopbanen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"school career"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"social-emotional development"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"primary school"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"basisschool"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"sociaal-emotionele ontwikkeling"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2021-09-29"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Project Leader"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"A. M. Veen (Kohnstamm Instituut)"}}]},{"typeName":"distributor","multiple":true,"typeClass":"compound","value":[{"distributorName":{"typeName":"distributorName","multiple":false,"typeClass":"primitive","value":"Kohnstamm Instituut"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2022-12-12"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2022-12-22"}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Dr. M. H. van Binsbergen (Kohnstamm Instituut)","Dr. M. H. van Binsbergen (Kohnstamm Instituut)"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D60000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D60000","termName":[{"lang":"en","value":"Social sciences"},{"lang":"nl","value":"Sociale wetenschappen"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]}]},"dansDataVaultMetadata":{"displayName":"Data Vault Metadata","name":"dansDataVaultMetadata","fields":[{"typeName":"dansDataversePid","multiple":false,"typeClass":"primitive","value":"doi:10.17026\/DANS-XEN-Y3AF"},{"typeName":"dansDataversePidVersion","multi
          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This data contains the total excretion of inflammatory markers, measured in urine samples of ten healthy individuals. Ten participants collected 24-hour urine for 63 consecutive days in two portion, a day and an overnight portion. Multiplex analyses were used to quantify levels of eight selected markers: C-reactive protein (CRP), Fractalkine, Interleukin-1 receptor-antagonist (IL-1RA), interferon-α (IFNα), interferon-γ (IFNγ), Interferon gamma-induced protein 10 (IP10), Macrophage inflammatory protein-1β (MIP-1β), and Vascular Endothelial Growth Factor (VEGF). Data shows the concentration of the overnight portion (e.g. ng/ml), the total output overnight portion (ml), the concentration of the day portion (e.g. ng/ml), and the total output day portion (ml) of ten healthy individuals for 63 consecutive days."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2019-07-20"
                }
              }

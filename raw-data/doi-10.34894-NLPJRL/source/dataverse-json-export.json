              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The various files include all relevant demographic and questionnaire data (raw) as well as the empathic accuracy task data (prepared) of both participants/perceivers and targets. Only relevant demographic data are included to ensure participant anonymity (e.g., gender and age were removed, M age in the sample was 20 years, 62% were female). Preparing the empathic accuracy task data from original Eprime files to analysable Excel files involved averaging, for each clip, participants’ and targets’ continuous ratings across five-second intervals, and discarding the first and last intervals."
                }
              }

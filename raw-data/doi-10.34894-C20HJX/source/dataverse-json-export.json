            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "We conducted a questionnaire study among participants and non-participants of the Dutch Citizen Assembly on Energy (DCAE). One questionnaire was given before the DCAE (pre-DCAE) to measure participants' expectations, one questionnaire was given after the DCAE (post-DCAE) to measure participants' evaluations of the assembly. Data gathering for these questionnaires took place in January and February 2023. The last questionnaire was given to members of the general public who were not part of the DCAE to measure their acceptability of the whole assembly concept and process. Data gathering for this dataset took place in July 2023."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek in de wijk Bleijenburg in Den Haag is een aantal waterputten met een vermoedelijk 17e-eeuwse ouderdom aangetroffen. Voor de waterputten zijn tonnen hergebruikt en hiervan zijn monsters van de duigen aangeleverd voor dendrochronologisch onderzoek. Het gaat hier om twee duigen van vijf waterputten.\nVoor drie waterputten kan uit de twee duigen een middelcurve samengesteld worden die vervolgens weer gedateerd kan worden. Voor vondstnr. 118 kan maar één duig aangemerkt worden voor onderzoek en voor vondstnr. 110 kunnen geen resultaten gevonden. Alle dateringen bevestigen de 17e-eeuwse ouderdom.\nOp één van de duigen van vondstnr. 115 is een klein restje spinthout aangetroffen aan de hand waarvan een kapinterval rond 1621 geschat kan worden. Dit is te oud om contemporain te zijn met vondstnr. 78, 117 en waarschijnlijk vondstnr. 118 die enkele jaren eerder dateren."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-01-29"
                }
              }

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Uit het pand aan de Predikherenkerkhof 9 te Utrecht zijn twee dwarsdoorsneden aangeleverd voor dendrochronologisch onderzoek. Hierbij gaat het om een oorspronkelijke balk (M1) en een balk behorende bij een latere aanpassing (M2).\nIn beide gevallen gaat het om grove den  (Pinus sylvestris L.) en zijn voldoende jaarringen aanwezig. Wankant is niet aangetroffen.\nDe datering van M1 valt in 1649 en voor M2 in 1678. Gezien het ontbreken van de wankant zijn afgebakende kapintervallen niet vast te stellen. Gelet op de compleetheid van M1 lijkt het echter waarschijnlijk dat het kapjaar niet al te lang na 1649 valt. Voor M2 lijkt dit niet het geval."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-04-08"
                }
              }
            ]

{"license":"DANS Licence","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"KiVa Teacher Data"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:60779"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"B Oldenburg"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Rijksuniversiteit Groningen"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"R van der Ploeg"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Rijksuniversiteit Groningen"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"G.E. Huitsing"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Rijksuniversiteit Groningen"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"D.R. Veenstra"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Rijksuniversiteit Groningen"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/170392597"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"B.  Oldenburg"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Rijksuniversiteit Groningen"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"<p>This dataset contains survey data of 158 Dutch primary school teachers. The teachers were part of the evaluation of the Dutch version of the KiVa anti-bullying program and answered questions about victimization\/bullying in their classrooms and schools. The data were collected in the summer of 2012, before the teachers had started with the anti-bullying program. The answers were thus not affected by participation in the anti-bullying program.<\/p>"}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"<p>Please note: apart form the document 'Explanation_of_KiVa_Teacher_Data.pdf', all documentation is in Dutch.<\/p><p>For questions\/remarks about this dataset, please contact b.oldenburg@rug.nl<\/p><p>The KiVa student data are not included in the present dataset. These data will be archived seperately at DANS in the near future. The teacher data can be linked to the student data using the variable ‘klasnr’. This variable corresponds to the class number of both the teachers and students (wave 1). Should you be interested in using the KiVa student data please contact the principal investigator d.r.veenstra@rug.nl for more information.<\/p>"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"bullying"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"victimization"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"schools"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"teachers"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"pesten"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"scholen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"leerkrachten"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch","English"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2012-09-01"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2015-02-15"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2015-02-15"}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Unknown"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["English"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D60000","https:\/\/www.narcis.nl\/classification\/D50000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D60000","termName":[{"lang":"en","value":"Social sciences"},{"lang":"nl","value":"Sociale wetenschappen"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"},{"@id":"https:\/\/www.narcis.nl\/classification\/D50000","termName":[{"lang":"nl","value":"Gedragswetenschappen en onderwijskunde"},{"lang":"en","value":"Behavioural and educational sciences"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]},{"typeName":"dansRelation","multiple":true,"typeClass":"compound","value":[{"dansRelationType":{"typeName":"dansRelationType","multiple":false,"typeClass":"controlledVocabulary","value":"relation"},"dansRelationText":{"typeName":"dansRelationText","multiple":false,"typeClass":"primitive","value":"isReferencedBy: Oldenburg, B., Van Duijn, M.A.J., Sentse, M., Huitsing, G., Van der Ploeg, R., Salmivalli, C., & Veenstra, R. (2015). Teacher characteristics and peer victimization in elementary schools: A class-level perspective. Journal of Abnormal Child Psychology, 43, 33-44"},"dansRelationURI":{"typeName":"dansRelationURI","multiple":false,"typeClass":"primitive","value":"http:\/\/doi.org\/10.1007\/s10802-013-9847-4"}}]}]},"dansTemporalSpatial":{"displayName":"Temporal and Spatial Coverage","name":"dansTemporalSpatial","fields":[{"typeName":"dansTemporalCoverage","multiple":true,"typeClass":"primitive","value":["2012"]},{"typeName":"dansSpatialCoverageText","multiple":true,"typeClass":"primitive","value":["The Netherlands"]}]},"dansDataVaultMetadata":{"displayName":"Data Vault Metadata","name":"dansDataVaultMetadata","fields":[{"typeName":"dansDataversePid","multiple":false,"typeClass":"primitive","value":"doi:10.17026\/DANS-246-RGMB"},{"typeName":"dansDataversePidVersion","multiple":false,"typeClass":"primitive","value":"2.1"},{"typeName":"dansBagId","multiple":false,"typeClass":"primitive","value":"urn:uuid:af00357e-229b-4c99-b32b-e3d2ce0e37eb"},{"typeName":"dansNbn","multiple":false,"typeClass":"primitive","value":"urn:nbn:nl:ui:13-fzus-0o"}]}}}
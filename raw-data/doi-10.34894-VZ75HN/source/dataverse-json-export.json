            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Door de historische kring Haaksbergen is een aantal boormonsters genomen uit de boerderij aan de Broekheurnerweg 17A te Buurse. Op basis van stilistische kenmerken wordt een ouderdom in de eerste helft van de 17e eeuw verwacht. Dendrochronologisch onderzoek moet hier meer duidelijkheid over verschaffen.\nVoor het onderzoek zijn 5 boormonsters aangeleverd, in alle gevallen eik (Quercus sp.). Hiervan bleek er één (M4) te weinig jaarringen te bevatten voor onderzoek.\nDe overgebleven boormonsters konden allemaal gedateerd worden. De 3 monsters waarbij de wankant aanwezig is dateren in 1617. Dit betekent dat het hout in de herfst of winter van 1617/18 gekapt is. Het monster zonder wankant dateert iets eerder (1615), maar zal ongetwijfeld gelijktijdig met de rest gekapt zijn.\nOp basis van de resultaten lijkt het om lokaal hout te gaan."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2022-07-14"
                }
              }

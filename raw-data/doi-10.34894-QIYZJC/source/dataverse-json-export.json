            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This includes the SPSS syntax, EFA R code and cleaned SPSS datasets (used for HLM analyses, N=1,358) for the study on ‘Group-based shame, guilt, and regret across cultures’ published in the European Journal of Social Psychology. This study was conducted as part of the ERC research project ‘Political Apologies across Cultures’ (for more information, see www.politicalapologies.com). \nThe data were collected through online or face-to-face surveys conducted with a community sample in Burkina Faso, Costa Rica, Indonesia, Japan, Jordan, the Netherlands, Poland and the United States in 2017 and 2018. \nOnly data pertaining to this study has been included. Although the questionnaire included a number of additional measures concerning responsibility, reputation and face-honor-dignity norms, these pertain to other studies within the project. More information about these measures is available from the authors upon request."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

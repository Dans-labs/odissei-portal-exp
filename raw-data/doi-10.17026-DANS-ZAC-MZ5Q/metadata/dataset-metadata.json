{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Arbeidsvraagpanel 2019 – AVP2019"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:259578"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Sociaal en Cultureel Planbureau (SCP)"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"SCP  Databeheerder"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Sociaal en Cultureel Planbureau"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Het Arbeidsvraagpanel is een vragenlijstonderzoek onder vestigingen van werkgevers in Nederland. Het bestaat sinds 1989. Sindsdien worden iedere twee jaar opnieuw werkgevers geënquêteerd. Het aantal waarnemingen ligt rond de 3000. Er zijn inmiddels 16 metingen voor onderzoekers beschikbaar.Het Arbeidsvraagpanel is bedoeld om meer inzicht te krijgen in de vraag naar arbeid en het personeelsbeleid van werkgevers. De kracht van het Arbeidsvraagpanel ligt vooral in de combinatie van onderwerpen die het panel bestrijkt. Het Arbeidsvraagpanel is destijds opgezet door de OSA (Organisatie voor Strategisch Arbeidsmarktonderzoek). Sinds augustus 2010 is het panel ondergebracht bij het Sociaal en Cultureel Planbureau (SCP).Door de coronapandemie en de bijbehorende maatregelen is het veldwerk van Ronde 3 met een half jaar uitgesteld tot najaar 2020.In het databestand van meting 2019 dat bij DANS beschikbaar wordt gesteld zijn variabelen verwijderd. Dit wordt in het overzicht van variabelen verantwoord. Het overzicht bevat daarnaast alle variabelen en thema’s vanaf 1989 die in het Arbeidsvraagpanel aan bod zijn gekomen."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"arbeid"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"dynamiek arbeidsmarkt"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"flexibilisering"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"personeelsbeleid"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"mobiliteit"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"scholing"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"gesubsidieerde arbeid"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"oudere werknemers"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"duurzame inzetbaarheid"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2022-10-11"},{"typeName":"distributor","multiple":true,"typeClass":"compound","value":[{"distributorName":{"typeName":"distributorName","multiple":false,"typeClass":"primitive","value":"Sociaal en Cultureel Planbureau (SCP)"}}]},{"ty
          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Het onderwerp van dit onderzoek is een paneelschilderij met een tafereel van enkele schepen op woelig water. Het schilderij staat sinds de negentiende eeuw bekend als een werk van Ludolf Backhuysen (1630 – 1708) en wordt als zodanig vermeld in veilingcatalogi. Recent is gesuggereerd dat het schilderij niet in de zeventiende eeuw maar rond 1800 ontstaan zou zijn. Om meer inzicht in de ouderdom van het schilderij te krijgen is dendrochronologisch onderzoek uitgevoerd.\nHet schilderij bestaat uit een enkel paneel van kwartiers eikenhout (Quercus sp.).\nOpmerkelijk is dat (vrijwel) het gehele spinthout aanwezig is. Doorgaans wordt dit minder duurzame hout verwijderd. Gezien de beperkte dikte van het paneel is het onmogelijk vast te stellen of de wankant aanwezig is of niet, maar hoe dan ook is het aantal ontbrekende jaarringen zeer beperkt.\nDe meting beslaat 186 jaarringen en de laatste jaarring kan in 166o geplaatst worden. Het kapjaar ligt hoogstens enkele jaren later. Een vergelijkbaar klein aantal jaarringen moet bijgeteld worden bij wijze van droogtijd van het paneel. Hiermee lijkt een productie ergens tussen 1665 en 1670 erg waarschijnlijk, wat zeer goed aansluit bij de veronderstelde datering van c. 1667."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-03-30"
                }
              }
            ]

            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Het onderzoek naar vier beukenhouten monsters die zijn aangetroffen in de fundering van een stadsmuur (objectnr. 05-27) op de site Rotterdam Spoortunnel - ter hoogte van het huidige Sint Jacobspark - die eind jaren ’80 en begin jaren ’90 is opgegraven, resulteert in een datering van één van de vier meetreeksen. De datering ná 1528 is het aller vroegst mogelijke kapjaar. Voor de bouwfase dient een ruimere interpretatie te worden meegewogen met een uitloop tot in de tweede helft van de 16e eeuw."
                }
              }
            ]
          },

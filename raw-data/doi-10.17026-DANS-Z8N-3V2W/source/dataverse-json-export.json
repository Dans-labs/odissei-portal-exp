                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Japanse bezetting Indië c.q. Bersiap"
                }
              },
              {
                "keywordValue": {
                  "typeName": "keywordValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Ondernemen c.q. werken in Manokwari c.q. de Vogelkop"
                }
              }
            ]
          },
          {
            "typeName": "language",

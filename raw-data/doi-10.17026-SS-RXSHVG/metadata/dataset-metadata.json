/\/vocabularies.cessda.eu\/vocabulary\/TopicClassification?v=4.2#SocialStratificationAndGroupings.Children","https:\/\/vocabularies.cessda.eu\/vocabulary\/TopicClassification?v=4.2#Education.CompulsoryAndPreschoolEducation","https:\/\/vocabularies.cessda.eu\/vocabulary\/TopicClassification?v=4.2#NaturalEnvironment.EnvironmentAndConservation"],"expandedvalue":[{"@id":"https:\/\/vocabularies.cessda.eu\/vocabulary\/TopicClassification?v=4.2#SocialStratificationAndGroupings.Children","vocabularyUri":"https:\/\/vocabularies.cessda.eu\/vocabulary\/TopicClassification?v=4.2"},{"@id":"https:\/\/vocabularies.cessda.eu\/vocabulary\/TopicClassification?v=4.2#Education.CompulsoryAndPreschoolEducation","vocabularyName":"CESSDA Topis classification4.2","vocabularyUri":"https:\/\/vocabularies.cessda.eu\/vocabulary\/TopicClassification?v=4.2"},{"@id":"https:\/\/vocabularies.cessda.eu\/vocabulary\/TopicClassification?v=4.2#NaturalEnvironment.EnvironmentAndConservation","vocabularyName":"CESSDA Topis classification4.2","vocabularyUri":"https:\/\/vocabularies.cessda.eu\/vocabulary\/TopicClassification?v=4.2"}]},{"typeName":"dansUniverse","multiple":true,"typeClass":"primitive","value":["120 school children (11-12 years old) from six classes of three public secondary schools of Venice (Francesco Morosini from Venice, Giuseppe Volpi from Favaro Veneto, and Lazzaro Spallanzani from Mestre). In the Italian school system, 11-12 year old children are typically in the first or second year of Scuola Media (lower secondary school), also known as Scuola Secondaria di Primo Grado. This stage of education is compulsory for all pupils and lasts for three years, starting at age 11."]},{"typeName":"dansFrequencyOfDataCollection","multiple":false,"typeClass":"primitive","value":"Before and after one-day educational activities in the field"},{"typeName":"dansSamplingProcedureFreeText","multiple":false,"typeClass":"primitive","value":"All the children in 6 classes from 3 schools in the wider Venice area (see Universe). Selection of schools and classes was based on willingness to participate in and follow instructions about the proposed nature education programme"},{"typeName":"dansDataCollectionSituation","multiple":false,"typeClass":"primitive","value":"Surveys were taken by the teachers of the children. Every child completed, individually, the same exercises before and after the educational activities. Exercises were first completed in the classrooms, prior to a presentation explaining the lagoon and the planned excursion. The second time, exercises were completed on the boat, on the way back after the outdoor excursion.  Exercises were printed in separate booklets so children could not consult their previous answers."},{"typeName":"dansActionsToMinimizeLoss","multiple":false,"typeClass":"primitive","value":"no follow up visits"},{"typeName":"dansWeighting","multiple":false,"typeClass":"primitive","value":"no weights were used"},{"typeName":"dansResponseRate","multiple":false,"typeClass":"primitive","value":"response rate varied between 72-79%, depending on the survey question"}]},"dansTemporalSpatial":{"displayName":"Temporal and Spatial Coverage","name":"dansTemporalSpatial","fields":[{"typeName":"dansTemporalCoverage","multiple":true,"typeClass":"primitive","value":["2023"]},{"typeName":"dansSpatialCoverageControlled","multiple":true,"typeClass":"controlledVocabulary","value":["Italy"]},{"typeName":"dansSpatialCoverageText","multiple":true,"typeClass":"primitive","value":["Venice and Mestre"]}]},"dansDataVaultMetadata":{"displayName":"Data Vault Metadata","name":"dansDataVaultMetadata","fields":[{"typeName":"dansDataversePid","multiple":false,"typeClass":"primitive","value":"doi:10.17026\/SS\/RXSHVG"},{"typeName":"dansDataversePidVersion","multiple":false,"typeClass":"primitive","value":"1.0"},{"typeName":"dansBagId","multiple":false,"typeClass":"primitive","value":"urn:uuid:df7e86a9-27f0-4c47-9998-3aa4e6b110e7"},{"typeName":"dansNbn","multiple":false,"typeC
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset was produced as part of the funded research project 'RAAK Groenblauwe Oplossingen' (RAAK.PUB07.015), led by the Hanze University of Applied Sciences in Groningen. It contains information on over 50 swales across The Netherlands, collected between April 2021 and December 2022. The dataset contains data collected through several fieldwork methods: infiltration tests, soil pollution scans and neighbourhood surveys, as well as metadata on characteristics of the swales and the locations they're positioned in. The main goal of the dataset was to analyse, compare and explain the functioning of swales in an attempt to improve their functioning in the future. As the dataset does not contain sensitive information, it can be used freely"
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",

            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "De Schelmentoren in Heerlen is een middeleeuwse toren waarin twee houten deuren bewaard gebleven zijn. Het is onduidelijk hoe oud deze deuren zijn.\nBij restauratie van deze deuren is van de gelegenheid gebruik gemaakt om de kopse kant van enkele planken vast te leggen voor dendrochronologisch onderzoek.\nEén van de planken bevat voldoende jaarringen en is aangemerkt voor onderzoek.\nDeze plank bevat 134 jaarringen waarvan de laatste in 1757 dateert. Om basis van enkele aanwezige spinthoutringen kan een kapinterval rond 1774 geschat worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-12-16"
                }
              }
            ]

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van Pont West in Ronse is een waterput aangetroffen. Uit de houten bekisting zijn monsters genomen voor dendrochronologisch onderzoek. In alle gevallen gaat het om eik (Quercus sp.). Voor de planken zijn zware en buitengewoon snel gegroeide eiken gebruikt. Voor twee planken kan vastgesteld worden dat deze uit dezelfde boom afkomstig zijn, maar dit leidt niet tot verdere resultaten.\nOverige onderlinge datering kunnen niet vastegsteld worden.\nVan de diverse balken kunnen er twee gedateerd worden. Beide dateringen vallen aan het begin van de 1e eeuw, maar omdat er geen spinthout aanwezig is kan alleen de ondergrens van het kapinterval bepaald worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",

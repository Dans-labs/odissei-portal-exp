                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This is a slightly adapted version of the official HSN 2013.01 HISCO release. The original file has no headers and a subsequent version was in Dutch csv standard (i.e. ';' as seperator and ',' as decimal indicator). This dataset contains that Dutch file, an R-script to transpose it to the international csv-format, and the resulting file."
                },

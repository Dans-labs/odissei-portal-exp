            "typeClass": "compound",
            "value": [
              {
                "datasetContactName": {
                  "typeName": "datasetContactName",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Schaacke, Joost"
                },
                "datasetContactAffiliation": {
                  "typeName": "datasetContactAffiliation",

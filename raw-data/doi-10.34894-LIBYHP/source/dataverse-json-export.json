              {
                "publicationCitation": {
                  "typeName": "publicationCitation",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "van der Lee, C., Emmery, C., Wubben, S., & Krahmer, E. (2020, December). The CACAPO dataset: A multilingual, multi-domain dataset for neural pipeline and end-to-end data-to-text generation. In Proceedings of the 13th International Conference on Natural Language Generation (pp. 68-79)."
                },
                "publicationIDType": {

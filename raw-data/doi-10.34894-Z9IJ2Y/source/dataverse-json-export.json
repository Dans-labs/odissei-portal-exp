            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The goal of the project is to explore in what ways AI-based simulations can support pre-service mathematics teachers in developing their teacher noticing skills. The project is divided into small studies, where some are already complete and others are still running. Study 1 is the first study, in which we conducted 3 workshops: two workshops with pre-service mathematics teachers for secondary school and one workshop with pre-service computer science teachers. In the workshops, the teachers interacted with an AI chatbot assuming the role of a student, around a classroom situation we call a critical event, using a pre-designed prompt. After the workshops, we held interviews with the teachers. Overall, we collected 9 interviews. Here we share a metadata file containing general information about the data we collected (the number of times each teacher used the prompt to interact with the AI, the length of the interaction in number of turns, and language). We also attach the prompt used, which is open for reuse with appropriate citation. Specific additional data that can be made available upon request includes: 1) scripts of the pre-service teachers' interactions with the AI in the simulation; 2) 9 interviews conducted with the pre-service teachers after a workshop where they tried the simulations; 3) 2 audio files of the workshop. "
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-05-06"
                }
              }

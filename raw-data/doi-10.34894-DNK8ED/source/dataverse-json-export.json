            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This data set focuses specifically on the accessibility of honours education for first generation students (i.e., students who are the first in their family to attend higher education) while taking a social psychological approach. We have collected both quantitative and qualitative data across two academic years (2020-2021 & 2021-2022) with first- and continuing generation honours students about their experiences in honours as well as with first- and continuing generation regular students about their (not) to study in honours.\n\nThis data set consists of 4 different parts:\nPart 1 includes survey data of students about their choice (not) to participate in an honours programme\nPart 2 includes survey data of students at the start of their honours programme\nPart 3 includes survey data of students during their honours programme\nPart 4 includes qualitative interview data with first generation honours students. For privacy reasons only the meta data of this part is included."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

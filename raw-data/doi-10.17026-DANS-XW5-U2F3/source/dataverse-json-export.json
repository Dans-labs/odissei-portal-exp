                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>PGvsPI-5 has intimate knowledge of the global developments in regulation of exchanges through their work for the Fédération Internationale des Bourses de Valeurs. The interview discusses global developments, the role of IOSCO, and the demutualization and opening up of exchanges.</p>"
                }

              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This research data is part of the publication \"Teaching as part of Open Scholarship\", which was submitted to the journal Scientometrics on November 10, 2023. In the article we discuss statistics for Open Educational Resources (OER). We conducted interviews with scientometrics experts. The transcripts of the interviews are available here (see: raw data files). We prepared an overview graphic that presents initial thoughts on OER statistics (see: appendix). During the interviews, we discussed this graphic and went through it from start to finish. No further interview guideline was given."
                }
              }
            ]

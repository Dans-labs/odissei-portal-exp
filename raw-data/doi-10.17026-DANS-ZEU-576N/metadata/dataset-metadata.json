{"license":"CC-BY-4.0","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Weg naar de WIA 3"},{"typeName":"alternativeTitle","multiple":true,"typeClass":"primitive","value":["Cohortonderzoek onder langdurig zieke werknemers en vangnetters"]},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:111482"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"C.G.L. van Deursen"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Uitvoeringsinstituut Werknemers Verzekering - UWV (SBK Kenniscentrum)"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"C.G.L. van Deursen"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"UWV"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"UWV heeft een cohort gevolgd van langdurig zieke werknemers en vangnetters die in 2015 9 maanden ziek waren. Zij zijn geënquêteerd 11 en 18 maanden na de ziekmelding. Gevraagd is naar de ziekte\/gezondheid, de eerstejaars Ziektewet-beoordeling, de kenmerken van het werk en het arbeidsverleden, de begeleiding bij werkhervatting, het zoeken naar werk, de werkhervatting en de eigen betrokkenheid en de eigen inbreng in de re-integratie. In dit tabellenboek worden de antwoorden weergeven van de eerste meting bij de vangnetters, uitgesplitst naar type vangnetters. Daarbij worden waar mogelijk ook de resultaten uit een vergelijkbaar, 3 jaar eerder gehouden onderzoek gepresenteerd."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Medicine, Health and Life Sciences","Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Wet Werk en Inkomen naar Arbeidsvermogen - WIA"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"WIA"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"reintegratie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"claimbeoordeling"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"arbeidsongeschiktheid"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Ziektewet"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"42e ziekteweek melding"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Wet Bezava (Wet beperking ziekteverzuim en arbeidsongeschiktheid vangnetters)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"sociale zekerheid"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2018-09-28"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","value":"Researcher"},"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primi
          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This data package contains (meta) data, analysis scripts, and relevant documents for the project: “Perspective-taking and norm predictability in coalition formation”. This project examines whether perspective-taking plays a role in predictable vs. unpredictable coalition formation context and potential underlying mechanisms. \nParticipants played the Political Convention Game, which simulates coalition formation in a political setting, and reported their disposition to engage in perspective-taking during the game. This project used secondary data from Experiment 3 of Wissink et al. \n(2023)."
                }
              }
            ]
          },

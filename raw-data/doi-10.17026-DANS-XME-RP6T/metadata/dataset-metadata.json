tive","value":["https:\/\/www.narcis.nl\/classification\/D60000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D60000","termName":[{"lang":"en","value":"Social sciences"},{"lang":"nl","value":"Sociale wetenschappen"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]},{"typeName":"dansRelation","multiple":true,"typeClass":"compound","value":[{"dansRelationType":{"typeName":"dansRelationType","multiple":false,"typeClass":"controlledVocabulary","value":"relation"},"dansRelationText":{"typeName":"dansRelationText","multiple":false,"typeClass":"primitive","value":"Forthcoming: Melissa Chan, Tim MH Li, YW Law, Paul WC Wong, Michael Chau, Cecilia Cheng, KW Fu, John Bacon-Shone, Qijin Emily Cheng and Paul SF Yip. Engagement of vulnerable youths using internet platforms. PLOSONE"}}]}]},"dansTemporalSpatial":{"displayName":"Temporal and Spatial Coverage","name":"dansTemporalSpatial","fields":[{"typeName":"dansTemporalCoverage","multiple":true,"typeClass":"primitive","value":["23 January 2016 - 22 March 2013"]},{"typeName":"dansSpatialCoverageControlled","multiple":true,"typeClass":"controlledVocabulary","value":["Hong Kong"]}]},"dansDataVaultMetadata":{"displayName":"Data Vault Metadata","name":"dansDataVaultMetadata","fields":[{"typeName":"dansDataversePid","multiple":false,"typeClass":"primitive","value":"doi:10.17026\/dans-xme-rp6t"},{"typeName":"dansDataversePidVersion","multiple":false,"typeClass":"primitive","value":"2.2"},{"typeName":"dansBagId","multiple":false,"typeClass":"primitive","value":"urn:uuid:b2be8eb6-fba2-40d2-b10c-f97df4601605"},{"typeName":"dansNbn","multiple":false,"typeClass":"primitive","value":"urn:nbn:nl:ui:13-kznr-h3"}]}}}
          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Gruttersdijk te Utrecht is een aantal als waterput hergebruikte tonnen aangetroffen. Van de duigen zijn monsters genomen voor dendrochronologisch onderzoek. Daarnaast zijn delen van de hoepels en andere losse vondsten aangeleverd voor houtsoortenonderzoek.\nSpoornr. 97 bevat twee tonnen en de meeste losse vondstnrs. Uit de ton met vondstnr. 115 kunnen twee duigen aangemerkt worden voor onderzoek. Voor vondstnr. 121 zijn 15 duigen beschikbaar, waarvan er acht geschikt zijn voor onderzoek. Voor beide tonnen kan een vergelijkbare ouderdom in de tweede helft van de 16e eeuw en herkomst vastgesteld worden. Op basis hiervan lijken deze twee tonnen bij elkaar te horen.\nAan de hand van enkele spinthoutringen op vondstnr. 121.9 kan een kapinterval rond 1584 bepaald worden.\nDe meeste duigen uit vondstnr. 115 zijn afkomstig uit twee bomen. Hiervoor zijn de boom-middelcurven 23.039.B01 en B02 gemaakt.\nUit spoornr. 180 is één ton afkomstig (vondstnr. 232), waarvan vijf duigen onderzocht konden worden. Hiervoor is een middelcurve gemaakt (23.039.M01) en kan gedateerd worden aan het begin van de 14e eeuw. Hoewel er geen spinthout aanwezig is en er dus geen afgebakend kapinterval geschat worden, lijkt het duidelijk dat het om een oudere put gaat."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-08-21"
                }
              }
            ]

{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Interview Arjan van Hessen, online, 2 april 2025"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Sanneke Stigter"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit van Amsterdam"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0001-5250-8461"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Data Steward Faculty of Humanities"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"}},{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Sanneke Stigter"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Interview voor een Engelstalig hoofdstuk in het boek Artworks through Oral History, voortkomend uit het door het PDI-SSH ondersteunde onderzoeksproject, Oral History–Stories at the Museum about Artworks (OH-SMArt) (2021-2025), en verschillende andere onderzoeksprojecten voor het inrichten van een gebruiksvriendelijke workflow voor het optimaal archiveren en ontsluiten van Oral History in de Nederlandse digitale onderzoeksinfrastructuur, volgens FAIR Principles voor onderzoeksdata. Van Hessen is specialist op het gebied van Automatic Speech Recognition (ASR), en ondersteunt Oral History onderzoekers bij het archiveren van hun bronmateriaal bij het omzetten van spraak naar tijd gecodeerde transcripties. Hij beschrijft de ontwikkeling van Kaldi spraakherkenningssoftware naar Whisper van OpenAI, gat in op waar oral history onderzoekers op moeten letten bij het opnemen en archiveren, en besluit met enthousiasme over wat er tegenwoordig allemaal mogelijk is met het digitaal omzetten van gesproken woord in het dagelijks leven."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities","Computer and Information Science"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"oral history (discipline)"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"Art and Architecture Thesaurus"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"http:\/\/vocab.getty.edu\/aat\/300054402"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"interviews"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"Art and Architecture Thesaurus"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"http:\/\/vocab.getty.edu\/aat\/300026392"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"interviewing"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"Art and Architecture Thesaurus"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","mul
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "A dataset called UserratedPatch2021 was compiled, which consists of 220,800 DIF image patches (of size 50 x 50 pixels) extracted from 106 images of 46 patients (4,800 patches per each patient). The half of the dataset is u-serrated patterns from DIF biopsies of 23 patients with confirmed diagnoses of EBA and the other half is non-u-serrated patterns from DIF biopsies of the other 23 patients with other pemphigoid diseases. \r\nDifferent staining intensities and slide thicknesses (4 µm, 6 µm, and 8 µm) were included to generate the dataset, representing routine diagnostics. All DIF slides were cut and stained at the Immunodermatology Laboratory of the Center for Blistering Diseases, University Medical Center Groningen, the Netherlands. DIF images were taken under standardized settings with the same microscope (Leica DMRA, Leica, Wetzlar, Germany) and 40x magnification dry objective (Leica HCX PL Fluotar 40x/0.75, Leica, Wetzlar, Germany) and 10x magnification ocular."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2021"
                }
              }
            ]

            "typeClass": "primitive",
            "value": "Interview with Sanneke Stigter on DIAL for Complex Artworks. Online, 30 April 2021"
          },
          {
            "typeName": "subtitle",
            "multiple": false,
            "typeClass": "primitive",
            "value": "A conservation research project and reflexivity tool"
          },

{"license":"DANS Licence","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, Een kerkscheuring in oorlogstijd, interview 08"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:41644"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Historisch Documentatiecentrum voor het Nederlands Protestantisme ©"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"W.P.  Beekers"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Vrije Universiteit"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"J. Kleisen werd geboren in Apeldoorn als zoon van een christelijk-gereformeerd predikant. Hij was de een na oudste in het gezin. In de jaren dertig woonde het gezin in Vlissingen. Kleisen herinnert zich de opkomst van de socialistische beweging aldaar nog goed. Vooral de 1 Mei optochten staan hem nog scherp voor de geest. In huize Kleisen werden kerkelijke bladen gelezen. Ook luisterde men naar de BBC en volgde men de oorlog op de voet met behulp van landkaarten.Na de oorlog werd Kleisen gereformeerd, omdat de intellectuele cultuur van de christelijk gereformeerden hem niet meer aansprak. Maar hij bezag de Vrijmaking, waaraan hij zelf geen deel had, met lede ogen als student in Utrecht: de gelijkhebberigheid en de zekerheid waarmee over Gods wil gesproken werd, prikkelde Kleisen. Volgens hem heeft de verzetshouding in de oorlog een rol gespeeld in de kerkscheuring: gereformeerden namen een ‘verzetshouding’ aan in het leven, ook Kleisen zelf naar eigen zeggen."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date Submitted: 2010-03-19"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Kerken"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"gereformeerden"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"onderwijs"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Vrijmaking"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Nationaal-Socialistische Beweging"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"1 Mei vieringen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"WA"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"kaartmateriaal"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Radio Oranje"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"oral history"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","valu
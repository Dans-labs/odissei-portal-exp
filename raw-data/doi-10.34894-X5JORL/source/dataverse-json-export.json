          {
            "typeName": "publication",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "publicationCitation": {
                  "typeName": "publicationCitation",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Vranjes, I., Baillien, E., Erreygers, S., Vandebosch, H., & De Witte,\nH. (2021). You wouldn’t like me when I’m angry: A daily diary study\nof displaced online aggression in dual‐earner couples. Applied\nPsychology, 70(4), 1463-1491."
                },
                "publicationIDType": {
                  "typeName": "publicationIDType",
                  "multiple": false,
                  "typeClass": "controlledVocabulary",
                  "value": "doi"
                },
                "publicationIDNumber": {

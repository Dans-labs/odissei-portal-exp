            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Dataset contains information on the first deposits of the costumers of the Post Office Savings Bank in Leiden. The relation between the first deposit, social circumstances and status of the depositors is investigated. Information as interest rates, religion, age, occupation and the district of Leiden where the depositor lives, are included. The dataset is divided in one main file which contains all variables and many subfiles which contain parts of the research, such as the relation between rent and occupation or age and occupation.</p>"
                }
              }
            ]

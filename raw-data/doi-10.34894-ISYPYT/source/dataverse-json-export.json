            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Dendrochronological research project. D.J. de Vries and H. Tisje performed the research and produced the initial dating resuls. Digitization of the analog measurement series: Benno Ridderhof (VU, 2008); further additions, reformatting and verification of results: Esther Jansma (2011, 2022). In 2022 the initial dates could not be confirmed with sufficient statistical certaintly."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2022-01-31"
                }
              },
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The year in which the research stored in https://dataverse.nl/dataverse/stichtingring took place, from 1985 onwards can be found in the report number, with for example ‘P:1997001’ implying that this particular study took place in 1997. Interpretations of the most likely wood provenance and estimations of the number of missing sapwood rings, if included in the original research report, are based on the knowledge at the time and may be subject to later refinement."
                }
              }
            ]

{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Sociale impact van fysieke afstand op kwetsbare populaties tijdens COVID-19 (2020): interviews met dak- en thuislozen, belangenorganisaties en professionals"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:215971"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"D.H. de Vries"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Universiteit van Amsterdam"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0001-7455-0628"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"D.H. de Vries"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Deze dataset is gecollecteerd in het kader van het ZonMw gefinancierde project “Sociale impact van fysieke afstand op kwetsbare populaties tijdens COVID-19” in 2020 (projectnummer 10150062010007). In dit project onderzochten we de effecten van sociale isolatie op kwetsbare groepen in Nederland ten tijde van ‘de lockdown’ periode (van 15 maart 2020 tot 23 mei 2020) en de periode van ‘de versoepeling’ van de maatregelen tot het einde van het onderzoek (de periode na 23 mei 2020-1 juli 2020). Voor meer informatie zie ook www.coronatijden.nl.Het doel van deze dataset is om te beschrijven op welke manier de coronamaatregelen van invloed zijn op de opvang en begeleiding van mensen die dakloos zijn en wat dat betekent voor hun dagelijks leven. Ook geven we aan welke bedreigingen en kansen er zijn en doen we suggesties voor vertaling naar beleidsmaatregelen. Voor dit onderzoek hebben we in zes gemeenten gesproken met cliënten van de opvang, opvangprofessionals en belangenbehartigers\/ straatadvocaten. De data is gecollecteerd door onderzoekers van het Trimbos Instituut.  Met hulp van de opvangprofessionals en de belangenbehartigersorganisaties zijn cliënten van de maatschappelijke opvang geworven. Van de 15 cliënten waren er drie vrouw, de leeftijd varieerde van 23 tot 62 jaar. De duur van de periode waarin ze gebruik maakten van de maatschappelijke opvang en\/of dakloos waren loopt uiteen van 5 dagen tot 18 maanden. Twee cliënten hebben gedurende zes weken een dagboek bijgehouden. Ook opvangprofessionals en belangenbehartigers zijn geïnterviewd tussen 24 april en 10 juni. Enkele professionals hebben per mail een update gegeven over de situatie in hun voorziening."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date: april- juni 2020 (data collection)"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Medicine, Health and Life Sciences","Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"COVID-19"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"corona"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"sars-cov-2"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"sociale isolatie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"fysieke afstand"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"thuisisolatie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"beleid"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"sociale kwetsbaarheid"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"daklozen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"dakloos"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"thuislozen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"thuisloos"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"longitudinaal"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"kwalitatief"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"zorg"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"preventie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"kwetsbare burgers"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2021-07-10"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorType":{"typeName":"contributorType","multiple":false,"typeClass":"controlledVocabulary","valu
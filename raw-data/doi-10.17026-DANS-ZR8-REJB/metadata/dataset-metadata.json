{"license":"DANS Licence","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, Schiedamse Bleekneusjes, interview 03"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:41507"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Nieuwendijk, C.I., Gemeentearchief Schiedam (©)"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"C.I.  Nieuwendijk"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Gemeentearchief Schiedam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Meneer was ruim 5 jaar toen de oorlog uitbrak. Hij herinnert zich het bombardement op Rotterdam. Zijn ouders waren hervormd, maar zelf ging hij vaak naar de katholieke kerk - het theater daar trok hem aan. Tijdens de hongerwinter woonde hij met moeder en jongere broer in de Nicolaas Beetsstraat. Zijn vader was gevorderd voor de Arbeitseinsatz en keerde voor de bevrijding terug. Vanwege ondervoeding werd de geïnterviewde in de zomer van 1945 naar het luthers pleeggezin Larsen in Denemarken gestuurd. In dat gezin, dat in het gehucht Gerlev woonde, waren enkel pleegkinderen: twee jongens en een gehandicapt meisje. Zijn pleegvader had een schildersbedrijf. Het eten in Denemarken was volgens hem bijzonder lekker. Ook de Deense manier van leven beviel hem. Hij is Denemarken als zijn tweede vaderland gaan beschouwen."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Respondentnummer 92. De beschrijvingen van de bijgevoegde foto's zitten in het document GV_Schiedam_gastgezin2_03_fotodocumentatie. Document GV_Schiedam_gastgezin2_02_analyse_interview bevat een analyse van het interview. Document GV_Schiedam_gastgezin2_03_herinneringen is afkomstig van de geïnterviewde zelf."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Schiedam"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Hongertochten"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Hongerwinter"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Kinderuitzending"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Kinderen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Honger"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Hunger"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Hungerwinter"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Children"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Childrentransport"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primi
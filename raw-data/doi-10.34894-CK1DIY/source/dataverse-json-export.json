            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Op de huidige locatie Almere-Pampus zijn er de jaren ’80 van de vorige eeuw de onderdelen van een Middeleeuwse kerkkap aangetroffen. Deze zijn waarschijnlijk bij transport over de Zuiderzee overboord geslagen of gegooid.\nDe onderdelen zijn na ontdekking verzameld en herbegraven om degradatie tegen te gaan.\nDeze locatie was decennia later echter niet meer duidelijk, waardoor een archeologisch onderzoek noodzakelijk om de onderdelen van de kap weer terug te vinden. Vervolgens is een kleine sleuf aangelegd om een deel van balken bloot te leggen. Deze gelegenheid is aangegrepen om een aantal monsters voor dendrochronologisch onderzoek te nemen. De kap werd aangeduid als vroeg 15e-eeuws en het doel van het dendrochronologisch onderzoek is deze datering aan te scherpen."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-10-15"
                }
              }

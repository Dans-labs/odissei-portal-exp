:false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/079403980"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"M.A. Hulsbosch"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud University"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/391248413"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"H. van den Heuvel"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Radboud University"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"DAI"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"info:eu-repo\/dai\/nl\/136423701"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"RU  Radboud University"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"<p>Whatsappdata collected for the PhD research of Lieke Verheijen (Radboud University). Informed consent only from contributor and not from conversational partner. Consequently, the subcorpus only contains contributions from the submitter.  Metadata per conversation are available in CMDI XML files. Ref: Verheijen, L., & Stoop, W. (2016, September). Collecting facebook posts and whatsapp chats. In International Conference on Text, Speech, and Dialogue (pp. 249-258). Springer, Cham.<\/p><p>The  corpus has been made available for the CLARIAH sponsored ACAD project.<br>See https:\/\/www.clariah.nl\/projecten\/research-pilots\/acad\/acad and https:\/\/cesar.science.ru.nl\/.<\/p><p>Cooperators:<br>Micha Hulsbosch - Radboud University Nijmegen, Faculty of Arts, Humanities Lab, TSG<br>Wilbert Spooren - Radboud University Nijmegen, Faculty of arts, Dutch language<br>Erwin R. Komen \t- Radboud University Nijmegen, Faculty of Arts, Humanities Lab, TSG<br>Patrick Sonsma \t- Radboud University Nijmegen, Faculty of arts, Dutch language<\/p><p>Original researcher:<br>Lieke Verheijen - Radboud University Nijmegen, Faculty of arts, Dutch language<\/p><p>The corpus contains 218 WhatsApp chat sessions that have been collected by Lieke Verheijen in 2012-2014 in the Netherlands.<br>The exact date of each chat is included in the <event> tag attributes in the .folia.xml files.<br>The participants have all indicated that their chats can be used (in an anonymized form) for research purposes.<br>Metadata per chat are available in CMDI XML files.<\/p><p>The File textlist-folia.json contains an overview of all available texts in json format.<\/p><p>===========================================================<br>Version: Date:        Notes:<br>1.0      10\/oct\/2018  [First] archiving of this corpus<br>===========================================================<\/p>"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities","Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"social media"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"whatsapp"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"corpus linguistics"}},{"keywordValue":{"typeName
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "GENAISIS is a quality framework for responsible development, validation, evaluation, implementation, and monitoring of GenAI applications in healthcare regardless of their specific intended function or purpose. Developed through a large international, multi-stakeholder Delphi process, it provides a clear eight-phase lifecycle and defines a checklist with key criteria for good practice at each phase. This dataset includes four rounds of aggregated survey results, the scripts used to generate the graphics in the survey results documents, as well as the approved Data Management Plan (DMP) and research protocol."
                },

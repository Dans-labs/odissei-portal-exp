          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Van het pand aan de Oudestraat 4 te Kampen wordt vermoed dat hier 14e eeuwse elementen bewaard gebleven zijn. Om dit te achterhalen zijn boormonsters uit verschillende delen van het houtskelet genomen voor dendrochronologisch onderzoek. In totaal zijn 13 monsters aangeleverd, in alle gevallen eik (Quercus sp.). De meeste monsters zijn van matige kwaliteit, maar zijn onderzocht in de veronderstelling dat middels onderlinge synchronisatie een bruikbare middelcurve samengesteld kan worden. De uitzondering hierop zijn monsters 4-BDJ 1, 6-ODB 6 en 8-MB 1 die ook niet aan lagere standaarden konden voldoen, en 7-MB 5 die als enige wel voldoende jaarringen bevat en zonder twijfel op eigen gelegenheid gedateerd kan worden. Uit de metingen kan een middelcurve (25.036.M01) samengesteld worden waarin vier metingen opgenomen zijn, waaronder een meting van Oudestraat 16 (25.037.003). Deze metingen laten zowel onderling als met referentiecurven goede resultaten zijn. Met uitzondering van 25.036.010 zijn deze metingen echter te kort om op eigen gelegenheid te dateren, maar in samenhang met de middelcurve is dit als onderbouwing te beschouwen. De middelcurve kan gedateerd worden 1423. Hieruit volgt dat er twee verschillende faseringen aanwezig zijn; één voor de herfst/winter van 1377/78 en één rond 1431."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-05-21"
                }
              }
            ]

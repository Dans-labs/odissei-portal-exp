            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Van het archeologisch onderzoek aan de Schoppershofstraat te Leeuwarden is een drietal monsters aangeleverd voor dendrochronologisch onderzoek.\nHet gaat om monsters van drie grenen (Pinus sylvestris L.) planken waarvan de context niet nader is toegelicht.\nEén van de monsters (vondstnr. 175) bevat zeer veel jaarringen, maar kon niet gedateerd worden. Vermoedelijk omdat de meeste van deze jaarringen gevormd zijn in periodes van extreem gereduceerd groei, waardoor er jaarringen kunnen ontbreken en het jaarringsignaal weinig uitgesproken is.\nDe andere twee monsters kunnen gedateerd worden in de 15e en 16e eeuw, maar omdat er geen wankant aanwezig is, kan alleen vastgesteld worden dat het kapjaar ergens na de tweede helft van de 16e eeuw valt."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-01-30"
                }
              }
            ]

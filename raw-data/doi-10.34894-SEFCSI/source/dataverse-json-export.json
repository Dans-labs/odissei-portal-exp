          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij werkzaamheden aan de Promenade in Wijk bij Duurstede is een spant van een overnaads schip aangetroffen. Het gaat hiermee om een ouder scheepstype en het gebrek aan andere aanwijzingen geeft ruimte voor speculatie, waaronder de mogelijkheid dat het om een vikingschip gaat.\nDe ouderdom en herkomst van het hout kan hier meer inzicht over verschaffen en daarom is een monster aangeleverd voor dendrochronologisch onderzoek.\nDe laatste jaarring kan gedateerd worden in 759. Aangezien de wankant aanwezig is kan bepaald worden dat het hout in de herfst/winter van 759/60 gekapt is.\nVoor deze dateringen zijn consistente, maar niet buitengewoon sterke resultaten gevonden.\nDe meting is vervolgens onderzocht door dr. A. Daly  die niet alleen dezelfde positie met sterke resultaten kon reproduceren, maar ook een herkomst in het midden van Duitlsand kon aangeven . Hiermee lijkt een vikingschip uitgesloten, maar blijft het een opmerkelijke vondst."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-06-08"
                }
              }
            ]

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "ACURIA was an empirical comparative research project aimed at identifying legal and procedural strategies, blockages and best practices that can be replicated or prevented in different legal and judicial systems regarding business failure and insolvency, therefore enabling courts to provide a more accurate and fair response in that context. The participating jurisdictions were Portugal, Italy, Poland, and the Netherlands. This project has been completed."
                }
              }
            ]
          },

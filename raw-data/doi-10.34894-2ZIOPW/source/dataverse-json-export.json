            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van het oude postkantoor aan de Oude Vest 4 in Breda zijn de resten aangetroffen van barakken uit de 80e jarige oorlog. Deze zouden in 1630/40 gebouwd zijn.Om de ouderdom nader te bepalen is een eiken (Quercus sp.) balk bemonsterd en aangeleverd voor dendrochronologisch onderzoek\nDe laatste jaarring van dit monster dateer in 1512 en correspondeert met de spinthoutgrens. Het kapinterval komt hiermee rond 1532 te liggen; ongeveer een eeuw eerder dan de barakken gebouwd zouden zijn."
                },
                "dsDescriptionDate": {

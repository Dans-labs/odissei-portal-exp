            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek op het bedrijventerrein Harseveld te Barneveld is door Archol bv is een aantal bewoningssporen aangetroffen. Uit het houten vondstmateriaal zijn 16 monsters genomen voor dendrochronologisch onderzoek. Hierbij gaat het één maal om grove den (Pinus sylvestris L.) en één maal els (Alnus glutinosa Gaertn.) en voor de rest om eik (Quercus sp.). Hiervan zijn er 10 aangemerkt voor onderzoek. Zes hiervan zijn afkomstig uit wat een IJzertijd waterput bleek. Hiervoor zijn vier monsters onderling gesynchroniseerd tot de middelcurve 22.062.M01, welke in -639 gedateerd kan worden. De twee monsters met wankant uit dit spoornummer kunnen niet gedateerd worden.\nHet overige materiaal lijkt afkomstig uit recentere contexten. Hiervoor geeft alleen de datering van vondstnr. 436 een indicatie met een datering in 1608 (zonder wankant of spinthout).\nGezien de Franse herkomst moet het hier wel om een duig gaan omdat andere voorbeelden van deze herkomst niet bekend zijn."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2022-12-06"
                }
              }

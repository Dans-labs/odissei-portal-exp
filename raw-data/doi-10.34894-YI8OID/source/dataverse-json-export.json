          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p dir=\"ltr\">Our EUR strategic priorities of <i>Creating Positive Societal Impact</i> and <i>Recognition & Rewards</i> mean that we increasingly support those who are passionate about creating and fostering positive societal impact. Academics should be able to dedicate part of their time to develop impact-related competences, activities, and outputs. This <i>Fostering Impactful Careers</i> tool provides food for thought for your own understanding of how different impact identities may evolve in our institutional environment. It also makes explicit the connections between the pillars of Recognition & Rewards with societal impact.<br><br>This tool is part of a trilogy. Each tool focusses on different components of how staff can be impactful. This tool serves as a reflective tool on how to build an impactful careers and impact identities, the <i>Impact Competences Catalogue</i> shares relevant impactful competences and the <i>Impact Activities Catalogue</i> on impactful activities.</p>"
                }
              }
            ]

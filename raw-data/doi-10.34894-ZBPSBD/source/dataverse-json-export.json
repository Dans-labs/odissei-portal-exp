          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Burchtstraat in Herentals is een aantal houten structuren aangetroffen. Het gaat hierbij om drie middeleeuwse viskuilen en drie leerlooierskuipen uit de 18e of 19e eeuw. Eén van de leerlooierskuipen (spoornr. 404) bleek geschikt voor dendrochronologisch onderzoek. Hiervoor zijn enkele tientallen monsters van grenen (Pinus sylvestris L.) aangeleverd, waarvan een aanzienlijk deel dendrochronologisch onderzocht is.\nUit onderlinge synchronisatie blijkt dat voor de duigen regelmatig hout uit dezelfde boom gebruikt is. Voor deze gevallen zijn de metingen van de desbetreffende duigen gemiddeld tot boom-middelcurven. De 28 onderzochte duigen kunnen zo terug gebracht worden tot 19 individuele bomen. Voor vier hiervan kan geen datering gevonden worden. De overige dateren tussen 1564 en 1770. De uiteenlopende einddateringen zijn geen reden verschillende faseringen te veronderstellen. De wankant ontbreekt in alle gevallen, waardoor afgebakende kapintervallen ontbreken. De verschillen in einddateringen kunnen verklaard worden door de bewerking van het hout. Er kan alleen met zekerheid gesteld worden dat het kapjaar ergens ná 1770 valt."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-05-06"
                }
              }
            ]
          },

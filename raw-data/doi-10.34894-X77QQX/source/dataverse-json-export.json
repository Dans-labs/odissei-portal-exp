            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Op het terrein van de havezate Huis te Echten bevind zich een vermoedelijk 17e eeuwese boerderij. Deze boerderij heeft niet de gebruikelijke ankerbalkconstructie, maar bestaat uit drie beuken, met boven elke beuk een enkelvoudige balklaag met grenen (Pinus sylvestris L.) balken. De balken zijn beschilderd waardoor vóór monstername geen goed beeld van het jaarringaptroon te krijgen is. Dit bleek geen obstakel voor het verkrijgen van geschikte monsters. Verdeeld over de drie beuken zijn zeven boormonsters genomen, waarvan er zes geschikt waren voor onderzoek. Ondanks de uitstekende kwaliteit kan slechts één monster gedateerd worden. De laatste jaarring valt in 1691, maar het spinthout is niet bewaard gebleven. Hierdoor kan geen afgebakend kapinterval bepaald worden, maar vermoedelijk ligt dit in de eerste helft van de 18e eeuw.\nTwee balken kunnen onderling gedateerd worden, maar dit leidt niet tot nieuwe resultaten."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-11-12"
                }
              }

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The thesis aims to investigate the effect of different video background settings on interview outcome, the potential mediation of perceived warmth and perceived competence (stereotype content model), and moderation of candidate's gender. The data includes a pilot study to compare 2 actors' physical attractiveness, and the main study with a 2 (gender: male vs. female) x 3 (background: blank vs. casual vs. formal) experimental design."
                }
              }
            ]
          },

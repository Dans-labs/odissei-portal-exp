            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Codebook and data of the NEtherlands Longitudinal Lifecourse Study 2022. A cross-sectional study on a sample of 3017 inhabitants of the Netherlands, age group 15-45, with oversamples of the Moroccan and Turkish minorities. The data were collected in the period of  June - September 2022 through a web survey.</p><p>The variables include family background indicators, socio-demographic and socio-economic background variables, social inequality, social cohesion and integration, a large set of values, norms and attitudes, and egocentric network items.</p>"
                }
              },
              {
                "dsDescriptionValue": {

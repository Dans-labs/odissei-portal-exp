            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The Maddison Project, initiated in March 2010 by a group of close colleagues of Angus Maddison, aims to develop an effective way of cooperation between scholars to continue Maddison’s work on measuring economic performance in the world economy. This paper is a first product of the project. Its goal is to inventory recent research on historical national accounts, to briefly discuss some of the problems related to these historical statistics and to extend and where necessary revise the estimates published by Maddison in his recent overviews (2001; 2003; 2007) (also made available on his website at http://www.ggdc.net/MADDISON/oriindex.htm)."
                },
                "dsDescriptionDate": {

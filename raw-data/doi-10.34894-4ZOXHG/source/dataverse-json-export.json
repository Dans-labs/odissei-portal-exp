            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset comes from a retrospective database combined with a prospective registry on heart failure patients who are treated with intravenous diuretics in an outpatient setting as an alternative to hospitalization in two hospitals in the Netherlands. The aim of the study was to identify predictors of heart failure hospitalization in order to improve the selection of patients who qualify for successful outpatient treatment. The study involves patients with an established diagnosis of chronic heart failure who experience symptoms of worsening heart failure that are unresponsive to intensification of oral medication or who are too symptomatic to treat at home. Patients with newly onset HF, ischemic heart disease with current ischemia, valve disease who are awaiting intervention, new cardiac rhythm disturbances, or cardiogenic shock or respiratory failure at time of presentation are excluded from outpatient treatment. The primary endpoint is 30-day heart failure hospitalization. Secondary endpoints include 6-month heart failure hospitalization, repeated outpatient treatment, and mortality. Data is collected from electronic health records."
                }
              }
            ]
          },

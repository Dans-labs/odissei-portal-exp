            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Uit het pand aan de Voorstraat 96 te Kampen is een aantal boormonsters aangeleverd voor dendrochronologisch onderzoek. In totaal zijn monsters van zeven elementen aangeleverd. Hierbij gaat het in alle gevallen om eik (Quercus sp.). Hiervan konden er vier aangemerkt worden voor onderzoek, waarvan er vervolgens weer drie gedateerd kunnen worden.\nDeze dateringen vallen aan het eind van de 14e eeuw. Op twee monsters is de wankant aanwezig, waardoor het kapseizoen vastgesteld kan worden. Hieruit blijkt dat het hout niet gelijktijdig gekapt is, maar enkele jaren na elkaar."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-07-14"
                }
              }

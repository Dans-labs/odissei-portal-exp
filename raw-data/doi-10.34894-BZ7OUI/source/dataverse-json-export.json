            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Het hotel-restaurant “Het Witte Paard” is gehuisvest in een voormalige hoeve aan de Hengelosestraat te Delden. Om de ouderdom van deze hoeve te achterhalen zijn boormonsters genomen en aangeleverd voor dendrochronologisch onderzoek. Van de negen aangeleverde monsters zijn er zeven aangemerkt voor onderzoek. Hierbij zijn ook minder geschikte monsters meegenomen in de veronderstelling dat deze in combinatie met andere metingen een bijdrage kunnen leveren. De onderlinge synchronisaties zijn echter beperkt. Twee monsters m1a en M5) zijn afkomstig uit dezelfde boom. Hiervoor is de middelcurve 23.095.B01 gemaakt. Daarnaast kunnen twee andere metingen (M1 en M3a) onderling gedateerd worden. Hiervoor is de middelcurve 23.095.M01 gemaakt.  Hier kunnen geen metingen aan toegevoegd worden, waardoor aangenomen moet worden dat het niet om één samenhangende fase gaat, of dat het uitgesproken individuele jaarringpatronen gaat.\nHet vergelijken van de losse metingen en middelcurven met referentiemateriaal levert geen resultaat op, waardoor er geen uitsluitsel over de ouderdom gegeven kan worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-02-19"
                }
              }
            ]

              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Op 16 maart 1991 stond in de Leeuwarder Courant een vragenlijst met 100 genummerde vragen over het Fries.<br>Op 25 april 1991 heeft de Leeuwarder Courant over die vragenlijst gerapporteerd. Die rapportage was op grond van 2400 inzendingen. Het totaal aantal respondenten was evenwel 7323. In de tweede helft van 1991 is op de Fryske Akademy het resterende deel van de ingezonden vragenlijsten in de computer ingevoerd.</p>"
                }
              }
            ]

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Ter plaatse van de Postweg nabij Poortvliet zijn bij archeologisch onderzoek enkele houten palen aangetroffen. Op basis van eerder onderzoek en aangetroffen aardewerk wordt vermoed dat het om (twee verschillende) structuren uit de Romeinse Tijd gaat.\nIn alle gevallen gaat het om eik (Quercus sp.).\nVoor vondstnr. 237 resten kunnen geen goede resultaten gevonden worden en kan de ouderdom niet bevestigd worden. Vondstnr. 313 en 314 zijn uit de andere structuur afkomstig. Sterke onderlinge correlaties geven aan dat beide palen uit dezelfde boom afkomstig zijn. Hiervoor is de middelcurve 23.036.B01 gemaakt. Deze kan gedateerd worden 1593 en is afkomstig uit het zuiden van Noorwegen."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-06-08"
                }
              }
            ]

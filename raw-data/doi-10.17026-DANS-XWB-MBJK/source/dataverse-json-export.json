            "value": [
              {
                "keywordValue": {
                  "typeName": "keywordValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "carrière bij Defensie, reflecties achteraf, religieus fanatisme, zingeving"
                }
              },
              {
                "keywordValue": {
                  "typeName": "keywordValue",

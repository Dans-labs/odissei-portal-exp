            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek aan de Croesselaan in Utrecht zijn de resten van een tonput aangetroffen. Van drie duigen is een monster aangeleverd voor dendrochronologisch onderzoek. In alle gevallen gaat het om eik (Quercus spp.). Op twee duigen is een klein restje spinthout bewaard gebleven.\nDe drie duigen kunnen onderling gesynchroniseerd worden en hieruit is de middelcurve 25.140.M01 samengesteld. Deze kan gedateerd worden in 1333. Aan de hand van de spinthoutresten kan een kapjaar rond 1346 geschat worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",

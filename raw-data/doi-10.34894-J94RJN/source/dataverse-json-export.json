            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "In this data repository, we have uploaded the Supplementary Information of Chapter 3-6 of the thesis “The many faces of regeneration: Engineering multifunctional scaffolds for craniomaxillofacial applications”, from Sophia Dalfino. The worked described in this thesis focuses on the development of scaffolds with osteogenic and angiogenic properties for the regeneration of craniomaxillofacial bones. The thesis presents different approaches to enhance biological outcomes. In Chapter 3, the role of complex scaffold pore geometries in enhancing osteogenic differentiation of stromal cells was investigated. In Chapter 4, composite scaffolds incorporating bioactive glasses were fabricated to promote osteogenesis and expression of pro-angiogenic markers. In Chapter 5, a surface coating was implemented on the scaffolds to release hypoxia-mimicking molecules to trigger pro-angiogenic response in stromal cells. Finally, in Chapter 6, a hybrid scaffold comprising a polymeric mesh and a hydrogel component was fabricated and pre-vascularized in vitro to obtain capillary-like structures formation."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-11-17"
                }
              }
            ]

{"license":"CC0-1.0","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Zij woonden \"op de Smilde\" De bevolking van Smilde in de 19e eeuw"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:51766"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"G. Ax"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"G.  Ax"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Het betreft een genealogisch onderzoek naar de 19e-eeuwse inwoners van Smilde, een gemeente in de provincie Drenthe. Het uitgangspunt van dit onderzoek is de volkstelling van 1840. Als aanvulling op de volkstelling zijn gegevens verwerkt uit verscheidene documenten daterend uit de 19e eeuw: o.a. kranten, geboorte- huwelijks- en overlijdensaktes en successiememories. De momentopname van de gezinnen tijdens de volkstelling zijn hiermee omgezet naar een zo volledig mogelijk document van de gezinnen."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities","Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"genealogie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"prim
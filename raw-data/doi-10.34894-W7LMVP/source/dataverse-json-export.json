            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Van het archeologisch onderzoek ter plaatse van het Hof der twee getuigen in Brielle zijn vier eiken (Quercus spp.) duigen aangeleverd voor dendrochronologisch onderzoek. Deze zijn afkomstig van twee tonputten. De metingen laten onderling een matige tot redelijke gelijkenis zien. Een middelcurve van de metingen levert echter weinig meerwaarde op, omdat de duigen op eigen gelegenheid ook goede resultaten opleveren.\nDe dateringen van de duigen vallen tussen 1487 en 1519. Zonder spinthout kan alleen de ondergrens van het kapinterval bepaald worden.\nOpmerkelijk is dat de sterkste resultaten voor alle duigen gevonden worden met eerder onderzochte tonputten uit Nibbixwoud. De herkomst van de duigen ligt in de Maasvallei."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",

          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van het Meterikse Veld te Meterik zijn twee waterputten met een vermoedelijke ouderdom in de IJzertijd aangetroffen. De bekisting van de waterputten is zo compleet mogelijk bemonsterd en de monsters zijn aangeleverd voor dendrochronologisch onderzoek. In alle gevallen gaat het om eik (Quercus sp.).\nVoor spoornr. 1081 zijn 10 monsters beschikbaar. Hiervan zijn er zeven afkomstig uit dezelfde boom. Hiervoor is de middelcurve 23.074.B01 gemaakt. Samen met twee andere metingen kan de definitieve middelcurve 23.074.M01 voor de waterput gemaakt worden. Deze kan gedateerd worden 689 voor Chr. Aangezien het enige monster met spinhout (en wankant) niet gedateerd kon worden kan er geen afgebakend kapinterval voor deze waterput geschat worden.\nVoor spoornr. 781 zijn vijf monsters aangeleverd waarbij er twee uit dezelfde boom afkomstig zijn. Hiervoor is de middelcurve 23.074.B02 gemaakt waarmee samen met een andere meting de middelcurve 23.074.M01 gemaakt is voor deze waterput. Aan de hand van het spinthout en de wankant op vondstnr. 812 kan vastgesteld worden dat het hout tussen het najaar van 300 voor Chr. en het voorjaar van 299 voor Chr. gekapt is. Vondstnr. 822 is hier een uitzondering op. Het (niet afgebakende) kapinterval valt minstens 15 jaar vroeger. Mogelijk gaat het hier om een reparatie."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-09-06"
                }
              }
            ]

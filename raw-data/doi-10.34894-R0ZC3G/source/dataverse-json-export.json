                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Van het archeologisch onderzoek ter plaatse van de Steentilkade in Groningen zijn twee eiken (Quercus sp.) monstrers aangeleverd voor dendrochronologisch onderzoek. Over de context van de monsters is geen informatie verstrekt. Eén van de monsters kan gedateerd worden en aan de hand van het aanwezige spinthout kan een kapinterval rond 1844 geschat worden."
                },

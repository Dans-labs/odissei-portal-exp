{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Onderzoek naar de werking van het Sirius Programma om excellentie in het hoger onderwijs te bevorderen"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:64241"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"B. Leest"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"ITS, Radboud Universiteit Nijmegen"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"CMB  Leest"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"KBA Nijmegen"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Na afloop van het Sirius Programma hebben veel van de deelnemende hogeronderwijsinstellingen zich gecommitteerd aan een voortzetting van hun excellentiebeleid. Om dit beleid te ondersteunen is het van belang in kaart te brengen hoe en welke excellentie in het Sirius Programma is gerealiseerd. Op verzoek van het Ministerie van OCW hebben het ITS (Radboud Universiteit), het ROA (Universiteit Maastricht) en CHEPS (Universiteit Twente) hiertoe een onderzoek uitgevoerd. In het onderzoek is intensief samengewerkt met vier universiteiten en vier hogescholen die hebben deelgenomen aan het Sirius Programma."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"De vraag behorende bij de variabelen reden1 t\/m reden7 (gelijk aan B_NH_EXCELLENTIE_004_S1 t\/m B_NH_EXCELLENTIE_004_S7) in het databestand 'Onderzoek Sirius Programma 2015' is apart gesteld. Deze luidde: 'Waarom heb je niet deelgenomen aan een excellentieprogramma? (Meerdere antwoorden mogelijk)'. De antwoordcategorieën van de bijbehorende variabelen zijn 1=gekozen en 0=niet-gekozen.Het .SAV databestand is door het ITS geleverd. Op basis van dit bestand heeft DANS de .POR en .DTA versie toegevoegd."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"honoursprogramma"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"excellentieprogramma"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Sirius Programma"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2015-01-01"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2016-04-18"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2016-03-30"}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Unknown"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D60000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D60000","termName":[{"lang":"en","value":"Social sciences"},{"lang":"nl","value":"Sociale wetenschappen"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]}]},"dansTemporalSpatial":{"displayName":"Temporal and Spatial Coverage","name":"dansTemporalSpatial","fields":[{"typeName":"dansTemporalCoverage","multiple":true,"typeClass":"primitive","value":["november 2014 – februari 2015"]},{"typeName":"dansSpatialCoverageText","multiple":true,"typeClass":"primitive","value":["Nederland"]}]},"dansDataVaultMetadata":{"displayName":"Data Vault Metadata","name":"dansDataVaultMetadata","fields":[{"typeName":"dansDataversePid","multiple":false,"typeClass":"primitive","value":"doi:10.17026\/DANS-XHM-RHFP"},{"typeName":"dansDataversePidVersion","multiple":false,"typeClass":"primitive","value":"2.2"},{"typeName":"dansBagId","multiple":false,"typeClass":"primitive","value":"urn:uuid:69f502ab-6b13-42ab-8e63-80becfeecd29"},{"typeName":"dansNbn","multiple":false,"typeClass":"primitive","value":"urn:nbn:nl:ui:13-mqql-jy"}]}}}
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "information technology"
                }
              },
              {
                "keywordValue": {
                  "typeName": "keywordValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "outsourcing"
                }
              },
              {
                "keywordValue": {
                  "typeName": "keywordValue",

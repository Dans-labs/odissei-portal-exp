            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Twelve participants (patients and citizens) were selected using purposive sampling, with variation in age, gender, educational level, and health status. They completed the CPHQ2.0 while verbalizing their thoughts aloud (think-aloud method). Afterwards, they answered additional usability questionnaire items to further clarify their experience with the questionnaire. The data were transcribed verbatim and analyzed thematically to gain insight into interpretations, cognitive processes, and potential difficulties.\nData contains 12 transcripts of think aloud sessions as well as processed and analyzed pseudonymized data."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Het doel van het project is om te komen tot een protocol voor sample en library preparation en tools voor het verminderen van humane ruis in het sequencing proces. \n\nTijdens dit project wordt er gewerkt aan het opstellen van protocollen voor de moleculaire detectie van (met name SOA) pathogenen in afvalwater, op basis van Next-Generation Sequencing. Sample preparation is daarbij een belangrijk onderdeel in de keten van sample-to-answer en is tijdens dit project de hoofdopdracht voor de analist en studenten die hieraan werken. Dit is essentieel omdat humane nucleïnezuren het sequencingproces voor identificatie van pathogenen kunnen verstoren. Er wordt gestart met gespiked afvalwater samples om het identificatieproces beter te kunnen volgen."
                }
              }
            ]
          },

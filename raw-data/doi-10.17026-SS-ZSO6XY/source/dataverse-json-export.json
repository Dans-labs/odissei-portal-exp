                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains metadata from online news coverage of the Egyptian music genre Mahraganat. The data were collected from five major Egyptian and Arabic-language news websites between 2019 and 2024. It includes article-level metadata (such as titles, publication dates, authors, and URLs). The dataset was compiled to examine how Mahraganat music has been represented and debated in digital news media during this period."
                },

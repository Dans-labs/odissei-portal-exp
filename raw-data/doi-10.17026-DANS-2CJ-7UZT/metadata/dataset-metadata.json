{"license":"DANS Licence","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, Het Molukse perspectief in oorlogstijd, interview 19"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:41443"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Museum Maluku (MuMa) ©"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"J.M. Vreeswijk-Manusiwa"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"JM  Vreeswijk Manusiwa"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Museum Maluku"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Geïnterviewde 19 is geboren op 20 februari 1925 in Batavia, Java, Indonesië. Ze groeide op in een gezin met twaalf kinderen, waarin ze het vijfde kind was. Haar vader, een Nederlandse man,  ging van militaire dienst over naar de politie.Tijdens de oorlog zat haar vader  drie en een half jaar in verschillende kampen, waaronder Struiswijk. Toen een van haar broers eten kwam brengen voor hun vader, werd hij aangehouden en mocht niet meer naar huis. Haar vader overleefde de kampen en kwam na de oorlog weer thuis.Haar moeder, Indonesisch, maar Nederlands sprekend, verdiende geld door koekjes en dergelijke te maken en te verkopen. Tijdens de oorlog kon het gezin, weliswaar zonder vader, in hun eigen huis blijven wonen. Onderweg naar Nederland overlijdt haar moeder op de boot.Geïnterviewde is zelf tot twee keer toe geslagen en geschopt door Japanners, waardoor ze nu twee gehoorapparaten draagt. In 1946 trouwde ze met een Molukse man. Samen runden ze een winkel in Jakarta. Vlak voor de coup in 1965 vertrok ze met haar gezin naar Nederland. In 2001 overlijdt haar man, haar achterlatend in een flat in Amsterdam."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date Submitted: 2010-05-31"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Oral history"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Molukkers"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"WOII"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"vrouwen"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Moluccans"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"WWII"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"women"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2009-03-11"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2010-06-01"},{"typeName":"dateOfDeposit","m
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset supports \"Governance Interactions Concerning Peri-Urban Lake Ecosystems: A Systematic Literature Review\". The review conceptualises governance actor interactions concerning peri-urban lake ecosystems using a PRISMA-based systematic literature search. Of 132 records retrieved, 105 remained after de-duplication, and 31 full texts were included in the final analysis. The dataset includes the search strategy and term matrix, database screening records, inclusion/exclusion criteria, keyword co-occurrence data, and the coding scheme used to derive four dominant discourses on governance actor interactions, enabling transparency and further research on peri-urban lake governance, environmental discourse analysis, and socio-ecological transformation."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-10-29"
                }
              }

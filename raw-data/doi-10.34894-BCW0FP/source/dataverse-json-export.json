            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains 3 folders: 'Data_raw' with the raw data from gas chromatography (GC) and from optical emission spectroscopy (OES); 'Data_processed' with processed gas chromatography (GC) in an Excel file containing the formula structures, as well as a detailed description of the dataset and formulas in the README file and CSV file with the average data. Finally, a folder named 'Output_data' with the graphs generated from these data, as well as plasma photoemission images \n\nThe data correspond to non-oxidative methane coupling experiments performed in a continuous-wave microwave plasma reactor operated in forward vortex (FV) and reverse vortex (RV) flow configurations."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

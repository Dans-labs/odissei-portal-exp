            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Provides data on vegetation and nematode community composition monitored for 20 years in plots that were either sown with 15 mid-succession plant species or inoculated with mid-succession soil in a full-factorial randomized block design in an ex-arable fiedl (Mossel) that had just been abandoned.  A detailed description of the methods is included."
                }
              }
            ]
          },

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This presentation is devoted to working with personal data which is at the heart of research done at ESHPM. What is personal data in different types of research (surveys, interviews, focus groups)? What is personal sensitive data? What are the GDPR requirements you need to be aware of with respect to research? What are the ways of protecting the privacy of your research participants? This presentation will answer your questions on how to deal with personal data responsibly!"
                }
              }
            ]

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "In opdracht van de gemeente Breda is een is een moerbalk uit de Ridderstraat 8 dendrochronologisch onderzocht. De moerbalk is aangetroffen bij een renovatie van het gebouw en de vraag is of deze dateert van kort na de stadsbrand van 1534.\nHet monster bevat ruim voldoende jaarringen en een deel van het spinthout is bewaard gebleven. De laatste jaarring dateert in 1603 waarmee het kapjaar rond 1610 komt te liggen, ruim na de stadsbrand."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

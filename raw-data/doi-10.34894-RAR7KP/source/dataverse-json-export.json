            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van het Westfries Museum (Roode Steen 1, 15 en 16) te Hoorn zijn enkele houten vondsten aangetroffen. Vier eiken (Quercus sp.) vondsten zijn aangemerkt voor dendrochronologisch onderzoek. Hiervan kom er slechts één gedateerd worden. Hiervan kan bepaald worden dat het hout rond 1736 gekapt is.\nDaarnaast zijn drie vondsten aangeleverd voor houtsoortenonderzoek. Hierbij gaat het in alle gevallen om els (Alnus glutinosa Gaertn.)."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",

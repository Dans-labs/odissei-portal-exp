            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>This project attempts to disentangle concepts of Newman's defensible space theory in order to highlight some of the conceptual issues that may pose problems for measurement, as well as which concepts hold the most promise for developing our understanding of guardianship in action at micro-places. The end result will be an integrated theoretical framework to explain the main contextual factors that affect guardianship. Observational dataset with risk and protective factors of streets in in multiple neighborhoods in The Hague. Supplemented with demographic data for these neighborhoods.</p>"
                }
              },
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Data available in consultation with NSCR. Please contact the datamanager [datamanagement@nscr.nl]</p>"
                }
              }
            ]

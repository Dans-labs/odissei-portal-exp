              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "We developed a negotiation training on strategic adaptability, titled \"Strategic Adaptability Negotiation Training in Purchasing and Supply Management: A Multi-Method Instructional Approach\". The paper can be accessed at https://doi.org/10.1016/j.pursup.2024.100968.\n\nWe share all teaching materials here. This includes: \n1) Lecture slides, including links to the video clips\n3) Questions to guide class discussions, and detailed video and debriefing instructions\n4) Implementation-intention exercise\n5) Simulation and its debriefing guidelines"
                }
              }

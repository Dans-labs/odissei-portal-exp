              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Nederland wordt vaak voor internationale ondernemingen een belastingparadijs genoemd, maar hoe zit het met de onder­nemingen van eigen bodem die binnen Nederland opereren? Een analyse van de belastingdruk van grote én kleine Nederlandse ondernemingen op basis van de private AMADEUS-database.\n\n<i>English translation: The Netherlands is often portrayed as a tax haven for international corporations, but what about Dutch domestic entities? We provide an analysis of the effective tax rate of large and small Dutch firms based on the private AMEADEUS-database. (2022-05-19)</i>"
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",

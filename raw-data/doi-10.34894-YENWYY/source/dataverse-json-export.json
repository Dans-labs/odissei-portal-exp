          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This file contains qualitative interview transcripts conducted as part of the study “Intuition as Evidence: Integrating Tacit Knowledge into Evidence-Based Management.” The interviews were conducted with healthcare managers across multiple hospitals in Lebanon, including managers in different levels of seniority and from different job families. The purpose of these interviews is to explore how managers use intuition as a source of evidence in their decision-making, how it interacts with formal data and analytical processes, and the contextual factors that influence intuitive judgment within healthcare management settings. The data provides in-depth insights into real-world managerial decision processes in complex and uncertain healthcare environments."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

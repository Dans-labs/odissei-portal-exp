            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This study determined the potential of a poly-ε-lysine and hyaluronic acid (PEL-10/HA144-1) contact-killing coating as a promising prevention of bacterial attachment. \nThe PEL-10/HA144-1 coating was deposited on titanium alloy Ti6Al4V (Ti) and ultra-high-molecular-weight-polyethylene (UHMWPE). Data includes coating characterization (water contact angle, roughness, pin-on-disk test), antibacterial efficacy testing, and biocompatibility and osteogenic function assessment."
                }
              }
            ]
          },

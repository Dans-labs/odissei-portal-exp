{"license":"CC-BY-4.0","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Verpleegkundig leiderschap in de ziekenhuispraktijk"},{"typeName":"subtitle","multiple":false,"typeClass":"primitive","value":"Een onderzoek naar de beleving, ervaringen en zelfbeoordeling van leiderschapscompetenties door verpleegkundigen in een STZ-ziekenhuis (Medisch Centrum Leeuwarden)"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"M. van der Cingel"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"NHL University of Applied Sciences"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0002-6185-2915"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"van der Cingel, Margreet"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"NHL University of Applied Sciences"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Betreft kwalitatieve data van 17 deelstudies in de periode 2018-2020 waarin verpleegkundigen in 34 diepte-interviews en verpleegkundige teams in 24 focusgroep-interviews zijn bevraagd over verpleegkundig leiderschap en concreet leiderschapsgedrag tijdens de toepassing van 11 van de 24 kernbegrippen van leiderschap. Daarnaast zijn kwalitatieve data van 6 deelstudies opgenomen waarin 41 hbo-studentverpleegkundigen in diepte-interviews zijn bevraagd naar hun ervaringen tijdens praktijkstages met verpleegkundig leiderschap en concreet leiderschapsgedrag. De analyse van kwantitatieve data van 435 verpleegkundigen die zichzelf beoordeelden op hun functioneren zijn ook onderdeel van deze dataset. Daarnaast is een Delphistudie gedaan om 24 kernbegrippen van het landelijk opleidingsprofiel voor de bachelor verpleegkunde opleiding (BN2020) in te delen in 3 vormen van leiderschap en een expertstudie waarbij de items van de kwantitatieve professionaliteitsscan werden gekoppeld aan de kernbegrippen van het opleidingsprofiel. (2021)"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Medicine, Health and Life Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"nursing leadership"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"nursing"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"https:\/\/www.ncbi.nlm.nih.gov\/mesh\/68009729"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"nurses"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"https:\/\/www.ncbi.nlm.nih.gov\/mesh\/68009726"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"Leadership"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"https:\/\/www.ncbi.nlm.nih.gov\/mesh\/?term=leadership"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Verpleegkunde"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"https:\/\/thesauruszorgenwel
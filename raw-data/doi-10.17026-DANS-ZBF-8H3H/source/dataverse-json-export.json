            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>This data set contains the results of a survey about reviewing Data Management Plans (DMPs). The survey was carried out by the Research Support and Advice working group of the Dutch National Coordination Point Research Data Management (LCRDM). Sixty people shared their experiences and feedback on DMPs by responding to the survey. The data set contains a concise report, the survey questions and the anonymised data.</p>"
                }
              }
            ]

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>This folder contains expenditure and service level data for water supply systems and sanitation facilities in Andhra Pradesh</p><p>Primary data collection of household and water point surveys and secondary data was collected from detailed household surveys on over 500 variables for 5,242 households collected from 187 rural habitations and towns spread across nine agro-climatic zones.</p><p>The second file contains  expenditure data on a variety water supply systems. This is based on hundreds of water point surveys drawn from 187 rural habitations and towns spread across nine agro-climatic zones of Andhra Pradesh.</p>"
                }
              }
            ]

{"license":"CC0-1.0","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Het aanzien van het politieke ambt"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:63265"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"P. Van Wijnen"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Overheid in Nederland"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"M.J.H. Hulsen"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Overheid in Nederland"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Martijn  Hulsen"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Toponderzoek"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Een belevingsonderzoek onder decentrale volksvertegenwoordigers (zittende raadsleden, wethouders, DB-leden waterschap, AB-leden waterschap, uitgetreden raadsleden en politiek geïnteresseerde burgers).Van de databestanden zijn zowel anonieme als niet-anonieme versies in de dataset opgenomen (m.u.v. bestand 'oin 150909 bestand burgers.sav’, dit is een anoniem origineel). De anonieme bestanden zijn openbaar en bevatten geen locatiegegevens."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"In het wethouders bestand zitten 442 respondenten, terwijl er in het rapport over 435 wethouders wordt gesproken. Dit komt omdat 7 wethouders met missende waardes niet uit het bestand zijn gehaald. Het betreft de respondenten met de volgende ID nummers: 195048, 195268, 195349, 195682, 195739, 195756, 196121.Overheid in Nederland heeft de sav bestanden geleverd. Op basis van deze bestanden heeft DANS de por en dta bestanden toegevoegd."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"decentrale volksvertegenwoordigers"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"zittende raadsleden"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"wethouders"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"DB-leden waterschap"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"AB-leden waterschap"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"uitgetreden raadsleden"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"politiek geïnteresseerde burgers"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"belevingsonderzoek"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Het aanzien van het politieke ambt"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek op het Staatsliedenkwartier in Apeldoorn zijn enkele houten palen aangetroffen. Het gaat om eiken (Quercus sp.) palen uit een niet nader omschreven context.\nVoor het onderzoek zijn twee palen aangeleverd, waarvan er één voldoende jaarringen bevat.\nDesondanks konden voor het monster geen eenduidige resultaten gevonden worden."
                },

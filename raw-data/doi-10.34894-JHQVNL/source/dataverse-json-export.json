            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset was collected as part of the research project “Developing Expressive Music Performance”. This part of the project explored the following research questions: How do instrumental teachers in Higher Music Education (HME) conceptualize expressive music performance; and what are HME teachers’ perspectives on teaching expressiveness nowadays? Data was collected through a questionnaire and two interviews. The questionnaire responses were anonymized by deleting personal information, gender, and age group. Data was analyzed using Reflexive Thematic Analysis, as described by Braun & Clarke (2022), using Atlas.ti. No AI tools were used for data analysis or writing (2026-03-17). This record contains supporting material (the set of questions used for the questionnaire; the explanation of variables) and the anonymized questionnaire data."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-03-19"
                }
              }

              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Please refer to scientific paper; in the dataset, the moments of onset of activity of diurnal birds is stored. The onset is calculated relative to the moments the bright daylights in the cages went on; for a ful reference, below each parameter is explained:\r\n\r\n#  gtID  =  bird\r\n#  lightInt  =  treatment\r\n#  treatment  =  treatment\r\n#  include  =  include\r\n#  StackOnsLD  =  moment onset calc by stacked actiivty in LD relative to lights on\r\n#  StackOffLD  =  moment offset calc by stacked actiivty in LD relative to lights on\r\n#  StackOnsLAN  =  moment onset calc by stacked actiivty in LAN relative to lights on\r\n#  StackOffLAN  =  moment offset calc by stacked actiivty in LAN relative to lights on\r\n#  diffStackOnsLDtoLAN  =  difference in stacked onsets with and without LAN    \r\n#  diffStackOffLDtoLAN  =  difference in stacked offset with and without LAN\r\n#  diffIndOnsLDtoLAN  =  difference in mean individual onsets with and without LAN\r\n#  diffIndOffLDtoLAN  =  difference in mean indvidual offset with and without LAN\r\n#  onsDphiLDtoDD  =  onset phase shift LD to DD control\r\n#  CoGDphiLDtoDD  =  cog phase shift LD to DD control\r\n#  offDphiLDtoDD  =  offset phase shift LD to DD control\r\n#  onsDphiLDLANtoDD  =  onset phase shift LD to DD with LAN\r\n#  CoGDphiLDLANtoDD  =  cog phase shift LD to DD with LAN\r\n#  offDphiLDLANtoDD  =  offset phase shift LD to DD with LAN\r\n#  onsDphiLANtoDD  =  copied\r\n#  CoGDphiLANtoDD  =  copied\r\n#  offDphiLANtoDD  =  copied\r\n#  diffOnsDphi  =  diff\r\n#  diffCoGDphi  =  diff\r\n#  diffOffDphi  =  diff\r\n#  diffLDtauLANtau  =  diff\r\n#  LDtau  =  LDtau\r\n#  LANtau  =  LANtau\r\n"
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2017-05-15"
                }
              }
            ]

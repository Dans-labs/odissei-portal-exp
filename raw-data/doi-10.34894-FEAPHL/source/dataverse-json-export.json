                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Social sciences"
                }
              },
              {
                "keywordValue": {
                  "typeName": "keywordValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Psychophysiology"
                }
              },
              {
                "keywordValue": {

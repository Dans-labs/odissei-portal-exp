                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Interview with Annie Fletcher, then curator of the Van Abbemuseum, about Jan Dibbets’ work The Shortest Day at the Van Abbemuseum (1970), possible ways of installing the work to explore its significance in various forms in relation to the idea of the collection, the museum and archive, ideas that also form the basis of the exhibition 'For Eindhoven'- The City as Muse as part of the exhibition series VANUIT HIER - OUT OF HERE.</p>"
                }
              }

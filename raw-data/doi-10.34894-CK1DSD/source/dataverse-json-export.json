          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This land-use scenario represents a hybrid or 'plural' future whereby the environmental value translations (ie: the model decision rules designed to represent the different environmental values) for the Natures Futures Framework (NFF) scenarios are combined for a more inclusive sustainable future. The NFF scenarios, along with their technical documentation, are published at (https://doi.org/10.5281/zenodo.19051405). All scenarios were modeled using the spatially explicit land-system model CLUMondo (v5.1). The projected land-use outcomes are provided at a 1km resolution using an EPSG 3035 - ETRS89-extended/LAEA Europe projection at a broader European regional scale, in yearly timesteps from 2020 - 2050."
                }
              }
            ]
          },
          {
            "typeName": "subject",
            "multiple": true,
            "typeClass": "controlledVocabulary",
            "value": [
              "Earth and Environmental Sciences"
            ]
          },
          {

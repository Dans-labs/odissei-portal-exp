              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Rondom de slag om Overloon kwam een vluchtelingenstroom op gang. Onderhavig interview reflecteert op de periode dat inwoners uit Overloon e.o. hiermee werden geconfronteerd.</p>"
                }
              }
            ]
          },

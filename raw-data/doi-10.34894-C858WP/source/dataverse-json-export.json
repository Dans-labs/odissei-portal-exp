            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset was produced for doctoral research about ritual-musical appropriations of Psalms in contemporary Dutch and Flemish culture. It contains semi-structured interviews with different participants in these appropriations, such as composers, poets, performers, event organizers, and participants from the audiences of the performances. These interviews focus on their experiences with the performance of Psalms in extra-ecclesial contexts. Furthermore, the dataset contains field notes and non-copyright textual materials. All data were analyzed in order to construct a theological understanding of the meaning of psalmody in (post)secular, post-Christian culture, beyond liturgical ritual."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-01-17"
                }
              }

{"license":"CC0-1.0","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Getuigen Verhalen, Atlantikwall Den Haag, interview 10 - Nel Noordervliet-Jol"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:50490"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Museon ©"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"HMF  Kockelkorn"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Museon"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Interview met Nel Noordervliet-Jol (geboren 1918), die in april 1943 vanuit Scheveningen werd geëvacueerd, ook al was haar vader economisch aan het dorp gebonden. De familie vond een huis in Wassenaar, samen met een broer van haar vader. Ze verhuisden met een auto van het Deutsches Theater in die Niederlanden, wat het idee versterkte dat de familie Duitsgezind was. Haar vader ging daarna nog dagelijks per tram naar zijn visrokerij in het Sperrgebiet. Vertelt over haar moeder die aan maagkanker werd geopereerd, maar vervolgens aan iets anders stierf. Het huishouden kwam nu op de dochter neer, die het combineerde met haar baan op een afdeling van het Ministerie van Sociale Zaken in het Bezuidenhout. Ging zelf wel eens de vesting binnen met een geleende Ausweis. In 1944 moest de rokerij sluiten en zat haar vader werkloos thuis. Vertelt ook hoe ze per fiets het land introk in de hoop dat ze zeezout voor voedsel zou kunnen ruilen.Bevrijdingsdag is voor haar verbonden met de dood van haar oom, die in huis lag opgebaard. Keerden pas in november 1945 naar Scheveningen terug. De ruiten in het huis dat ze huurden waren allemaal kapot, en toen haar vader ze had vervangen, brachten spelende kinderen een bom tot ontploffing, met als gevolg dat de ruiten in de hele buurt weer sprongen."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Date Submitted: 2012-07-04"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Atlantikwall"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"schaarste"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"evacuatie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"bevrijding"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Oral history"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Tweede Wereldoorlog"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2011-01-18"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Verbaan, Danny (interviewer)"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"pr
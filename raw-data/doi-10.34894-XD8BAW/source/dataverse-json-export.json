            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This data was collected as part of the research project “Developing Expressive Music Performance”. This part of the project explored the following research questions: How do instrumental teachers in Higher Music Education (HME) conceptualize expressive music performance; and what are HME teachers’ perspectives on teaching expressiveness nowadays? Data was collected through a questionnaire and two interviews. Two teachers from the researchers’ network were invited for an interview. These interviews were recorded and transcribed in Teams. The interview transcriptions were checked and corrected in Atlas.ti. Data was analyzed using Reflexive Thematic Analysis, as described by Braun & Clarke (2022). No AI tools were used for the analysis or writing (2026-03-17). This record contains supporting material, such as the set of starting questions for the questionnaire, the codes and code groups, which led to initial themes in qualitative data analysis."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-03-19"
                }
              }

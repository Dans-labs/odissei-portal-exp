            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This document contains the full scripts, facilitator guides, and workshop materials used to conduct the data dialogues within the project Making Big Data meaningful for a Promising Start (“Betekenisvol Datagebruik voor een Kansrijke Start”). The materials include detailed protocols for sessions with parents, healthcare professionals, and policymakers, both in-person and online. Each script outlines the session structure, facilitation instructions, example questions, and the use of interactive components such as the “Big Data Game.” The document also includes presentation slides, questionnaires, and supporting materials (e.g., whiteboard templates and card sets) used to explore participants’ perspectives on the ethical and meaningful use of administrative data to support child development."
                }
              }
            ]
          },

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This experiment tested the effects of enforcement style of regulators on citizen trust in regulators and regulatees. Data was collected during late Spring 2021 in six countries: Norway, Israel, Belgium, Netherlands, Germany and Denmark. In this document, we outline our hypotheses, experimental design, how the experiment was developed, how the experiment was fielded, how the dataset was constructed, and what ethical considerations were followed."
                }
              }
            ]

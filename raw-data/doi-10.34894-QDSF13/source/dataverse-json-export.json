            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The dataset contains carbon dioxide (CO2), methane (CH4), and oxygen (O2) headspace concentrations derived from oxic and anoxic peat incubations, as well as peat biogeochemical/organic matter properties and ancillary environmental data. The data was generated through field sample collection, analysis, and laboratory experiments from four sites across northern Fennoscandia. Using peat incubations and stoichiometric, energetic, and thermodynamic parameters, the dataset highlights that the mechanisms of organic matter degradation are similarly constrained for deep permafrost peatland carbon following thaw in thermokarst fens and ponds across Fennoscandia.\n\nThe data is provided in a single spreadsheet with four tabs; (a) a read me tab that contains descriptions of all column headers and data. It provides units of measurement for each and explains nomenclature used throughout the dataset, (b) biogeochemical/peat properties and ancillary environmental data (2172 entries over 25 columns), (c) oxic incubation data (30107 entries over 11 columns), and (d) anoxic incubation data (68415 entries over 15 columns)."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

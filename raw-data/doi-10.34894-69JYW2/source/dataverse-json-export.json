            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Archeologie West-Friesland voerde onderzoek uit ter plaatse van Nes 30 te Schagen. Hierbij een waterput aangetroffen die bestond uit drie op elkaar gestapelde tonnen. Van de drie tonnen zijn monsters genomen en aangeleverd voor onderzoek. Het gaat in alle gevallen om eik (Quercus sp.).\nDe duigen van de tonnen M2 en M3 laten een betrekkelijk onregelmatig jaarringpatroon zien. Hiervoor konden geen dateringen gevonden.\nVoor de ton M4.1 is één duig onderzocht. De laatste jaarring kan gedateerd worden in 1520. Omdat exact één spinthoutring aangetroffen is, kan een kapinterval geschat worden. Dit valt rond 1539."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-01-18"
                }
              }

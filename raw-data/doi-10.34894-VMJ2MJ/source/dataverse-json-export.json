          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij werkzaamheden ter plaatse van de Markermeerdijken ten zuiden van Hoorn is een aantal grenen (Pinus sylvestris L.) beschoeiingspalen en -planken aangetroffen samen met een enkele eiken (Quercus spp.) planken afkomstig uit twee sluizen. In totaal zijn 26 monsters aangeleverd voor dendrochronologisch onderzoek met daarnaast twee vondsten voor houtsoortbepaling. \nVoor de laatste twee gaat hem om grove den en een stuk wortelhout dat berk (Betula sp. L) of els (Alnus glutinosa Gaertn.) lijkt te zijn. De afwijkende houtanatomie van wortelhout maakt het onderscheid onduidelijk.\nHet eikenhout laat de hoogste ouderdom zien; M1269 is gekapt in het voorjaar van 1395. Voor het hout uit de andere sluis kan geen afgebakend kapinterval gegeven worden. De meest recente jaarring valt in 1400, dus een 15e eeuwse ouderdom lijkt aannemelijk.\nBinnen de grenen monsters van de beschoeiing lijken in ieder geval vijf verschillende fases aanwezig. De oudste twee faseringen vallen in of kort na 1653 en 1712. Het gaat hier om slechts één monster per fase.\nVoor de volgende fase zijn de vondsten talrijker. Hiervoor vallen de dateringen tussen 1716 en 1720. De meeste van deze vondsten zijn afkomstig uit twee individuele bomen, waarvoor boom-middelcurven gemaakt zijn. De opvolgende faseringen in of kort na 1733/34 en 1774 bevatten slechts enkele vondsten."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-07-15"
                }
              }
            ]

            "typeClass": "primitive",
            "value": "Log-based behavoral and self-reported personal qualities in educational assessments"
          },
          {
            "typeName": "alternativeTitle",
            "multiple": true,
            "typeClass": "primitive",
            "value": [
              "Predictive Validity of Self-Reported Measures and Log-based Behavioral Measures of Personal Qualities in Large-Scale International Educational Surveys"
            ]

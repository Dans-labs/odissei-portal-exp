                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>- Geïnterviewde is een van de leidende figuren op Ambon tijdens de burgeroorlog (1999-2002) geweest.<br>- Transcriptie ontbreekt, evenals vertaling.</p>"
                }
              }

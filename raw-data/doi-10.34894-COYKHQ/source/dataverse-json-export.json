            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de nieuwbouw locatie An Der Boerbrink is een boomstamput aangetroffen. Hiervan is een monster aangeleverd voor dendrochronologisch onderzoek. Ondank de beperkte afmeting zijn er vanwege een trage aanwas voldoende jaarringen aanwezig is.\nDe laatste jaarring kan gedateerd worden in 730. Spinhtout of de wankant ontbreekt, dus kan alleen de ondergrens van het kapinterval geschat worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",

            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Kloosterweg in Ninove is een kelder of beerput aangetroffen die in twee fases is opgetrokken. Om de faseringen te dateren zijn van vloerbalken en –planken stalen genomen voor dendrochronologisch onderzoek.\nIn alle gevallen gaat dit om eik (Quercus spp.).\nVoor de planken zijn consistent de buitenste delen van snel gegroeide eiken gebruik. Hierdoor is er ondanks de zware afmetingen geen bruikbaar materiaal aanwezig.\nUit vloerbalken van fase 1 kunnen enkele bruikbare monsters geselecteerd worden. Hieruit kan een middelcurve samengesteld worden (25.137.M01) waarvoor geen goede resultaten gevonden kunnen worden. Aanvullend onderzoek door dr. K. Haneca  leverde eveneens geen resultaat op.\nUit de vloerbalken van fase 2 kon geen bruikbaar materiaal geselecteerd worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-05-20"
                }
              }
            ]

              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Op de Razende Bol (een eilandje voor de kust van Texel) is een aangespoeld stuk eiken (Quercus sp.) scheepshuid aangetroffen. Hiervan is een monster gezaagd en aangeleverd voor dendrochronologisch onderzoek.\nDe laatste jaarring dateert in 1539 en hieruit kan afgeleid worden dat het hout ergens na 1548 gekapt is, vermoedelijk nog ergens in de 16e eeuw."
                },

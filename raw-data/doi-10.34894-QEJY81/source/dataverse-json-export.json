            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "In aanvulling op het bouwhistorisch onderzoek van de boerderij ter plaatse van Voort 3 te Velden is door Buro4 Bouwhistorie een aantal boormonsters genomen voor dendrochrochronologisch onderzoek.\nDe monsters zijn afkomstig uit de gebinten van de hoeve. In alle gevallen gaat het vrij snel gegroeid eiken (Quercus sp.), waardoor enkele monsters niet in aanmerking komen voor onderzoek. De overige monsters zijn matig geschikt, maar onderzocht in de veronderstelling dat een eventuele middelcurve samengesteld kan worden die wel bruikbaar is. Hiervoor zijn de metingen eerst onderling vergeleken en de balken afkomstig uit één boom geïdentificeerd. Hierbij gaat het om M1 en M5, waarvoor de boom-middelcurve 23.031.B01 is samengesteld en M3 en M4, waarvoor 23.031.B02 is samengesteld. De laatste middelcurve levert geen verdere resultaten op, maar uit de eerst kan samen met M6 en M7 in de uiteindelijke middelcurve 23.031.Mo1 opgenomen worden. Deze kan weer in 1818 gedateerd worden.\nAan de hand van de wankant op M7 kan een kapseizoen vastgesteld worden de herfst/winter van 1818/19.\nDe geschatte kapintervallen voor de monsters zonder wankant vallen te hoog uit omdat het spinthoutmodel uit gaat van oudere bomen met gemiddeld meer spinthoutringen."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-05-23"
                }
              }
            ]

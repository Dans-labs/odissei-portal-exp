            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Development and validation of the ReproQ, a self-report questionnaire for experiences of women with maternity care during pregnancy, childbirth and postpartum care. The ReproQ is based on the responsiveness concept of the WHO, which aims to measure quality of care from the perspective of the client. This concept covers 8 domains: Dignity, Autonomy, Confidentiality, Communication, Prompt attention, Social consideration, Basic amenities, Choice and continuity.  Second paper is about psychometric char\nacteristics, in order to asess usefulness of ReproQ for quality improvement."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2014-12-16"
                }
              }
            ]

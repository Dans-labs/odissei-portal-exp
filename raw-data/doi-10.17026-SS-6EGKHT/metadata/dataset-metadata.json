Class":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"De-identified dataset underlying the paper 'Remembering Past Emotions\". The uploaded dataset consists of 14 participants discussing happy and sad memories and rated each memory on a past and present valence scale ranging from -1 (negative) to 1 (positive). The dataset underlying the paper consists of 17 participants, however 3 participants are removed due to ethical and consent reasons. Each memory was segmented based on meaningful topics. The lexical, acoustic and facial features were then extracted based on the segments transcripts and the video and audio recordings. Due to privacy reasons and consent of participants, only de-identified data is shared. The dataset does not contain transcripts, topic labelling, video and audio-recordings or any other personal identifiable data. \n\nFor more information on the dataset, data collection, extraction of the features, please refer to the paper."},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2025-09-05"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"autobiographical memories"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Older adults"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Multimodal"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"emotional expressions"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"emotional experience"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["English"]},{"
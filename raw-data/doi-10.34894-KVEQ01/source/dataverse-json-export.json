                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This research is about the didactical practice of Dutch secondary school teacher educators, and the motives that underlie this practice. The purpose is to measure what kind of didactical activities the teach about and with, activities that are grouped within four components: using learning goals, presenting learning content, deploying instructional methods and conduction evaluation. Additionally, motives are measured, including the role of educational research in these motives."
                }
              }

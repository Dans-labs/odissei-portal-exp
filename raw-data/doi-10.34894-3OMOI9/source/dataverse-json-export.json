            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Dorpsstraat 22 in Oostwijterwerd is een tonput aangetroffen. Van de bodem van de ton is een eiken (Quercus sp.) monster aangeleverd voor dendrochronologisch onderzoek. Voor het monster kon geen dateringen gevonden worden.\nDit lijkt te liggen aan de beperkte opzet van het onderzoek. Het is niet duidelijk of andere delen van de ton niet zijn aangeleverd of simpelweg niet zijn aangetroffen."
                },
                "dsDescriptionDate": {

          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Mimi Hol-Bierenbroodspot werd in 1935 geboren in Semarang en groeide op in een gezin waarin haar vroege jeugd verbonden was met het huis, haar ouders en de mensen die daar werkten, onder wie een baboe, djongos en tuinman. Door de oorlog verhuisde het gezin via Lawang en Surabaya. Na de capitulatie werd haar vader weggevoerd en kwam zij met haar moeder en broertje in verschillende kampen terecht, waaronder de Werkwijk en Halmahera. Daar maakte zij angst, onzekerheid en verlies mee; haar moeder overleed in het kamp. Na de oorlog werd zij van haar broertje gescheiden, verbleef zij onder meer in ziekenhuizen en kampen, en reisde uiteindelijk per schip naar Nederland."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-07-07"
                }
              }

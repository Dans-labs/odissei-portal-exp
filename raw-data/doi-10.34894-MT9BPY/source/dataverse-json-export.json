            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Replication data for chapter 2: This chapter examines the impact of drought on child health and schooling outcomes and investigates the contemporaneous relationship between these two main building blocks of human capital. We merge childlevel longitudinal data from the Ethiopia Rural Socioeconomic Survey (ERSS) with geo-referenced climate data. Our findings from within-child variation estimators reveal that drought has a detrimental impact on the highest grade completed of female children. We show that the negative eect of drought on a female child's completed years of formal schooling is channelled, albeit not entirely, through ill health."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

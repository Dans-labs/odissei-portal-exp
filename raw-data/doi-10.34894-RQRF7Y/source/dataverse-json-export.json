              {
                "publicationCitation": {
                  "typeName": "publicationCitation",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The data related to Study 1 have been gathered by Emily Felker for her MA thesis (under supervision of Marijn Struiksma and Bregje Holleman). The data were re-analyzed and presented at the ICA conference 2018 in Prague. The ICA conference also published online conference proceedings. After the ICA conference we decided to run a second study to check on our null-findings. This study was preregistred via aspredicted.org. We also applied the stricter cleaning criteria as they were preregistred for study 2 for study 1 and this gave similar results."
                }
              }

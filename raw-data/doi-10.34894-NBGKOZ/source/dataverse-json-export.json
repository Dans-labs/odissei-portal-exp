              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset originates from a single-case experimental study evaluating inhibitory retrieval (IR)–based exposure therapy and EPT-based exposure therapy for PTSD. It contains daily measures of PTSD symptoms, negative expectancies, and distress tolerance from 19 individuals with DSM-5 PTSD, collected across baseline, treatment, and follow-up phases."
                },

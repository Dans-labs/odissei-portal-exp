            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset was created through an experimental study examining the effects of binaural beats embedded in audiovisual art on working memory performance and relaxation. Participants were assigned to one of three audio conditions: no binaural beats (control), 10Hz binaural beats, or 40Hz binaural beats. Working memory was measured using an n-back task (2-back and 3-back). Relaxation was measured using the Relaxation State Questionnaire (RSQ). Additional questionnaires assessed sound sensitivity (SSSQ2) and personality (TIPI), as well as binaural beat familiarity and expectancy, information on menstruation cycle, and general demographics."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

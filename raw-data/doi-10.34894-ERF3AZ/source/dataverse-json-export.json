            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek op het Verkadeterrein in Zaandam is de fundering van een molen aangtroffen. Van drie houten vondsten zijn monsters aangeleverd voor waardering, houtsoortbepaling en aanvullend dendrochronologisch onderzoek waar mogelijk. In alle gevallen ging het om naaldhout; twee maal fijnspar (Picea abies Karst.) en één maal grove den (Pinus sylvestris L.). Eén van de vuren monsters (vondstnr. 25) bleek geschikt voor dendrochronologisch onderzoek. Hiervan kan de laatste ring gedateerd worden in 1912. De wankant is niet aanwezig, waardoor alleen bepaald kan worden dat het hout ergens na 1912 gekapt is."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-02-10"
                }
              }

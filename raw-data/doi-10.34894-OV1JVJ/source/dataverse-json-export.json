            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Door Archeologie West-Friesland zijn twee vondsten aangeleverd voor houtsoorten- en dendrochronologisch onderzoek. De vondsten zijn afkomstig van archeologisch onderzoek ter plaatse van Hauwert 102-104 te Hauwert (gemeente Medemblik). Dit context van de vondsten is niet nader omschreven.\nHet gaat om een beukenhouten (Fagus sylvatica L.) deel van een wagenwiel en een grenen (Pinus sylvestris L.) plank. De laatste is aangewezen voor dendrochronologisch onderzoek. Ondanks bescheiden afmetingen waren er voldoende jaarringen aanwezig en de laatste jaarring dateert in 1589. Gezien het ontbreken van de wankant en de fragmentaire aard van de vondst kan alleen de ondergrens van het kapinterval (1589) bepaald worden.\nZoals gebruikelijk is het grenen afkomstig uit het zuiden van Noorwegen."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

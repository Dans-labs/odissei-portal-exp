s (estate, vehicles, income), tax category (\"klasse\") and tax assessment.   The original Microsoft Access database file has been converted to a comma separated value file format (.csv \/ delimiter: semi-colon)."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"economic history"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"taxes"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"taxes"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"tax register"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"elite"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"income taxes"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"1998-09-28"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"1998-09-28"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"1998-09-28"},{"typeName":"dateOfCollection","multiple":true,"typeClass":"compound","value":[{"dateOfCollectionStart":{"typeName":"dateOfCollectionStart","multiple":false,"typeClass":"primitive","value":"1998-06-01"},"dateOfCollectionEnd":{"typeName":"dateOfCollectionEnd","multiple":false,"typeClass":"primitive","value":"1998-09-28"}}]},{"typeName":"dataSources","multiple":true,"typeClass":"primitive","value":["Belastingkohier Leiden 1742; Gemeentearchief, Leiden; F5008"]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeCla
            "typeClass": "primitive",
            "value": "Bridging Clinical Art Therapy and Social Justice-Oriented Art-Based Communities"
          },
          {
            "typeName": "subtitle",
            "multiple": false,
            "typeClass": "primitive",
            "value": "Art Therapy as a Healing and Emancipatory Space for Persons with Intellectual Disabilities"

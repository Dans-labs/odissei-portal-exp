          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains kinematic data from 13 Standardbred Warmblood Trotters. Kinematic data were collected using nine wireless inertial measurement units (IMUs) containing 3D low-g and high-g accelerometers as well as a 3D gyroscope set at a sampling rate of 200 Hz. The IMUs were attached to the head, withers, tubera sacrale, both tuber coxae, and on all four legs at the mid-lateral aspect of the third metacarpal/metatarsal bones. Speed data were collected using the Global Navigation Satellite System (GNSS)-node of the IMU located on the right tuber coxae, sampling at 5hz. Each horse performed a standardized exercise test (SET) where this dataset is focusses on the warming-up jog (Jog-Start) and cooling-down jog (Jog-End)."
                }
              }
            ]
          },

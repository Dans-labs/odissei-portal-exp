            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "De boerderij Klein Basselt is een vervallen boerderij gelegen aan de Kruisvoordeweg 9 te Twello.\nMet het oog op de mogelijke ontwikkeling van de directe omgeving en de daarmee gepaard gaande sloop van de boerderij zijn de aanwezige elementen gedocumenteerd, onder andere middels dendrochronologie.\nHiervoor zijn de aanwezige elementen beoordeeld en, waar relevant, bemonsterd.\nDe oorspronkelijke structuur van twee eiken gebinten is ingestort en bloot gesteld aan de elementen.\nOndanks het beperkte aanbod kon er één geschikt boormonster genomen worden.\nDeze laat zien dat het hout in de herfst of winter van 1727/28 gekapt is. De boerderij dan vermoedelijk in 1728 of anders kort daarna opgetrokken."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2024-01-29"
                }
              }

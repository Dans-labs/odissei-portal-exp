            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "In de Bloemendalerpolder ten noorden van Weesp zijn tijdens graafwerkzaamheden voor de ontwikkeling van woningbouw in het gebied subfossiele resten van eikenbomen zijn aangetroffen. De eikenstammen zijn aangetroffen in het bosveen. Er zijn 48 gezaagde plakken hout van veeneiken onderzocht, met als doel de ouderdom van het hout en het sterfjaar van de boom zo nauwkeurig mogelijk te bepalen. Er is sprake van een continue groei van eiken vanaf 1283 BCE tot en met 71 CE."
                }
              }
            ]
          },

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Door Erfgoed Delft is een monster van de eiken (Quercus sp.) bodemplank van een grafkist aangeleverd voor dendrochronologisch onderzoek. De grafkist is aangetroffen ter plaatse van Koningsveld 4 te Delft. Verdere informatie over de context is niet verstrekt.\nDe laatste jaarring kan gedateerd worden in 1378. Aangezien spinthout of wankant ontbreekt, kan alleen de ondergrens van het kapinterval bepaald worden. Vermoedelijk is het hout aan het eind van de 14e of begin van de 15e eeuw gekapt.\nEr zijn geen sterke aanwijzingen dat het hout geïmporteerd hebben, dus mogelijk gaat het om inheems eiken."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-03-15"
                }
              }
            ]

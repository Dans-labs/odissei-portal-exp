            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek aan de Gildestraat in Riethoven zijn de resten van twee waterputten aangetroffen. Per waterput is een monster aangeleverd voor dendrochronologisch onderzoek.\nVnr. 230 is afkomstig van een boomstamput en hiervan kan de laatste jaarring in 742 gedateerd worden. Spinhout of de wankant is niet aanwezig, dus kan alleen de ondergrens van het kapinterval bepaald worden. Vermoedelijk is het hout in de tweede helft van de 8e eeuw gekapt.\nVoor vnr. 339 is de aard van de constructie niet duidelijk en kan geen datering voor het monster gevonden worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-12-03"
                }
              }

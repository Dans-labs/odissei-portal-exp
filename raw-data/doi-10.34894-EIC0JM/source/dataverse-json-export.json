            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van het Prinsenplein te Meppel is de houten fundering van een kademuur aangetroffen. Hiervan zijn twee monsters van vuren (Picea abies Karst.) elementen aangeleverd. Hiervan kon er één gedateerd worden in het midden van de 19e eeuw. Aangezien er geen wankant aanwezig is, kan alleen bepaald worden dat het kapinterval later moet vallen."
                },
                "dsDescriptionDate": {

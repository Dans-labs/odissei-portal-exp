                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Twee dendrochronologische onderzoeken die in 1995 door IBID zijn uitgevoerd in opdracht van Gemeente Amsterdam worden in deze rapportage opnieuw bekeken en de oude metingen worden vergeleken met de recente referentiekalenders met als doel de ongedateerde meetdata alsnog te dateren. Het gaat op drie metingen van archeologische houtmonsters van de site Diemen (IBID-rapportage 95.005, DIE001) en drie metingen van de site van Sloten (IBID-rapportage 95.004, SL001)"

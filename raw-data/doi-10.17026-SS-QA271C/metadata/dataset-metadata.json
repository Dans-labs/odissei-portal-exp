ue":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0009-0004-7184-7943"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"W. van Peursen"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"https:\/\/ror.org\/008xxew50","expandedvalue":{"scheme":"http:\/\/www.grid.ac\/ontology\/","termName":"Vrije Universiteit Amsterdam","@type":"https:\/\/schema.org\/Organization"}},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0002-3142-5752"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"van Peursen, Willem"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Vrije Universiteit Amsterdam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Welcome to the Visio Divina Dataset (VVD).\n\nThe VVD dataset is an output of the project Seeing the Words, conducted jointly \nat the Eep Talstra Centre for Bible and Computer (ETCBC) and the Computer Science department, Vrije Universiteit Amsterdam.\n\nProf. Prof. Willem van Peursen led the project. Hidde Makimei was the student who wrote the code and generated the images. Shuai Wang was involved as a daily supervisor of the student and the data steward.\n\n\nThe images were generated using different tools including \n- Dall E (in the folder .\/images\/dall_e_2\/).\n- Midjourney (in the folder .\/images\/mid_journey)\n- Stable Diffusion (various versions).  \nWe used some popular open-source releases: SG161222 (SG in short), runwayml (RW), CompVis (CV), stabilityai, (SAI), prompthero (PH), nitrosocke (NS), and dreamlike-art (DA).\n\nThere are in total 7,116 images. We generated 500 images using Dall E 2, and 616 images using Midjourney. For Stable Diffusion, we generated one thousand images each for RW, CV, SAI, PH, and SG. Additionally, we generated 500 images using SG and 500 images using DA. \n\nPlease check the ETCBC website for the latest version and related resources."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities","Computer and Information Science"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"sacred text"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"http:\/\/eurovoc.europa.eu\/7397"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"EuroVoc"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"http:\/\/eurovoc.europa.eu\/"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"theology"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"http:\/\/eurovoc.europa.eu\/3297"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"EuroVoc"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"http:\/\/eurovoc.europa.eu\/"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"religion"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"http:\/\/eurovoc.europa.eu\/3257"},"keywordVocabulary":{"typeName":"keywordVocabulary","multipl
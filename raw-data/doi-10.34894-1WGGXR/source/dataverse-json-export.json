            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains a text-based measure related to a firm's digital transformation. The text-based digital transformation measure is based on the firm’s business section (Item I. Business) of the annually filed 10-K report with the SEC. It contains a term-frequency (TF) based measure and a term frequency-inverse document frequency (TF-IDF) based measure. <br>\nThe data description file provides a description of all variables. <br> <br>\nPlease cite the related publication: Firk, S., Hennig, J.C., Meier, J. and Wolff, M. (2024). Institutional Entrepreneurship and Digital Transformation: The Role of Outsider CEOs. Strategic Organization, https://doi.org/10.1177/14761270241242905"
                }
              }
            ]
          },

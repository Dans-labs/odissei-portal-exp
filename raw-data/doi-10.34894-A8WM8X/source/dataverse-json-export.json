            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p dir=\"ltr\">The Impact Toolbox by the Evaluating Societal Impact project is a catalogue of tools and methods that helps university staff select resources for a structured approach to academic impact ambitions, activities and assessment.</p><p dir=\"ltr\">The collection draws upon a range of sources, such as the experience of experts in the field of impact evaluation and literature on the topic. Many of the tools have been co-designed and tested at Erasmus University Rotterdam.</p><p dir=\"ltr\">\n        <p dir=\"ltr\"> \n            <p>\n                <b>Notes: </b>This entry includes metadata only. The corresponding files will be added shortly.\n            </p>\n        </p>\n        </p>"
                }
              }
            ]

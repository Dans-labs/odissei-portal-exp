          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This dataset contains the responses to self-reported questionnaires by older people who participant in the ValueCare project across seven cities in Europe (Athens, Coimbra, Cork and Kerry, Rijeka, Rotterdam, Treviso and Valencia). The dataset contains the response at three measurement timepoints: T0, T1 and T2. The questionnaire was divided into 7 parts: quality of life, health and well-being, physical functioning, lifestyle behaviour, medication use, care use, general questions and productivity loss. The validated questionnaires used are: Promis-10, EQ-5D-5L, Tilburg Frailty Indicator, UCLA-3 loneliness scale, ADL, Visual analogue scale for fear of falling, one item of SHARE-Frailty, one item of IPAQ, SNAQ-65+, MRQ-10, the modified SMRC Health Care Utilisation questionnaire, iMTA productivity cost questionnaire (iPCQ)"
                }
              }
            ]
          },

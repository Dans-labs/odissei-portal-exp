            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "In opdracht van Archeologie West-Friesland is een monster van een scheepswrak dendrochronologisch onderzocht. Het scheepswrak is aangetroffen in de buurt van Callantsoog. Over de verdere context van de vondst is geen aanvullende informatie verstrekt.\nHet monster bevat voldoende jaarringen en ook is de wankant aanwezig. Het jaarringpatroon is echter onregelmatig wat een reden kan zijn waarom er geen datering voor het monster gevonden kon worden."
                },
                "dsDescriptionDate": {

                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This data repository includes C++ simulation code, simulation results and R data analysis scripts for the manuscript “Coevolution of larval signalling and worker response can trigger developmental caste determination in social insects”.\nC++ code can be found in folder “code”. Analyses and figures can be reproduced by running the R-script in folder “data_analysis”. In order to run the R-script the directories need to be set correctly to the data folders (“Developmental_length”, “Foraging_shape”, “Mutation_rate”, “Number_matings”, “Resources_reproduction”, “Signalling_cost”, “Egg_size”, “Detailed_output)."
                },

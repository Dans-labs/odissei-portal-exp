            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Een houtmonster van een paal afkomstig van mogelijk huisplattegrond is door een archeologisch vrijwilliger aangedragen voor dendrochronologisch onderzoek. De dendrochronologische metingen resulteren in meetreeks 26HH0011 met een lengte van 73 jaarringen. De buitenste gemeten jaarring loopt voor een groot deel parallel aan de kromming van het rondhout. Hiermee is te veronderstellen dat de laatste gemeten jaarring de spintgrens betreft. De te verwachten zone spinthout – die dus ontbreekt in dit houtmonster – zou voor een eik van deze leeftijd ongeveer 18 ± 5 jaar zijn. De laatst gemeten jaarring in het hout is gegroeid in het jaar 37 na Chr. Door de aanwezigheid van de spinthoutgrens is te calculeren dat het kapinterval 55 ± 5 jaar na Chr. zal hebben plaatsgevonden, kortom tussen 50 en 60 na Chr."
                }
              }
            ]
          },

                  "typeClass": "primitive",
                  "value": "childcare; voor- en vroegschoolse educatie; schoolloopbanen; school career; sociaal-emotionele ontwikkeling; social-emotional development; primary school; basisschool"
                }
              }
            ]
          },
          {
            "typeName": "language",
            "multiple": true,

ousehold \/ Other: presence of partner in family\/household   Respondent: occupational status   Respondent: gross income \/ Respondent: net income \/ Total family\/household: gross income \/ Total family\/ household: net income   Respondent: highest grade attained \/ Respondent: highest type attended   Other: constructed variable ( social economic class ) according to GFK *  Dongen."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"criminology"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"crime"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"law"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"1995-09-01"},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Centerdata Tilburg University (depositor)"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"CenterData, Universiteit Brabant, Tilburg (research initiator)"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"CenterData, Universiteit Brabant, Tilburg (data collector)"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"CenterData, Universiteit Brabant, Tilburg (primary investigator)"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2009-09-08"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"1995-09-01"}]},"dansRights":{"displayName":"Rights Meta
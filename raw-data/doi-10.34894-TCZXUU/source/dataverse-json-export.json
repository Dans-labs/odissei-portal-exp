            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Uit het pand aan de Buiten Nieuwstraat 56 te Kampen zijn door van der Schee Bouwhistorie enkele boormonsters genomen en aangeleverde voor dendrochronologisch onderzoek. Daarnaast is een monster van een plank uit de Boven Nieuwstraat 87 meegeleverd.\nVoor de Buiten Nieuwstraat 56 zijn vijf eiken (Quercus sp.) monsters aangeleverd, waarvan er vier geschikt bleken voor onderzoek. Hiervan konden er twee gedateerd worden; één monster (2-3 mb) zonder spinthout dateert in de 14e eeuw. Hoewel hiervoor geen afgebakend kapinterval bepaald kan worden, is deze datering lastig te verenigen met de het kapinterval rond 1495 voor 3-3 mb. \nDe plank uit de Boven Nieuwstraat 87 is fijnspar (Picea abies Karst.) en hoewel deze voldoende jaarringen bevatte voor onderzoek, konden geen resultaten gevonden worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-04-18"
                }
              }
            ]

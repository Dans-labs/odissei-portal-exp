              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The validation of the USD-4D is performed in multiple studies\n1)\tWhat do patients need to use the USD-4D in daily care\nQualitative data from individual interviews with 13 patients\n2)\tWhat do healthcare professionals need to work with the USD4D in daily care\nQuantitative data from a 49-item survey  completed by 122 healthcare professionals\n3)\tContent validity of the USD-4D from the patient perspective\nQualitative data from interviews with 12 patients\n4)\tContent validity of the USD-4D from the health care professional perspective\nQuantitative data from a survey completed by 601 healthcare professionals\n5)\tConstruct validity of the USD-4D using hypotheses testing \nQuantitative data were used from two cohorts of patients with life limiting illness."
                },

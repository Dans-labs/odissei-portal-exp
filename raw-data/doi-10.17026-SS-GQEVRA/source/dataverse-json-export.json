                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Interview with the experienced textile conservator, Emmy de Groot, contributing to enriching conservation history in textiles, conducted in the Ateliergebouw, Amsterdam, the Netherlands, on 14 January 2025. The interview includes her training, career in conservation, a conservation studio in Haarlem, her teaching experience, and ethics and philosophy in conservation."
                }

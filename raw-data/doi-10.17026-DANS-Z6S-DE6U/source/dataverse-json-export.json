              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Geïnterviewde werkte tijdens de oorlog in de mijnen en gaf gehoor aan de oproep om op de Amerikaanse oorlogsbegraafplaats te komen helpen. In de periode van de heropgravingen (1948-1949) gaat hij opnieuw aan de slag op de begraafplaats, en blijft tot 1983 in dienst.</p>"
                }
              },
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>audio kanaal 1: hengel geïnterviewde,<br>audio kanaal 2: zender interviewer |<br><br>interview in het Limburgs dialect, transcriptie vertaald naar het nederlands |</p>"
                }
              }

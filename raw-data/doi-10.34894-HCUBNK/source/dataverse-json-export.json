            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The dataset ‘ESTA Database Locations (GLOBALISE Replication)’ covers the (projected) locations in the Exploring Slave Trade in Asia (ESTA) project’s database as of January 2023. The ESTA Database contains data on slave trade movements, often maritime, in the larger Indian Ocean basin and East Asia, from roughly the sixteenth to the nineteenth century. Locations have been standardised and classified into four region categories, panning from continents to subregions. A list of these coded regions is included in this dataset. Also, coordinates have been determined in various degrees of probability and geographical accuracy, along with specific sources and personal comments supporting or clarifying these claims. (2025-04-11)"
                }
              }
            ]
          },

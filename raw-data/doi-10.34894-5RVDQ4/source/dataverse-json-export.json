          {
            "typeName": "dsDescription",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Midwouder Dorpstraat 25 in Midwoud zijn bewoningresten aangetroffen. Het gaat hier om waterputten, een waterkelder en enkele funderingsresten aangetroffen. Hiervoor is grove den (Pinus sylvestris L.), vuren (Picea abies Karst.), eik (Quercus spp.), zilverspar (Abies alba Mill.) en beuk (Fagus sylvatica L.) gebruikt. \nVoor de waterput met spoornr. 66 lan geen datering gevonden worden. De waterput met spoornr. 87 dateert uit 1565, gebaseerd op de datering van M 7.3 waarop de wankant bewaard is gebleven.\nDe fundering met spoornr. 122 dateert uit het begin van de 19e eeuw.\nDe waterkelder (spoornr. 88) laat een vergelijkbare ouderdom zien met een datering van M 10.3 aan het eind van de 18e eeuw. De wankant ontbreekt hier echter. De eiken plank M 9.1 uit dezelfde context kan niet gedateerd worden. Waarschijnlijk heeft deze een vergelijkbare, recente ouderdom en is het relevante referentiemateriaal simpelweg niet voorhanden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-08-05"
                }
              }
            ]
          },

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The data have been collected as part of a discrete choice experiment (DCE). The aim of the DCE was to examine how nurses and teachers can be motivated to increase their working hours. Increasing the working hours of nurses and teachers might be a solution to address labour shortages in these professions. The survey was designed by researchers from Maastricht University, Vrije Universiteit Amsterdam, and MUMC+. The results of this study have been published in PLOS One and was funded by Instituut Gak. This is a restricted dataset from which personal identifying information (e.g.,  municipality of residence) has been removed."
                },
                "dsDescriptionDate": {

                  "value": "Atria  kennisinstituut voor emancipatie en vrouwengeschiedenis"
                },
                "datasetContactAffiliation": {
                  "typeName": "datasetContactAffiliation",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Atria, kennisinstituut voor emancipaie en vrouwengeschiedenis"

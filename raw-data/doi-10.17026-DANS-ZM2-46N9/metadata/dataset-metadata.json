{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Interview Arthur Vriens over Shattered Ghost Stories"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:160465"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"S.R. Janson"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Data stewards FGw-UvA"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Interview met Arthur Vriens over het maakproces van hoofden en lichamen, die hij heeft gemaakt in opdracht van de Nederlandse kunstenares Lydia Schouten voor de installatie Shattered Ghost Stories begin jaren ’90. Het lichaam van de kunstenares zelf vormde de basis voor de mallen van zowel de hoofden als de lichamen. Schouten heeft in meerdere installaties hoofden gebruikt. De lichamen gebruikte ze alleen voor Shattered Ghost Stories. De invalshoek van het interview is de conservering van dit werk in de collectie van Museum Arnhem. De installatie bestaat uit vier kolommen waarin een levensgrote figuur, een hoofd, poppetjes, foto’s en een tekstplaat hangen. Daarnaast zijn licht, audio, rook en een blauwe kleur onderdeel van de installatie. Elk van de vier hoofden van Shattered Ghost Stories heeft een huid van natuurrubber en een kern van polyurethaanschuim (PUR schuim)."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Lydia Schouten"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Arthur Vriens"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Sjoerd Didden"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Shattered Ghost Stories"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Museum Arnhem"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Gips"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"latex"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"schuim"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"natuurrubber"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"polyurethaanschuim"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"PUR schuim"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"conservering en restauratie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"installatie"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"kunstenaarsnala
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "In this folder you will find metadata files of the Jellinek Prevention study. This study consists of three parts that focus on mental health problems and substance use among refugees. Below a description of the three parts:\n1. Policy advice: This part includes a group interview about policy advice regarding mental health care among refugees.\n2. E-learning for professionals who work with refugees: In this e-learning, professionals receive information and tools about mental health problems and substance use.\n3. Information sessions for refugees: During these sessions, the topics mental health problems and substance use were discussed through the use of interventions.\n\nFunded by ZonMw, project number: 636602004"
                }
              }
            ]

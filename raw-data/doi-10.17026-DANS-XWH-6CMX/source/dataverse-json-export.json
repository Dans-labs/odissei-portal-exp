                  "typeClass": "primitive",
                  "value": "CBS BMB"
                }
              },
              {
                "keywordValue": {
                  "typeName": "keywordValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Schoolverlaters"
                }
              }
            ]
          },
          {
            "typeName": "notesText",
            "multiple": false,
            "typeClass": "primitive",
            "value": "Vanwege het ontbreken van enkele variabelen zijn nieuwe versies van de datafiles over 2018 beschikbaar gesteld per 18 maart 2021.\nDe bestanden zijn uitgebreid met de variabele: SVOVRGHuidSit. De documentatie is hierdoor ook aangepast."

lying ideas and the socio-cultural context as well as cultures of conservation. The collection is ongoing and additions are welcome to build a rich collection of unique source material to help sustain our cultural heritage for future generations."}}]},{"typeName":"dataSources","multiple":true,"typeClass":"primitive","value":["The files can be consulted by registrering with DANS and request access through the Datastation by selecting the desired files under the files tab, and indicating the purpose of use as part of the request."]}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Stigter, S."]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Yes"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch","English"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D35000","https:\/\/www.narcis.nl\/classification\/D35100","https:\/\/www.narcis.nl\/classification\/D30000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D35000","termName":[{"lang":"en","value":"Arts and culture"},{"lang":"nl","value":"Kunst- en cultuurwetenschappen"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"},{"@id":"https:\/\/www.narcis.nl\/classification\/D35100","termName":[{"lang":"nl","value":"Kunstgeschiedenis en architectuurgeschiedenis"},{"lang":"en","value":"History of arts and architecture"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"},{"@id":"https:\/\/www.narcis.nl\/classification\/D30000","termName":[{"lang":"nl","value":"Geesteswetenschappen"},{"lang":"en","value":"Humanities"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]},{"typeName":"dansCollection
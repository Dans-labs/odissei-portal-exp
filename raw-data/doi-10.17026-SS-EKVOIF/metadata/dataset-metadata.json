{"license":"DANS Licence","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Interview met Robert Smit, Amsterdam, 22 februari 2024"},{"typeName":"subtitle","multiple":false,"typeClass":"primitive","value":"Over intentie, werkwijze, presentatie en behoud"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Stigter, S."},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0001-5250-8461"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Brum, O"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0009-0006-6310-9646"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Datasteward"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"}},{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Stigter, S."},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"University of Amsterdam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Het interview is gericht op kunstenaarsintentie in het kader van een onderzoeksproject bij de Universiteit van Amsterdam. Robert Smit vertelt hoe zijn werk als edelsmid en kunstenaar begon, verrast door zijn aanleg voor sieraad reparaties en geïnspireerd door goede vriend Jan Schoonhoven, ook uit Delft, ten tijden van de Nul beweging (Zero-periode); zijn opleiding aan de Kunst und Werkschule in Pforzheim; zijn werkproces in series, waarin een volgende sieraad, of serie, een reactie vormt op een vorige, in materiaal, kleur, vorm. Ter illustratie toont hij recente halssieraden uit blik, in reactie op het traditionele gebruik van goud als materiaal voor sieraden. Uit zijn werkwijze blijkt een onderzoekende houding in het uittesten van mogelijkheden en vindingrijkheid in technische oplossingen in verwerken van materialen, bijvoorbeeld het lassen van ringen veerstaal uit plantenclips met behulp van minieme hoeveelheid goud. Voorts over bevriende kunstenaars Sjoerd Buisman en Franck Gribling, evenals collega Armando."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Arts and Humanities"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Robert Smit"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"RKD"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"https:\/\/rkd.nl\/artists\/73343"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Beeldend Kunstenaar"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"http
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van Walsland te Vianen is een als beerput hergebruikte ton aangetroffen. Van de ton zijn enkele duigen geselecteerd en bemonsterd voor dendrochronologisch onderzoek. In alle drie gevallen gaat het om eik (Quercus sp.).\nDe drie duigen kunnen onderling gedateerd worden en hiermee kan de middelcurve 23.086.M01 gemaakt worden. Deze kan gedateerd worden in 1525. Aangezien er geen spinthout of wankant aanwezig is kan alleen de ondergrens van kapinterval geschat worden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2023-10-12"
                }
              }
            ]

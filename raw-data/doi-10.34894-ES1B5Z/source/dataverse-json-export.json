            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Door ADC ArcheoProjecten zijn 2 monsters van een tabaksschuur aan de Doornsteeg 21 te Nijkerk aangeleverd voor dendrochronologisch onderzoek. Op basis van de context wordt een ouderdom in de 17e tot 19e eeuw verwacht.\nOp basis van de sterke onderlinge gelijkenis tussen de meetreeksen mag aangenomen worden dat beide monsters uit dezelfde boom afkomstig zijn. Hiervoor is de middelcurve 22.088.B01 gemaakt. Deze middelcurve kan gedateerd worden in 1652. Aangezien op één van de monsters de wankant aanwezig is, kan bepaald worden dat het hout in de herfst of winter van 1652/53 gekapt is. Waarschijnlijk is de tabaksschuur dan in 1653, of anders kort daarna, opgetrokken."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2022-10-19"
                }
              }

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek op de locatie van de Groeningeabdij in Kortrijk is een aantal vermoedelijke Romeinse waterputten aangetroffen. Hiervan zijn vijf monsters genomen en aangeleverd voor dendrochronologisch onderzoek.\nIn alle gevallen gaat het om eik (Quercus sp.). De meeste bevatten te weinig jaarringen voor onderzoek. H3 bleek echter wel geschikt.\nDit monster kan gedateerd worden in 166 na Chr. Spinthout of de wankant is niet aanwezig waardoor alleen de ondergrens van het kapinterval bepaald kan worden.\nDit komt overeen met de Romeinse ouderdom."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,

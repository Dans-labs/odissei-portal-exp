            "typeName": "dataSources",
            "multiple": true,
            "typeClass": "primitive",
            "value": [
              "The data consists in webpages, newspaper and magazine articles retrieved on the LexisNexis database, all selected because they resulted from a search on a single keyword 'neuromarketing'. These webpages and articles have been saved fully (whole HTML code), plus indexed by a human coder, in a bibliography management software (Zotero). Visuals included in these documents have been indexed in a separate folder in the same Zotero archive."
            ]
          }

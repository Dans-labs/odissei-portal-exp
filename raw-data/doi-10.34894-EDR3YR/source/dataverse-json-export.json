            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The discussion about costs and benefits of preregistration has been \nhindered by a lack of a conceptual analysis of what preregistration aims\n to accomplish. Any conceptual definition about a tool that scientists \nuse must examine the goal it has. Scientists differ in the goals they \nhave, which depend in turn on their philosophy of science. It is \ntherefore important to justify the value of preregistration based on a \nphilosophy of science. This presentation distinguishes the goal of \npreregistration from positive externalities and highlights the \nimportance of evaluating the usefulness of a tool such as \npreregistration from one specific philosophy of science."
                }
              }
            ]
          },

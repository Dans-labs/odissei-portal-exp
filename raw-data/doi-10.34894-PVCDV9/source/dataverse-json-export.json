            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek ter plaatse van de Melkweg te Zelhem door Econsultancy zijn twee boomstamputten aangetroffen. In beide gevallen gaat het om eik (Quercus sp.). Van de waterputten zijn monsters genomen en aangeleverd voor onderzoek. Eén van de monsters (vondstnr. 297) bevat voldoende jaarringen. Tevens is het spinthout bewaard gebleven.\nOndanks de goede kwaliteit bleek het niet mogelijk een datering voor de waterput te vinden."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "17-01-23"
                }
              }
            ]

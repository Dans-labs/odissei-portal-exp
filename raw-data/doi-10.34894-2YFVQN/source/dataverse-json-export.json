            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek aan de Gistelse Steenweg in Sint-Andries is een waterkuil aangetroffen met een vermoedelijk Romeinse ouderdom. Onderin de waterkuil is een eiken (Quercus sp.) plank aangetroffen. Hiervan is een staal aangeleverd voor dendrochronologisch onderzoek. Ondanks iets meer dan 200 jaarringen kon de Romeinse ouderdom (of een andere ouderdom) niet aangetoond worden.\nAanvullend onderzoek door dr. K. Haneca  leverde eveneens geen resultaat op."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",

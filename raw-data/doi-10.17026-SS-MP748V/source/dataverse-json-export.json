            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This study used PAR in which participants and researchers collaborate to bring their unique perspectives, knowledge, and experiences to collaboratively produce knowledge and take action to improve the offered HBSR. Different methods for data generation and analysis were used in the different PAR phases, depending on the aim of the PAR phase and the stages of change of the participants. The Consolidated Framework for Implementation Research (CFIR) was used to guide the selection of implementation strategies and evaluate which strategies were utilized during the project."
                }
              }
            ]

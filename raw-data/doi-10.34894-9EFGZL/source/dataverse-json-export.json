            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Bij archeologisch onderzoek langs het Pasveld nabij Holtum zijn de resten van een vermoedelijk Romeinse waterput aangetroffen.\nUit de bekisting zijn drie monsters genomen en aangeleverd voor dendrochronologisch onderzoek. In alle gevallen gaat het om eik (Quercus spp.). De twee planken met vondstnummers 210-2 en 210-3 lijken uit dezelfde boom afkomstig. Hiervoor is de middelcurve 25.051.B01 gemaakt. Ondanks de voorbeelding eigenschappen van de meting kan geen goed resultaat gevonden worden. Het resterende monster (vondstnr. 210-1) laat een datering zien in 118 na Chr. Omdat er geen spinthout aanwezig is kunnen er geen afgebakende kapintervallen bepaald worden. Vermoedelijk stamt de waterput uit het midden van de 2e eeuw."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2025-07-07"
                }
              }
            ]

            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "<p>Mevrouw van Brandwijk schetst haar jeugd op het Groninger platteland in de jaren ’50. Zij werd na haar middelbare schooltijd actief in de vakbeweging, en was radiomaakster en beleidsmedewerker voordat zij een opleiding tot humanistisch raadsvrouw volgde. Zij ging rond haar 30ste aan het werk bij defensie als raadsvrouw, en schetst een helder beeld van het werken als vrouw in een mannenbolwerk. In 1992 beleefde zij een uitzending in het kader van Cambo II, waarbij onder andere het werken als vrouwelijke militair bij het korps mariniers en de tegenwerking als vrouw op uitzending centraal stond.</p>"
                }
              }
            ]

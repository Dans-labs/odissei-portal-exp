            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This database was produced in the context of the dissertation \"A Truth Universally Acknowledged. Dutch Investment in French Colonial Resources, 1717-1792\", as part of NWO VICI project VI.C.191.027. This database consists of 562 protested bills of exchange. These bills of exchange were addenda to a type of notarial deed, the wisselprotest.  All wisselprotesten (and therefore bills of exchange) in this database originate from the notarial archives of Amsterdam, preserved by the Amsterdam City Archives. All information on the archival sources, selection mechanisms, and form of the database can be found in the protocol."
                }

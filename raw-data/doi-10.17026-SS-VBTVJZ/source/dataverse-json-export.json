          {
            "typeName": "series",
            "multiple": true,
            "typeClass": "compound",
            "value": [
              {
                "seriesInformation": {
                  "typeName": "seriesInformation",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "In dit onderzoek worden de Nederlandse nationale herinnering aan de genocide in Srebrenica en activistische herinneringen hiervan onder de Bosnische diaspora in Nederland onderzocht, met een focus op hoe deze herinneringen worden beïnvloed door ideeën van slachtofferschap en daderschap. Om dit te doen worden culturele en persoonlijke expressies van herinneringen geanalyseerd. De oral history interviews die worden afgenomen in het kader van dit onderzoek ondersteunen de analyse van persoonlijke herinneringen van leden van de Bosnische diaspora in Nederland die zich actief bezighouden met de herinnering aan de Srebrenica genocide."
                }
              }
            ]
          }

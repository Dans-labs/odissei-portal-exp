            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "De aanleg van een riooltracé langs de Grotestraat in Almelo is archeologisch begeleid.\nHet houten vondstmateriaal wat hierbij is aangetroffen bestaat overwegend uit enkele stukken constructiehout en kleiner bewerkingsafval. Vermoedelijk stamt dit uit de late middeleeuwen of het begin van de nieuwe tijd. Drie eiken (Quercus spp.) vondsten zijn geselecteerd voor dendrochronologisch onderzoek, maar hiervoor kunnen geen dateringen gevonden worden. \nUit het bewerkingsafval is een selectie gemaakt voor houtsoortendeterminatie. Hieruit blijkt dat het om algemene houtsoorten gaat zoals els (Alnus glutinosa Gaertn.), wilg (Salix sp.) en eik."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "2026-07-06"
                }
              }
            ]

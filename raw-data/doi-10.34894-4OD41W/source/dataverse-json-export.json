                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "Van de boerderij aan de Berweg 46 in Tuk is een monster van een ankerbalk aangeleverd voor dendrochronologisch onderzoek. Het gaat om een grenen (Pinus sylvestris L.) deel van de ankerpen. De laatste jaarring dateert in 1592. De wankant is niet aanwezig, dus kan alleen bepaald worden dat het hout ergens na 1592 gekapt is."
                },

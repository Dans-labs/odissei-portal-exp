            "typeClass": "compound",
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "This data set contains the raw data used for the analysis of the research article “Religion, social desirability bias and financial inclusion: Evidence from a list experiment on Islamic (micro-)finance”. In particular, it comprises information regarding the attitudes of the Muslim poor towards the use of non-Islamic financial products and services, based on survey data and list experiment data of 2,145 borrowers of an Islamic microfinance institution (Akhuwat) from the city of Multan, Punjab Province, Pakistan, collected in 2017. Data collection took place in Urdu."
                }
              }
            ]

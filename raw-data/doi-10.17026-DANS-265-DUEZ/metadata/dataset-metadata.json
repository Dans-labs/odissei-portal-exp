:{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Pilot for the NSCR School project among 148 vmbo (preporatory vociational) students in The Hague, partly pencil and paper, partly via computer. PILOT to test the questionnaire of the NSCR Schoolproject. The NSCR Schoolproject aimed to enhance insights into the complicated relations between delinquency and other problem behaviors, psycho-social development, peer networks, and school informal interventions."}},{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Data available in consultation with NSCR. Please contact the datamanager [datamanagement@nscr.nl]"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Law"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"juvenile delinquency"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"problem behavior"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"peers"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"social network analysis"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"method datacollection"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2003-07-30"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2013-03-01"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2013-03-01"},{"typeName":"dataSources","multiple":true,"typeClass":"primitive","value":["Primarily preporatory vocational (vmbo) secondary school students from the province South Holland (N=148). The datacol
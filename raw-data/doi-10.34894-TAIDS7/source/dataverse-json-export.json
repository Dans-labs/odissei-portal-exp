            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "In opdracht van ADC ArcheoProjecten is een aantal duigen van een ton dendrochronologisch onderzocht. De ton is aangetroffen bij een opgraving op het plangebied “Centrumplan” in IJsselstein en is opmerkelijk omdat de bodem met de afbeelding van een leeuw beschilderd is.\nOp basis van de onderlinge synchronisatie van de metingen kan een middelcurve (21.108.M01) samengesteld worden waarin 6 van de 10 duigen opgenomen kunnen worden.\nSynchronisatie van middelcurve met Europese referentiecurven levert geen resultaten op, maar referenties voor Noord-Amerika leveren wel goede resultaten op."
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "22-04-24"
                }
              }
            ]

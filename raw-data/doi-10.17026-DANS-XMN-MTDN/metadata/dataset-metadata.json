{"license":"CC0-1.0","fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Online Appendix: Using Moral Foundations in Government Communication to Reduce Vaccine Hesitancy"},{"typeName":"otherId","multiple":true,"typeClass":"compound","value":[{"otherIdAgency":{"typeName":"otherIdAgency","multiple":false,"typeClass":"primitive","value":"DANS-KNAW"},"otherIdValue":{"typeName":"otherIdValue","multiple":false,"typeClass":"primitive","value":"easy-dataset:158398"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"F.A. Heine"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Tilburg University"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0002-9903-4555"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"E. Wolters"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Tilburg University"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Florian  Heine"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Vrije Universiteit Amsterdam"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"This is the online appendix for the article Using Moral Foundations in Government Communication to Reduce Vaccine Hesitancy. Using vaccination information brochures from the Dutch National Institute for Public Health and the Environment (RIVM) we analyse the use of Moral Foundations in this context of government communication. We find that RIVM predominantly uses the dimensions of Harm\/Care and Purity\/Degradation in its communication with parents. By contrast, the dimensions Authority\/Subversion and Fairness\/Cheating play only a minor role or no role in government communication with parents. We employ these results to investigate the effect of this communication channel on vaccination rates. While prior research has shown that vaccine hesitant individuals emphasise the Moral Foundations Liberty\/Oppression and Purity\/Degradation, our results confirm this relationship only with respect to the dimension Liberty\/Oppression. For the use of Purity\/Degradation, by contrast, we find no significant effect on parents' vaccine hesitancy. Instead, Authority\/Subversion appears to reduce, while Loyalty\/Betrayal increases vaccine hesitancy."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Vaccinations"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Moral Foundations Theory"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Vaccine Hesitancy"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Vaccination Rate"}}]},{"typeName":"notesText","multiple":false,"typeClass":"primitive","value":"The dataset has been updated (22 October 2021) to extend towards vaccination data on regional (GGD regio) and municipal level. Furthermore, the data now also includes the year 2019. The command documentation now also incorporates graphical analyses.\nUpdatet files: \n*Dofile.do\nNew command documentation for the statistical analysis. Replaces old Dofile.do.\n*Merged3.dta\nNew Dataset, now with municipal and regional data, and with data from 2019. Replaces Merged.dta.\n*Dunntest3.dta\nDataset for the Dunntest. New file.\n*Attachment5_LIWC.dta\nUpdated LIWC output based on new data. Replaces Attachment5_LIWC output.ods"},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["Dutch","English"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2020-01-16"},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2020-01-29"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2020-01-29"}]},"dansRights":{"displayName":"Rights Metadata","name":"dansRights","fields":[{"typeName":"dansRightsHolder","multiple":true,"typeClass":"primitive","value":["Dr. F.A. Heine (Tilburg University)","MSc E. Wolters (Tilburg University)","Dr. F.A. Heine (Tilburg University)","MSc E. Wolters (Tilburg University)"]},{"typeName":"dansPersonalDataPresent","multiple":false,"typeClass":"controlledVocabulary","value":"Unknown"},{"typeName":"dansMetadataLanguage","multiple":true,"typeClass":"controlledVocabulary","value":["English"]}]},"dansRelationMetadata":{"displayName":"Relation Metadata","name":"dansRelationMetadata","fields":[{"typeName":"dansAudience","multiple":true,"typeClass":"primitive","value":["https:\/\/www.narcis.nl\/classification\/D60000"],"expandedvalue":[{"@id":"https:\/\/www.narcis.nl\/classification\/D60000","termName":[{"lang":"en","value":"Social sciences"},{"lang":"nl","value":"Sociale wetenschappen"}],"vocabularyUri":"https:\/\/www.narcis.nl\/classification\/"}]},{"typeName":"dansRelation","multiple":true,"typeClass":"compound","value":[{"dansRelationType":{"typeName":"dansRelationType","multiple":false,"typeClass":"controlledVocabulary","value":"is referenced by"},"dansRelationText":{"typeName":"dansRelationText","multiple":false,"typeClass":"primitive","value":"Using Moral Foundations in Government Communication to Reduce Vaccine Hesitancy"},"dansRelationURI":{"typeName":"dansRelationURI","multiple":false,"typeClass":"primitive","value":"https:\/\/fheine.weebly.com\/uploads\/6\/2\/5\/1\/62510193\/manuscript2.pdf"}}]}]},"dansTemporalSpatial":{"displayName":"Temporal and Spatial Coverage","name":"dansTemporalSpatial","fields":[{"typeName":"dansTemporalCoverage","multiple":true,"typeClass":"primitive","value":["2011-2018"]},{"typeName":"dansSpatialCoverageControlled","multiple":true,"typeClass":"controlledVocabulary","value":["Netherlands"]}]},"dansDataVaultMetadata":{"displayName":"Data Vault Metadata","name":"dansDataVaultMetadata","fields":[{"typeName":"dansDataversePid","multiple":false,"typeClass":"primitive","value":"doi:10.17026\/DANS-XMN-MTDN"},{"typeName":"dansDataversePidVersion","multiple":false,"typeClass":"primitive","value":"2.1"},{"typeName":"dansBagId","multiple":false,"typeClass":"primitive","value":"urn:uuid:c974ca39-732a-4868-8b3f-9c13eb3bef5f"},{"typeName":"dansNbn","multiple":false,"typeClass":"primitive","value":"urn:nbn:nl:ui:13-5a-udc9"}]}}}
            "value": [
              {
                "dsDescriptionValue": {
                  "typeName": "dsDescriptionValue",
                  "multiple": false,
                  "typeClass": "primitive",
                  "value": "The dataset contains robotic flight data of high agility maneuvers and fruit-fly inspired rapid banked turns, which are reported in the manuscript \"A tailless aerial robotic flapper reveals that flies use torque coupling in rapid banked turns\".\r\nhttp://science.sciencemag.org/cgi/doi/10.1126/science.aat0350\r\n<br>\r\n<br>\r\nFor each experiment we provide:\r\n<ul>\r\n<li>motion tracking data\r\n<li>on-board data\r\n<li>on-board data interpolated to the motion tracking sample times\r\n</ul>"
                },
                "dsDescriptionDate": {
                  "typeName": "dsDescriptionDate",
